<?xml version="1.0" encoding="UTF-16"?>
<!--
  Reference export of the DeresoRoleGroupSync root-server Scheduled Task (07-05 Task 3).
  Authoritative generator: scripts/Register-AutomationTasks.ps1 -TaskName DeresoRoleGroupSync
  (which registers the task then re-exports this file via `schtasks /Query /TN ... /XML`).
  Hand-authored here because running the generator registers a real task on the host;
  07-12 regenerates this on the real BES root server. Paths below are the script's default
  parameter values; note -DatabasePath below is RolePublish.db (the D-05 audit store),
  built from the -RolePublishDbPath parameter, NOT the AutomationState.db every other
  Dereso*Sync/Publish/Ingest task in this directory uses. 04:00 is deliberately one hour
  after the content pipeline's 03:00 window (task-DeresoContentSync.xml /
  task-DeresoRoleIngest.xml / task-DeresoRolePublish.xml) so the two never contend. The
  helper prefers pwsh.exe and falls back to powershell.exe.
-->
<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>D-06 drift check (07-05): re-syncs each role's automatic Computer Group relevance against the RolePublish.db audit store. Reads RolePublish.db, NOT AutomationState.db.</Description>
    <URI>\DeresoRoleGroupSync</URI>
  </RegistrationInfo>
  <Triggers>
    <CalendarTrigger>
      <StartBoundary>2026-01-01T04:00:00</StartBoundary>
      <Enabled>true</Enabled>
      <ScheduleByDay>
        <DaysInterval>1</DaysInterval>
      </ScheduleByDay>
    </CalendarTrigger>
  </Triggers>
  <Principals>
    <Principal id="Author">
      <UserId>S-1-5-18</UserId>
      <RunLevel>HighestAvailable</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <AllowHardTerminate>true</AllowHardTerminate>
    <StartWhenAvailable>true</StartWhenAvailable>
    <RunOnlyIfNetworkAvailable>false</RunOnlyIfNetworkAvailable>
    <IdleSettings>
      <StopOnIdleEnd>true</StopOnIdleEnd>
      <RestartOnIdle>false</RestartOnIdle>
    </IdleSettings>
    <AllowStartOnDemand>true</AllowStartOnDemand>
    <Enabled>true</Enabled>
    <Hidden>false</Hidden>
    <RunOnlyIfIdle>false</RunOnlyIfIdle>
    <WakeToRun>false</WakeToRun>
    <ExecutionTimeLimit>PT0S</ExecutionTimeLimit>
    <Priority>7</Priority>
  </Settings>
  <Actions Context="Author">
    <Exec>
      <Command>C:\Windows\System32\WindowsPowerShell\v1.0\powershell.exe</Command>
      <Arguments>-NonInteractive -NoProfile -ExecutionPolicy Bypass -File "C:\Program Files (x86)\BigFix Enterprise\BES Server\SoftwarePortal\scripts\Sync-RoleGroups.ps1" -DatabasePath "C:\Program Files (x86)\BigFix Enterprise\BES Server\SoftwarePortal\RolePublish.db" -SQLDir "C:\Program Files (x86)\BigFix Enterprise\BES Client\EC\sqlite" -LogDir "C:\Program Files (x86)\BigFix Enterprise\BES Server\SoftwarePortal\logs"</Arguments>
    </Exec>
  </Actions>
</Task>
