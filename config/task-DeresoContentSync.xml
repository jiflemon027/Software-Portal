<?xml version="1.0" encoding="UTF-16"?>
<!--
  Reference export of the DeresoContentSync root-server Scheduled Task (07-03 Task 3).
  Authoritative generator: scripts/Register-AutomationTasks.ps1 -TaskName DeresoContentSync
  (which registers the task then re-exports this file via `schtasks /Query /TN ... /XML`).
  Hand-authored here because running the generator registers real tasks on the host;
  07-05 regenerates this on the real BES root server. Paths below are the script's default
  parameter values. The helper prefers pwsh.exe and falls back to powershell.exe.
-->
<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>Dereso content pipeline (07-03): weekly scan of the configured source sites for newer/added product fixlets. Records ContentItems as discovered - the 4-step copy is operator-gated (stage=ready), AutoApprove OFF by default (D-26). Chains DeresoRepoStage on a successful run.</Description>
    <URI>\DeresoContentSync</URI>
  </RegistrationInfo>
  <Triggers>
    <CalendarTrigger>
      <StartBoundary>2026-01-04T03:00:00</StartBoundary>
      <Enabled>true</Enabled>
      <ScheduleByWeek>
        <DaysOfWeek>
          <Sunday />
        </DaysOfWeek>
        <WeeksInterval>1</WeeksInterval>
      </ScheduleByWeek>
    </CalendarTrigger>
  </Triggers>
  <Principals>
    <Principal id="Author">
      <UserId>S-1-5-18</UserId>
      <RunLevel>HighestAvailable</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <AllowHardTerminate>true</AllowHardTerminate>
    <StartWhenAvailable>true</StartWhenAvailable>
    <RunOnlyIfNetworkAvailable>false</RunOnlyIfNetworkAvailable>
    <IdleSettings>
      <StopOnIdleEnd>true</StopOnIdleEnd>
      <RestartOnIdle>false</RestartOnIdle>
    </IdleSettings>
    <AllowStartOnDemand>true</AllowStartOnDemand>
    <Enabled>true</Enabled>
    <Hidden>false</Hidden>
    <RunOnlyIfIdle>false</RunOnlyIfIdle>
    <WakeToRun>false</WakeToRun>
    <ExecutionTimeLimit>PT0S</ExecutionTimeLimit>
    <Priority>7</Priority>
  </Settings>
  <Actions Context="Author">
    <Exec>
      <Command>C:\Windows\System32\WindowsPowerShell\v1.0\powershell.exe</Command>
      <Arguments>-NonInteractive -NoProfile -ExecutionPolicy Bypass -File "C:\Program Files (x86)\BigFix Enterprise\BES Server\SoftwarePortal\scripts\Invoke-ContentSync.ps1" -DatabasePath "C:\Program Files (x86)\BigFix Enterprise\BES Server\SoftwarePortal\AutomationState.db" -SQLDir "C:\Program Files (x86)\BigFix Enterprise\BES Client\EC\sqlite" -LogDir "C:\Program Files (x86)\BigFix Enterprise\BES Server\SoftwarePortal\logs"</Arguments>
    </Exec>
  </Actions>
</Task>
