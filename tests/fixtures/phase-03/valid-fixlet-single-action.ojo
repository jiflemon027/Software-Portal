<?xml version="1.0" encoding="UTF-8"?>
<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Fixlet>
    <Title>Sample Fixlet — Single Action</Title>
    <Description><![CDATA[Phase 3 test fixture: fixlet with a single DefaultAction only. Used to test the parsedActions.length === 1 case through parseActions() in the dispatcher.]]></Description>
    <Relevance>true</Relevance>
    <Category>Coding Tools</Category>
    <Source>Internal</Source>
    <SourceID></SourceID>
    <SourceReleaseDate>2026-06-14</SourceReleaseDate>
    <SourceSeverity></SourceSeverity>
    <CVENames></CVENames>
    <SANSID></SANSID>
    <Domain>BESC</Domain>
    <MIMEField>
      <Name>Associated_Roles</Name>
      <Value>IT Developer</Value>
    </MIMEField>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">// placeholder action script</ActionScript>
    </DefaultAction>
  </Fixlet>
</BES>
