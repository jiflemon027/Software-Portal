<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<meta http-equiv="X-UA-Compatible" content="IE=9">
<meta http-equiv="Content-type" content="text/html; charset=UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">

<link rel="stylesheet" href="/JavaScript/datatables/css/bootstrap.min.css">
<link rel="stylesheet" href="/JavaScript/datatables/css/dataTables.bootstrap.min.css">
<link rel="stylesheet" href="/JavaScript/datatables/css/buttons.dataTables.css">
<link rel="stylesheet" href="/JavaScript/datatables/css/select.dataTables.css">
<link rel="stylesheet" href="/JavaScript/datatables/css/jquery.dataTables.min.1.10.25.css">
<link rel="stylesheet" href="/JavaScript/datatables/css/searchBuilder.dataTables.min.1.1.0.css">
<link rel="stylesheet" href="/JavaScript/datatables/css/searchPanes.dataTables.min.1.3.0.css">
<link rel="stylesheet" href="/JavaScript/datatables/css/select.dataTables.min.1.3.3.css">
<link rel="stylesheet" href="/JavaScript/datatables/css/dataTables.dateTime.min.1.1.0.css">

<style type="text/css" class="init">
tr.group,
tr.group:hover {
    background-color: #ddd !important;
    cursor: pointer;
}
tr.group td { font-weight: bold; }
.grp-ind { display: inline-block; width: 14px; }
tr.group.no-actions,
tr.group.no-actions:hover { background-color: #fff3cd !important; }
.role-badge {
    display: inline-block;
    background: #2a5d9f;
    color: #fff;
    border-radius: 3px;
    padding: 1px 6px;
    font-size: 11px;
    margin: 1px;
}
.role-badge.action { background: #237241; }
#headtop {
    background-color: #F2F2F2;
    color: black;
    text-align: left;
    font-size: medium;
    padding: 5px;
}
</style>

<script src="/JavaScript/datatables/js/jquery-3.5.1.js"></script>
<script src="/JavaScript/datatables/js/jquery.dataTables.min.1.10.25.js"></script>
<script src="/JavaScript/datatables/js/jszip.js"></script>
<script src="/JavaScript/datatables/js/pdfmake.js"></script>
<script src="/JavaScript/datatables/js/vfs_fonts.js"></script>
<script src="/JavaScript/datatables/js/dataTables.buttons.js"></script>
<script src="/JavaScript/datatables/js/buttons.colVis.js"></script>
<script src="/JavaScript/datatables/js/buttons.html5.js"></script>
<script src="/JavaScript/datatables/js/buttons.print.js"></script>
<script src="/JavaScript/datatables/js/dataTables.select.js"></script>
<script src="/JavaScript/datatables/js/dataTables.bootstrap.min.js"></script>
<script src="/JavaScript/datatables/js/dataTables.searchBuilder.min.1.1.10.js"></script>
<script src="/JavaScript/datatables/js/dataTables.searchPanes.min.1.3.0.js"></script>
<script src="/JavaScript/datatables/js/dataTables.select.min.1.3.3.js"></script>
<script src="/JavaScript/datatables/js/dataTables.dateTime.min.1.1.0.js"></script>
<script src="/JavaScript/datatables/js/moment.min.2.8.4.js"></script>
<script src="/JavaScript/datatables/js/datetime-moment.1.10.19.js"></script>

<script type="text/javascript" class="init">

// PORTAL_CONFIG — keep in sync with fixlet_modifier.ojo and fixlet_role_assigner.ojo
var PORTAL_CONFIG = {
    siteName: 'Dereso Software Portal',
    roles: ['IT Operations', 'Finance', 'HR']
};

// Relevance queries — single-pipe delimited, evaluated async via Relevance() API
var FIXLET_QUERY = '((item 0 of it as string & "|" & item 1 of it as string & "|" & item 2 of it as string & "|" & item 3 of it as string) of (id of it, name of it, name of site of it, (if (exists mime fields whose (name of it = "Associated_Roles") of it) then ((if (exists value whose (not(it = "")) of it) then (concatenation " | " of values of it) else "Nulled Role") of mime fields whose (name of it = "Associated_Roles") of it) else "General Access")) of ((bes fixlets) whose ((exists fixlet flag of it) and (exists site whose (name of it contains "Dereso Software Portal") of it))))';

var ACTION_QUERY = '((item 0 of it as string & "|" & item 1 of it as string & "|" & item 2 of it as string & "|" & (value of key "id" of json of item 3 of it) as string & "|" & (value of key "sitename" of json of item 3 of it) as string & "|" & item 4 of it as string & "|" & item 5 of it as string & "|" & item 6 of it as string & "|" & item 7 of it as string) of (id of it, name of it, (if (exists MIME Field whose (name of it = "Associated_Roles") of it) then (concatenation "" of values of MIME Fields whose (name of it = "Associated_Roles") of it) else "General Access") of it, (if (exists MIME Field whose (name of it = "SmartRole_Source") of it) then (concatenation "" of values of MIME Fields whose (name of it = "SmartRole_Source") of it) else ("{%22id%22:%22%22,%22sitename%22:%22%22}")) of it, state of it, time issued of it, (if (exists end date of it) then (end date of it) as string else ("--")) of it, number of results of it) of (bes actions whose ((exists offer flag of it) and (exists MIME Field whose (name of it = "Associated_Roles") of it) and (exists MIME Field whose (name of it = "SmartRole_Source") of it))))';

var fixletMap       = {};
var noActionFixlets = {}; // fixlet names with no deployed actions — keyed by name, value true
var expandedGroups  = {}; // keyed by fixlet name — true = expanded, absent/false = collapsed

function escHtml(s) {
    return String(s)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
}

function SearchForData() {
    document.getElementById('msg1').innerHTML = 'Loading fixlets...';
    Relevance(FIXLET_QUERY, {
        success: function(results) {
            for (var i = 0; i < results.length; i++) {
                var f = results[i].split('|');
                var key = (f[0] || '') + '|' + (f[2] || '');
                fixletMap[key] = {
                    id:    f[0] || '',
                    name:  f[1] || '',
                    site:  f[2] || '',
                    roles: (f[3] || '').split(' | ').map(function(r) { return r.trim(); }).filter(Boolean)
                };
            }
            document.getElementById('msg1').innerHTML = 'Loading actions...';
            loadActions();
        },
        failure: function(xhr, textStatus, errorThrown) {
            document.getElementById('msg1').innerHTML =
                'Error loading fixlets: ' + textStatus + ' - ' + errorThrown;
        }
    });
}

function loadActions() {
    Relevance(ACTION_QUERY, {
        success: function(results) {
            var DataList      = [];
            var referencedKeys = {};

            for (var i = 0; i < results.length; i++) {
                var a = results[i].split('|');
                var srcId   = decodeURIComponent(a[3] || '');
                var srcSite = decodeURIComponent(a[4] || '');
                var fKey    = srcId + '|' + srcSite;
                referencedKeys[fKey] = true;
                var fixlet  = fixletMap[fKey] || { name: '(unknown fixlet)', site: srcSite, roles: [] };
                DataList.push([
                    fixlet.name,                        // col 0 — grouping key (hidden)
                    fixlet.roles.join(' | '),            // col 1 — fixlet roles (hidden, in group header)
                    a[0] || '',                          // col 2 — action ID (hidden)
                    a[1] || '',                          // col 3 — action name
                    decodeURIComponent(a[2] || ''),      // col 4 — action role
                    fixlet.site,                         // col 5 — site (hidden)
                    srcId,                               // col 6 — source fixlet ID (hidden)
                    a[5] || '',                          // col 7 — state
                    a[6] || '',                          // col 8 — time issued
                    a[7] || '--',                        // col 9 — expiry date
                    a[8] || '0'                          // col 10 — results count
                ]);
            }

            // Placeholder rows for fixlets that have no deployed actions
            for (var fk in fixletMap) {
                if (!referencedKeys[fk]) {
                    var f = fixletMap[fk];
                    noActionFixlets[f.name] = true;
                    DataList.push([
                        f.name,
                        f.roles.join(' | '),
                        '',
                        '(no actions deployed)',
                        '',
                        f.site,
                        f.id,
                        '', '', '', ''
                    ]);
                }
            }

            var z = $('#srch').DataTable();
            z.rows.add(DataList).draw();
            z.columns.adjust().draw();
            var noActionCount = Object.keys(noActionFixlets).length;
            var msg = results.length + ' action(s) loaded';
            if (noActionCount) msg += ', ' + noActionCount + ' fixlet(s) with no deployed actions';
            document.getElementById('msg1').innerHTML = msg + '.';
        },
        failure: function(xhr, textStatus, errorThrown) {
            document.getElementById('msg1').innerHTML =
                'Error loading actions: ' + textStatus + ' - ' + errorThrown;
        }
    });
}

$(document).ready(function() {
    $('#srch').DataTable({
        scrollY:    600,
        scrollX:    true,
        pagingType: 'full_numbers',
        stateSave:  true,
        order:      [[0, 'asc']],
        dom:        'QBlfrtip',
        buttons: [
            { extend: 'colvis', postfixButtons: ['colvisRestore'] },
            'excel', 'copy', 'pdf', 'csv'
        ],
        columnDefs: [
            { targets: [3, 4, 7, 8, 9, 10], visible: true  },
            { targets: [0, 1, 2, 5, 6],     visible: false, searchable: true }
        ],
        lengthMenu:    [[10, 25, 50, -1], [10, 25, 50, 'All']],
        displayLength: 25,
        drawCallback: function(settings) {
            var api      = this.api();
            var rowNodes = api.rows({ page: 'current' }).nodes();
            var rowIdx   = api.rows({ page: 'current' }).indexes();
            var last     = null;

            // Inject group header rows and set initial visibility
            api.column(0, { page: 'current' }).data().each(function(fixletName, i) {
                var $actionRow = $(rowNodes).eq(i);

                if (last !== fixletName) {
                    var roles    = api.cell(rowIdx[i], 1).data() || '';
                    var badges   = roles.split(' | ').filter(Boolean)
                        .map(function(r) {
                            return '<span class="role-badge">' + escHtml(r.trim()) + '</span>';
                        })
                        .join(' ');
                    var expanded = expandedGroups[fixletName] === true;
                    var ind      = expanded ? '&#9660;' : '&#9654;';
                    var cls = 'group' + (noActionFixlets[fixletName] ? ' no-actions' : '');
                    $actionRow.before(
                        '<tr class="' + cls + '" data-group="' + escHtml(fixletName) + '">' +
                        '<td colspan="6"><span class="grp-ind">' + ind + '</span>' +
                        ' <b>' + escHtml(fixletName) + '</b> &nbsp; ' + badges + '</td></tr>'
                    );
                    last = fixletName;
                }

                // Collapsed by default; show only when group is expanded
                $actionRow.toggle(expandedGroups[last] === true);
            });

            // Click handler — event delegation so it survives redraws
            $('#srch tbody').off('click.grp', 'tr.group').on('click.grp', 'tr.group', function() {
                var groupName  = $(this).data('group');
                expandedGroups[groupName] = !expandedGroups[groupName];
                var isExpanded = expandedGroups[groupName];

                // Flip the indicator arrow
                $(this).find('.grp-ind').html(isExpanded ? '&#9660;' : '&#9654;');

                // Toggle every sibling action row until the next group header
                var $next = $(this).next();
                while ($next.length && !$next.hasClass('group')) {
                    $next.toggle(isExpanded);
                    $next = $next.next();
                }
            });
        }
    });

    SearchForData();
});

</script>
</head>
<body>

<div class="fw-body">
    <div class="content">

        <div id="headtop">
            <b>Dereso Role Awareness Report</b> &mdash; Role-aware fixlets and their deployed actions.
            Actions shown are scoped to computers within your operator permissions.
        </div>

        <p id="msg1">Loading...</p>

        <table id="srch" class="table table-striped table-bordered" style="width:100%">
            <thead>
                <tr>
                    <th>Fixlet Name</th>
                    <th>Fixlet Roles</th>
                    <th>Action ID</th>
                    <th>Action Name</th>
                    <th>Action Role</th>
                    <th>Site</th>
                    <th>Source Fixlet ID</th>
                    <th>State</th>
                    <th>Issued</th>
                    <th>Expires</th>
                    <th>Results</th>
                </tr>
            </thead>
            <tfoot>
                <tr>
                    <th>Fixlet Name</th>
                    <th>Fixlet Roles</th>
                    <th>Action ID</th>
                    <th>Action Name</th>
                    <th>Action Role</th>
                    <th>Site</th>
                    <th>Source Fixlet ID</th>
                    <th>State</th>
                    <th>Issued</th>
                    <th>Expires</th>
                    <th>Results</th>
                </tr>
            </tfoot>
            <tbody></tbody>
        </table>

    </div>
</div>

</body>
</html>
