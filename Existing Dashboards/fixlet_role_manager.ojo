<?xml version="1.0" encoding="UTF-8"?>
<BES>
  <Wizard>
    <Title>Dereso Role Manager</Title>
    <UIHooks LaunchType="Document" RequiresAuthoring="false" Menu="Dashboards"></UIHooks>
    <DefaultPage>main</DefaultPage>

    <Page Name="main" DocType="HTML">
      <Title>Dereso Role Manager</Title>
      <Head><![CDATA[
<meta http-equiv="X-UA-Compatible" content="IE=9">
<style type="text/css">
body { font-family: Arial; font-size: 11px; background: #f3f3f3; margin: 0; padding: 0; }
.dashboardVersion { position: fixed; top: 6px; right: 10px; font-size: 10px; color: #999999; z-index: 1000; }
.page { padding: 16px; }
h1 { color: #2a5d9f; font-size: 24px; margin: 0 0 12px 0; font-weight: bold; }
.panel { background: #ffffff; border: 1px solid #d7dbe0; margin-bottom: 14px; }
.panelBody { padding: 12px; }
.rowTable { width: 100%; border-collapse: collapse; }
.rowTable td { padding: 6px 8px; vertical-align: middle; border: none; }
.lbl { font-weight: bold; color: #333333; white-space: nowrap; }
input[type=text], input[type=number], textarea, select { font-family: Arial; font-size: 11px; border: 1px solid #c8c8c8; padding: 4px 6px; }
.txt { width: 260px; }
.txtWide { width: 340px; }
.btn { font-family: Arial; font-size: 11px; padding: 6px 14px; border: 1px solid #b3b3b3; background: #f7f7f7; cursor: pointer; }
.btnGreen { font-family: Arial; font-size: 11px; padding: 8px 18px; border: 1px solid #237241; background: #33a05a; color: #ffffff; font-weight: bold; cursor: pointer; }
.tableGrid { width: 100%; border-collapse: collapse; background: #ffffff; }
.tableGrid td, .tableGrid th { border: 1px solid #d7dbe0; padding: 6px 8px; vertical-align: middle; }
.tableGrid th { background: #f4f6f8; color: #2a5d9f; text-align: left; }
.small { color: #666666; font-size: 10px; }
.warn { color: #996600; }
.warn-row { background: #fffbe6; }
.error-row { background: #fff0f0; }
.dim { color: #aaaaaa; }
.tabBar { margin: 0 0 14px 0; border-bottom: 2px solid #2a5d9f; }
.tabBtn { font-family: Arial; font-size: 12px; padding: 8px 16px; border: 1px solid #d7dbe0; border-bottom: none; background: #eef1f4; cursor: pointer; margin-right: 3px; }
.tabActive { background: #2a5d9f; color: #ffffff; font-weight: bold; }
.roleHeader { cursor: pointer; }
.roleToggle { display: inline-block; width: 16px; color: #2a5d9f; font-size: 11px; }
.roleHeading { display: inline; margin: 0; color: #2a5d9f; font-size: 15px; }
.linkBtn { color: #2a5d9f; text-decoration: underline; cursor: pointer; font-size: 11px; }
</style>
<script language="javascript">
// ==========================================================================
// PORTAL CONFIGURATION -- Edit this block only.
// D-14 "Dereso Role Manager" -- replaces fixlet_role_admin.ojo and
// fixlet_role_assigner.ojo (both retired to Existing Dashboards/archive/).
// Role -> username-list editing/Publish flow; no GroupRoleMap, no CSV
// break-glass. D-17 (2026-10-21) added a REQUIRED per-role identity (default,
// or regional via an optional Region name) -- each its own Computer
// Group/Task/Action -- replacing the original optional "scope to an
// arbitrary existing group" picker.
// ==========================================================================
var PORTAL_CONFIG = {
  siteName: 'Dereso Software Portal',
  // D-03: role list is fixed/small, edited here -- not dynamically added/removed
  // from the dashboard UI.
  roles: ["IT Operations", "Business Operations","Database Administrators"],
  // D-17 (2026-10-21 redesign): the D-10 "optional scope to an arbitrary
  // pre-existing group" picker is retired. Every role now has one or more
  // REQUIRED identities -- the default/no-region one plus any number of
  // regional ones -- each its own Computer Group/Task/Action, gated purely
  // on username (see buildRoleGroupRelevance, groupTitleFor/taskTitleFor/
  // actionTitleFor, regionalSuffix). loadAllComputerGroups() still queries
  // every live BES computer group, but only to detect which of THIS role's
  // own naming-convention identities already exist (isRegionGroupLive/
  // knownRegionsForRole) -- never offered as a raw fleet-wide picker.
  groupTitlePrefix:  'DSP Role - ',           // Computer Group title = prefix + [region +] role
  taskTitlePrefix:   'Assign Role Mapping - ',// per-identity Task title  = prefix + [region +] role
  actionTitlePrefix: 'DSP RoleMap - ',        // policy action title  = prefix + [region +] role
  // Resolved once at console render time -- current console operator's name,
  // stamps __ASSIGNED_BY__ / RolePublishRun.Published_by.
  // getAssignedBy() below guards the empty-result case.
  //
  // "current console operator" is not a real BigFix relevance noun (confirmed
  // 2026-10-21: errors "is not defined", the same class of mistake as the
  // GetRelevance bug -- see [[bigfix-nonexistent-relevance-nouns]]). The real
  // one is "current console user" ("is not defined" vs "Singular expression
  // refers to nonexistent object" in a context with no attached console
  // session -- a materially different error, confirming this one is real).
  assignedBy: '<?relevance name of current console user ?>',
  // Resolved once at console render time -- the BES Root Server's own Computer ID,
  // the D-07 audit-write SingleAction's <Target><ComputerID> (verbatim from
  // fixlet_dispatcher.ojo).
  rootServerComputerId: '<?relevance concatenation "" of ((id of it as string) of bes computers whose(exists value whose (it = "BES Root Server") of result (it, bes property "BES Relay Service Installed"))) ?>',
  // D-16/D-02: the Analysis property names published by
  // Dashboard_4_samples/Dereso SWD.bes (users/mapped_users/map_source/map_region).
  // rolePublish is a DIFFERENT, root-server-only Analysis (moved 2026-10-21):
  // Dashboard_4_samples/"Dereso SWD Role Publication.bes" -- RolePublish.db only
  // ever exists on the BES Root Server (same reasoning as the existing
  // "Dereso SWD Repository Cache" Analysis), so it doesn't belong on the
  // fleet-wide "Dereso SWD" Analysis. Its property is named "Saved Roles",
  // not "... in r.db" -- the "r.db" suffix on every other property here is
  // shorthand for RoleAwareness.db, which this property does NOT read (it
  // reads RolePublish.db), so keeping that suffix would have been actively
  // misleading. Also deliberately not "Published Roles": this reflects the
  // last SAVE, not necessarily a completed Publish -- those are separate
  // steps, and the property has no way to know whether Publish ran after.
  // The property NAME is still globally unique site-wide, so
  // loadSavedRoleState()'s query below needs no change beyond this comment
  // -- "bes property whose (name of it = ...)" finds it regardless of which
  // Analysis defines it.
  props: {
    knownUsers:  "users in r.db",
    mappedUsers: "mapped_users in r.db",
    mapSource:   "map_source in r.db",
    mapRegion:   "map_region in r.db",
    rolePublish: "Saved Roles"
  },
  fieldSep: "\u001f"
};
// ==========================================================================
// END PORTAL CONFIGURATION
// ==========================================================================

// ==========================================================================
// SHARED SETTINGS (v2.12.0) -- dsp_config.json site file, shared with
// fixlet_console.ojo. PORTAL_CONFIG.roles above is only the built-in fallback;
// the live role list comes from the file and is edited on the Settings tab.
// ==========================================================================

// BEGIN SHARED DSP_CONFIG_CLIENT
// dsp_config_client.js -- v1.0.1 (shared by fixlet_console.ojo and fixlet_role_manager.ojo)
// Source of truth for the shared-config block. Copied verbatim into both dashboards
// between the BEGIN/END SHARED DSP_CONFIG_CLIENT markers by
//   node scripts/sync_shared_config_client.js
// Never edit the copies inside the .ojo files.
//
// The config lives in ONE site file, dsp_config.json, in DSP_CONFIG_SITE. It is read live
// over REST (GET site/custom/<site>/file/<id>) so edits apply on "Reload config" without
// waiting for the console to gather a new site version. The dashboards never write it:
// writing site-file content over REST did not work on this server (2026-11-17), so the
// admin uploads it by hand (console: Manage Site Files) -- see config/dsp_config.json.
// Role Manager > Settings > Generate JSON produces the full file text to upload.
//
// ES5 only (dashboards run in the console's IE9-mode engine). JSON.parse/stringify exist there.

var DSP_CONFIG_SITE = "Dereso Software Portal";
var DSP_CONFIG_FILE = "dsp_config.json";

// What was loaded, for the UI and for the optimistic-concurrency check on save.
var DSP_CONFIG_STATE = { source: "defaults", fileId: null, rawText: null, raw: null, error: "", warnings: [] };

// -- pure helpers (unit-tested) ------------------------------------------------

function dspTrim(s){ return String(s == null ? "" : s).replace(/^\s+|\s+$/g, ""); }

// Characters that would break titles, relevance strings or the Analysis row parsing
// ("UserID, Role" is split on the first ", ") if they appeared in a role name.
var DSP_ROLE_FORBIDDEN = /[",|\u001f\\]/;

// dspCleanList(value, label, forbidden, warnings) -> array or null (null = invalid, use default)
function dspCleanList(value, label, forbidden, warnings){
  if(Object.prototype.toString.call(value) !== "[object Array]"){
    warnings.push(label + " is not a list -- using built-in default.");
    return null;
  }
  var out = [], seen = {}, i, v;
  for(i = 0; i < value.length; i++){
    if(typeof value[i] !== "string"){ warnings.push(label + ": ignored a non-text entry."); continue; }
    v = dspTrim(value[i]);
    if(v === ""){ continue; }
    if(forbidden && forbidden.test(v)){ warnings.push(label + ": ignored \"" + v + "\" (contains a forbidden character: \" , | \\)."); continue; }
    if(seen[v.toLowerCase()]){ continue; }
    seen[v.toLowerCase()] = true;
    out.push(v);
  }
  if(out.length === 0){ warnings.push(label + " is empty -- using built-in default."); return null; }
  return out;
}

// dspNormalizeConfig(obj, defaults) -> { config, warnings }
// config always has every key of defaults; any missing/invalid field falls back to the
// default with a warning. Unknown keys in obj are ignored here (but kept for saving --
// see dspMergeForSave).
function dspNormalizeConfig(obj, defaults){
  var warnings = [];
  var d = defaults || {};
  var o = (obj && typeof obj === "object") ? obj : {};
  var cfg = {};
  var list;

  list = (o.roles === undefined) ? null : dspCleanList(o.roles, "roles", DSP_ROLE_FORBIDDEN, warnings);
  cfg.roles = list || (d.roles || []).slice();

  list = (o.categories === undefined) ? null : dspCleanList(o.categories, "categories", null, warnings);
  cfg.categories = list || (d.categories || []).slice();

  cfg.categoryMap = {};
  var srcMap = o.categoryMap, k;
  if(srcMap !== undefined && (typeof srcMap !== "object" || srcMap === null || Object.prototype.toString.call(srcMap) === "[object Array]")){
    warnings.push("categoryMap is not an object -- using built-in default.");
    srcMap = undefined;
  }
  if(srcMap === undefined){ srcMap = d.categoryMap || {}; }
  for(k in srcMap){
    if(!srcMap.hasOwnProperty(k)){ continue; }
    if(typeof srcMap[k] !== "string" || dspTrim(k) === "" || dspTrim(srcMap[k]) === ""){ continue; }
    cfg.categoryMap[dspTrim(k)] = dspTrim(srcMap[k]);
  }

  var dc = d.console || {};
  var oc = (o.console && typeof o.console === "object") ? o.console : {};
  cfg.console = {};
  cfg.console.defaultSiteName = (typeof oc.defaultSiteName === "string" && dspTrim(oc.defaultSiteName) !== "") ? dspTrim(oc.defaultSiteName) : (dc.defaultSiteName || "");
  list = (oc.sourceSites === undefined) ? null : dspCleanList(oc.sourceSites, "console.sourceSites", null, warnings);
  cfg.console.sourceSites = list || (dc.sourceSites || []).slice();
  var days = oc.defaultExpirationDays;
  if(days !== undefined && !(typeof days === "number" && days >= 1 && days <= 365 && Math.floor(days) === days)){
    warnings.push("console.defaultExpirationDays must be a whole number 1-365 -- using built-in default.");
    days = undefined;
  }
  cfg.console.defaultExpirationDays = (days !== undefined) ? days : dc.defaultExpirationDays;

  return { config: cfg, warnings: warnings };
}

// dspParseConfigText(text) -> { obj, error }
function dspParseConfigText(text){
  var t = String(text == null ? "" : text);
  if(t.charCodeAt(0) === 0xFEFF){ t = t.substring(1); } // strip a UTF-8 BOM
  if(dspTrim(t) === ""){ return { obj: null, error: "file is empty" }; }
  var obj;
  try { obj = JSON.parse(t); } catch(ex){ return { obj: null, error: "not valid JSON (" + (ex && ex.message ? ex.message : ex) + ")" }; }
  if(!obj || typeof obj !== "object" || Object.prototype.toString.call(obj) === "[object Array]"){
    return { obj: null, error: "top level must be a JSON object" };
  }
  return { obj: obj, error: "" };
}

// dspFindFileIdInListing(xml, name) -> "47815" | null   (GET site/custom/<site>/files response)
function dspFindFileIdInListing(xml, name){
  var re = /<SiteFile\b[\s\S]*?<\/SiteFile>/g, m, nm, id;
  var want = String(name).toLowerCase();
  while((m = re.exec(String(xml || ""))) !== null){
    nm = /<Name>([^<]*)<\/Name>/.exec(m[0]);
    id = /<ID>(\d+)<\/ID>/.exec(m[0]);
    if(nm && id && dspTrim(nm[1]).toLowerCase() === want){ return id[1]; }
  }
  return null;
}

// dspMergeForSave(rawObj, edited) -> object to write. Keeps every key the file already had
// (so one dashboard never drops another's settings), overwriting only what was edited.
function dspMergeForSave(rawObj, edited){
  var out = {}, k;
  var base = (rawObj && typeof rawObj === "object") ? rawObj : {};
  for(k in base){ if(base.hasOwnProperty(k)){ out[k] = base[k]; } }
  for(k in edited){ if(edited.hasOwnProperty(k)){ out[k] = edited[k]; } }
  return out;
}

function dspSerializeConfig(obj){ return JSON.stringify(obj, null, 2) + "\n"; }

// -- REST (not unit-tested; needs the console's API object) ---------------------

function dspSitePath(){ return "site/custom/" + encodeURIComponent(DSP_CONFIG_SITE); }

// dspFetchConfigText(cb) -- cb(err, text, fileId)
function dspFetchConfigText(cb){
  API.Get(dspSitePath() + "/files", function(e, s, b){
    if(s !== 200){ cb("could not list site files (status " + s + (e ? ", " + e : "") + ")"); return; }
    var id = dspFindFileIdInListing(b, DSP_CONFIG_FILE);
    if(!id){ cb(DSP_CONFIG_FILE + " not found in site \"" + DSP_CONFIG_SITE + "\""); return; }
    API.Get(dspSitePath() + "/file/" + id, function(e2, s2, b2){
      if(s2 !== 200){ cb("could not read " + DSP_CONFIG_FILE + " (status " + s2 + (e2 ? ", " + e2 : "") + ")", null, id); return; }
      cb(null, (b2 === undefined || b2 === null) ? "" : String(b2), id);
    });
  });
}

// dspLoadConfig(defaults, cb) -- cb(config, DSP_CONFIG_STATE). Never fails: on any error the
// built-in defaults are returned and DSP_CONFIG_STATE.error says why.
function dspLoadConfig(defaults, cb){
  dspFetchConfigText(function(err, text, fileId){
    DSP_CONFIG_STATE = { source: "defaults", fileId: fileId || null, rawText: null, raw: null, error: "", warnings: [] };
    if(err){
      DSP_CONFIG_STATE.error = err;
      cb(dspNormalizeConfig({}, defaults).config, DSP_CONFIG_STATE);
      return;
    }
    var parsed = dspParseConfigText(text);
    if(parsed.error){
      DSP_CONFIG_STATE.error = DSP_CONFIG_FILE + ": " + parsed.error;
      DSP_CONFIG_STATE.rawText = text;
      cb(dspNormalizeConfig({}, defaults).config, DSP_CONFIG_STATE);
      return;
    }
    var n = dspNormalizeConfig(parsed.obj, defaults);
    DSP_CONFIG_STATE.source = "file";
    DSP_CONFIG_STATE.rawText = text;
    DSP_CONFIG_STATE.raw = parsed.obj;
    DSP_CONFIG_STATE.warnings = n.warnings;
    cb(n.config, DSP_CONFIG_STATE);
  });
}

// dspConfigStatusText(state) -> one-line description for the UI.
function dspConfigStatusText(state){
  var st = state || DSP_CONFIG_STATE;
  if(st.source === "file"){
    return "Shared settings loaded from " + DSP_CONFIG_FILE + " (site file " + st.fileId + ")" +
      (st.warnings && st.warnings.length ? " with " + st.warnings.length + " warning(s): " + st.warnings.join(" ") : ".");
  }
  return "Using built-in defaults -- " + (st.error || "shared settings not loaded") + ".";
}
// END SHARED DSP_CONFIG_CLIENT

var RM_CONFIG_DEFAULTS = {
  roles: PORTAL_CONFIG.roles.slice(),
  categories: [],
  categoryMap: {},
  console: { defaultSiteName: PORTAL_CONFIG.siteName, sourceSites: [], defaultExpirationDays: 7 }
};
// The full normalized shared config last loaded (the Settings tab edits a copy).
var RM_SHARED_CONFIG = null;

// newRoleState() -- the per-role state shape initDashboard has always created.
function newRoleState(){
  return { users: [], selectedRegion: "", regions: { "": { users: [], dirty: false, groupId: null } } };
}

function roleHasUnsavedEdits(role){
  var st = roleState[role];
  if(!st || !st.regions){ return false; }
  for(var r in st.regions){
    if(st.regions.hasOwnProperty(r) && st.regions[r] && st.regions[r].dirty){ return true; }
  }
  return false;
}

// applyRoleList(newRoles) -> array of warning strings. Adds state for new roles,
// keeps state (and any unsaved edits) for roles that remain, and keeps a removed
// role on screen for this session if it still has unsaved edits, so nothing typed
// is silently lost. Re-renders the Roles tab and re-imports saved members.
function applyRoleList(newRoles){
  var warnings = [];
  var list = newRoles.slice();
  var i, role, inNew = {};
  for(i = 0; i < list.length; i++){ inNew[list[i]] = true; }
  for(i = 0; i < PORTAL_CONFIG.roles.length; i++){
    role = PORTAL_CONFIG.roles[i];
    if(!inNew[role] && roleHasUnsavedEdits(role)){
      list.push(role);
      warnings.push("Role \"" + role + "\" was removed from the shared settings but has unsaved edits -- kept on screen until you reload the dashboard.");
    }
  }
  for(i = 0; i < list.length; i++){
    role = list[i];
    if(!roleState[role]){ roleState[role] = newRoleState(); }
    roleBySlug[roleSlug(role)] = role;
  }
  PORTAL_CONFIG.roles = list;
  return warnings;
}

function renderConfigStatus(extraWarnings){
  var el = document.getElementById("configStatus");
  if(!el){ return; }
  var text = dspConfigStatusText(DSP_CONFIG_STATE);
  if(extraWarnings && extraWarnings.length){ text += " " + extraWarnings.join(" "); }
  el.className = (DSP_CONFIG_STATE.source === "file" && !DSP_CONFIG_STATE.warnings.length && !(extraWarnings && extraWarnings.length)) ? "small" : "small warn";
  el.innerHTML = htmlEscape(text);
}

// reloadSharedConfig(onDone) -- re-reads dsp_config.json and applies the role list in
// place (no dashboard reload). Used by the header "Reload config" button and after Save.
function reloadSharedConfig(onDone){
  dspLoadConfig(RM_CONFIG_DEFAULTS, function(cfg){
    RM_SHARED_CONFIG = cfg;
    var w = applyRoleList(cfg.roles);
    renderRolesTab();
    loadSavedRoleState();
    renderConfigStatus(w);
    renderSettingsForm();
    if(onDone){ onDone(); }
  });
}

function onReloadConfigClick(){
  setStatus("Reloading shared settings...");
  reloadSharedConfig(function(){ setStatus("Shared settings reloaded."); });
}

// ---- Settings tab ----------------------------------------------------------

function linesToList(text){
  var parts = String(text || "").split(/\r?\n/), out = [], i;
  for(i = 0; i < parts.length; i++){ if(dspTrim(parts[i]) !== ""){ out.push(dspTrim(parts[i])); } }
  return out;
}

function categoryMapToText(map){
  var keys = [], k, i, out = [];
  for(k in map){ if(map.hasOwnProperty(k)){ keys.push(k); } }
  keys.sort(function(a, b){ var x = a.toLowerCase(), y = b.toLowerCase(); return x < y ? -1 : x > y ? 1 : 0; });
  for(i = 0; i < keys.length; i++){ out.push(keys[i] + " = " + map[keys[i]]); }
  return out.join("\r\n");
}

// parseSettingsForm(f, previous) -> { edited, errors, warnings }  -- pure, unit-tested.
// f = { roles, categories, categoryMap, defaultSiteName, sourceSites, defaultExpirationDays } (raw text)
// previous = the currently loaded normalized config (to report removed roles).
function parseSettingsForm(f, previous){
  var errors = [], warnings = [], i, line, eq, key, val;
  var roles = linesToList(f.roles);
  var categories = linesToList(f.categories);
  var seenRole = {};
  for(i = 0; i < roles.length; i++){
    if(DSP_ROLE_FORBIDDEN.test(roles[i])){ errors.push("Role \"" + roles[i] + "\" contains a forbidden character (\" , | \\)."); }
    if(seenRole[roles[i].toLowerCase()]){ errors.push("Role \"" + roles[i] + "\" is listed twice."); }
    seenRole[roles[i].toLowerCase()] = true;
  }
  if(roles.length === 0){ errors.push("At least one role is required."); }
  if(categories.length === 0){ errors.push("At least one category is required."); }

  var catSet = {};
  for(i = 0; i < categories.length; i++){ catSet[categories[i]] = true; }
  var map = {}, mapLines = String(f.categoryMap || "").split(/\r?\n/);
  for(i = 0; i < mapLines.length; i++){
    line = dspTrim(mapLines[i]);
    if(line === ""){ continue; }
    eq = line.lastIndexOf("=");
    if(eq <= 0){ errors.push("Category suggestion line " + (i + 1) + " needs the form  Product name = Category"); continue; }
    key = dspTrim(line.substring(0, eq));
    val = dspTrim(line.substring(eq + 1));
    if(key === "" || val === ""){ errors.push("Category suggestion line " + (i + 1) + " has an empty product name or category."); continue; }
    if(!catSet[val]){ warnings.push("\"" + key + "\" suggests \"" + val + "\", which is not in the category list."); }
    map[key] = val;
  }

  var days = dspTrim(f.defaultExpirationDays);
  var daysNum = parseInt(days, 10);
  if(!/^\d+$/.test(days) || daysNum < 1 || daysNum > 365){ errors.push("Default expiry days must be a whole number from 1 to 365."); }

  var site = dspTrim(f.defaultSiteName);
  if(site === ""){ errors.push("Default site is required."); }

  if(previous && previous.roles){
    for(i = 0; i < previous.roles.length; i++){
      if(!seenRole[previous.roles[i].toLowerCase()]){
        warnings.push("Removing role \"" + previous.roles[i] + "\" hides it here and in the console. Its existing Computer Groups, Tasks and policy actions are NOT deleted -- stop/delete them in the console if they should go.");
      }
    }
  }

  return {
    errors: errors,
    warnings: warnings,
    edited: {
      roles: roles,
      categories: categories,
      categoryMap: map,
      console: {
        defaultSiteName: site,
        sourceSites: linesToList(f.sourceSites),
        defaultExpirationDays: daysNum
      }
    }
  };
}

function setSettingsField(id, value){
  var el = document.getElementById(id);
  if(el){ el.value = value; }
}
function getSettingsField(id){
  var el = document.getElementById(id);
  return el ? el.value : "";
}

function renderSettingsForm(){
  var cfg = RM_SHARED_CONFIG || dspNormalizeConfig({}, RM_CONFIG_DEFAULTS).config;
  setSettingsField("setRoles", cfg.roles.join("\r\n"));
  setSettingsField("setCategories", cfg.categories.join("\r\n"));
  setSettingsField("setCategoryMap", categoryMapToText(cfg.categoryMap));
  setSettingsField("setDefaultSite", cfg.console.defaultSiteName);
  setSettingsField("setSourceSites", cfg.console.sourceSites.join("\r\n"));
  setSettingsField("setExpiryDays", String(cfg.console.defaultExpirationDays));
  var note = document.getElementById("settingsSourceNote");
  if(note){
    note.className = DSP_CONFIG_STATE.source === "file" ? "small" : "small warn";
    note.innerHTML = htmlEscape(DSP_CONFIG_STATE.source === "file"
      ? "Showing " + DSP_CONFIG_FILE + " (site file " + DSP_CONFIG_STATE.fileId + ") from site \"" + DSP_CONFIG_SITE + "\"."
      : "Showing built-in defaults: " + (DSP_CONFIG_STATE.error || "the shared settings file was not loaded") +
        ". Generate the JSON below and add it to site \"" + DSP_CONFIG_SITE + "\" as " + DSP_CONFIG_FILE + " (Manage Site Files, not sent to clients), then Reload config.");
  }
  var out = document.getElementById("settingsJsonOut");
  if(out){ out.value = ""; }
  var outWrap = document.getElementById("settingsJsonWrap");
  if(outWrap){ outWrap.style.display = "none"; }
  showSettingsMessages([], []);
}

function showSettingsMessages(errors, warnings){
  var errEl = document.getElementById("settingsErr");
  var warnEl = document.getElementById("settingsWarn");
  if(errEl){ errEl.style.display = errors.length ? "" : "none"; errEl.innerHTML = errors.length ? htmlEscape(errors.join("\n")).replace(/\n/g, "<br>") : ""; }
  if(warnEl){ warnEl.style.display = warnings.length ? "" : "none"; warnEl.innerHTML = warnings.length ? htmlEscape(warnings.join("\n")).replace(/\n/g, "<br>") : ""; }
}

function readSettingsForm(){
  return parseSettingsForm({
    roles: getSettingsField("setRoles"),
    categories: getSettingsField("setCategories"),
    categoryMap: getSettingsField("setCategoryMap"),
    defaultSiteName: getSettingsField("setDefaultSite"),
    sourceSites: getSettingsField("setSourceSites"),
    defaultExpirationDays: getSettingsField("setExpiryDays")
  }, RM_SHARED_CONFIG);
}

function onSettingsCheckClick(){
  var r = readSettingsForm();
  showSettingsMessages(r.errors, r.warnings);
  setStatus(r.errors.length ? "Settings have errors." : "Settings look valid.");
}

// onSettingsGenerateClick() -- v2.12.1: writing the site file from the dashboard
// does not work on this server (REST PUT of site-file content failed live,
// 2026-11-17), so the dashboard produces the complete file text instead, for the
// admin to save as dsp_config.json and upload via Manage Site Files. Keys the
// loaded file had but this form doesn't edit (configVersion, _comment, ...) are kept.
function onSettingsGenerateClick(){
  var r = readSettingsForm();
  showSettingsMessages(r.errors, r.warnings);
  if(r.errors.length){ setStatus("Not generated -- fix the errors shown."); return; }
  var base = DSP_CONFIG_STATE.raw || { configVersion: "1.0.0" };
  var text = dspSerializeConfig(dspMergeForSave(base, r.edited));
  var out = document.getElementById("settingsJsonOut");
  var wrap = document.getElementById("settingsJsonWrap");
  if(wrap){ wrap.style.display = ""; }
  if(out){
    out.value = text;
    try { out.focus(); out.select(); } catch(ex){}
  }
  setStatus("JSON generated -- copy it into dsp_config.json, upload to the site, then Reload config.");
}

function onSettingsDiscardClick(){
  renderSettingsForm();
  setStatus("Edits discarded.");
}

// btoa polyfill for IE9 -- verbatim from fixlet_role_assigner.ojo (L59-72)
if (typeof btoa === 'undefined') {
  btoa = function(s) {
    var CHARS = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/';
    var str = String(s), out = '', i = 0;
    while (i < str.length) {
      var b0 = str.charCodeAt(i++), b1 = str.charCodeAt(i++), b2 = str.charCodeAt(i++);
      out += CHARS.charAt(b0 >> 2)
           + CHARS.charAt(((b0 & 3) << 4) | (b1 >> 4))
           + (isNaN(b1) ? '=' : CHARS.charAt(((b1 & 15) << 2) | (b2 >> 6)))
           + (isNaN(b2) ? '=' : CHARS.charAt(b2 & 63));
    }
    return out;
  };
}

// -- HTML escaping to prevent XSS from untrusted data -- verbatim from fixlet_role_assigner.ojo (L83-89)
function htmlEscape(s){
  return String(s)
    .replace(/&/g,"&amp;")
    .replace(/</g,"&lt;")
    .replace(/>/g,"&gt;")
    .replace(/"/g,"&quot;");
}

// -- Status -- verbatim from fixlet_role_assigner.ojo (L92-95)
function setStatus(msg){
  var el = document.getElementById("status");
  if(el){ el.innerText = msg; }
}

// -- Surface a fatal init/runtime error in the shared banner -- no popup dialogs --
function showGlobalError(msg){
  var el = document.getElementById("globalError");
  if(el){ el.style.display = ""; el.innerHTML = htmlEscape(msg); }
  setStatus(msg);
}

// -- XML helpers -- verbatim from fixlet_dispatcher.ojo (L470-481) / fixlet_role_assigner.ojo (L98-109)
function xmlEscape(s){
  return String(s)
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;")
    .replace(/'/g, "&apos;");
}
function cdataStart(){ return '<!' + '[CDATA['; }
function cdataEnd(){   return ']]' + '>'; }
function xmlCDataSafe(s){ return String(s).replace(/\]\]>/g, ']]]]><![CDATA[>'); }

// -- IE9 XML parse (MSXML) -- verbatim from fixlet_role_admin.ojo (L114-136)
function parseXml(text){
  var xml = new ActiveXObject("Msxml2.DOMDocument.6.0");
  xml.async = false;
  xml.setProperty("SelectionLanguage", "XPath");
  xml.loadXML(String(text));
  return xml;
}
function parseActionId(body){
  if(!body){ return ""; }
  try {
    var xml = parseXml(body);
    var nodes = xml.getElementsByTagName("Action");
    if(nodes.length > 0){
      var idNode = nodes[0].selectSingleNode("ID");
      if(idNode && idNode.text){ return idNode.text; }
    }
  } catch(ex) {}
  var m = /\/api\/action\/(\d+)/i.exec(String(body));
  if(m && m[1]){ return m[1]; }
  m = /<ID>(\d+)<\/ID>/i.exec(String(body));
  return (m && m[1]) ? m[1] : "";
}

// -- ActionScript brace escaping (bigfix-relevance skill S2 / fixlet_dispatcher.ojo L622-632) --
// Only the OPENING brace is doubled. "{{" is BigFix ActionScript's escape for a
// literal "{" -- it never opens a real {relevance} substitution, so a later plain
// "}" has nothing to close and passes through as a literal character on its own.
// Doubling "}" too produces a stray extra "}" at the end of every block -- a
// previously-shipped, confirmed bug in this codebase's staging-action history.
// Never "fix" this to double both braces.
function escapeActionScriptBraces(s){
  return String(s).replace(/\{/g, "{{");
}

// -- getRelevanceSafe(rel) -- EvaluateRelevance wrapper that returns [] on any failure.
// Was GetRelevance (verbatim from fixlet_role_assigner.ojo, L863-872) -- GetRelevance is not
// a real BigFix dashboard API function (confirmed against developer.bigfix.com's Dashboard
// API reference, which documents only EvaluateRelevance/Relevance); calling it threw
// "GetRelevance is not defined" every time, silently swallowed by this very try/catch, so
// every caller (loadKnownUsers, loadAnalysisView) always got back [] regardless of whether
// real data existed server-side. See [[bigfix-getrelevance-is-not-a-real-api]].
function getRelevanceSafe(rel){
  try {
    var d = EvaluateRelevance(rel);
    return d ? d : [];
  } catch(ex){
    return [];
  }
}

// -- Guards PORTAL_CONFIG.assignedBy: an empty console-operator-name resolution --
// -- must never produce an empty RolePublishRun.Published_by / __ASSIGNED_BY__. --
function getAssignedBy(){
  var v = PORTAL_CONFIG.assignedBy;
  if(!v || String(v).replace(/^\s+|\s+$/g, "") === ""){ return "console-operator"; }
  return v;
}

// ==========================================================================
// TAB SWITCHING (fixlet_role_admin.ojo L166-178 pattern)
// ==========================================================================
function switchTab(tab){
  var ids = ["Roles","Analysis","Settings"];
  var i, panel, btn;
  for(i=0;i<ids.length;i++){
    panel = document.getElementById("tab"+ids[i]);
    btn   = document.getElementById("tabBtn"+ids[i]);
    if(panel){ panel.style.display = (ids[i]===tab) ? "" : "none"; }
    if(btn){ btn.className = (ids[i]===tab) ? "tabBtn tabActive" : "tabBtn"; }
  }
  // D-16 (07-09): refresh the read-only Analysis view every time it becomes
  // the visible tab, so an admin never looks at a stale snapshot.
  if(tab === "Analysis"){ loadAnalysisView(); }
}

// -- Init -- populates roleState from PORTAL_CONFIG.roles (D-03: config is
// the only source of the role list, never mutated at runtime), loads the
// D-02 known-users cache, then renders the Roles tab.
// v2.12.0: the shared settings (role list) are loaded first, then the original
// init runs with them. dspLoadConfig always calls back (built-in defaults on error).
function initDashboard(){
  switchTab("Roles");
  setStatus("Loading shared settings...");
  var started = false;
  var go = function(cfg){
    if(started){ return; }
    started = true;
    if(cfg){ RM_SHARED_CONFIG = cfg; PORTAL_CONFIG.roles = cfg.roles.slice(); }
    initDashboardCore();
    renderConfigStatus();
    renderSettingsForm();
  };
  try { dspLoadConfig(RM_CONFIG_DEFAULTS, go); }
  catch(ex){ DSP_CONFIG_STATE.error = "shared settings unavailable (" + (ex && ex.message ? ex.message : ex) + ")"; go(null); }
}

function initDashboardCore(){
  var i, role;
  for(i = 0; i < PORTAL_CONFIG.roles.length; i++){
    role = PORTAL_CONFIG.roles[i];
    // D-17: users here is a DERIVED union across every region bucket below
    // (recomputeRoleUnionUsers keeps it in sync) -- reconcileIntentVsActual/
    // isUserConfiguredInRole read it and need no changes. The default/
    // no-region identity ("") always exists so a role is immediately usable
    // without any region typed in.
    roleState[role] = {
      users: [],
      selectedRegion: "",
      regions: { "": { users: [], dirty: false, groupId: null } }
    };
    roleBySlug[roleSlug(role)] = role;
  }
  loadKnownUsers();
  renderRolesTab();
  loadClientPrefetchPort();
  updateInitRoleDbUI();
  loadSavedRoleState();
  loadAllComputerGroups();
  updateStageEndpointScriptUI();
  // D-16 (07-09): populate the Analysis tab's data once at load, even though
  // it isn't the visible tab yet, so it's never empty on first switch.
  loadAnalysisView();
  setStatus("Ready.");
}

// ==========================================================================
// PURE BUILDERS -- unit-tested in tests/unit/role_manager.test.js
// None of these touch the DOM or call API.*. findBesObjectIdByTitle calls
// EvaluateRelevance (a console-provided read-only query function, not local
// mutable state) so it can't run under Node -- everything else here is a
// deterministic string-in/string-out function of its own arguments plus
// PORTAL_CONFIG.
// ==========================================================================

// buildRoleGroupRelevance(usernames) -- D-09/D-17.
// T-07-04-01 (Elevation of Privilege, highest-impact bug this generator could
// ship): a role (+ region) with ZERO usernames must never produce an
// unconstrained match. This guard is the single most important line in this
// file. An empty or all-blank username list always yields the literal string
// "false", never "true", never an empty `set of ()`.
//
// D-17 redesign (2026-10-21): this no longer takes a separate scope-group
// AND-clause. The old "optional scope to an arbitrary pre-existing group"
// concept is retired -- every role+region group IS its own scope now (see
// groupTitleFor/regionalSuffix), so membership is gated purely on username,
// full stop. A regional identity is expressed through the GROUP'S OWN NAME,
// never through a nested "member of group X" filter.
function buildRoleGroupRelevance(usernames){
  if(!usernames || usernames.length === 0){ return "false"; }
  var seen   = {};
  var quoted = [];
  var i, u;
  for(i = 0; i < usernames.length; i++){
    u = String(usernames[i]).toLowerCase().replace(/^\s+|\s+$/g, "");
    if(u === ""){ continue; }
    if(seen[u]){ continue; }
    seen[u] = true;
    // T-07-04-02 (Tampering): double any embedded double-quote before
    // interpolating into the relevance string literal -- matches
    // fixlet_dispatcher.ojo's buildTargetRelevance() escaping discipline.
    quoted.push('"' + u.replace(/"/g, '""') + '"');
  }
  if(quoted.length === 0){ return "false"; }
  return '(number of (logged on users whose (name of it as lowercase is contained by ' +
    'set of (' + quoted.join(';') + ')))) = 1';
}

// sanitizeRegion(input) -- D-17. A region is a short administrative label
// ("Europe", "APAC") that ends up inside a BES object Title AND inside a
// literal ActionScript parameter value ("...") -- so it's restricted to
// letters/digits/spaces only (no quotes, no braces, no punctuation that could
// break either context). Trims and collapses internal whitespace. Returns ""
// for the default/no-region identity.
function sanitizeRegion(input){
  var s = String(input || "").replace(/[^A-Za-z0-9 ]/g, "");
  s = s.replace(/\s+/g, " ").replace(/^\s+|\s+$/g, "");
  return s;
}

// prefixStem(prefix) -- strips the trailing " - "/"-" every PORTAL_CONFIG
// *TitlePrefix already carries, so regionalSuffix below can re-insert the
// region BEFORE that dash ("DSP Role" + " " + "Europe - IT Operations")
// instead of after it (which would double up the dash).
function prefixStem(prefix){
  return String(prefix || "").replace(/[\s-]+$/, "");
}

// regionalSuffix(region, role) -- D-17. Shared suffix pattern for every BES
// object this generator manages (Computer Group / Task / Action), appended to
// that object kind's own prefixStem. A blank region reproduces EXACTLY the
// pre-D-17 naming ("<prefix>IT Operations", since "<prefix>" already ends in
// "- ") so every already-published default/no-region object keeps matching
// by title and is never orphaned by this redesign -- only a non-blank region
// changes the shape ("<stem> Europe - IT Operations").
function regionalSuffix(region, role){
  var r = sanitizeRegion(region);
  return (r ? (r + " ") : "") + "- " + role;
}

function groupTitleFor(role, region){ return prefixStem(PORTAL_CONFIG.groupTitlePrefix) + " " + regionalSuffix(region, role); }
function taskTitleFor(role, region){ return prefixStem(PORTAL_CONFIG.taskTitlePrefix) + " " + regionalSuffix(region, role); }
function actionTitleFor(role, region){ return prefixStem(PORTAL_CONFIG.actionTitlePrefix) + " " + regionalSuffix(region, role); }

// buildComputerGroupXml(title, domain, relevance) -- Pattern 1.
// Six-element belt-and-suspenders body confirmed accepted live by plan 07-01
// (07-SPIKE-FINDINGS.md Check A, six-element POST -> success=True status=200):
// Title / Domain / JoinByIntersection / IsDynamic / EvaluateOnClient /
// SearchComponentRelevance. No deviation needed -- the spike did not force a
// reduced form.
function buildComputerGroupXml(title, domain, relevance){
  var xml  = '<?xml version="1.0" encoding="UTF-8"?>\r\n';
  xml += '<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"';
  xml += ' xsi:noNamespaceSchemaLocation="BES.xsd">\r\n';
  xml += '  <ComputerGroup>\r\n';
  xml += '    <Title>' + xmlEscape(title) + '</Title>\r\n';
  xml += '    <Domain>' + xmlEscape(domain || "BESC") + '</Domain>\r\n';
  xml += '    <JoinByIntersection>true</JoinByIntersection>\r\n';
  xml += '    <IsDynamic>true</IsDynamic>\r\n';
  xml += '    <EvaluateOnClient>true</EvaluateOnClient>\r\n';
  xml += '    <SearchComponentRelevance Comparison="IsTrue">\r\n';
  xml += '      <Relevance>' + cdataStart() + xmlCDataSafe(relevance) + cdataEnd() + '</Relevance>\r\n';
  xml += '    </SearchComponentRelevance>\r\n';
  xml += '  </ComputerGroup>\r\n';
  xml += '</BES>';
  return xml;
}

// buildRolePolicyTaskXml(templateFields, role, assignedBy) -- Pattern 3 step 1.
// templateFields is a plain object carrying fields extracted (via
// getElementsByTagName, by the caller) from bes/Assign-RoleMapping.bes:
//   { title, description, relevances (array), category, source, sourceId,
//     sourceReleaseDate, sourceSeverity, cveNames, sansId,
//     mimeFields (array of {name,value}), domain,
//     actionDescription {preLink,link,postLink}, actionScript }
// T-07-04-04 (Tampering, in-place-mutation pitfall): this always emits a
// brand-new <BES><Task> document in SKILL.md S7 schema order -- it never
// mutates a fetched DOM and re-serialises it.
function buildRolePolicyTaskXml(templateFields, role, assignedBy, region){
  var tf  = templateFields || {};
  var sub = function(s){
    return String(s || "")
      .replace(/__ROLE__/g, role)
      .replace(/__ASSIGNED_BY__/g, assignedBy)
      .replace(/__REGION__/g, sanitizeRegion(region));
  };
  // The Task <Title> is always taskTitleFor(role, region) (not the raw
  // template title) so findBesObjectIdByTitle can locate this exact Task by
  // title on every subsequent Publish -- one per (role, region) pair (D-17).
  var title             = taskTitleFor(role, region);
  var description        = sub(tf.description);
  var relevances          = tf.relevances || [];
  var category            = tf.category || "";
  var source               = tf.source || "Internal";
  var sourceId             = tf.sourceId || "";
  var sourceReleaseDate    = tf.sourceReleaseDate || "";
  var sourceSeverity       = tf.sourceSeverity || "";
  var cveNames             = tf.cveNames || "";
  var sansId               = tf.sansId || "";
  var mimeFields           = tf.mimeFields || [];
  var domain               = tf.domain || "BESC";
  var actionDescription    = tf.actionDescription || {};
  var preLink              = actionDescription.preLink || "Click ";
  var link                 = actionDescription.link || "here";
  var postLink             = sub(actionDescription.postLink || "");
  // __USERNAME__ is deliberately NOT substituted here -- the ActionScript
  // resolves it at runtime from client relevance ({name of current user as
  // lowercase}). Substituting a real username would defeat the whole
  // "exactly one of N" design (the Computer Group already guarantees
  // uniqueness; baking a username in here would make every deployed copy of
  // this Task target a single fixed person instead of "whoever is logged on
  // and in the role").
  var actionScript = sub(tf.actionScript);

  var xml  = '<?xml version="1.0" encoding="UTF-8"?>\r\n';
  xml += '<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">\r\n';
  xml += '  <Task>\r\n';
  xml += '    <Title>' + xmlEscape(title) + '</Title>\r\n';
  xml += '    <Description>' + cdataStart() + xmlCDataSafe(description) + cdataEnd() + '</Description>\r\n';
  var ri;
  for(ri = 0; ri < relevances.length; ri++){
    // Defensive: the current bes/Assign-RoleMapping.bes template carries no
    // tokens in either <Relevance> body, so this is a no-op today -- but
    // substituting here too (same __ROLE__/__ASSIGNED_BY__ global replace as
    // every other field) means a future template edit that adds a token to a
    // Relevance can't silently leak an unsubstituted placeholder.
    xml += '    <Relevance>' + cdataStart() + xmlCDataSafe(sub(relevances[ri])) + cdataEnd() + '</Relevance>\r\n';
  }
  xml += '    <Category>' + xmlEscape(category) + '</Category>\r\n';
  xml += '    <Source>' + xmlEscape(source) + '</Source>\r\n';
  xml += '    <SourceID>' + xmlEscape(sourceId) + '</SourceID>\r\n';
  xml += '    <SourceReleaseDate>' + xmlEscape(sourceReleaseDate) + '</SourceReleaseDate>\r\n';
  xml += '    <SourceSeverity>' + xmlEscape(sourceSeverity) + '</SourceSeverity>\r\n';
  xml += '    <CVENames>' + xmlEscape(cveNames) + '</CVENames>\r\n';
  xml += '    <SANSID>' + xmlEscape(sansId) + '</SANSID>\r\n';
  var mi;
  for(mi = 0; mi < mimeFields.length; mi++){
    xml += '    <MIMEField>\r\n';
    xml += '      <Name>' + xmlEscape(mimeFields[mi].name) + '</Name>\r\n';
    xml += '      <Value>' + xmlEscape(mimeFields[mi].value) + '</Value>\r\n';
    xml += '    </MIMEField>\r\n';
  }
  xml += '    <Domain>' + xmlEscape(domain) + '</Domain>\r\n';
  xml += '    <DefaultAction ID="Action1">\r\n';
  xml += '      <Description>\r\n';
  xml += '        <PreLink>' + xmlEscape(preLink) + '</PreLink>\r\n';
  xml += '        <Link>' + xmlEscape(link) + '</Link>\r\n';
  xml += '        <PostLink>' + xmlEscape(postLink) + '</PostLink>\r\n';
  xml += '      </Description>\r\n';
  xml += '      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">';
  xml += cdataStart() + xmlCDataSafe(actionScript) + cdataEnd();
  xml += '</ActionScript>\r\n';
  xml += '    </DefaultAction>\r\n';
  xml += '  </Task>\r\n';
  xml += '</BES>';
  return xml;
}

// buildRolePolicyActionXml(title, relevance, actionScript, groupId, siteName)
// -- Pattern 3 steps 2-3, D-11. SingleAction only (T-07-04-05) -- never the
// server-evaluated sourced-fixlet action type, whose <CustomRelevance> is
// evaluated server-side where `member of group` cannot resolve (skill S3,
// RESEARCH Pitfall 2). Element
// order is fixed: Title -> Relevance -> ActionScript -> Settings -> Target ->
// MIMEFieldSingleAction -- Target before Settings is a confirmed 400.
function buildRolePolicyActionXml(title, relevance, actionScript, groupId, siteName, role, region){
  var safeSite  = String(siteName || "").toLowerCase().replace(/"/g, '""');
  var targetRel = 'member of group ' + groupId + ' of site whose (name of it as lowercase = "' + safeSite + '" as lowercase)';

  // MIMEFieldSingleAction role/region values -- D-17: passed in explicitly by
  // the caller rather than re-derived from title (a regional title like
  // "DSP RoleMap Europe - IT Operations" can't be split back into role vs.
  // region unambiguously once either one can itself contain a space).
  var roleValue   = String(role || "");
  var regionValue = sanitizeRegion(region);

  var xml  = '<?xml version="1.0" encoding="UTF-8"?>\r\n';
  xml += '<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"';
  xml += ' xsi:noNamespaceSchemaLocation="BES.xsd">\r\n';
  xml += '  <SingleAction>\r\n';
  xml += '    <Title>' + xmlEscape(title) + '</Title>\r\n';
  xml += '    <Relevance>' + xmlEscape(relevance) + '</Relevance>\r\n';
  xml += '    <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">';
  xml += cdataStart() + xmlCDataSafe(actionScript) + cdataEnd();
  xml += '</ActionScript>\r\n';
  xml += '    <Settings>\r\n';
  xml += '      <ActionUITitle>' + xmlEscape(title) + '</ActionUITitle>\r\n';
  xml += '      <PreActionShowUI>false</PreActionShowUI>\r\n';
  xml += '      <Reapply>true</Reapply>\r\n';
  xml += '      <HasReapplyLimit>false</HasReapplyLimit>\r\n';
  xml += '      <HasReapplyInterval>true</HasReapplyInterval>\r\n';
  xml += '      <ReapplyInterval>P1D</ReapplyInterval>\r\n';
  xml += '      <IsOffer>false</IsOffer>\r\n';
  xml += '    </Settings>\r\n';
  xml += '    <Target>\r\n';
  xml += '      <CustomRelevance>' + cdataStart() + xmlCDataSafe(targetRel) + cdataEnd() + '</CustomRelevance>\r\n';
  xml += '    </Target>\r\n';
  xml += '    <MIMEFieldSingleAction>\r\n';
  xml += '      <Name>DSP_RoleManager_Role</Name>\r\n';
  xml += '      <Value>' + xmlEscape(roleValue) + '</Value>\r\n';
  xml += '    </MIMEFieldSingleAction>\r\n';
  xml += '    <MIMEFieldSingleAction>\r\n';
  xml += '      <Name>DSP_RoleManager_Region</Name>\r\n';
  xml += '      <Value>' + xmlEscape(regionValue) + '</Value>\r\n';
  xml += '    </MIMEFieldSingleAction>\r\n';
  xml += '  </SingleAction>\r\n';
  xml += '</BES>';
  return xml;
}

// findBesObjectIdByTitle(kind, siteName, title) -- session-relevance
// find-by-title, used by the Publish flow (07-06/07-07) to decide POST
// (create) vs. PUT (update) for each of the four BES object kinds this
// generator manages. kind is "computergroup" | "fixlet" | "task" | "action".
// For "action", additionally filters to state of it = "Open" so a previously
// stopped action (create-new-then-stop-previous, this plan's Publish-time
// decision) is never mistaken for the current one.
//
// "task" was added 2026-10-21 (confirmed live): ensureRoleTask's generated
// document is rooted <Task>, a genuine BES Task, but was being looked up
// via "bes fixlets" and POSTed/PUT against the fixlet/fixlets REST
// endpoints. The session-relevance "bes fixlets" collection happens to
// also match Task objects (confirmed: a known Task's id matched both "bes
// fixlets whose (id of it = ...)" and "bes tasks whose (id of it = ...)"),
// so the LOOKUP never looked broken -- but the fixlets/custom/{site} POST
// endpoint rejects a <Task>-rooted body with a bare 400 (confirmed live:
// the identical XML posted via the task/tasks endpoints instead succeeds).
function findBesObjectIdByTitle(kind, siteName, title){
  var collection;
  if(kind === "computergroup"){ collection = "bes computer groups"; }
  else if(kind === "fixlet"){ collection = "bes fixlets"; }
  else if(kind === "task"){ collection = "bes tasks"; }
  else if(kind === "action"){ collection = "bes actions"; }
  else { return null; }

  var safeSite  = String(siteName || "").replace(/"/g, '""');
  var safeTitle = String(title || "").replace(/"/g, '""');
  var rel = '(id of it as string) of ' + collection + ' whose (name of site of it = "' +
    safeSite + '" and name of it = "' + safeTitle + '"';
  if(kind === "action"){
    rel += ' and state of it = "Open"';
  }
  rel += ')';

  try {
    var data = EvaluateRelevance(rel);
    if(data && data.length > 0 && data[0] !== ""){ return String(data[0]); }
  } catch(ex) {}
  return null;
}

// mergeAnalysisRows(mappedData, sourceData, regionData) -- pure row-merge for
// the Analysis tab (D-16, plan 07-09). Lifted near-verbatim from
// fixlet_role_assigner.ojo's own mergeAnalysisRows (this dashboard's Analysis
// tab supersedes that file's, which is retired to archive/ per D-14/D-15).
// Each argument is an array of "computerName|||value" strings as returned by
// GetRelevance. For mappedData the value is "UserID, Role" (split on the
// FIRST ", " -- role names may contain spaces but not ", "). For
// sourceData/regionData the value is "UserID, Role, Extra" where Extra is
// Source_Value or Region and may be "". Rows are keyed by
// computerName + "|||" + user + "|||" + role. mappedData is the spine: the
// two other properties can never add or drop a row; a key absent from a new
// property renders as an em dash. Returns
//   [{ computerName, user, role, source, region }]
function mergeAnalysisRows(mappedData, sourceData, regionData){
  var EM_DASH = "—";
  function parseEntry(raw){
    var s = String(raw);
    var sep = s.indexOf("|||");
    if(sep < 0){ return null; }
    return { computer: s.substring(0, sep), value: s.substring(sep + 3) };
  }
  function splitUserRole(value){
    var v = String(value);
    var idx = v.indexOf(", ");
    if(idx < 0){ return { user: v, role: "" }; }
    return { user: v.substring(0, idx), role: v.substring(idx + 2) };
  }
  function splitTriple(value){
    var v = String(value);
    var i1 = v.indexOf(", ");
    if(i1 < 0){ return { user: v, role: "", extra: "" }; }
    var rest = v.substring(i1 + 2);
    var i2 = rest.indexOf(", ");
    if(i2 < 0){ return { user: v.substring(0, i1), role: rest, extra: "" }; }
    return { user: v.substring(0, i1), role: rest.substring(0, i2), extra: rest.substring(i2 + 2) };
  }
  var extraByKey = {};
  function indexExtra(arr, which){
    if(!arr){ return; }
    for(var i = 0; i < arr.length; i++){
      var e = parseEntry(arr[i]);
      if(!e){ continue; }
      var t = splitTriple(e.value);
      var key = e.computer + "|||" + t.user + "|||" + t.role;
      if(!extraByKey[key]){ extraByKey[key] = {}; }
      extraByKey[key][which] = t.extra;
    }
  }
  indexExtra(sourceData, "source");
  indexExtra(regionData, "region");
  var out = [];
  if(!mappedData){ return out; }
  for(var i = 0; i < mappedData.length; i++){
    var m = parseEntry(mappedData[i]);
    if(!m){ continue; }
    var ur = splitUserRole(m.value);
    var key = m.computer + "|||" + ur.user + "|||" + ur.role;
    var ex = extraByKey[key] || {};
    out.push({
      computerName: m.computer,
      user: ur.user,
      role: ur.role,
      source: (ex.source !== undefined && ex.source !== "") ? ex.source : EM_DASH,
      region: (ex.region !== undefined && ex.region !== "") ? ex.region : EM_DASH
    });
  }
  return out;
}

// reconcileIntentVsActual(roleState, analysisRows) -- pure (no DOM, no
// GetRelevance). D-16's whole reason to exist: catch the failure mode this
// model is most exposed to, a username typed into a role that never matches
// a real logged-on user. Compares each role's CONFIGURED username list
// (roleState[role].users) against what actually landed on the fleet
// (analysisRows, from mergeAnalysisRows), case- and whitespace-insensitively
// (the generator lower-cases usernames; an admin may not). Never mutates
// either argument -- both are read-only here. Returns:
//   configuredNotMapped: [{ role, user }]      -- every configured username
//     that appears in NO analysis row for that role (the typo/never-logged-on
//     case).
//   mappedNotConfigured: [{ role, user, computer }] -- every analysis row
//     whose user+role pair is not in that role's configured list. D-17: these
//     age out naturally, so treat as informational, never as errors.
function reconcileIntentVsActual(roleState, analysisRows){
  var rs   = roleState || {};
  var rows = analysisRows || [];

  function norm(s){ return String(s || "").toLowerCase().replace(/^\s+|\s+$/g, ""); }

  var roleNames = [];
  var rn;
  for(rn in rs){ if(rs.hasOwnProperty(rn)){ roleNames.push(rn); } }

  // Index every analysis row's normalised user under its role.
  var mappedByRole = {};
  var i, r, roleKey;
  for(i = 0; i < rows.length; i++){
    r = rows[i];
    roleKey = String(r.role || "");
    if(!mappedByRole[roleKey]){ mappedByRole[roleKey] = {}; }
    mappedByRole[roleKey][norm(r.user)] = true;
  }

  // Index every role's normalised configured usernames.
  var configuredSetByRole = {};
  var j, role, cfgUsers, nu;
  for(i = 0; i < roleNames.length; i++){
    role = roleNames[i];
    cfgUsers = (rs[role] && rs[role].users) ? rs[role].users : [];
    var set = {};
    for(j = 0; j < cfgUsers.length; j++){
      nu = norm(cfgUsers[j]);
      if(nu !== ""){ set[nu] = true; }
    }
    configuredSetByRole[role] = set;
  }

  var configuredNotMapped = [];
  for(i = 0; i < roleNames.length; i++){
    role = roleNames[i];
    cfgUsers = (rs[role] && rs[role].users) ? rs[role].users : [];
    var mappedSet = mappedByRole[role] || {};
    var seenCfg = {};
    for(j = 0; j < cfgUsers.length; j++){
      nu = norm(cfgUsers[j]);
      if(nu === "" || seenCfg[nu]){ continue; }
      seenCfg[nu] = true;
      if(!mappedSet[nu]){
        configuredNotMapped.push({ role: role, user: cfgUsers[j] });
      }
    }
  }

  var mappedNotConfigured = [];
  var cfgSet;
  for(i = 0; i < rows.length; i++){
    r = rows[i];
    roleKey = String(r.role || "");
    cfgSet = configuredSetByRole[roleKey];
    if(!(cfgSet && cfgSet[norm(r.user)])){
      mappedNotConfigured.push({ role: r.role, user: r.user, computer: r.computerName });
    }
  }

  return { configuredNotMapped: configuredNotMapped, mappedNotConfigured: mappedNotConfigured };
}


// ==========================================================================
// PUBLISH PREREQUISITES (07-07). Task 1: endpoint-script staging into the
// root server's Custom Repository (the prefetch every per-role policy action
// depends on). Task 2: the per-role Task find-or-create (ensureRoleTask).
// Neither writes to RolePublish.db -- Save (07-06) already owns that write.
// Plan 07-08's publishRole() calls ensureRoleTask() directly; the Publish
// button itself (onPublishRoleClick) remains a 07-08 stub, unchanged here.
// ==========================================================================

// Mirror of scripts/Assign-RoleMapping.ps1 (repo root) -- the endpoint script
// every per-role policy action's prefetch block downloads. Kept as a literal
// copy here so the staging action can createfile it directly on the root
// server's own Custom Repository. If you edit scripts/Assign-RoleMapping.ps1,
// regenerate this array from it (do not hand-edit) -- scripts/Assign-RoleMapping.ps1
// itself remains the source of truth for the SCRIPT CONTENT.
//
// Joiner convention: scripts/Assign-RoleMapping.ps1 is LF-only (verified --
// unlike scripts/Upsert-RolePublish.ps1, which is CRLF and uses '\r\n' for
// ROLE_PUBLISH_SCRIPT above). ASSIGN_ROLE_MAPPING_SCRIPT_LINES therefore joins
// with a bare '\n' so the reconstructed string is byte-identical to
// scripts/Assign-RoleMapping.ps1 on disk (sha1 28e9daf7cc6b8a6f01298a75b16c6a869eb23c85,
// 9453 bytes) -- but do NOT assume that is the prefetch pin.
//
// IMPORTANT, found by live testing 2026-09-25, re-confirmed 2026-10-21 (D-17 Region
// rollout): BigFix's `createfile` action does NOT write this content byte-identically to
// the staged Custom Repository file, and -- newly confirmed this same day -- is not even
// STABLE across repeated writes of the identical source: the first staging run produced
// 30aa07b6f35e5b5f24d2f7958971391df69809d0 / 9672 bytes (an apparent clean LF->CRLF
// expansion), but a second query against the SAME staged path (no edit to the source in
// between) came back 9674 bytes / eeeae841d9cc88d411c0b935af890f2b4f3a9aad instead -- so
// this is not even a deterministic function of the source content on this environment.
// The upshot: the .bes/.ojo prefetch sha1/size/sha256 pin must be the OBSERVED hash of the
// STAGED file at the moment you're about to rely on it (currently
// eeeae841d9cc88d411c0b935af890f2b4f3a9aad / 9674 /
// 85d5c0700f7e10c127994e39ce8183c773d027a3fcf30c8eeb43bd3374ab782d), never a locally-computed
// hash of scripts/Assign-RoleMapping.ps1 itself, and never assumed stable from a PRIOR
// live check either -- re-verify right before every Task resync, not just once per script
// edit. Whenever the script changes (or before trusting an old pin): re-run "Stage Endpoint
// Script", pull the actually-written file's checksums back from the server, and re-pin
// THOSE values here and in bes/Assign-RoleMapping.bes. Do not "normalise" this joiner to
// '\r\n' -- untested whether that would change the staged-file transformation, so don't
// change it without re-verifying live.
var ASSIGN_ROLE_MAPPING_SCRIPT_LINES = [
  "#Requires -Version 5.1",
  "# Version: 1.1.0",
  "<#",
  ".SYNOPSIS",
  "    Endpoint role-mapping writer for the Operator-Role-Group model. Given a role, a",
  "    username and the issuing operator, ensures the user exists in RoleAwareness.db and",
  "    upserts a UserID -> Role row into the Map table, using the same D-12 discipline as",
  "    Reconcile-LocalRoles.ps1 (INSERT OR IGNORE + a conditional UPDATE guarded by",
  "    Locked_by_Override = 0).",
  "",
  ".DESCRIPTION",
  "    This is the endpoint half of a deliberately simpler assignment model than the Axonius",
  "    snapshot pipeline:",
  "",
  "      * One automatic Computer Group per role. Its membership relevance carries the list",
  "        of operator usernames that hold the role and admits a device only when EXACTLY",
  "        ONE logged-on user is in that list.",
  "      * One policy action per group runs this script. The ActionScript resolves the",
  "        single matching user and passes it as -UserName, so this script does no",
  "        logged-on-user parsing of its own - it trusts its inputs.",
  "      * BigFix Operator -> Role assignments are the source of truth. There is no CSV, no",
  "        snapshot, no GroupRoleMap.",
  "",
  "    Revoke: none. When an operator loses the role they drop out of the Computer Group,",
  "    the policy action stops applying, and the Map row lapses at Valid_to (age-out) - the",
  "    same no-revoke model as Reconcile-LocalRoles.ps1 v1.",
  "",
  "    Constrained Language Mode safe: no Add-Type, no System.Data.SQLite, no dynamic .NET",
  "    type loading. Every database call goes through Sqlite-Helper.ps1 (bundled sqlite3.exe).",
  "    Assumes Sqlite-Helper.ps1 and sqlite3.exe are already staged on the endpoint by the",
  "    \"Init  Current User and UserRole DB\" task (787); the task's <Relevance> gates on that.",
  "",
  ".PARAMETER Role",
  "    The role name to assign, e.g. \"IT Operations\". Inserted into Roles if new to this",
  "    endpoint (D-15 parity with Reconcile-LocalRoles.ps1). Trimmed, case preserved.",
  "",
  ".PARAMETER UserName",
  "    The user to map. Any DOMAIN\\ prefix or UPN \"@domain\" suffix is stripped; the result",
  "    is lower-cased to match how Initialize-RoleDb.ps1 stores UserID.",
  "",
  ".PARAMETER AssignedBy",
  "    Value written to Map.Assigned_By - the identity of the operator who issued the task",
  "    (the ActionScript substitutes it). Default 'OperatorRoleGroup' for a manual run.",
  "",
  ".PARAMETER Region",
  "    Value written to Map.Region (D-17, regional role groups). Baked into the per-(role,region)",
  "    policy Task's ActionScript at Publish time by fixlet_role_manager.ojo -- NOT derived from",
  "    any client-side setting, unlike the retired Axonius-era GPC_Sub_Name passthrough. Empty",
  "    string for the default/no-region group (the common case; Map.Region stays blank, same as",
  "    before this parameter existed).",
  "",
  ".PARAMETER ValidityMonths",
  "    How far forward the mapped row's Valid_to is pushed. Default 6 (mirrors",
  "    Initialize-RoleDb.ps1 -ValidityMonths / PORTAL_CONFIG.validityMonths).",
  "",
  ".PARAMETER DatabasePath",
  "    Full path to RoleAwareness.db.",
  "",
  ".PARAMETER SQLDir",
  "    Directory containing sqlite3.exe directly (no arch subfolder).",
  "",
  ".PARAMETER SqliteHelperPath",
  "    Path to the shared Sqlite-Helper.ps1. Default: Sqlite-Helper.ps1 in the same folder",
  "    as -DatabasePath (the layout task 787 lays down).",
  "",
  ".NOTES",
  "    PowerShell 5.1, Constrained Language Mode safe. Aborts via throw (non-zero exit).",
  "#>",
  "[CmdletBinding(SupportsShouldProcess = $true)]",
  "param(",
  "    [Parameter(Mandatory = $true)]",
  "    [string]$Role,",
  "",
  "    [Parameter(Mandatory = $true)]",
  "    [string]$UserName,",
  "",
  "    [Parameter()]",
  "    [string]$AssignedBy = 'OperatorRoleGroup',",
  "",
  "    [Parameter()]",
  "    [string]$Region = '',",
  "",
  "    [Parameter()]",
  "    [int]$ValidityMonths = 6,",
  "",
  "    [Parameter()]",
  "    [string]$DatabasePath = 'C:\\Program Files (x86)\\BigFix Enterprise\\BES Client\\EC\\SoftwarePortal\\RoleAwareness.db',",
  "",
  "    [Parameter()]",
  "    [string]$SQLDir = 'C:\\Program Files (x86)\\BigFix Enterprise\\BES Client\\EC\\sqlite',",
  "",
  "    [Parameter()]",
  "    [string]$SqliteHelperPath",
  ")",
  "",
  "Set-StrictMode -Version Latest",
  "$ErrorActionPreference = 'Stop'",
  "",
  "if ([string]::IsNullOrWhiteSpace($SqliteHelperPath)) {",
  "    $SqliteHelperPath = Join-Path (Split-Path $DatabasePath) 'Sqlite-Helper.ps1'",
  "}",
  "",
  "$logfile = Join-Path (Split-Path $DatabasePath) 'SWDlog.log'",
  "",
  "function Write-Tag {",
  "    param([string]$Tag, [string]$Message)",
  "    $line = \"[$Tag] $Message\"",
  "    Write-Host $line",
  "    try { Add-Content -Path $logfile -Value (\"{0} assign-role {1}\" -f (Get-Date -Format 's'), $line) -WhatIf:$false } catch { }",
  "}",
  "",
  "function Get-DbRows {",
  "    # Flatten Sqlite-Helper's (return ,$rows) wrapper so multi-row .Count is correct.",
  "    param([string]$Sql, [hashtable]$P = @{})",
  "    $r = Invoke-SqliteCommand -DatabasePath $DatabasePath -SQLDir $SQLDir -Sql $Sql -Parameters $P",
  "    return @($r | ForEach-Object { $_ })",
  "}",
  "",
  "function Invoke-DbWrite {",
  "    param([string]$Sql, [hashtable]$P = @{})",
  "    if ($WhatIfPreference) { return }",
  "    Invoke-SqliteCommand -DatabasePath $DatabasePath -SQLDir $SQLDir -Sql $Sql -Parameters $P | Out-Null",
  "}",
  "",
  "# --- normalise inputs -------------------------------------------------------",
  "$Role = $Role.Trim()",
  "$user = $UserName.Trim().TrimStart('@').Split('\\')[-1]",
  "$user = $user.Split('@')[0].ToLowerInvariant()",
  "",
  "$result = [ordered]@{",
  "    whatif               = [bool]$WhatIfPreference",
  "    role                 = $Role",
  "    user                 = $user",
  "    assigned_by          = $AssignedBy",
  "    region               = $Region",
  "    validity_months      = $ValidityMonths",
  "    roles_created        = 0",
  "    rows_updated         = 0",
  "    rows_blocked_by_lock = 0",
  "    outcome              = $null",
  "}",
  "",
  "function Write-RunLog {",
  "    $dir = Split-Path $DatabasePath",
  "    $path = Join-Path $dir (\"assign-role-{0}.json\" -f ((Get-Date).ToUniversalTime().ToString('yyyyMMdd-HHmmss')))",
  "    try {",
  "        Set-Content -Path $path -Value ([pscustomobject]$result | ConvertTo-Json -Depth 5 -Compress) -Encoding UTF8 -WhatIf:$false",
  "    } catch { }",
  "    Write-Host \"----RUN SUMMARY----\"",
  "    Write-Host ([pscustomobject]$result | ConvertTo-Json -Depth 5 -Compress)",
  "}",
  "",
  "try {",
  "    if ([string]::IsNullOrWhiteSpace($Role)) { throw \"[ABORT] -Role is empty\" }",
  "    if ([string]::IsNullOrWhiteSpace($user)) { throw \"[ABORT] -UserName is empty after normalisation\" }",
  "",
  "    if (-not (Test-Path $SqliteHelperPath)) { throw \"[ABORT] Sqlite-Helper.ps1 not found at: $SqliteHelperPath (endpoint not initialised by task 787?)\" }",
  "    . $SqliteHelperPath",
  "",
  "    if (-not (Test-Path $DatabasePath)) { throw \"[ABORT] RoleAwareness.db not found at: $DatabasePath\" }",
  "",
  "    $validModifier = \"+$ValidityMonths months\"",
  "",
  "    if ($WhatIfPreference) {",
  "        Write-Tag 'WOULD' (\"ensure user '{0}', upsert Map: role='{1}' Assigned_By='{2}' Valid_to=now{3}\" -f $user, $Role, $AssignedBy, $validModifier)",
  "        $result.outcome = 'whatif'",
  "        Write-RunLog",
  "        return",
  "    }",
  "",
  "    # 1. Users: INSERT OR IGNORE + UPDATE LastSeen (never delete-and-reinsert)",
  "    Invoke-DbWrite \"INSERT OR IGNORE INTO Users (UserID, LastSeen) VALUES (@u, datetime('now','localtime'))\" @{ u = $user }",
  "    Invoke-DbWrite \"UPDATE Users SET LastSeen = datetime('now','localtime') WHERE UserID = @u\" @{ u = $user }",
  "",
  "    # 2. Roles: role new to this endpoint propagates without an init redeploy (D-15)",
  "    $before = @(Get-DbRows \"SELECT COUNT(*) AS n FROM Roles WHERE Role = @r\" @{ r = $Role })",
  "    Invoke-DbWrite \"INSERT OR IGNORE INTO Roles (Role) VALUES (@r)\" @{ r = $Role }",
  "    $after = @(Get-DbRows \"SELECT COUNT(*) AS n FROM Roles WHERE Role = @r\" @{ r = $Role })",
  "    if ([int]$before[0].n -eq 0 -and [int]$after[0].n -eq 1) { $result.roles_created++ }",
  "",
  "    # 3. Map: create the row if absent, without disturbing any existing state",
  "    Invoke-DbWrite \"INSERT OR IGNORE INTO Map (UserID, Role, Active, Created_on) VALUES (@u, @r, 1, datetime('now','localtime'))\" `",
  "        @{ u = $user; r = $Role }",
  "",
  "    # 4. guarded UPDATE + connection-scoped changes() in ONE call (see Initialize-RoleDb.ps1 error 5350 note)",
  "    $upd = @(Get-DbRows @\"",
  "UPDATE Map SET Active = 1, Updated_on = datetime('now','localtime'),",
  "    Valid_to = datetime('now','localtime', @v),",
  "    Source_Type = 'BigFix Role', Source_Value = @sv, Assigned_By = @ab, Region = @rg",
  "WHERE UserID = @u AND Role = @r AND Locked_by_Override = 0;",
  "SELECT changes() AS n",
  "\"@ @{ v = $validModifier; sv = $Role; ab = $AssignedBy; rg = $Region; u = $user; r = $Role })",
  "    $changed = if ($upd.Count -gt 0) { [int]$upd[0].n } else { 0 }",
  "",
  "    if ($changed -gt 0) {",
  "        $result.rows_updated += $changed",
  "        $result.outcome = 'mapped'",
  "        Write-Tag 'UPSERT' (\"user='{0}' role='{1}' region='{2}' -> Assigned_By={3}, Valid_to +{4}mo\" -f $user, $Role, $Region, $AssignedBy, $ValidityMonths)",
  "    } else {",
  "        $lockRow = @(Get-DbRows \"SELECT COUNT(*) AS n FROM Map WHERE UserID = @u AND Role = @r AND Locked_by_Override = 1\" @{ u = $user; r = $Role })",
  "        if ([int]$lockRow[0].n -gt 0) {",
  "            $result.rows_blocked_by_lock++",
  "            $result.outcome = 'blocked-by-lock'",
  "            Write-Tag 'LOCKED' (\"user='{0}' role='{1}' has Locked_by_Override=1 - left untouched\" -f $user, $Role)",
  "        } else {",
  "            $result.outcome = 'no-change'",
  "            Write-Tag 'OK' (\"user='{0}' role='{1}' already current - no change\" -f $user, $Role)",
  "        }",
  "    }",
  "",
  "    Write-RunLog",
  "}",
  "finally {",
  "    try {",
  "        if (Get-Command Invoke-SqliteCommand -ErrorAction SilentlyContinue) {",
  "            Invoke-SqliteCommand -DatabasePath $DatabasePath -SQLDir $SQLDir -Sql \"PRAGMA wal_checkpoint(TRUNCATE)\" | Out-Null",
  "        }",
  "    } catch { }",
  "}",
  ""
];
var ASSIGN_ROLE_MAPPING_SCRIPT = ASSIGN_ROLE_MAPPING_SCRIPT_LINES.join('\n');

// buildEndpointScriptStagingActionXml() -- Task 1. Emits a ComputerID-targeted
// SingleAction that createfile's the byte-identical ASSIGN_ROLE_MAPPING_SCRIPT
// mirror into the root server's own Custom Repository, at the exact path
// bes/Assign-RoleMapping.bes's prefetch block pins:
// Uploads\CustomRepository\SoftwarePortal\rolegroups\Assign-RoleMapping.ps1.
// RepoDir is derived entirely from the wwwRootFolder registry value (SKILL.md
// S4) plus a hard-coded suffix -- no operator input reaches the path
// (T-07-07-03). Only escapeActionScriptBraces touches braces, and only the
// createfile body -- the {parameter "RepoDir"} / {value "wwwRootFolder" ...}
// substitutions live outside it and are never escaped (T-07-07-02).
function buildEndpointScriptStagingActionXml(){
  if(!PORTAL_CONFIG.rootServerComputerId){ return ""; }
  var stamp = (new Date()).toISOString();
  var title = "DSP RoleMap StageScript " + stamp;

  var lines = [];
  lines.push('\tparameter "RepoDir"="{(value "wwwRootFolder" of key "HKEY_LOCAL_MACHINE\\SOFTWARE\\Wow6432Node\\BigFix\\Enterprise Server" of registry) as string & "Uploads\\CustomRepository\\SoftwarePortal\\rolegroups"}"');
  lines.push('');
  lines.push('\tif {not exists folder (parameter "RepoDir")}');
  lines.push('\t\trunhidden cmd /c mkdir "{parameter "RepoDir"}"');
  lines.push('\tendif');
  lines.push('');
  lines.push('delete __createfile');
  lines.push('delete "{parameter "RepoDir"}\\Assign-RoleMapping.ps1"');
  lines.push('');
  lines.push('createfile until _EOF_');
  lines.push(escapeActionScriptBraces(ASSIGN_ROLE_MAPPING_SCRIPT));
  lines.push('_EOF_');
  lines.push('');
  lines.push('move __createfile "{parameter "RepoDir"}\\Assign-RoleMapping.ps1"');

  var script = lines.join('\r\n');

  var xml  = '<?xml version="1.0" encoding="UTF-8"?>\r\n';
  xml += '<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"';
  xml += ' xsi:noNamespaceSchemaLocation="BES.xsd">\r\n';
  xml += '  <SingleAction>\r\n';
  xml += '    <Title>' + xmlEscape(title) + '</Title>\r\n';
  xml += '    <Relevance>true</Relevance>\r\n';
  xml += '    <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">';
  xml += cdataStart() + xmlCDataSafe(script) + cdataEnd();
  xml += '</ActionScript>\r\n';
  xml += '    <Settings>\r\n';
  xml += '      <ActionUITitle>' + xmlEscape(title) + '</ActionUITitle>\r\n';
  xml += '      <PreActionShowUI>false</PreActionShowUI>\r\n';
  xml += '      <HasEndTime>true</HasEndTime>\r\n';
  xml += '      <EndDateTimeLocalOffset>P1D</EndDateTimeLocalOffset>\r\n';
  xml += '      <IsOffer>false</IsOffer>\r\n';
  xml += '    </Settings>\r\n';
  xml += '    <Target>\r\n';
  xml += '      <ComputerID>' + xmlEscape(PORTAL_CONFIG.rootServerComputerId) + '</ComputerID>\r\n';
  xml += '    </Target>\r\n';
  xml += '  </SingleAction>\r\n';
  xml += '</BES>';
  return xml;
}

// stageEndpointScript(onDone) -- Task 1. POSTs the staging action;
// onDone(err, actionId). No popup dialogs -- callers surface the
// result/error in the Prerequisites panel's dedicated resultEl/errEl.
function stageEndpointScript(onDone){
  var xml = buildEndpointScriptStagingActionXml();
  if(xml === ""){
    if(onDone){ onDone("root server Computer ID not resolved -- staging disabled"); }
    return;
  }
  API.Post("actions", xml, function(e, s, b){
    if(s === 200 || s === 201){
      var bodyText = (typeof b !== "undefined" && b !== null) ? String(b) : "";
      if(onDone){ onDone(null, parseActionId(bodyText)); }
    } else {
      if(onDone){ onDone("status=" + s + " " + (e || "")); }
    }
  });
}

function onStageEndpointScriptClick(){
  var resultEl = document.getElementById("stageScriptResult");
  var errEl    = document.getElementById("stageScriptErr");
  var btn      = document.getElementById("stageScriptBtn");
  if(resultEl){ resultEl.style.display = "none"; resultEl.innerHTML = ""; }
  if(errEl){ errEl.style.display = "none"; errEl.innerHTML = ""; }
  if(btn){ btn.disabled = true; }
  setStatus("Staging endpoint script on root server...");
  stageEndpointScript(function(err, actionId){
    if(btn){ btn.disabled = false; }
    if(err){
      setStatus("Stage failed.");
      if(errEl){
        errEl.style.display = "";
        errEl.innerHTML = htmlEscape("Stage failed: " + err);
      }
      return;
    }
    setStatus("Staged.");
    if(resultEl){
      resultEl.style.display = "";
      resultEl.innerHTML = htmlEscape("Endpoint script staged (action " + (actionId || "(unknown)") + "). SHA1 must match eeeae841d9cc88d411c0b935af890f2b4f3a9aad.");
    }
  });
}

// updateStageEndpointScriptUI() -- mirrors fixlet_dispatcher.ojo's
// updateStagingCheckboxUI(): disables the Prerequisites Stage button with an
// inline note when rootServerComputerId is unresolved.
function updateStageEndpointScriptUI(){
  var btn  = document.getElementById("stageScriptBtn");
  var note = document.getElementById("stageScriptNote");
  if(!btn){ return; }
  if(!PORTAL_CONFIG.rootServerComputerId){
    btn.disabled = true;
    if(note){ note.innerHTML = htmlEscape("rootServerComputerId not configured in PORTAL_CONFIG -- staging disabled."); }
  } else {
    btn.disabled = false;
    if(note){ note.innerHTML = ""; }
  }
}

// ==========================================================================
// PREREQUISITE: Init RoleDB task (v2.11.0, 2026-11-17).
// The "Initialize Current User and UserRole DB" task prefetches the sqlite
// tools zip from the root server's Custom Repository. A relevance-computed
// prefetch URL is a DYNAMIC download, which the root server did not cache on
// the 53311 environment (confirmed live 2026-11-17); a literal URL is a static
// download and caches fine. So the dashboard bakes the root server port in as
// a plain literal (CLIENT_PREFETCH_PORT) and publishes the Task itself --
// find-or-create by title prefix in PORTAL_CONFIG.siteName.
// Template source of truth: bes/Init-RoleDb.bes, mirrored below by
// scripts/generate_init_roledb_template.js.
// ==========================================================================

// BEGIN GENERATED INIT_ROLEDB_TEMPLATE
// Generated by scripts/generate_init_roledb_template.js from bes/Init-RoleDb.bes.
// DO NOT HAND-EDIT -- edit the .bes and re-run the generator.
var INIT_ROLEDB_ACTIONSCRIPT_LINES = [
  "begin prefetch block",
  "\tadd prefetch item name=unzip.exe sha1=e1652b058195db3f5f754b7ab430652ae04a50b8 size=167936 url=http://software.bigfix.com/download/redist/unzip-5.52.exe sha256=8d9b5190aace52a1db1ac73a65ee9999c329157c8e88f61a772433323d6b7a4a",
  "\tadd prefetch item name=sqlite-tools-win-x64-3530100.zip sha1=184d4d0b75cd75c2118fb22a1727e9220f843b98 size=6511283  url=http://127.0.0.1:__PREFETCH_PORT__/Uploads/CustomRepository/sqlite_util/sqlite-tools-win-x64-3530100.zip sha256=bcc88a2f9ebcf3d90b7a95337cc96bd492b1633f741bbdbff0525d1806098fc2",
  "end prefetch block",
  "",
  "// Working Params",
  "parameter \"RootDir\"=\"{ (pathname of parent folder of parent folder of client folder of site \"actionsite\") as string}\"",
  "parameter \"ECDir\"=\"{(concatenation (if windows of operating system then \"\\\" else \"/\") of ( (item 0 of it;item 1 of it) of ((pathname of parent folder of parent folder of client folder of site \"actionsite\") as string,\"EC\")))}\"",
  "parameter \"SWPDir\"=\"{(concatenation (if windows of operating system then \"\\\" else \"/\") of ( (item 0 of it;item 1 of it;item 2 of it) of ((pathname of parent folder of parent folder of client folder of site \"actionsite\") as string,\"EC\",\"SoftwarePortal\")))}\"",
  "parameter \"TargetStore\"=\"{(concatenation (if windows of operating system then \"\\\" else \"/\") of ( (item 0 of it; item 1 of it; item 2 of it; item 3 of it) of ((pathname of parent folder of parent folder of client folder of site \"actionsite\") as string,\"EC\",\"SoftwarePortal\",\"RoleAwareness.db\"))) }\"",
  "parameter \"SQLiteDir\"=\"{(concatenation (if windows of operating system then \"\\\" else \"/\") of ( (item 0 of it; item 1 of it; item 2 of it) of ((pathname of parent folder of parent folder of client folder of site \"actionsite\") as string,\"EC\",\"sqlite\"))) }\"",
  "parameter \"Region\"=\"{if (exists setting \"GPC_Sub_Name\" whose (exists value of it) of client) then (value of setting \"GPC_Sub_Name\" of client as string) else \"\"}\"",
  "",
  "",
  "// Prepare Directories",
  "if {not exists folder ((parameter \"ECDir\") as string)}",
  "\trunhidden cmd /c mkdir \"{parameter \"ECDir\"}\" ",
  "endif",
  "",
  "if {not exists folder ((parameter \"SWPDir\") as string)}",
  "\trunhidden cmd /c mkdir \"{parameter \"SWPDir\"}\" ",
  "endif",
  "",
  "//Prepare the SQLite folder with sqlite3.exe (CLM-safe -- no System.Data.SQLite.dll, no Add-Type)",
  "if {  ( exists file (parameter \"SQLiteDir\" & (if windows of operating system then \"\\\" else \"/\") & \"sqlite3.exe\") ) }",
  "    folder delete  \"{(parameter \"SQLiteDir\")}\"",
  "endif",
  "\t",
  "// ADD TO UTILITY CACHE: unzip,",
  "utility __Download\\unzip.exe",
  "",
  "folder create \"{parameter \"SQLiteDir\"}\"",
  "// EXTRACT using unzip: the 7zip command line utility",
  "waithidden __Download\\unzip.exe -o \"{ download path \"sqlite-tools-win-x64-3530100.zip\" }\"  -d \"{parameter \"SQLiteDir\"}\"",
  "",
  "",
  "//=============================================================================================//",
  "// Create/refresh Sqlite-Helper.ps1 + Initialize-RoleDb.ps1, then run init -- unconditional.",
  "// Initialize-RoleDb.ps1 is fully idempotent (CREATE TABLE IF NOT EXISTS, PRAGMA-gated ALTER",
  "// TABLE migration, [SKIP]-on-populated role seeding), so re-running this task against an",
  "// already-initialised endpoint safely migrates an existing RoleAwareness.db to the current",
  "// schema (adds Updated_on/Valid_to/idx_map_expiry) and preserves existing rows, instead of",
  "// only ever initialising brand-new endpoints.",
  "//=============================================================================================//",
  "",
  "    delete __createfile",
  "    delete \"{parameter \"SWPDir\"}\\Sqlite-Helper.ps1\"",
  "",
  "    createfile until _EOF_",
  "",
  "#Requires -Version 5.1",
  "<#",
  ".SYNOPSIS",
  "    CLM-safe SQLite access helper: invokes the bundled sqlite3.exe CLI via a stdin pipe,",
  "    with injection-safe parameter substitution, busy-timeout parity, and a CLM-safe",
  "    non-ASCII TEXT read-back decoder. Contains zero Add-Type / System.Data.SQLite usage.",
  "",
  ".DESCRIPTION",
  "    Dot-source this file once at the top of a caller script:",
  "",
  "        . \"$PSScriptRoot\\Sqlite-Helper.ps1\"",
  "",
  "    Then call Invoke-SqliteCommand for every database operation (DDL, INSERT/UPDATE/DELETE,",
  "    or SELECT). Parameters:",
  "",
  "        -DatabasePath [string] (Mandatory)   Full path to the SQLite database file.",
  "        -SQLDir       [string] (Mandatory)   Directory containing sqlite3.exe directly",
  "                                              (no x64/x86 arch subfolder -- SCHEMA-06).",
  "        -Sql          [string] (Mandatory)   One or more SQL statements. @name tokens are",
  "                                              substituted from -Parameters before execution.",
  "                                              WR-02: at most ONE of those statements may be",
  "                                              result-returning (e.g. a single SELECT, or a",
  "                                              single returning PRAGMA) -- a call with two or",
  "                                              more result-returning statements throws a clear",
  "                                              error instead of silently mis-parsing. DDL/",
  "                                              INSERT/UPDATE/DELETE statements are not result-",
  "                                              returning and may be freely combined.",
  "        -Parameters   [hashtable] = @{{}      Bare hashtable literal. Keys are bare names",
  "                                              (no leading @); values are string-coerced and",
  "                                              single-quote-doubled before substitution.",
  "",
  "    Returns the raw parsed JSON array from sqlite3.exe's `.mode json` output (D-14/D-15) --",
  "    every call returns an array, even for a single-row/single-column result such as",
  "    COUNT(*). Access rows via $result[0].ColumnName, aliasing columns for readability",
  "    (e.g. \"SELECT COUNT(*) AS n\").",
  "",
  "    PRAGMA busy_timeout=30000 is automatically prepended to every invocation -- callers",
  "    never need to request it (D-06/D-09).",
  "",
  "    Non-ASCII TEXT read-back convention (D-16): PowerShell's decode of sqlite3.exe's",
  "    stdout is unreliable for non-ASCII bytes under Constrained Language Mode (the fix,",
  "    [Console]::OutputEncoding's setter, is CLM-blocked). Callers that need byte-exact",
  "    non-ASCII TEXT column values back MUST select that column as:",
  "",
  "        SELECT hex(SomeTextColumn) AS \"SomeTextColumn__hex\" FROM ...",
  "",
  "    Invoke-SqliteCommand post-processes every returned row: any property whose name ends",
  "    with the literal suffix \"__hex\" is hex-decoded (pure CLM-safe bitwise decode, no",
  "    System.Text.Encoding / System.Convert calls) and re-exposed under the base property",
  "    name (suffix stripped); the \"__hex\" property itself is removed. Properties without",
  "    the suffix are returned unchanged. This applies to any TEXT column, not just a fixed",
  "    set of column names.",
  "",
  ".NOTES",
  "    PowerShell 5.1 only. No external modules. Zero Add-Type / System.Data.SQLite usage --",
  "    all database access goes through the bundled sqlite3.exe CLI via a stdin pipe (D-01).",
  "#>",
  "",
  "Set-StrictMode -Version Latest",
  "",
  "# Module-level, set once when this file is dot-sourced.",
  "# [System.Text.Encoding]::UTF8 is a static PROPERTY GET -- CLM-safe.",
  "# New-Object System.Text.UTF8Encoding($false) / ::new($false) (no-BOM) are CLM-BLOCKED --",
  "# do not use them. The BOM this introduces is harmless -- see Invoke-SqliteCommand's",
  "# statement ordering below (PRAGMA busy_timeout is always the literal first line).",
  "$OutputEncoding = [System.Text.Encoding]::UTF8",
  "",
  "function ConvertTo-SqliteLiteral {{",
  "    <#",
  "    .SYNOPSIS",
  "        SAFE-01: the entire SQL-injection escaping surface. Single-quote-doubles a value",
  "        and wraps it in single quotes, per SQLite string-literal escaping rules. Do NOT",
  "        add semicolon-stripping or any other blacklist sanitization -- it is unnecessary",
  "        (verified sufficient against the ROADMAP injection payload) and would corrupt",
  "        legitimate data (e.g. a Role named \"IT; Ops\").",
  "    #>",
  "    param(",
  "        [Parameter(Mandatory)]",
  "        [AllowEmptyString()]",
  "        [string]$Value",
  "    )",
  "    return \"'\" + $Value.Replace(\"'\", \"''\") + \"'\"",
  "}",
  "",
  "function ConvertFrom-SqliteHexNibble {{",
  "    param(",
  "        [Parameter(Mandatory)]",
  "        [char]$Char",
  "    )",
  "    $code = [int]$Char",
  "    if ($code -ge 48 -and $code -le 57)  {{ return $code - 48 }   # '0'-'9'",
  "    if ($code -ge 65 -and $code -le 70)  {{ return $code - 55 }   # 'A'-'F'",
  "    if ($code -ge 97 -and $code -le 102) {{ return $code - 87 }   # 'a'-'f'",
  "    throw \"ConvertFrom-SqliteHexUtf8: invalid hex character '$Char'\"",
  "}",
  "",
  "function ConvertFrom-SqliteUtf8Bytes {{",
  "    # Private helper for ConvertFrom-SqliteHexUtf8",
  "    param(",
  "        [Parameter(Mandatory)]",
  "        $Bytes",
  "    )",
  "    $result = ''",
  "    $i = 0",
  "    $len = $Bytes.Length",
  "    while ($i -lt $len) {{",
  "        $b0 = [int]$Bytes[$i]",
  "        if (($b0 -band 0x80) -eq 0) {{",
  "            $cp = $b0",
  "            $seqLen = 1",
  "        } elseif (($b0 -band 0xE0) -eq 0xC0) {{",
  "            $cp = $b0 -band 0x1F",
  "            $seqLen = 2",
  "        } elseif (($b0 -band 0xF0) -eq 0xE0) {{",
  "            $cp = $b0 -band 0x0F",
  "            $seqLen = 3",
  "        } elseif (($b0 -band 0xF8) -eq 0xF0) {{",
  "            $cp = $b0 -band 0x07",
  "            $seqLen = 4",
  "        } else {{",
  "            throw (\"ConvertFrom-SqliteHexUtf8: invalid UTF-8 lead byte 0x{{0:X2}\" -f $b0)",
  "        }",
  "",
  "        for ($j = 1; $j -lt $seqLen; $j++) {{",
  "            $cb = [int]$Bytes[$i + $j]",
  "            $cp = ($cp -shl 6) -bor ($cb -band 0x3F)",
  "        }",
  "",
  "        if ($cp -le 0xFFFF) {{",
  "            $result += [char]$cp",
  "        } else {{",
  "            # Surrogate pair for codepoints beyond the BMP.",
  "            $result += [char](0xD800 -bor (($cp - 0x10000) -shr 10))",
  "            $result += [char](0xDC00 -bor (($cp - 0x10000) -band 0x3FF))",
  "        }",
  "",
  "        $i += $seqLen",
  "    }",
  "    return $result",
  "}",
  "",
  "function ConvertFrom-SqliteHexUtf8 {{",
  "    param(",
  "        [Parameter(Mandatory)]",
  "        [AllowEmptyString()]",
  "        [string]$Hex",
  "    )",
  "    if ($Hex.Length -eq 0) {{ return '' }",
  "",
  "    $byteCount = [int]($Hex.Length / 2)",
  "    $bytes = [byte[]]::new($byteCount)",
  "    for ($i = 0; $i -lt $byteCount; $i++) {{",
  "        $hi = ConvertFrom-SqliteHexNibble -Char $Hex[$i * 2]",
  "        $lo = ConvertFrom-SqliteHexNibble -Char $Hex[$i * 2 + 1]",
  "        $bytes[$i] = [byte](($hi -shl 4) -bor $lo)",
  "    }",
  "",
  "    return (ConvertFrom-SqliteUtf8Bytes -Bytes $bytes)",
  "}",
  "",
  "function Invoke-SqliteCommand {{",
  "    param(",
  "        [Parameter(Mandatory)]",
  "        [string]$DatabasePath,",
  "",
  "        [Parameter(Mandatory)]",
  "        [string]$SQLDir,",
  "",
  "        [Parameter(Mandatory)]",
  "        [string]$Sql,",
  "",
  "        [hashtable]$Parameters = @{{}",
  "    )",
  "",
  "    # SCHEMA-06: -SQLDir resolves directly to sqlite3.exe ",
  "    $sqlite3exe = Join-Path $SQLDir 'sqlite3.exe'",
  "    if (-not (Test-Path $sqlite3exe)) {{",
  "        throw \"sqlite3.exe not found at: $sqlite3exe`nSet -SQLDir to the directory containing sqlite3.exe.\"",
  "    }",
  "",
  "    $resolvedSql = $Sql",
  "    if ($Parameters.Keys.Count -gt 0) {{",
  "        $sortedKeys = @($Parameters.Keys | Sort-Object -Property Length -Descending)",
  "        $pattern = ($sortedKeys | ForEach-Object {{ [regex]::Escape(\"@$_\") }) -join '|'",
  "        $tokenMatches = [regex]::Matches($Sql, \"(?:$pattern)(?![A-Za-z0-9_])\")",
  "        if ($tokenMatches.Count -gt 0) {{",
  "            $sb = ''",
  "            $lastIndex = 0",
  "            foreach ($tokenMatch in $tokenMatches) {{",
  "                $sb += $Sql.Substring($lastIndex, $tokenMatch.Index - $lastIndex)",
  "                $matchedKey = $sortedKeys | Where-Object {{ $tokenMatch.Value -eq \"@$_\" } | Select-Object -First 1",
  "                $sb += ConvertTo-SqliteLiteral -Value ([string]$Parameters[$matchedKey])",
  "                $lastIndex = $tokenMatch.Index + $tokenMatch.Length",
  "            }",
  "            $sb += $Sql.Substring($lastIndex)",
  "            $resolvedSql = $sb",
  "        }",
  "    }",
  "",
  "    $fullSql = \"PRAGMA busy_timeout=30000;`n.mode json`n$resolvedSql\"",
  "",
  "    $ErrorActionPreference = 'Continue'",
  "    $raw = $fullSql | & $sqlite3exe $DatabasePath 2>&1",
  "    $exitCode = $LASTEXITCODE",
  "",
  "    $rawArr    = @($raw)",
  "    $stdoutArr = @($rawArr | Where-Object {{ $_ -isnot [System.Management.Automation.ErrorRecord] })",
  "    $stderrArr = @($rawArr | Where-Object {{ $_ -is    [System.Management.Automation.ErrorRecord] } |",
  "                    ForEach-Object {{ $_.Exception.Message })",
  "",
  "    if ($exitCode -ne 0) {{",
  "        throw \"sqlite3.exe failed (exit=$exitCode): $($stderrArr -join '; ')\"",
  "    }",
  "    $jsonLines = @($stdoutArr | Select-Object -Skip 1)",
  "    if ($jsonLines.Count -eq 0) {{",
  "        return @()   # write-only statement -- nothing after the busy_timeout echo",
  "    }",
  "",
  "    $topLevelArrayStarts = @($jsonLines | Where-Object {{ $_.StartsWith('[') })",
  "    if ($topLevelArrayStarts.Count -gt 1) {{",
  "        throw \"Invoke-SqliteCommand: -Sql produced $($topLevelArrayStarts.Count) result sets from a single call, but only one result-returning statement is supported per call. Split multi-SELECT (or SELECT + returning PRAGMA) calls into separate Invoke-SqliteCommand invocations.\"",
  "    }",
  "",
  "    # re-join before ConvertFrom-Json.",
  "    $joined = $jsonLines -join \"`n\"",
  "    $parsed = $joined | ConvertFrom-Json",
  "    $rows   = @($parsed)",
  "",
  "    for ($r = 0; $r -lt $rows.Count; $r++) {{",
  "        $row = $rows[$r]",
  "        $hexPropNames = @($row.PSObject.Properties | Where-Object {{ $_.Name.EndsWith('__hex') } |",
  "                            ForEach-Object {{ $_.Name })",
  "        if ($hexPropNames.Count -eq 0) {{ continue }",
  "",
  "        $decoded = @{{}",
  "        foreach ($hexName in $hexPropNames) {{",
  "            $baseName = $hexName.Substring(0, $hexName.Length - 5)  ",
  "            $hexVal = $row.$hexName",
  "            $decoded[$baseName] = if ($null -eq $hexVal) {{ $null } else {{ ConvertFrom-SqliteHexUtf8 -Hex ([string]$hexVal) }",
  "        }",
  "",
  "        $newRow = $row | Select-Object -Property * -ExcludeProperty $hexPropNames",
  "        foreach ($baseName in $decoded.Keys) {{",
  "            Add-Member -InputObject $newRow -MemberType NoteProperty -Name $baseName -Value $decoded[$baseName] -Force",
  "        }",
  "        $rows[$r] = $newRow",
  "    }",
  "",
  "    return @(, $rows) ",
  "}",
  "",
  "_EOF_",
  "    move __createfile \"{parameter \"SWPDir\"}\\Sqlite-Helper.ps1\"",
  "",
  "    delete __createfile",
  "    delete \"{parameter \"SWPDir\"}\\Initialize-RoleDb.ps1\"",
  "",
  "    createfile until _EOF_",
  "",
  "#Requires -Version 5.1",
  "<#",
  ".SYNOPSIS",
  "    Creates the SQLite database and schema for the Role Aware Software Distribution.",
  "",
  ".DESCRIPTION",
  "    Initialises RoleAwareness.db with the Roles, Users, Map, and Overrides tables.",
  "    Safe to re-run: uses CREATE TABLE IF NOT EXISTS. Already-present tables are",
  "    skipped with a [SKIP] message. No data is modified on skip.",
  "",
  "    v2 changes:",
  "      - Map gains Updated_on (TEXT) and Valid_to (TEXT) columns.",
  "      - Migration block (error 5400) adds both columns to existing tables if absent.",
  "      - idx_map_expiry partial index added after migration for efficient expiry queries.",
  "",
  "    v3 changes:",
  "      - This script is re-run on every logon by the RoleDB_Maintenance scheduled task",
  "        (registered by the init .bes; see Scheduled_RoleDb_mnc.ps1), not just once at",
  "        DB-creation time. The \"Load Current User\" step (error 5300) now also renews",
  "        Valid_to on the logged-on user's active, non-overridden Map rows (error 5350) --",
  "        same D-12 upsert philosophy as Assign-RoleMapping.ps1's CSV-deploy path, just",
  "        applied automatically on every logon instead of by admin action.",
  "",
  "    v4 changes (Phase 7, D-18):",
  "      - Map gains four additive TEXT columns, added by the same PRAGMA table_info(Map)-",
  "        gated ALTER TABLE mechanism as Updated_on / Valid_to (error 5400):",
  "          Source_Type   provenance kind - e.g. \"AD Security Group\" | \"Mailing List\" |",
  "                        \"Azure AD Group\". '|'-joined when a role was granted by more",
  "                        than one group.",
  "          Source_Value  the granting group's CN / display name. '|'-joined likewise.",
  "          Region        the endpoint's own GPC_Sub_Name client-setting value at the",
  "                        time the role was assigned.",
  "          Assigned_By   one of \"AxoniousSync\" | \"AdminCSV\" | \"Logon\".",
  "      - These columns are WRITTEN by scripts/Assign-RoleMapping.ps1 (Operator-Role-Group",
  "        model), not by this script. This script only guarantees the columns exist. UNIQUE(UserID, Role),",
  "        Active, Locked_by_Override, Valid_to and the D-12 renew upsert are unchanged.",
  "",
  ".PARAMETER DatabasePath",
  "    Full path to the SQLite database file to create or open.",
  "    Default: C:\\Program Files (x86)\\BigFix Enterprise\\BES Client\\EC\\SoftwarePortal\\RoleAwareness.db",
  "",
  ".PARAMETER SQLDir",
  "    Directory containing sqlite3.exe directly (no x64\\/x86\\ arch subfolder).",
  "",
  ".PARAMETER ValidityMonths",
  "    How far to push a renewed row's Valid_to forward, expressed as SQLite datetime()",
  "    modifier months. Default: 6, mirroring PipelineConfig.ValidityMonths (formerly",
  "    PORTAL_CONFIG.validityMonths in the now-archived, retired fixlet_role_assigner.ojo,",
  "    D-15). Keep the two in sync if that default ever changes -- RoleDB_Maintenance does",
  "    not pass -ValidityMonths explicitly, so redeploying the init task is enough to",
  "    change the script default without touching the scheduled task.",
  "",
  ".EXAMPLE",
  "    .\\Initialize-RoleDb.ps1 -DatabasePath .\\RoleAwareness.db -SQLDir .\\SQLite",
  "",
  ".NOTES",
  "    PowerShell 5.1 only. No external modules required (D-15).",
  "    Uses the bundled sqlite3.exe CLI via Sqlite-Helper.ps1 -- NOT System.Data.SQLite.dll",
  "    and NOT PSSQLite from PSGallery. Zero Add-Type calls (Constrained Language Mode safe).",
  "    Re-run safe: CREATE TABLE IF NOT EXISTS; column migration uses PRAGMA table_info.",
  "",
  "    Upsert pattern (D-12): downstream scripts use INSERT OR IGNORE + conditional UPDATE",
  "    to preserve deploy state across re-imports. A delete-and-reinsert upsert is",
  "    prohibited on any stateful table -- it destroys existing Active /",
  "    Locked_by_Override values. (The Users table is the sole exception: it carries only",
  "    UserID + LastSeen, no state, so its one delete-and-reinsert write is safe.)",
  "",
  "    Error codes:",
  "      5100  Table creation",
  "      5150  idx_overrides_lookup index",
  "      5200  Default role seeding",
  "      5300  Current user detection",
  "      5350  Map.Valid_to renewal for the logged-on user",
  "      5400  Map column migration (Updated_on, Valid_to, Source_Type, Source_Value,",
  "            Region, Assigned_By) + idx_map_expiry index",
  "#>",
  "[CmdletBinding()]",
  "param(",
  "    [Parameter()]",
  "    [string]$DatabasePath = 'C:\\Program Files (x86)\\BigFix Enterprise\\BES Client\\EC\\SoftwarePortal\\RoleAwareness.db',",
  "",
  "    [Parameter()]",
  "    [string]$SQLDir = 'C:\\Program Files (x86)\\BigFix Enterprise\\BES Client\\EC\\sqlite',",
  "",
  "    [Parameter()]",
  "    [int]$ValidityMonths = 6",
  ")",
  "",
  "Set-StrictMode -Version Latest",
  "$ErrorActionPreference = 'Stop'",
  "",
  "$logfile = Join-Path (Split-Path $DatabasePath) 'SWDlog.log'",
  "",
  "Add-Content -Path $logfile -Value \"----Starting\"",
  "",
  ". \"$PSScriptRoot\\Sqlite-Helper.ps1\"",
  "",
  "try {{",
  "",
  "    $rolesDdl = @\"",
  "CREATE TABLE IF NOT EXISTS Roles (",
  "    RoleID  INTEGER PRIMARY KEY AUTOINCREMENT,",
  "    Role    TEXT NOT NULL UNIQUE",
  ")",
  "\"@",
  "",
  "    $usersDdl = @\"",
  "CREATE TABLE IF NOT EXISTS Users (",
  "    UID       INTEGER PRIMARY KEY AUTOINCREMENT,",
  "    UserID    TEXT UNIQUE NOT NULL,",
  "    LastSeen  TEXT NOT NULL",
  ")",
  "\"@",
  "",
  "    $mapDdl = @\"",
  "CREATE TABLE IF NOT EXISTS Map (",
  "    MapID              INTEGER PRIMARY KEY AUTOINCREMENT,",
  "    UserID             TEXT NOT NULL,",
  "    Role               TEXT NOT NULL,",
  "    Active             INTEGER NOT NULL DEFAULT 1,",
  "    Locked_by_Override INTEGER NOT NULL DEFAULT 0,",
  "    Created_on         TEXT NOT NULL DEFAULT (datetime('now', 'localtime')),",
  "    Updated_on         TEXT,",
  "    Valid_to           TEXT,",
  "    UNIQUE(UserID, Role)",
  ")",
  "\"@",
  "",
  "    $overridesDdl = @\"",
  "CREATE TABLE IF NOT EXISTS Overrides (",
  "    OID             INTEGER PRIMARY KEY AUTOINCREMENT,",
  "    Override_Type   TEXT NOT NULL,",
  "    Override_Key    TEXT NOT NULL,",
  "    Override_Value  TEXT NOT NULL,",
  "    Override_Reason TEXT NOT NULL,",
  "    Overridden_By   TEXT NOT NULL,",
  "    Overriden_On    TEXT DEFAULT (concat(date('now'), ' ', time('now'))),",
  "    Valid_To        TEXT DEFAULT (concat(date('now'), ' ', time('now', '+1 hours')))",
  ")",
  "\"@",
  "",
  "    ## Build Tables",
  "    try {{",
  "        foreach ($tbl in @(",
  "            @{{ Name = 'Roles';     Ddl = $rolesDdl     }",
  "            @{{ Name = 'Users';     Ddl = $usersDdl     }",
  "            @{{ Name = 'Map';       Ddl = $mapDdl       }",
  "            @{{ Name = 'Overrides'; Ddl = $overridesDdl }",
  "        )) {{",
  "            $before = Invoke-SqliteCommand -DatabasePath $DatabasePath -SQLDir $SQLDir `",
  "                -Sql \"SELECT COUNT(*) AS n FROM sqlite_master WHERE type='table' AND name=@n\" `",
  "                -Parameters @{{ n = $tbl.Name }",
  "",
  "            if ($before[0].n -eq 1) {{",
  "                Write-Host \"[SKIP] $($tbl.Name) table already exists - no changes made\"",
  "\t\t\t\tAdd-Content -Path $logfile -Value \"[SKIP] $($tbl.Name) table already exists - no changes made\"",
  "            } else {{",
  "                Invoke-SqliteCommand -DatabasePath $DatabasePath -SQLDir $SQLDir -Sql $tbl.Ddl | Out-Null",
  "                Write-Host \"[CREATE] $($tbl.Name) table created\"",
  "\t\t\t\tAdd-Content -Path $logfile -Value \"[CREATE] $($tbl.Name) table created\"",
  "            }",
  "        }",
  "    } catch {{ throw 5100 }",
  "",
  "",
  "    ## Add index for fast override lookups",
  "    try {{",
  "        Invoke-SqliteCommand -DatabasePath $DatabasePath -SQLDir $SQLDir -Sql @\"",
  "CREATE INDEX IF NOT EXISTS idx_overrides_lookup",
  "    ON Overrides (Override_Type, Override_Key, Override_Value)",
  "    WHERE Valid_to > datetime('now', 'localtime')",
  "\"@ | Out-Null",
  "    } catch {{ throw 5150 }",
  "",
  "    try {{",
  "        $mapColRows = Invoke-SqliteCommand -DatabasePath $DatabasePath -SQLDir $SQLDir -Sql \"PRAGMA table_info(Map)\"",
  "        $mapCols = @($mapColRows | ForEach-Object {{ $_.name })",
  "",
  "        if ($mapCols -notcontains 'Updated_on') {{",
  "            Invoke-SqliteCommand -DatabasePath $DatabasePath -SQLDir $SQLDir -Sql \"ALTER TABLE Map ADD COLUMN Updated_on TEXT\" | Out-Null",
  "            Write-Host \"[MIGRATE] Map.Updated_on column added\"",
  "\t\t\t\tAdd-Content -Path $logfile -Value \"[MIGRATE] Map.Updated_on column added\"",
  "        } else {{",
  "            Write-Host \"[SKIP] Map.Updated_on already present\"",
  "\t\t\tAdd-Content -Path $logfile -Value \"[SKIP] Map.Updated_on already present\"",
  "        }",
  "",
  "        if ($mapCols -notcontains 'Valid_to') {{",
  "            Invoke-SqliteCommand -DatabasePath $DatabasePath -SQLDir $SQLDir -Sql \"ALTER TABLE Map ADD COLUMN Valid_to TEXT\" | Out-Null",
  "            Write-Host \"[MIGRATE] Map.Valid_to column added\"",
  "\t\t\tAdd-Content -Path $logfile -Value \"[MIGRATE] Map.Valid_to column added\"",
  "        } else {{",
  "            Write-Host \"[SKIP] Map.Valid_to already present\"",
  "\t\t\tAdd-Content -Path $logfile -Value \"[SKIP] Map.Valid_to already present\"",
  "        }",
  "",
  "        # v4 (Phase 7, D-18): four additive provenance columns, same mechanism as above.",
  "        # Written later by scripts/Assign-RoleMapping.ps1 (Operator-Role-Group model); this block only ensures they exist.",
  "        foreach ($col in 'Source_Type','Source_Value','Region','Assigned_By') {{",
  "            if ($mapCols -notcontains $col) {{",
  "                Invoke-SqliteCommand -DatabasePath $DatabasePath -SQLDir $SQLDir -Sql \"ALTER TABLE Map ADD COLUMN $col TEXT\" | Out-Null",
  "                Write-Host \"[MIGRATE] Map.$col column added\"",
  "                Add-Content -Path $logfile -Value \"[MIGRATE] Map.$col column added\"",
  "            } else {{",
  "                Write-Host \"[SKIP] Map.$col already present\"",
  "                Add-Content -Path $logfile -Value \"[SKIP] Map.$col already present\"",
  "            }",
  "        }",
  "",
  "        Invoke-SqliteCommand -DatabasePath $DatabasePath -SQLDir $SQLDir -Sql @\"",
  "CREATE INDEX IF NOT EXISTS idx_map_expiry",
  "    ON Map (Valid_to)",
  "    WHERE Active = 1 AND Locked_by_Override = 0",
  "\"@ | Out-Null",
  "        Write-Host \"[INDEX] idx_map_expiry ready\"",
  "\t\tAdd-Content -Path $logfile -Value  \"[INDEX] idx_map_expiry ready\"",
  "    } catch {{ throw 5400 }",
  "",
  "",
  "    ## Load Default Roles (skip if already populated)",
  "    try {{",
  "        $roleCount = Invoke-SqliteCommand -DatabasePath $DatabasePath -SQLDir $SQLDir -Sql \"SELECT COUNT(*) AS n FROM Roles\"",
  "",
  "        if ($roleCount[0].n -gt 0) {{",
  "            Write-Host \"[SKIP] Roles already populated - no changes made\"",
  "\t\t\t\tAdd-Content -Path $logfile -Value \"[SKIP] Roles already populated - no changes made\"",
  "        } else {{",
  "            $defaultRoles = @(",
  "                'IT Operations', 'Business Operations', 'Business Default'",
  "            )",
  "            foreach ($role in $defaultRoles) {{",
  "                Invoke-SqliteCommand -DatabasePath $DatabasePath -SQLDir $SQLDir `",
  "                    -Sql \"INSERT OR IGNORE INTO Roles (Role) VALUES (@role)\" -Parameters @{{ role = $role } | Out-Null",
  "            }",
  "            Write-Host \"[CREATE] Roles populated with defaults\"",
  "\t\t\t\tAdd-Content -Path $logfile -Value \"[CREATE] Roles populated with defaults\"",
  "        }",
  "    } catch {{ throw 5200 }",
  "",
  "",
  "    ## Load Current User",
  "    try {{",
  "        $users = Get-CimInstance -ClassName Win32_Process -Filter \"Name='explorer.exe'\" | Invoke-CimMethod -MethodName GetOwner | Select-Object -ExpandProperty User -Unique",
  "        foreach ($u in @($users)) {{",
  "            Write-Host \"[DIAG] GetOwner().User='$u'\"",
  "\t\t\t\tAdd-Content -Path $logfile -Value \"[DIAG] GetOwner().User='$u'\"",
  "        }\t\t",
  "        if (-not $users) {{",
  "            Write-Host \"[SKIP] No current user found\"",
  "\t\t\t\tAdd-Content -Path $logfile -Value \"[SKIP] No current user found\"",
  "        } else {{",
  "\t\t\tforeach($user in $users) {{",
  "\t\t\t\t$bareUser = $user.Split('\\')[-1].ToLower()",
  "\t\t\t\tInvoke-SqliteCommand -DatabasePath $DatabasePath -SQLDir $SQLDir `",
  "\t\t\t\t\t-Sql \"INSERT OR REPLACE INTO Users (UserID, LastSeen) VALUES (@uid, datetime('now', 'localtime'))\" `",
  "\t\t\t\t\t-Parameters @{{ uid = $bareUser } | Out-Null",
  "\t\t\t\tWrite-Host \"[UPSERT] User '$bareUser' written to Users table\"",
  "\t\t\t\tAdd-Content -Path $logfile -Value \"[UPSERT] User '$bareUser' written to Users table\"",
  "\t\t\t}",
  "        }",
  "    } catch {{ throw 5300 }",
  "",
  "",
  "    ## Renew Valid_to on the logged-on user's active, non-overridden Map rows.",
  "    ## Runs every time this script runs -- both the one-shot init and every RoleDB_Maintenance",
  "    ## logon rerun -- so a brand-new user's first run is simply a no-op (no Map rows yet).",
  "    ## Locked_by_Override = 1 rows are intentionally excluded: an admin override is a",
  "    ## deliberate \"stop auto-renewing this mapping\" signal that this step must never fight.",
  "    ## UPDATE + SELECT changes() must be ONE Invoke-SqliteCommand call: each call opens a",
  "    ## fresh sqlite3.exe process, and changes() is scoped to that single connection --",
  "    ## splitting them across two calls would always read back 0.",
  "    try {{",
  "        if ($users) {{",
  "            $validModifier = \"+$ValidityMonths months\"",
  "            foreach ($user in $users) {{",
  "                $bareUser = $user.Split('\\')[-1].ToLower()",
  "                $renewed = Invoke-SqliteCommand -DatabasePath $DatabasePath -SQLDir $SQLDir `",
  "                    -Sql \"UPDATE Map SET Updated_on = datetime('now','localtime'), Valid_to = datetime('now','localtime',@validModifier) WHERE UserID = @uid AND Active = 1 AND Locked_by_Override = 0;",
  "SELECT changes() AS n\" `",
  "                    -Parameters @{{ uid = $bareUser; validModifier = $validModifier }",
  "                $renewedCount = if ($renewed.Count -gt 0) {{ $renewed[0].n } else {{ 0 }",
  "",
  "                Write-Host \"[RENEW] User '$bareUser': $renewedCount active role mapping(s) extended to +$ValidityMonths months\"",
  "\t\t\t\tAdd-Content -Path $logfile -Value \"[RENEW] User '$bareUser': $renewedCount active role mapping(s) extended to +$ValidityMonths months\"",
  "            }",
  "        }",
  "    } catch {{ throw 5350 }",
  "",
  "} finally {{",
  "    try {{",
  "        Invoke-SqliteCommand -DatabasePath $DatabasePath -SQLDir $SQLDir -Sql \"PRAGMA wal_checkpoint(TRUNCATE)\" | Out-Null",
  "    } catch {{}",
  "}",
  "",
  "_EOF_",
  "    move __createfile \"{parameter \"SWPDir\"}\\Initialize-RoleDb.ps1\"",
  "    ",
  "    action uses wow64 redirection {x64 of operating system}",
  "    waithidden powershell.exe -NonInteractive -NoProfile -ExecutionPolicy Bypass -File  \"{parameter \"SWPDir\"}\\Initialize-RoleDb.ps1\" -DatabasePath \"{parameter \"TargetStore\"}\" -SQLDir \"{parameter \"SQLiteDir\"}\"",
  "",
  "//=============================================================================================//",
  "// Setup Scheduled Task -- only proceed if RoleAwareness.db actually exists (defensive: skip",
  "// if init somehow failed). Pitfall 5: the re-register below is gated on \"task does not",
  "// exist\", so an already-provisioned endpoint would keep the OLD command line forever.",
  "// Unregister first (ignore not-found) so every redeploy adopts the corrected single-action",
  "// (Initialize-RoleDb only) command line.",
  "//=============================================================================================//",
  "if {exists file (parameter \"TargetStore\")}",
  "",
  "    action uses wow64 redirection {x64 of operating system}",
  "    waithidden powershell.exe -NonInteractive -NoProfile -ExecutionPolicy Bypass -Command \"Unregister-ScheduledTask -TaskName 'RoleDB_Maintenance' -Confirm:$false -ErrorAction SilentlyContinue\"",
  "\t",
  "\tif {  not (exists (scheduled tasks whose (name of it = \"RoleDB_Maintenance\"))) }",
  "\t",
  "\t",
  "\tdelete __createfile",
  "\tdelete \"{parameter \"SWPDir\"}\\Scheduled_RoleDb_mnc.ps1\"",
  "\t",
  "\tcreatefile until _EO3_",
  "\t",
  "\t#Requires -Version 5.1",
  "\t<#",
  "\t.SYNOPSIS",
  "\t    Creates the Scheduled task that maintains the Role Aware Software Distribution user register.",
  "\t",
  "\t.DESCRIPTION",
  "\t    This task schedules Initialisation of RoleAwareness.db with the Roles, Users, Map, and Overrides tables.",
  "\t    Safe to re-run: uses CREATE TABLE IF NOT EXISTS. Already-present tables are",
  "\t    skipped with a [SKIP] message. No data is modified on skip.",
  "\t\tPopulates used table with current user and last-see date, and renews Valid_to on the",
  "\t\tlogged-on user's active, non-overridden Map rows (see Initialize-RoleDb.ps1 v3).",
  "\t#>",
  "\t",
  "\tSet-StrictMode -Version Latest",
  "\t$ErrorActionPreference = 'Stop'",
  "\t",
  "\t",
  "\t$logfile = '{parameter \"SWPDir\"}\\SWDlog.log'",
  "\t",
  "\tAdd-Content -Path $logfile -Value \"----Setting up schedul\"",
  "\t",
  "\t",
  "\t# RoleDB_Maintenance runs Initialize-RoleDb.ps1 on every logon -- this is CLM-safe SQLite",
  "\t# access with no relevance-engine dependency (no dynamic-group/relevance lookup at run time;",
  "\t# the script reads its own -DatabasePath/-SQLDir parameters directly).",
  "\t$actionInit = New-ScheduledTaskAction -Execute \"powershell.exe\" `",
  "\t    -Argument \"-NonInteractive -NoProfile -ExecutionPolicy Bypass -File `\"{parameter \"SWPDir\"}\\Initialize-RoleDb.ps1`\" -DatabasePath `\"{parameter \"TargetStore\"}`\" -SQLDir `\"{parameter \"SQLiteDir\"}`\"\"",
  "\t",
  "\t",
  "\tAdd-Content -Path $logfile -Value \"      Action created (init)\"",
  "\t",
  "\t$trigger = New-ScheduledTaskTrigger -AtLogOn",
  "\tAdd-Content -Path $logfile -Value \"      Trigger crteated\"",
  "\t",
  "\t$settings = New-ScheduledTaskSettingsSet -AllowStartIfOnBatteries `",
  "\t    -DontStopIfGoingOnBatteries -ExecutionTimeLimit 0",
  "\t",
  "\tAdd-Content -Path $logfile -Value \"      Content crteated\"",
  "\t",
  "\tRegister-ScheduledTask -TaskName \"RoleDB_Maintenance\" `",
  "\t    -Action @($actionInit) `",
  "\t    -Trigger $trigger `",
  "\t    -Settings $settings `",
  "\t    -User \"SYSTEM\" `",
  "\t    -RunLevel Highest `",
  "\t    -Force",
  "\t",
  "\tAdd-Content -Path $logfile -Value \"      Registered\"",
  "\t",
  "\t",
  "\t",
  "\t_EO3_",
  "\t    move __createfile \"{parameter \"SWPDir\"}\\Scheduled_RoleDb_mnc.ps1\"",
  "\t",
  "\t    action uses wow64 redirection {x64 of operating system}",
  "\t    waithidden powershell.exe -NonInteractive -NoProfile -ExecutionPolicy Bypass -File \"{parameter \"SWPDir\"}\\Scheduled_RoleDb_mnc.ps1\"",
  "\t",
  "\t",
  "\tendif",
  "",
  "endif",
  "",
  "",
  "",
  "//=============================================================================================//",
  "// Map User to Role",
  "//=============================================================================================//",
  "",
  "",
  "",
  ""
];
var INIT_ROLEDB_TEMPLATE = {
  title: "Initialize Current User and UserRole DB (2.1.0)",
  description: "<P>Use this task to create a local mapping database for Role Smart software depoyment.</P>\n<P>this task will perform the following:</P>\n<OL>\n<LI>Install RoleAwareness.db on client. \n<LI>Generate Scheduled task RoleDB_Maintenance to record active users</LI></OL>\n<P>&nbsp;</P>\n<P><B>Generated template.</B> This task is published by the Dereso Role Manager dashboard\n(Prerequisites &rarr; Publish Init RoleDB task). The prefetch URL's port is baked in as a plain\nliteral at publish time (this copy: <CODE>__PREFETCH_PORT__</CODE>), read from the root server's\nmasthead, because a relevance-computed URL is a dynamic download that the root server does not\ncache on non-default-port environments. Do not import bes/Init-RoleDb.bes directly.</P>",
  relevances: ["exists (operating system) whose (it as string as lowercase contains \"win\" as lowercase)"],
  category: "Setup",
  source: "ESM",
  sourceReleaseDate: "2026-11-17",
  mimeFields: [ { name: "x-fixlet-modification-time", value: "Tue, 17 Nov 2026 00:00:00 +0000" } ],
  domain: "BESC",
  actionDescription: { preLink: "Click ", link: "here", postLink: " to initialize RoleAwareness.db on this endpoint." },
  actionScript: INIT_ROLEDB_ACTIONSCRIPT_LINES.join('\n')
};
// END GENERATED INIT_ROLEDB_TEMPLATE

// Title prefixes this publish adopts as "the same task" -- both spellings, so a
// manually imported "Inititialize ... (2.0.x)" copy is updated in place rather
// than left alongside a new one.
var INIT_ROLEDB_TITLE_PREFIXES = [
  "Initialize Current User and UserRole DB",
  "Inititialize Current User and UserRole DB"
];

// buildInitRoleDbTaskXml(tf, port) -- pure, unit-tested. Emits a brand-new
// <BES><Task> (never mutates fetched XML). Returns "" unless port is all digits,
// so an empty/garbage port can never reach a prefetch URL.
function buildInitRoleDbTaskXml(tf, port){
  port = String(port || "");
  if(!/^\d{1,5}$/.test(port)){ return ""; }
  tf = tf || {};
  var sub = function(s){ return String(s || "").replace(/__PREFETCH_PORT__/g, port); };
  var ad  = tf.actionDescription || {};
  var xml = '<?xml version="1.0" encoding="UTF-8"?>\r\n';
  xml += '<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">\r\n';
  xml += '  <Task>\r\n';
  xml += '    <Title>' + xmlEscape(tf.title || "") + '</Title>\r\n';
  xml += '    <Description>' + cdataStart() + xmlCDataSafe(sub(tf.description)) + cdataEnd() + '</Description>\r\n';
  var ri, mi;
  var rels = tf.relevances || [];
  for(ri = 0; ri < rels.length; ri++){
    xml += '    <Relevance>' + cdataStart() + xmlCDataSafe(rels[ri]) + cdataEnd() + '</Relevance>\r\n';
  }
  xml += '    <Category>' + xmlEscape(tf.category || "") + '</Category>\r\n';
  xml += '    <Source>' + xmlEscape(tf.source || "Internal") + '</Source>\r\n';
  xml += '    <SourceID></SourceID>\r\n';
  xml += '    <SourceReleaseDate>' + xmlEscape(tf.sourceReleaseDate || "") + '</SourceReleaseDate>\r\n';
  xml += '    <SourceSeverity></SourceSeverity>\r\n';
  xml += '    <CVENames></CVENames>\r\n';
  xml += '    <SANSID></SANSID>\r\n';
  var mf = tf.mimeFields || [];
  for(mi = 0; mi < mf.length; mi++){
    xml += '    <MIMEField>\r\n';
    xml += '      <Name>' + xmlEscape(mf[mi].name) + '</Name>\r\n';
    xml += '      <Value>' + xmlEscape(mf[mi].value) + '</Value>\r\n';
    xml += '    </MIMEField>\r\n';
  }
  xml += '    <Domain>' + xmlEscape(tf.domain || "BESC") + '</Domain>\r\n';
  xml += '    <DefaultAction ID="Action1">\r\n';
  xml += '      <Description>\r\n';
  xml += '        <PreLink>' + xmlEscape(ad.preLink || "Click ") + '</PreLink>\r\n';
  xml += '        <Link>' + xmlEscape(ad.link || "here") + '</Link>\r\n';
  xml += '        <PostLink>' + xmlEscape(ad.postLink || "") + '</PostLink>\r\n';
  xml += '      </Description>\r\n';
  xml += '      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">';
  xml += cdataStart() + xmlCDataSafe(sub(tf.actionScript)) + cdataEnd();
  xml += '</ActionScript>\r\n';
  xml += '    </DefaultAction>\r\n';
  xml += '  </Task>\r\n';
  xml += '</BES>';
  return xml;
}

// findInitRoleDbTaskIds() -> ["812", "787", ...] (highest id first) -- every
// Task in PORTAL_CONFIG.siteName whose title starts with either prefix.
function findInitRoleDbTaskIds(){
  var safeSite = String(PORTAL_CONFIG.siteName || "").replace(/"/g, '""');
  var conds = [];
  for(var i = 0; i < INIT_ROLEDB_TITLE_PREFIXES.length; i++){
    conds.push('name of it starts with "' + INIT_ROLEDB_TITLE_PREFIXES[i].replace(/"/g, '""') + '"');
  }
  var rel = '(id of it as string) of bes tasks whose (name of site of it = "' + safeSite + '" and (' + conds.join(' or ') + '))';
  var ids = getRelevanceSafe(rel);
  var out = [];
  for(var j = 0; j < ids.length; j++){ if(/^\d+$/.test(String(ids[j]))){ out.push(String(ids[j])); } }
  out.sort(function(a, b){ return parseInt(b, 10) - parseInt(a, 10); });
  return out;
}

// publishInitRoleDbTask(onDone) -- onDone(err, { taskId, created, port, others }).
// Refuses when the port only came from the hardcoded default: baking an
// unverified 52311 into a non-default-port environment is exactly the bug this
// exists to prevent.
function publishInitRoleDbTask(onDone){
  if(CLIENT_PREFETCH_PORT_SOURCE === "default"){
    onDone("root server port could not be verified (masthead and Analysis both unavailable) -- not publishing with an assumed " + CLIENT_PREFETCH_PORT);
    return;
  }
  var port = CLIENT_PREFETCH_PORT;
  var xml  = buildInitRoleDbTaskXml(INIT_ROLEDB_TEMPLATE, port);
  if(xml === ""){ onDone("invalid port '" + port + "'"); return; }

  var ids      = findInitRoleDbTaskIds();
  var targetId = ids.length > 0 ? ids[0] : null;
  var others   = ids.slice(1);
  var site     = encodeURIComponent(PORTAL_CONFIG.siteName);

  var handle = function(e, s, b){
    if(s === 200 || s === 201){
      var bodyText = (typeof b !== "undefined" && b !== null) ? String(b) : "";
      onDone(null, { taskId: targetId || parseCreatedId(bodyText), created: !targetId, port: port, others: others });
    } else {
      onDone("status=" + s + " " + (e || ""));
    }
  };
  if(targetId){
    API.Put("task/custom/" + site + "/" + targetId, xml, handle);
  } else {
    API.Post("tasks/custom/" + site, xml, handle);
  }
}

function onPublishInitRoleDbClick(){
  var resultEl = document.getElementById("initRoleDbResult");
  var errEl    = document.getElementById("initRoleDbErr");
  var btn      = document.getElementById("initRoleDbBtn");
  if(resultEl){ resultEl.style.display = "none"; resultEl.innerHTML = ""; }
  if(errEl){ errEl.style.display = "none"; errEl.innerHTML = ""; }
  if(btn){ btn.disabled = true; }
  setStatus("Publishing Init RoleDB task...");
  publishInitRoleDbTask(function(err, r){
    if(btn){ btn.disabled = false; }
    if(err){
      setStatus("Init RoleDB publish failed.");
      if(errEl){ errEl.style.display = ""; errEl.innerHTML = htmlEscape("Publish failed: " + err); }
      return;
    }
    setStatus("Init RoleDB task published.");
    var msg = (r.created ? "Created" : "Updated") + " task " + (r.taskId || "(unknown)") +
      " in \"" + PORTAL_CONFIG.siteName + "\" with prefetch port " + r.port +
      ". Deploy it to Windows endpoints from the console.";
    if(r.others && r.others.length){
      msg += " Older copies left untouched (consider deleting): " + r.others.join(", ") + ".";
    }
    if(resultEl){ resultEl.style.display = ""; resultEl.innerHTML = htmlEscape(msg); }
  });
}

// updateInitRoleDbUI() -- shows the resolved port and where it came from.
function updateInitRoleDbUI(){
  var info = document.getElementById("prefetchPortInfo");
  if(!info){ return; }
  var srcText = { masthead: "from the masthead", analysis: "from the Repository Cache Analysis", "default": "UNVERIFIED default -- publish disabled" };
  info.innerHTML = "Root server prefetch port: <code>" + htmlEscape(CLIENT_PREFETCH_PORT) + "</code> (" +
    htmlEscape(srcText[CLIENT_PREFETCH_PORT_SOURCE] || CLIENT_PREFETCH_PORT_SOURCE) + ")";
  var btn = document.getElementById("initRoleDbBtn");
  if(btn){ btn.disabled = (CLIENT_PREFETCH_PORT_SOURCE === "default"); }
}

// ASSIGN_ROLE_TEMPLATE -- Task 2. Literal mirror of every field named in this
// plan's <interfaces> from bes/Assign-RoleMapping.bes, extracted programmatically
// (never hand-typed) via the same regex-extraction discipline as
// ROLE_PUBLISH_SCRIPT_LINES/ASSIGN_ROLE_MAPPING_SCRIPT_LINES above. __ROLE__ and
// __ASSIGNED_BY__ tokens are left unsubstituted for ensureRoleTask to fill in.
//
// DEVIATION FROM THIS PLAN'S ORIGINAL TEXT (see 07-07-SUMMARY.md): the plan's
// <interfaces>/acceptance criteria assumed the real template's ActionScript
// contains a literal __USERNAME__ placeholder token that must survive
// unsubstituted. bes/Assign-RoleMapping.bes (grep-verified, byte-for-byte
// extraction below) has NO such token anywhere in its ActionScript -- user
// identity is resolved entirely by BigFix client relevance (parameter "UserName"=
// "{name of current user as lowercase}", evaluated on each endpoint when the
// action runs), never baked in as a literal by this generator or by any
// token-substitution pass. This is a strictly SAFER property than the token the
// plan assumed (there is no placeholder to ever accidentally leave substituted
// with a fixed username -- T-07-07-05's mitigation holds trivially, by
// construction, because the identity expression is never touched by .replace()
// at all). Tests assert `{name of current user as lowercase}` -- not
// `__USERNAME__` -- remains present and untouched in the emitted Task XML.
var ASSIGN_ROLE_TEMPLATE = {
  title: "Assign Role Mapping — Operator Role Group (__ROLE__)",
  description: "<P>Endpoint task for the <B>Operator-Role-Group</B> assignment model. It ensures a named\n" +
    "user exists in the local <CODE>RoleAwareness.db</CODE> <CODE>Users</CODE> table and upserts a\n" +
    "<CODE>UserID -&gt; Role</CODE> row into the <CODE>Map</CODE> table.</P>\n" +
    "\n" +
    "<H3>How it is used</H3>\n" +
    "<OL>\n" +
    "<LI>An automatic Computer Group is created per role. Its membership relevance carries the list\n" +
    "of operator usernames that hold the role and admits a device only when <B>exactly one</B> logged-on\n" +
    "user is in that list.</LI>\n" +
    "<LI>One <B>policy action</B> from this task is targeted at that group, with reapplication enabled\n" +
    "(e.g. reapply while relevant, every 1 day) so a host where nobody logs off still re-maps.</LI>\n" +
    "<LI>The ActionScript resolves the single matching user from client relevance and passes it as\n" +
    "<CODE>-UserName</CODE>. The script trusts its inputs &mdash; it does no logged-on-user parsing of its own.</LI>\n" +
    "<LI>The upsert uses the D-12 discipline &mdash; INSERT OR IGNORE plus a conditional UPDATE guarded by\n" +
    "<CODE>Locked_by_Override = 0</CODE> &mdash; and stamps <CODE>Assigned_By</CODE> with the issuing operator.</LI>\n" +
    "</OL>\n" +
    "\n" +
    "<H3>Token substitution (per role)</H3>\n" +
    "<P>Like <CODE>bes/RoleRef-Policy-template.bes</CODE>, this file is a template. The group/action\n" +
    "generator replaces these tokens before PUT/POST:</P>\n" +
    "<UL>\n" +
    "<LI><CODE>__ROLE__</CODE> &mdash; the role name, e.g. <CODE>IT Operations</CODE></LI>\n" +
    "<LI><CODE>__USERNAME__</CODE> &mdash; the single user to map (bare sAMAccountName). Typically substituted\n" +
    "from client relevance in the ActionScript rather than baked in &mdash; see the parameter line below.</LI>\n" +
    "<LI><CODE>__ASSIGNED_BY__</CODE> &mdash; the operator who issued the task.</LI>\n" +
    "<LI><CODE>__REGION__</CODE> &mdash; (D-17) the optional region name baked into this role's regional\n" +
    "Computer Group, e.g. <CODE>Europe</CODE>, or an empty string for the default/no-region group. Written\n" +
    "through to <CODE>Map.Region</CODE> so it can surface in the dashboard's Region column &mdash; never\n" +
    "derived from the endpoint's own client settings.</LI>\n" +
    "<LI><CODE>__PREFETCH_PORT__</CODE> &mdash; the root server's REST/relay port the prefetch URL below\n" +
    "connects to over <CODE>127.0.0.1</CODE>. Resolved once at dashboard load from the root-server-only\n" +
    "\"Dereso SWD Repository Cache\" Analysis's \"Client Prefetch Port\" property (see\n" +
    "loadClientPrefetchPort()) and baked in as a plain literal &mdash; never left for each endpoint to\n" +
    "derive for itself via client relevance, which is unreliable (the registry keys it would need only\n" +
    "exist on the root server/relay, not on an ordinary endpoint).</LI>\n" +
    "</UL>\n" +
    "\n" +
    "<H3>Prerequisites</H3>\n" +
    "<P>The endpoint must already have been initialised by the &quot;Init  Current User and UserRole DB&quot;\n" +
    "task (787): <CODE>RoleAwareness.db</CODE>, <CODE>Sqlite-Helper.ps1</CODE> and <CODE>sqlite3.exe</CODE> in place. The\n" +
    "&lt;Relevance&gt; below gates on all three. <CODE>scripts/Assign-RoleMapping.ps1</CODE> must be staged in the\n" +
    "Custom Repository at <CODE>Uploads/CustomRepository/SoftwarePortal/rolegroups/</CODE> and the prefetch\n" +
    "<CODE>sha1:</CODE>/<CODE>size:</CODE> re-pinned whenever that script changes.</P>\n" +
    "\n" +
    "<H3>Scope / revoke</H3>\n" +
    "<P>v1 maps on single-user devices only (enforced by the Computer Group relevance). There is no\n" +
    "revoke &mdash; loss of the operator role removes the device from the group, the policy action stops\n" +
    "applying, and the row lapses at <CODE>Valid_to</CODE> (age-out).</P>",
  relevances: [
    "windows of operating system",
    "number of logged on users = 1",
    "(exists file (it & \"\\EC\\SoftwarePortal\\RoleAwareness.db\") AND exists file (it & \"\\EC\\SoftwarePortal\\Sqlite-Helper.ps1\") AND exists file (it & \"\\EC\\sqlite\\sqlite3.exe\")) of (pathname of parent folder of parent folder of client folder of site \"actionsite\")"
  ],
  category: "",
  source: "Internal",
  sourceId: "",
  sourceReleaseDate: "2026-09-09",
  sourceSeverity: "",
  cveNames: "",
  sansId: "",
  mimeFields: [
    { name: "x-fixlet-modification-time", value: "Wed, 09 Sep 2026 00:00:00 +0000" }
  ],
  domain: "BESC",
  actionDescription: {
    preLink: "Click ",
    link: "here",
    postLink: " to map role \"__ROLE__\" to the target user."
  },
  actionScript: "begin prefetch block\n" +
    "\u0009add prefetch item name=Assign-RoleMapping.ps1 sha1=eeeae841d9cc88d411c0b935af890f2b4f3a9aad size=9674 url=http://127.0.0.1:__PREFETCH_PORT__/Uploads/CustomRepository/SoftwarePortal/rolegroups/Assign-RoleMapping.ps1 sha256=85d5c0700f7e10c127994e39ce8183c773d027a3fcf30c8eeb43bd3374ab782d\n" +
    "end prefetch block\n" +
    "\n" +
    "// Client-relevance substitutions -- NOT touched by any brace-escaping pass (script is\n" +
    "// prefetched, not createfile'd, so no { -> {{ escaping is needed anywhere in this action).\n" +
    "\u0009parameter \"SWPDir\"=\"{(concatenation (if windows of operating system then \"\\\" else \"/\") of ((item 0 of it;item 1 of it;item 2 of it) of ((pathname of parent folder of parent folder of client folder of site \"actionsite\") as string,\"EC\",\"SoftwarePortal\")))}\"\n" +
    "\u0009parameter \"SQLiteDir\"=\"{(concatenation (if windows of operating system then \"\\\" else \"/\") of ((item 0 of it;item 1 of it;item 2 of it) of ((pathname of parent folder of parent folder of client folder of site \"actionsite\") as string,\"EC\",\"sqlite\")))}\"\n" +
    "\u0009parameter \"TargetStore\"=\"{(concatenation (if windows of operating system then \"\\\" else \"/\") of ((item 0 of it;item 1 of it;item 2 of it;item 3 of it) of ((pathname of parent folder of parent folder of client folder of site \"actionsite\") as string,\"EC\",\"SoftwarePortal\",\"RoleAwareness.db\")))}\"\n" +
    "\n" +
    "// Inputs. Role and Assigned_By are per-action tokens. UserName is the single logged-on\n" +
    "// user. \"name of current user\" was tried first and found to error on several live\n" +
    "// endpoints (DC01/GPBFS/PROXDEV11 and others) -- that inspector depends on session/\n" +
    "// console-ownership state and can be unresolvable even when exactly one user is\n" +
    "// logged on. \"concatenation of (names of logged on users)\" never errors: it collapses\n" +
    "// to the single username when there's exactly one (the only case the Computer Group's\n" +
    "// own membership relevance is designed to admit -- reinforced by the \"number of logged\n" +
    "// on users = 1\" gate above) and to an empty string if there are zero, which\n" +
    "// Assign-RoleMapping.ps1 already handles as a clean [ABORT] rather than a crash.\n" +
    "\u0009parameter \"Role\"=\"__ROLE__\"\n" +
    "\u0009parameter \"AssignedBy\"=\"__ASSIGNED_BY__\"\n" +
    "\u0009parameter \"Region\"=\"__REGION__\"\n" +
    "\u0009parameter \"UserName\"=\"{concatenation \"\" of (names of logged on users as lowercase)}\"\n" +
    "\n" +
    "// Land the endpoint script next to RoleAwareness.db.\n" +
    "\u0009if {not exists folder ((parameter \"SWPDir\") & \"\\rolegroups\")}\n" +
    "\u0009\u0009runhidden cmd /c mkdir \"{parameter \"SWPDir\"}\\rolegroups\"\n" +
    "\u0009endif\n" +
    "\u0009delete \"{parameter \"SWPDir\"}\\rolegroups\\Assign-RoleMapping.ps1\"\n" +
    "\u0009copy \"__Download\\Assign-RoleMapping.ps1\" \"{parameter \"SWPDir\"}\\rolegroups\\Assign-RoleMapping.ps1\"\n" +
    "\n" +
    "\u0009action uses wow64 redirection {x64 of operating system}\n" +
    "\u0009waithidden powershell.exe -NonInteractive -NoProfile -ExecutionPolicy Bypass -File \"{parameter \"SWPDir\"}\\rolegroups\\Assign-RoleMapping.ps1\" -Role \"{parameter \"Role\"}\" -UserName \"{parameter \"UserName\"}\" -AssignedBy \"{parameter \"AssignedBy\"}\" -Region \"{parameter \"Region\"}\" -SQLDir \"{parameter \"SQLiteDir\"}\" -DatabasePath \"{parameter \"TargetStore\"}\" -SqliteHelperPath \"{parameter \"SWPDir\"}\\Sqlite-Helper.ps1\"\n" +
    ""
};

// parseCreatedId(body) -- verbatim from fixlet_copier.ojo / fixlet_console.ojo /
// fixlet_update_tracker.ojo. Distinct from parseActionId (which hunts for an
// <Action> element and is the wrong parser for a Task/Fixlet creation response)
// -- added here (Rule 3 fix: the plan text named parseActionId for this step,
// which is a blocking bug against this codebase's own established convention --
// see 07-07-SUMMARY.md Deviations) because ensureRoleTask's POST-create path
// needs the new Task's <ID>/Resource, not an Action ID.
function parseCreatedId(body){
  var xml, nodes, txt, m;
  if(!body){ return ""; }

  try{
    xml = new ActiveXObject("Msxml2.DOMDocument.6.0");
    xml.async = false;
    xml.loadXML(body);

    nodes = xml.getElementsByTagName("Fixlet");
    if(nodes.length>0){
      txt = nodes[0].getAttribute("ID");
      if(txt && txt !== ""){ return txt; }
      txt = nodes[0].getAttribute("Resource");
      if(txt && txt !== ""){
        m = /\/([^\/]+)$/.exec(txt);
        if(m && m[1]){ return m[1]; }
      }
    }

    nodes = xml.getElementsByTagName("Task");
    if(nodes.length>0){
      txt = nodes[0].getAttribute("ID");
      if(txt && txt !== ""){ return txt; }
      txt = nodes[0].getAttribute("Resource");
      if(txt && txt !== ""){
        m = /\/([^\/]+)$/.exec(txt);
        if(m && m[1]){ return m[1]; }
      }
    }
  } catch(ex) {}

  m = /fixlet\/(?:custom|operator|external|master)\/[^\/]+\/(\d+)/i.exec(body);
  if(m && m[1]){ return m[1]; }
  m = /task\/(?:custom|operator|external|master)\/[^\/]+\/(\d+)/i.exec(body);
  if(m && m[1]){ return m[1]; }
  m = /\bID=["']?(\d+)["']?/i.exec(body);
  if(m && m[1]){ return m[1]; }

  return "";
}

// ensureRoleTask(role, region, onDone) -- Task 2, Pattern 3 step 1 find-or-create.
// Builds a from-scratch Task document via buildRolePolicyTaskXml (never
// fetches and mutates an existing Task's XML -- T-07-07-04), POSTs plural on
// create, PUTs singular on update -- re-PUT unconditionally on every Publish so
// __ASSIGNED_BY__ always reflects the current publisher (T-07-07-06), which is
// also idempotent. onDone(err, { taskId, taskFields, actionScript, relevance })
// -- plan 07-08's action deploy consumes actionScript/relevance directly, with
// no re-fetch/re-parse of the Task.
function ensureRoleTask(role, region, onDone){
  var assignedBy = getAssignedBy();
  var title      = taskTitleFor(role, region);
  var xml        = buildRolePolicyTaskXml(ASSIGN_ROLE_TEMPLATE, role, assignedBy, region);

  var existingId = null;
  try { existingId = findBesObjectIdByTitle("task", PORTAL_CONFIG.siteName, title); } catch(ex){ existingId = null; }

  var relParts = [];
  var ri;
  for(ri = 0; ri < ASSIGN_ROLE_TEMPLATE.relevances.length; ri++){
    relParts.push(String(ASSIGN_ROLE_TEMPLATE.relevances[ri])
      .replace(/__ROLE__/g, role)
      .replace(/__ASSIGNED_BY__/g, assignedBy)
      .replace(/__REGION__/g, sanitizeRegion(region)));
  }
  var relevance = (relParts.length > 1) ? ("(" + relParts.join(") AND (") + ")") : (relParts[0] || "");

  var actionScript = String(ASSIGN_ROLE_TEMPLATE.actionScript)
    .replace(/__ROLE__/g, role)
    .replace(/__ASSIGNED_BY__/g, assignedBy)
    .replace(/__REGION__/g, sanitizeRegion(region))
    .replace(/__PREFETCH_PORT__/g, CLIENT_PREFETCH_PORT);

  function handleResponse(e, s, b){
    if(s === 200 || s === 201){
      var bodyText = (typeof b !== "undefined" && b !== null) ? String(b) : "";
      var taskId   = existingId || parseCreatedId(bodyText);
      if(onDone){
        onDone(null, { taskId: taskId, taskFields: ASSIGN_ROLE_TEMPLATE, actionScript: actionScript, relevance: relevance });
      }
    } else {
      var msg   = "Task step failed: status=" + s + " -- " + (e || "");
      var errEl = document.getElementById("roleErr_" + roleSlug(role));
      if(errEl){
        errEl.style.display = "";
        errEl.innerHTML = htmlEscape(msg);
      }
      if(onDone){ onDone(msg); }
    }
  }

  if(existingId){
    API.Put("task/custom/" + encodeURIComponent(PORTAL_CONFIG.siteName) + "/" + existingId, xml, handleResponse);
  } else {
    API.Post("tasks/custom/" + encodeURIComponent(PORTAL_CONFIG.siteName), xml, handleResponse);
  }
}

// ==========================================================================
// PUBLISH (07-08). D-13 step two: the per-role Publish button. Sequenced
// least-disruptive-first per RESEARCH Pitfall 4/7 -- Group, then Task, then
// Action, then Stop-previous (this plan's <objective> explains why). Every
// step's outcome is recorded in publishState[role].stepStatus AND surfaced
// inline in the role's own resultEl/errEl -- never a popup dialog.
//
// Per-role isolation is the property that matters most in this whole
// section: every function here reads/writes only roleState[role] and
// publishState[role], and every REST call carries a title derived from that
// one role, so publishing one role can never disturb another's live
// Group/Task/action.
// ==========================================================================

// publishState: one entry per role (lazily created by ensurePublishState).
// Plan 07-09's Analysis tab compares intent (roleState) against reality
// (publishState) using this.
var publishState = {};

// D-17: keyed by (role, region) now, not role alone -- a role can have
// several concurrent regional groups, each with its own independent
// Group/Task/Action publish state.
function ensurePublishState(role, region){
  var key = role + "\u0001" + sanitizeRegion(region);
  if(!publishState[key]){
    publishState[key] = {
      groupId: null, taskId: null, actionId: null,
      lastPublishedOn: null, lastError: null,
      stepStatus: { group: "", task: "", action: "", stop: "" }
    };
  }
  return publishState[key];
}

// parseComputerGroupId(body) -- Task 1. Adapted from parseActionId's
// three-fallback approach (DOM element lookup, then a URL-shaped regex, then
// a bare <ID> element regex) for a ComputerGroup creation/update response.
function parseComputerGroupId(body){
  if(!body){ return ""; }
  try {
    var xml = parseXml(body);
    var nodes = xml.getElementsByTagName("ComputerGroup");
    if(nodes.length > 0){
      var idNode = nodes[0].selectSingleNode("ID");
      if(idNode && idNode.text){ return idNode.text; }
      var idAttr = nodes[0].getAttribute("ID");
      if(idAttr){ return idAttr; }
    }
  } catch(ex) {}
  var m = /\/api\/computergroup\/(?:custom|operator|external|master)\/[^\/]+\/(\d+)/i.exec(String(body));
  if(m && m[1]){ return m[1]; }
  m = /<ID>(\d+)<\/ID>/i.exec(String(body));
  return (m && m[1]) ? m[1] : "";
}

// ensureRoleGroup(role, region, onDone) -- Task 1, Pattern 1 find-or-create. The
// relevance is regenerated from the CURRENT username list on every call --
// never a cached/stale copy. T-07-08-01's guard against an unconstrained
// match lives entirely inside buildRoleGroupRelevance's own "false" branch
// (plan 07-04) -- not re-implemented or special-cased here; this function
// only records a distinct step-status note when that guard is the reason.
function ensureRoleGroup(role, region, onDone){
  var slug     = roleSlug(role);
  var errEl    = document.getElementById("roleErr_" + slug);
  var resultEl = document.getElementById("roleResult_" + slug);
  var ps       = ensurePublishState(role, region);

  var title     = groupTitleFor(role, region);
  var users     = getRoleUsers(role);
  var relevance = buildRoleGroupRelevance(users);
  var xml       = buildComputerGroupXml(title, "BESC", relevance);

  var groupId = null;
  try { groupId = findBesObjectIdByTitle("computergroup", PORTAL_CONFIG.siteName, title); } catch(ex){ groupId = null; }

  function handleResponse(e, s, b){
    if(s === 200 || s === 201){
      var bodyText = (typeof b !== "undefined" && b !== null) ? String(b) : "";
      var newId    = groupId || parseComputerGroupId(bodyText);
      ps.groupId   = newId;
      // Distinct note so the UI can say "0 users -- group will match no
      // computers" rather than looking like a bug (this plan's own action text).
      var note = (relevance === "false") ? " (0 users -- group will match no computers)" : "";
      ps.stepStatus.group = "Group OK (id " + newId + ")" + note;
      if(resultEl){
        resultEl.style.display = "";
        resultEl.innerHTML = htmlEscape(ps.stepStatus.group);
      }
      if(onDone){ onDone(null, newId); }
    } else {
      // A 400/404 here almost always means a malformed body or the wrong
      // site segment (plural "computergroups" on create vs. singular
      // "computergroup" on update) -- not a REST API limitation
      // (RESEARCH Pitfall 1).
      var msg = "Group step failed: status=" + s + " -- " + (e || "");
      ps.stepStatus.group = "FAILED: " + msg;
      if(errEl){
        errEl.style.display = "";
        errEl.innerHTML = htmlEscape("[1/4 Group] " + msg);
      }
      if(onDone){ onDone(msg); }
    }
  }

  if(groupId){
    API.Put("computergroup/custom/" + encodeURIComponent(PORTAL_CONFIG.siteName) + "/" + groupId, xml, handleResponse);
  } else {
    API.Post("computergroups/custom/" + encodeURIComponent(PORTAL_CONFIG.siteName), xml, handleResponse);
  }
}

// deployRolePolicyAction(role, region, groupId, taskResult, onDone) -- Task 2 step
// [3/4]. Deploys the SingleAction built by buildRolePolicyActionXml (never
// inline XML here) against the role's Computer Group, consuming
// taskResult.relevance/taskResult.actionScript directly from ensureRoleTask
// (07-07) -- already fully __ROLE__/__ASSIGNED_BY__-substituted, no
// re-fetch/re-parse of the Task.
function deployRolePolicyAction(role, region, groupId, taskResult, onDone){
  var title = actionTitleFor(role, region);
  var xml   = buildRolePolicyActionXml(title, taskResult.relevance, taskResult.actionScript, groupId, PORTAL_CONFIG.siteName, role, region);

  API.Post("actions", xml, function(e, s, b){
    if(s === 200 || s === 201){
      var bodyText = (typeof b !== "undefined" && b !== null) ? String(b) : "";
      if(onDone){ onDone(null, parseActionId(bodyText)); }
    } else {
      if(onDone){ onDone("Action step failed: status=" + s + " -- " + (e || "")); }
    }
  });
}

// findOpenActionIdsByTitle(title) -- plural variant of findBesObjectIdByTitle
// for the "action" kind: returns EVERY Open action id whose title matches
// EXACTLY (not a prefix/substring match), so stopPreviousRoleActions can
// find and stop every stale one without ever touching an unrelated role's
// action (T-07-08-06).
function findOpenActionIdsByTitle(title){
  var safeSite  = String(PORTAL_CONFIG.siteName || "").replace(/"/g, '""');
  var safeTitle = String(title || "").replace(/"/g, '""');
  var rel = '(id of it as string) of bes actions whose (name of site of it = "' +
    safeSite + '" and name of it = "' + safeTitle + '" and state of it = "Open")';
  try {
    var data = EvaluateRelevance(rel);
    if(data && data.length > 0){
      var out = [];
      var i;
      for(i = 0; i < data.length; i++){
        if(data[i] !== ""){ out.push(String(data[i])); }
      }
      return out;
    }
  } catch(ex) {}
  return [];
}

// stopPreviousRoleActions(role, region, exceptActionId, onDone) -- Task 2 step
// [4/4]. Stops every OTHER Open action matching this role's exact title.
// A failure to stop one action is recorded as a leftover warning, NEVER as a
// Publish failure -- the new action is already live and the stale one is
// idempotent (T-07-08-05, RESEARCH Pitfall 7's create-new-then-stop-old
// ordering). onDone(err, stoppedIds[], leftoverIds[]) -- err is always null;
// per-id failures surface via leftoverIds instead.
function stopPreviousRoleActions(role, region, exceptActionId, onDone){
  var title  = actionTitleFor(role, region);
  var ids    = findOpenActionIdsByTitle(title);
  var toStop = [];
  var i;
  for(i = 0; i < ids.length; i++){
    if(String(ids[i]) !== String(exceptActionId)){ toStop.push(ids[i]); }
  }

  if(toStop.length === 0){
    if(onDone){ onDone(null, [], []); }
    return;
  }

  var stopped  = [];
  var leftover = [];
  var pending  = toStop.length;

  function oneDone(){
    pending--;
    if(pending <= 0){
      if(onDone){ onDone(null, stopped, leftover); }
    }
  }

  var j;
  for(j = 0; j < toStop.length; j++){
    (function(actionId){
      API.Post("action/" + actionId + "/stop", "", function(e, s, b){
        if(s === 200 || s === 201){
          stopped.push(actionId);
        } else {
          leftover.push(actionId);
        }
        oneDone();
      });
    })(toStop[j]);
  }
}

// publishRole(role) -- the D-13 step-two orchestration, replacing the
// plan-07-06 Publish-button stub. Steps run SEQUENTIALLY via nested
// callbacks (IE9 predates the newer JS asynchronous-flow keywords):
// Group -> Task -> Action -> Stop, each one's success/failure surfaced
// separately with its own [n/4 Name] label, per RESEARCH Pitfall 4/7 (see
// this plan's <objective> for the ordering rationale). No popup dialogs
// anywhere.
//
// Per-role isolation invariant: this function reads and writes only
// roleState[role] and publishState[role], and every REST call it triggers
// (directly or via the step functions above) carries a title derived from
// that one role -- publishing one role can never touch another's live
// Group/Task/action.
// publishRole(role, onDone) -- onDone is optional (onPublishRoleClick never
// passes it); when given, it's called onDone(err) at every exit point so an
// orchestrating caller (D-21: revokeUsernameFromRole's auto-Publish) can
// detect completion without polling the DOM.
function publishRole(role, onDone){
  var slug     = roleSlug(role);
  var errEl    = document.getElementById("roleErr_" + slug);
  var resultEl = document.getElementById("roleResult_" + slug);
  var saveBtn  = document.getElementById("saveRole_" + slug);
  var pubBtn   = document.getElementById("publishRole_" + slug);
  var st       = roleState[role];
  if(!st){ if(onDone){ onDone("role not found"); } return; }
  var region = st.selectedRegion;
  var bucket = st.regions[region];
  if(!bucket){ if(onDone){ onDone("region bucket not found"); } return; }
  var regionLabel = region ? (" (" + region + ")") : "";

  if(errEl){ errEl.style.display = "none"; errEl.innerHTML = ""; }
  if(resultEl){ resultEl.style.display = "none"; resultEl.innerHTML = ""; }
  if(saveBtn){ saveBtn.disabled = true; }
  if(pubBtn){ pubBtn.disabled = true; }

  var ps = ensurePublishState(role, region);
  ps.stepStatus = { group: "", task: "", action: "", stop: "" };
  ps.lastError  = null;

  function reenable(){
    if(saveBtn){ saveBtn.disabled = false; }
    if(pubBtn){ pubBtn.disabled = false; }
  }

  function stepFailed(stepKey, label, msg, extraNote){
    ps.stepStatus[stepKey] = "FAILED: " + msg;
    ps.lastError = label + " " + msg;
    if(errEl){
      errEl.style.display = "";
      errEl.innerHTML = htmlEscape(label + " FAILED: " + msg + (extraNote ? (" -- " + extraNote) : ""));
    }
    setStatus("Publish failed for " + role + regionLabel + ".");
    reenable();
    if(onDone){ onDone(label + " " + msg); }
  }

  // D-13 two-step contract: Publish must never run against unsaved edits --
  // the audit store must record the membership that is about to go live
  // (NFR-03) before anything is deployed. This is not an error state, it is
  // the documented contract -- surfaced inline, never a popup.
  if(bucket.dirty){
    if(errEl){
      errEl.style.display = "";
      errEl.innerHTML = htmlEscape("Unsaved changes -- click Save first. Publish always applies the last-saved snapshot, never in-progress edits.");
    }
    reenable();
    if(onDone){ onDone("unsaved changes"); }
    return;
  }

  setStatus("Publishing " + role + regionLabel + " -- [1/4 Group]...");

  ensureRoleGroup(role, region, function(groupErr, groupId){
    if(groupErr){
      stepFailed("group", "[1/4 Group]", groupErr, "Task and action are unchanged");
      return;
    }
    bucket.groupId = groupId;

    setStatus("Publishing " + role + regionLabel + " -- [2/4 Task]...");
    ensureRoleTask(role, region, function(taskErr, taskResult){
      if(taskErr){
        stepFailed("task", "[2/4 Task]", taskErr, "group is now updated but the Task is stale");
        return;
      }
      ps.taskId = taskResult.taskId;
      ps.stepStatus.task = "Task OK (id " + taskResult.taskId + ")";

      setStatus("Publishing " + role + regionLabel + " -- [3/4 Action]...");
      deployRolePolicyAction(role, region, groupId, taskResult, function(actionErr, actionId){
        if(actionErr){
          stepFailed("action", "[3/4 Action]", actionErr, "group and Task are updated but the previous action is still the live one");
          return;
        }
        ps.actionId = actionId;
        ps.stepStatus.action = "Action OK (id " + actionId + ")";

        setStatus("Publishing " + role + regionLabel + " -- [4/4 Stop]...");
        stopPreviousRoleActions(role, region, actionId, function(stopErr, stoppedIds, leftoverIds){
          stoppedIds  = stoppedIds || [];
          leftoverIds = leftoverIds || [];
          if(leftoverIds.length > 0){
            ps.stepStatus.stop = "[4/4 Stop] WARNING: stopped " + stoppedIds.length + ", could not stop: " + leftoverIds.join(", ");
          } else {
            ps.stepStatus.stop = "[4/4 Stop] Stopped " + stoppedIds.length + " previous action(s)";
          }

          ps.lastPublishedOn = new Date().toISOString();
          ps.lastError = null;
          setStatus("Published " + role + regionLabel + ".");
          if(resultEl){
            resultEl.style.display = "";
            var summary = "Published " + role + regionLabel + ": group " + groupId + ", task " + taskResult.taskId +
              ", action " + actionId + ", stopped " + stoppedIds.length + " previous action(s).";
            if(leftoverIds.length > 0){
              summary += " WARNING: could not stop action(s) " + leftoverIds.join(", ") + " -- stop manually.";
            }
            resultEl.innerHTML = htmlEscape(summary);
          }
          reenable();
          if(onDone){ onDone(null); }
        });
      });
    });
  });
}

function onPublishRoleClick(slug){
  var role = roleBySlug[slug];
  if(role){ publishRole(role); }
}

// ==========================================================================
// ROLES TAB -- state, rendering, D-02 autocomplete, D-10 scope selector.
// Save (D-13 step 1) lands in the next block below; Publish is 07-07/07-08.
// ==========================================================================

// roleState: one entry per PORTAL_CONFIG.roles entry, initialised in
// initDashboard(). Plan 07-08's Publish flow reads getRoleUsers()/roleState.
var roleState = {};

// roleBySlug: reverse lookup from a DOM-safe roleSlug back to the real role
// name. Every inline onclick="...('slug')" attribute in this tab passes only
// a slug (guaranteed to match /^[A-Za-z0-9_]*$/, so it can never break out of
// the surrounding HTML attribute or JS string literal) -- never raw role or
// username text.
var roleBySlug = {};

// module-level cache of already-seen sAMAccountNames (D-02), populated once
// by loadKnownUsers() from initDashboard().
var knownUsers = [];

// module-level cache of every live BES computer group (D-10), populated once
// by loadAllComputerGroups() from initDashboard(). Shared read-only source
// list across every role panel's own search box + listbox -- ported from
// fixlet_console.ojo's targetGroupSelect pattern (loadGroups/filterGroups/
// renderGroupSelect), adapted for N independent per-role selectors instead of
// one dashboard-wide selector. Each entry: { id, name, siteName, groupType }.
var allGroups = [];

// roleSlug(role) -- deterministic, DOM-safe id fragment for a role name.
// Never build an element id (or an inline event-handler argument) by
// string-concatenating unescaped role text into innerHTML.
function roleSlug(role){
  return String(role).replace(/[^A-Za-z0-9]/g, "_");
}

// ensureRoleRegionBucket(role, region) -- find-or-create this role's
// in-memory per-identity bucket (D-17). Never clears an existing bucket's
// users/groupId/dirty state -- selecting a region you've already visited
// this session must not lose unsaved edits.
function ensureRoleRegionBucket(role, region){
  var st = roleState[role];
  if(!st){ return null; }
  if(!st.regions[region]){
    st.regions[region] = { users: [], dirty: false, groupId: null };
  }
  return st.regions[region];
}

// recomputeRoleUnionUsers(role) -- rebuilds roleState[role].users as the
// UNION of every region bucket's usernames. This is a DERIVED, read-only
// cache -- reconcileIntentVsActual/isUserConfiguredInRole read it so that a
// username configured under ANY of a role's regional identities still
// counts as "configured" fleet-wide, without those two functions needing to
// know anything about regions at all.
function recomputeRoleUnionUsers(role){
  var st = roleState[role];
  if(!st){ return; }
  var seen = {};
  var out  = [];
  var key, users, i;
  for(key in st.regions){
    if(!st.regions.hasOwnProperty(key)){ continue; }
    users = st.regions[key].users || [];
    for(i = 0; i < users.length; i++){
      if(!seen[users[i]]){ seen[users[i]] = true; out.push(users[i]); }
    }
  }
  st.users = out;
}

// getRoleUsers(role) -> string[] -- trimmed, lower-cased, de-duplicated
// usernames of the role's CURRENTLY SELECTED region identity (D-17).
function getRoleUsers(role){
  var st = roleState[role];
  if(!st){ return []; }
  var bucket = st.regions[st.selectedRegion];
  return bucket ? bucket.users.slice() : [];
}

// setRoleUsers(role, usernames) -- trims, lower-cases, drops empties and
// de-duplicates (case-insensitive) before storing against the role's
// CURRENTLY SELECTED region identity; marks that identity dirty and
// re-renders its panel. D-04: a username already present on another role (or
// another region of the SAME role) is untouched here -- each identity's list
// is independent. A duplicate within the same identity is a silent no-op.
function setRoleUsers(role, usernames){
  var st = roleState[role];
  if(!st){ return; }
  var bucket = ensureRoleRegionBucket(role, st.selectedRegion);
  if(!bucket){ return; }
  var seen = {};
  var out  = [];
  var i, u;
  for(i = 0; i < (usernames || []).length; i++){
    u = String(usernames[i]).toLowerCase().replace(/^\s+|\s+$/g, "");
    if(u === ""){ continue; }
    if(seen[u]){ continue; }
    seen[u] = true;
    out.push(u);
  }
  bucket.users = out;
  bucket.dirty = true;
  recomputeRoleUnionUsers(role);
  renderRolePanel(role);
}

// loadKnownUsers() -- runs once from initDashboard(). Reads the Analysis
// property named by PORTAL_CONFIG.props.knownUsers (SELECT userid from the
// endpoint's users table, one row per reporting computer; each row may
// itself carry multiple usernames as a tuple/comma list). On any failure or
// empty result, caches [] and renderRolePanel() shows the established
// "Analysis not reporting yet" hint -- freeform entry (D-02) still works
// either way.
function loadKnownUsers(){
  var raw = getRelevanceSafe('(value of it as string) of results whose (value of it != "") of bes property whose (name of it = "' + PORTAL_CONFIG.props.knownUsers + '")');
  var seen = {};
  var out  = [];
  var i, j, row, parts, p;
  for(i = 0; i < raw.length; i++){
    row = String(raw[i]);
    // The Analysis property emits its per-computer result as either a
    // %22-quoted tuple string ("alice","bob") or a plain comma list
    // (alice,bob) -- strip quoting, then split on comma. The value arrives
    // with literal " characters (%22 is only how relevance SOURCE writes a
    // quote); stripping %22 too is harmless.
    parts = row.replace(/"|%22/g, "").split(",");
    for(j = 0; j < parts.length; j++){
      p = String(parts[j]).toLowerCase().replace(/^\s+|\s+$/g, "");
      if(p === ""){ continue; }
      if(seen[p]){ continue; }
      seen[p] = true;
      out.push(p);
    }
  }
  knownUsers = out;
}

// loadSavedRoleState() -- fills each role's username list from the last
// Saved/Published snapshot in the root server's RolePublish.db, via the
// "Saved Roles" Analysis property (PORTAL_CONFIG.props.rolePublish).
// That property moved 2026-10-21 from the fleet-wide "Dereso SWD" Analysis
// to its own root-server-only Analysis, Dashboard_4_samples/"Dereso SWD
// Role Publication.bes" (same reasoning as "Dereso SWD Repository Cache" --
// RolePublish.db never exists anywhere but the root server) -- the query
// below is unaffected since it finds the property by name, not by Analysis.
// Without this, roleState[role].users only ever
// reflects what's been typed into the Roles tab in the CURRENT browser
// session -- every previously-saved role looked permanently empty on a
// fresh page load, which is also why the Analysis tab's reconciliation
// showed every real mapping as "mapped but not configured" (D-16).
//
// Scoped to the root server's own computer ID (rootServerComputerId) --
// RolePublish.db is a root-server-only file (written by a ComputerID-
// targeted action, see buildAuditWriteActionScript), so no other reporting
// computer will ever have a result for this property.
//
// Deliberately does NOT go through setRoleUsers()/renderRolePanel()'s
// dirty-marking path: this is loading an already-saved snapshot, not an
// in-progress edit, and Publish refuses to run while dirty ("click Save
// first"). Marking a freshly-loaded, unedited state as dirty would block
// Publish immediately after every page load for no reason.
// readSavedRoleMembers() -> { role: { region: string[] } }, or null when the
// root server ID isn't configured. Reads the "Saved Roles" property: the
// latest RolePublishRun per (Role, Region) in RolePublish.db, with its
// RoleUsers rows. Shared by loadSavedRoleState (page open) and
// importSavedMembersForRole (Import button).
function readSavedRoleMembers(){
  if(!PORTAL_CONFIG.rootServerComputerId){ return null; }
  var rel = '(value of it as string) of results whose (value of it != "" and id of computer of it as string = "' +
    PORTAL_CONFIG.rootServerComputerId + '") of bes property whose (name of it = "' + PORTAL_CONFIG.props.rolePublish + '")';
  var raw = getRelevanceSafe(rel);
  // D-17: each entry is now a 3-field "Role, Region, UserID" tuple (Region
  // blank for the default/no-region identity) -- see "Dereso SWD Role
  // Publication.bes"'s "Saved Roles" property SQL.
  var usersByRole = {}; // usersByRole[role][region] = string[]
  var i, j, row, entries, entry, firstSep, secondSep, role, region, user;
  for(i = 0; i < raw.length; i++){
    // Live value is '"Role, Region, user"|"Role, Region, user"' with literal
    // " quotes -- %22 only appears in relevance source, never in the result.
    row = String(raw[i]).replace(/"|%22/g, "");
    entries = row.split("|");
    for(j = 0; j < entries.length; j++){
      entry = entries[j];
      if(entry === ""){ continue; }
      firstSep = entry.indexOf(", ");
      if(firstSep < 0){ continue; }
      role = entry.substring(0, firstSep);
      secondSep = entry.indexOf(", ", firstSep + 2);
      if(secondSep < 0){ continue; }
      region = entry.substring(firstSep + 2, secondSep);
      user   = entry.substring(secondSep + 2);
      if(!usersByRole[role]){ usersByRole[role] = {}; }
      if(!usersByRole[role][region]){ usersByRole[role][region] = []; }
      usersByRole[role][region].push(user);
    }
  }
  return usersByRole;
}

function loadSavedRoleState(){
  var usersByRole = readSavedRoleMembers();
  if(!usersByRole){ return; }
  var r, roleName, st, region2, bucket;
  for(r = 0; r < PORTAL_CONFIG.roles.length; r++){
    roleName = PORTAL_CONFIG.roles[r];
    st = roleState[roleName];
    if(!st || !usersByRole[roleName]){ continue; }
    for(region2 in usersByRole[roleName]){
      if(!usersByRole[roleName].hasOwnProperty(region2)){ continue; }
      bucket = ensureRoleRegionBucket(roleName, region2);
      bucket.users = usersByRole[roleName][region2].slice();
    }
    recomputeRoleUnionUsers(roleName);
    renderRolePanel(roleName);
  }
}

// CLIENT_PREFETCH_PORT -- the literal port number baked into every per-endpoint
// Task's prefetch URL (see ASSIGN_ROLE_TEMPLATE/__PREFETCH_PORT__ below). Was
// previously a client-relevance expression that tried to derive this port on
// each endpoint from registry keys that only exist on the box running the BES
// Root Server/relay components -- on an ordinary endpoint both candidates
// evaluated to "0" and it silently fell through to a hardcoded "52311" literal
// buried inside that same relevance clause, which happened to be right here but
// is wrong on any environment whose root server uses a different port (e.g. the
// admin's other environment, which runs 53311). Defaulting to "52311" below
// preserves that same fallback for this environment if the lookup below can't
// run yet (Analysis not activated) -- update this default if this dashboard is
// ever deployed somewhere that default is wrong.
var CLIENT_PREFETCH_PORT = "52311";

// loadClientPrefetchPort() -- resolves CLIENT_PREFETCH_PORT once at dashboard
// load from "Dereso SWD Repository Cache"'s "Client Prefetch Port" property
// (root-server-only Analysis -- see [[bigfix-root-server-only-analysis-pattern]]),
// the same registry key "Repository Root Path"/"Cached SHA1 Directories" already
// read reliably from that Analysis. Scoped to rootServerComputerId exactly like
// loadSavedRoleState() -- this property only ever has a result on that one
// computer. Leaves CLIENT_PREFETCH_PORT at its default (and leaves a status note)
// if the Analysis isn't activated yet or hasn't reported a numeric value.
//
// v2.11.0 (2026-11-17): the masthead's actionsite gather URL is now tried FIRST
// (session relevance, always available, no Analysis dependency -- same lookup as
// fixlet_console/dispatcher's getRootServerPort()). The Analysis property is the
// fallback, then the default. CLIENT_PREFETCH_PORT_SOURCE records which one won,
// so the Init RoleDB publish can refuse to bake in an unverified default.
var CLIENT_PREFETCH_PORT_SOURCE = "default";

// parsePortFromUrl(url) -> "53311" | "" -- pure, unit-tested.
function parsePortFromUrl(url){
  var m = /^[a-z]+:\/\/[^\/:]+:(\d+)(?:\/|$)/i.exec(String(url || "").replace(/^\s+|\s+$/g, ""));
  return m ? m[1] : "";
}

function loadClientPrefetchPort(){
  var urls = getRelevanceSafe('urls of bes sites whose (master site flag of it)');
  var i, p;
  for(i = 0; i < urls.length; i++){
    p = parsePortFromUrl(urls[i]);
    if(p){ CLIENT_PREFETCH_PORT = p; CLIENT_PREFETCH_PORT_SOURCE = "masthead"; return; }
  }
  if(PORTAL_CONFIG.rootServerComputerId){
    var rel = '(value of it as string) of results whose (value of it != "" and id of computer of it as string = "' +
      PORTAL_CONFIG.rootServerComputerId + '") of bes property whose (name of it = "Client Prefetch Port")';
    var raw = getRelevanceSafe(rel);
    var candidate = (raw && raw.length > 0) ? String(raw[0]).replace(/^\s+|\s+$/g, "") : "";
    if(/^\d+$/.test(candidate)){
      CLIENT_PREFETCH_PORT = candidate;
      CLIENT_PREFETCH_PORT_SOURCE = "analysis";
      return;
    }
  }
  setStatus("Root server port could not be read from the masthead or the Repository Cache Analysis -- using default " + CLIENT_PREFETCH_PORT + ".");
}

// suggestUsernames(prefix) -> string[] -- pure filter over the knownUsers
// cache. Up to 10 case-insensitive prefix matches, ordinal-sorted.
function suggestUsernames(prefix){
  var p = String(prefix || "").toLowerCase().replace(/^\s+|\s+$/g, "");
  if(p === ""){ return []; }
  var out = [];
  var i, u;
  for(i = 0; i < knownUsers.length; i++){
    u = String(knownUsers[i]).toLowerCase();
    if(u.indexOf(p) === 0){ out.push(u); }
  }
  out.sort();
  return out.slice(0, 10);
}

// renderRolesTab() -- builds the static per-role panel skeleton (every id
// derived from roleSlug) once, then renders each panel's dynamic content.
function renderRolesTab(){
  var container = document.getElementById("rolePanelsContainer");
  if(!container){ return; }
  var html = "";
  var i, role, slug;
  for(i = 0; i < PORTAL_CONFIG.roles.length; i++){
    role = PORTAL_CONFIG.roles[i];
    slug = roleSlug(role);
    if(roleCollapsed[slug] === undefined){ roleCollapsed[slug] = true; } // default: collapsed
    html += '<div class="panel"><div class="panelBody">';
    // Clickable header -- the arrow lives OUTSIDE the h2 because
    // renderRolePanel rewrites roleHeading_'s innerHTML on every render.
    html += '<div class="roleHeader" onclick="toggleRolePanel(\'' + slug + '\')" title="Click to collapse/expand">';
    html += '<span id="roleToggle_' + slug + '" class="roleToggle">' + (roleCollapsed[slug] ? '&#9654;' : '&#9660;') + '</span>';
    html += '<h2 id="roleHeading_' + slug + '" class="roleHeading">' + htmlEscape(role) + '</h2>';
    html += '</div>';
    html += '<div id="roleBody_' + slug + '" style="margin-top:10px;' + (roleCollapsed[slug] ? 'display:none;' : '') + '">';
    html += '<div style="margin-bottom:8px;">';
    html += '<span class="btn" onclick="onImportSavedMembersClick(\'' + slug + '\')">Import saved members</span>';
    html += ' <span class="small">Replaces the list below with the full saved membership for this exact role + region (latest Save in the root server\'s RolePublish.db, via the "Saved Roles" property -- refreshes every 5 minutes) -- review, then add/remove as needed before Save.</span>';
    html += '</div>';
    html += '<table class="tableGrid"><thead><tr><th>Username</th><th style="width:170px;"></th></tr></thead><tbody id="userTable_' + slug + '"></tbody></table>';
    html += '<table class="rowTable" style="margin-top:10px;"><tr>';
    html += '<td class="lbl">Add username</td>';
    html += '<td>';
    html += '<input type="text" class="txt" id="addUser_' + slug + '" onkeyup="onAddUserKeyup(\'' + slug + '\')" autocomplete="off">';
    html += ' <span class="btn" onclick="onAddUserClick(\'' + slug + '\')">Add</span>';
    html += '<div id="suggest_' + slug + '" class="panel" style="display:none;position:absolute;max-width:260px;padding:4px;z-index:10;"></div>';
    html += '<div id="knownUsersHint_' + slug + '" class="small warn" style="display:none;">Analysis not reporting yet -- freeform entry still works.</div>';
    html += '</td>';
    html += '</tr></table>';
    html += '<table class="rowTable"><tr>';
    html += '<td class="lbl">In-Scope Group (required)</td>';
    html += '<td>';
    html += '<select id="identitySelect_' + slug + '" onchange="onIdentitySelectChange(\'' + slug + '\')" style="width:380px;"></select>';
    html += '<div style="margin-top:6px;">';
    html += '<input type="text" class="txt" id="regionInput_' + slug + '" placeholder="New region, e.g. Europe (optional)" autocomplete="off">';
    html += ' <span class="btn" onclick="onNewRegionClick(\'' + slug + '\')">Use / Create</span>';
    html += '</div>';
    html += '<div id="groupStatus_' + slug + '" class="small" style="margin-top:4px;"></div>';
    html += '<div class="small">Every role identity is its own Computer Group, named &quot;DSP Role [Region] - ' + htmlEscape(role) + '&quot;, gated purely on logged-on username -- leave Region blank for the role&#39;s default (no-region) group.</div>';
    html += '</td>';
    html += '</tr></table>';
    html += '<div style="margin-top:12px;">';
    html += '<span class="btnGreen" id="saveRole_' + slug + '" onclick="onSaveRoleClick(\'' + slug + '\')">Save</span> ';
    html += '<span class="btn" id="publishRole_' + slug + '" onclick="onPublishRoleClick(\'' + slug + '\')">Publish</span>';
    html += '</div>';
    html += '<div id="roleStatus_' + slug + '" class="small" style="margin-top:6px;"></div>';
    html += '<div id="roleResult_' + slug + '" class="small" style="display:none;margin-top:4px;"></div>';
    html += '<div id="roleErr_' + slug + '" class="small warn" style="display:none;margin-top:4px;"></div>';
    html += '</div>'; // roleBody_
    html += '</div></div>';
  }
  if(PORTAL_CONFIG.roles.length > 1){
    html = '<div style="margin:0 0 8px 0;">' +
      '<span class="linkBtn" onclick="setAllRolePanelsCollapsed(false)">Expand all</span> &nbsp;|&nbsp; ' +
      '<span class="linkBtn" onclick="setAllRolePanelsCollapsed(true)">Collapse all</span></div>' + html;
  }
  container.innerHTML = html;
  for(i = 0; i < PORTAL_CONFIG.roles.length; i++){
    renderRolePanel(PORTAL_CONFIG.roles[i]);
  }
}

// roleCollapsed[slug] -- per-role panel collapsed state (Roles tab). Purely
// a view toggle: collapsing never touches roleState or unsaved edits.
// Collapsed by default (set in renderRolesTab).
var roleCollapsed = {};

function setRolePanelCollapsed(slug, collapsed){
  roleCollapsed[slug] = !!collapsed;
  var bodyEl   = document.getElementById("roleBody_" + slug);
  var toggleEl = document.getElementById("roleToggle_" + slug);
  if(bodyEl){ bodyEl.style.display = collapsed ? "none" : ""; }
  if(toggleEl){ toggleEl.innerHTML = collapsed ? "&#9654;" : "&#9660;"; }
}

function toggleRolePanel(slug){
  setRolePanelCollapsed(slug, !roleCollapsed[slug]);
}

function setAllRolePanelsCollapsed(collapsed){
  var i;
  for(i = 0; i < PORTAL_CONFIG.roles.length; i++){
    setRolePanelCollapsed(roleSlug(PORTAL_CONFIG.roles[i]), collapsed);
  }
}

// prefixStem(prefix) / groupTitleFor etc. are defined earlier in the file
// (PURE BUILDERS section) -- regionFromGroupTitle/knownRegionsForRole/
// isRegionGroupLive below are the D-17 Roles-tab-only counterparts that read
// live DOM/allGroups state, so they stay down here with the rest of the tab.

// regionFromGroupTitle(title, role) -- inverse of groupTitleFor: recovers the
// region a LIVE Computer Group's title encodes for this role, or null if the
// title doesn't belong to this role at all (wrong prefix/suffix). Used to
// auto-discover a regional group someone created outside the dashboard.
function regionFromGroupTitle(title, role){
  var lead   = prefixStem(PORTAL_CONFIG.groupTitlePrefix) + " ";
  var suffix = "- " + role;
  var t = String(title || "");
  if(t.indexOf(lead) !== 0){ return null; }
  if(t.length < lead.length + suffix.length){ return null; }
  if(t.substring(t.length - suffix.length) !== suffix){ return null; }
  return sanitizeRegion(t.substring(lead.length, t.length - suffix.length));
}

// isRegionGroupLive(role, region) -- true when groupTitleFor(role, region)
// matches a live BES Computer Group in this site (per the last
// loadAllComputerGroups() query).
function isRegionGroupLive(role, region){
  var title = groupTitleFor(role, region);
  var i;
  for(i = 0; i < allGroups.length; i++){
    if(allGroups[i].siteName === PORTAL_CONFIG.siteName && allGroups[i].name === title){ return true; }
  }
  return false;
}

// knownRegionsForRole(role) -- every region identity this role currently
// has, from two sources: (a) regions already in roleState[role].regions
// (session-known: the default "" identity, anything Saved/Published loaded
// by loadSavedRoleState, anything switched to this session), and (b) any
// LIVE Computer Group in this site whose title matches this role's naming
// convention (covers one created by hand in the console). "" (default)
// always sorts first.
function knownRegionsForRole(role){
  var st = roleState[role];
  var seen = {};
  var out  = [];
  var key;
  if(st){
    for(key in st.regions){
      if(st.regions.hasOwnProperty(key) && !seen[key]){ seen[key] = true; out.push(key); }
    }
  }
  var i, parsed;
  for(i = 0; i < allGroups.length; i++){
    if(allGroups[i].siteName !== PORTAL_CONFIG.siteName){ continue; }
    parsed = regionFromGroupTitle(allGroups[i].name, role);
    if(parsed === null || seen[parsed]){ continue; }
    seen[parsed] = true;
    out.push(parsed);
  }
  out.sort(function(a, b){
    if(a === b){ return 0; }
    if(a === ""){ return -1; }
    if(b === ""){ return 1; }
    return a < b ? -1 : 1;
  });
  return out;
}

// switchRoleRegion(role, region) -- changes which identity this role's panel
// is editing (D-17). Never discards an identity's in-memory edits -- if the
// bucket already exists (e.g. you switched away and back), its users/dirty
// state is left exactly as it was. Picks up a live groupId for the new
// selection if loadAllComputerGroups() already found one.
function switchRoleRegion(role, region){
  var st = roleState[role];
  if(!st){ return; }
  st.selectedRegion = region;
  var bucket = ensureRoleRegionBucket(role, region);
  var title  = groupTitleFor(role, region);
  var i;
  for(i = 0; i < allGroups.length; i++){
    if(allGroups[i].siteName === PORTAL_CONFIG.siteName && allGroups[i].name === title){
      bucket.groupId = allGroups[i].id;
      break;
    }
  }
  renderRolePanel(role);
}

// renderIdentitySelectForRole(role) -- (re)builds the "In-Scope Group"
// dropdown from knownRegionsForRole, marking each option [live] (a real
// Computer Group exists), [saved, not published] (Saved but never
// Published), or [new] (switched-to locally this session, nothing written
// anywhere yet).
function renderIdentitySelectForRole(role){
  var slug = roleSlug(role);
  var sel  = document.getElementById("identitySelect_" + slug);
  if(!sel){ return; }
  var st = roleState[role];
  if(!st){ return; }
  var regions = knownRegionsForRole(role);
  sel.innerHTML = "";
  var i, region, opt, label, bucket, live;
  for(i = 0; i < regions.length; i++){
    region = regions[i];
    bucket = st.regions[region];
    live   = isRegionGroupLive(role, region);
    label  = region ? region : "(default -- no region)";
    if(live){ label += " [live]"; }
    else if(bucket && bucket.users && bucket.users.length > 0){ label += " [saved, not published]"; }
    else { label += " [new]"; }
    opt = document.createElement("option");
    opt.value = region;
    opt.text  = label;
    sel.appendChild(opt);
  }
  sel.value = st.selectedRegion;
}

// renderRolePanel(role) -- re-renders one role's identity selector, username
// table (for the CURRENTLY SELECTED region identity), member count and
// known-users degradation hint from roleState[role].
function renderRolePanel(role){
  var slug = roleSlug(role);
  var st   = roleState[role];
  if(!st){ return; }

  renderIdentitySelectForRole(role);

  var region = st.selectedRegion;
  var bucket = st.regions[region] || { users: [] };
  var users  = bucket.users || [];

  var headingEl = document.getElementById("roleHeading_" + slug);
  if(headingEl){
    var regionNote = region ? (" &mdash; " + htmlEscape(region)) : " &mdash; default";
    // "unsaved changes" repeated here so a COLLAPSED panel still flags edits.
    headingEl.innerHTML = htmlEscape(role) + regionNote + ' <span class="small">(' + users.length + ' member' + (users.length === 1 ? '' : 's') + ')</span>' +
      (bucket.dirty ? ' <span class="small warn">&mdash; unsaved changes</span>' : '');
  }

  var statusEl = document.getElementById("groupStatus_" + slug);
  if(statusEl){
    var title = groupTitleFor(role, region);
    statusEl.innerText = "Group: " + title + (isRegionGroupLive(role, region) ? " (live)" : " (not yet published)") +
      (bucket.dirty ? " -- unsaved changes" : "");
  }

  var tbody = document.getElementById("userTable_" + slug);
  if(tbody){
    tbody.innerHTML = "";
    if(users.length === 0){
      var trEmpty = document.createElement("tr");
      var tdEmpty = document.createElement("td");
      tdEmpty.colSpan = 2;
      tdEmpty.className = "dim";
      tdEmpty.innerText = "No usernames yet.";
      trEmpty.appendChild(tdEmpty);
      tbody.appendChild(trEmpty);
    } else {
      var i;
      for(i = 0; i < users.length; i++){
        (function(username){
          var tr   = document.createElement("tr");
          var tdU  = document.createElement("td");
          tdU.innerText = username;
          var tdBtn = document.createElement("td");
          var btn   = document.createElement("span");
          btn.className = "btn";
          btn.innerText = "Remove";
          btn.title = "Removes from this list only -- click Save/Publish to retarget the group.";
          btn.onclick = function(){ removeUsernameFromRole(role, username); };
          var btnRevoke = document.createElement("span");
          btnRevoke.className = "btn";
          btnRevoke.style.marginLeft = "4px";
          btnRevoke.innerText = "Revoke now";
          btnRevoke.title = "Removes from this list AND immediately deactivates this user's mapping on any machine where it's live -- does not wait for Save/Publish.";
          btnRevoke.onclick = function(){ revokeUsernameFromRole(role, username); };
          tdBtn.appendChild(btn);
          tdBtn.appendChild(btnRevoke);
          tr.appendChild(tdU);
          tr.appendChild(tdBtn);
          tbody.appendChild(tr);
        })(users[i]);
      }
    }
  }

  var hintEl = document.getElementById("knownUsersHint_" + slug);
  if(hintEl){ hintEl.style.display = (knownUsers.length === 0) ? "" : "none"; }
}

function onIdentitySelectChange(slug){
  var role = roleBySlug[slug];
  var sel  = document.getElementById("identitySelect_" + slug);
  if(role && sel){ switchRoleRegion(role, sel.value); }
}

// onNewRegionClick(slug) -- reads the free-text Region box, sanitizes it,
// and switches this role's panel to that identity (creating its bucket if
// it's genuinely new). An empty/blank entry is equivalent to picking the
// default identity from the dropdown -- never an error.
function onNewRegionClick(slug){
  var role  = roleBySlug[slug];
  var input = document.getElementById("regionInput_" + slug);
  if(!role || !input){ return; }
  var region = sanitizeRegion(input.value);
  switchRoleRegion(role, region);
  input.value = "";
}

// importSavedMembersForRole(role) -- D-22 (revised v2.9.0). REPLACES the
// currently-selected region bucket's username list with the FULL saved
// membership for this exact (role, region) pair: the latest RolePublishRun's
// RoleUsers in the root server's RolePublish.db, read fresh from the "Saved
// Roles" property (readSavedRoleMembers). Previously this read the Analysis
// tab's fleet mappings, which only list users who have already logged on to
// a mapped machine -- configured-but-not-yet-mapped users were silently
// dropped from the list on import.
//
// Region matched case/whitespace-insensitively (sanitizeRegion both sides).
// If nothing saved is found, the on-screen list is left untouched, so a
// not-yet-reporting property can't wipe in-progress edits.
function importSavedMembersForRole(role){
  var slug     = roleSlug(role);
  var errEl    = document.getElementById("roleErr_" + slug);
  var resultEl = document.getElementById("roleResult_" + slug);
  var st       = roleState[role];
  if(!st){ return; }
  var region     = st.selectedRegion;
  var regionNorm = sanitizeRegion(region).toLowerCase();
  var regionLabel = region ? (" (" + region + ")") : "";

  if(errEl){ errEl.style.display = "none"; errEl.innerHTML = ""; }
  if(resultEl){ resultEl.style.display = "none"; resultEl.innerHTML = ""; }

  var saved = readSavedRoleMembers();
  if(!saved){
    if(errEl){
      errEl.style.display = "";
      errEl.innerHTML = htmlEscape("Cannot import: PORTAL_CONFIG.rootServerComputerId is not set, so the root server's \"Saved Roles\" property can't be read.");
    }
    return;
  }

  var seen = {};
  var imported = [];
  var byRegion = saved[role] || {};
  var reg, list, i, u;
  for(reg in byRegion){
    if(!byRegion.hasOwnProperty(reg)){ continue; }
    if(sanitizeRegion(reg).toLowerCase() !== regionNorm){ continue; }
    list = byRegion[reg];
    for(i = 0; i < list.length; i++){
      u = String(list[i]).toLowerCase().replace(/^\s+|\s+$/g, "");
      if(u === "" || seen[u]){ continue; }
      seen[u] = true;
      imported.push(u);
    }
  }
  imported.sort();

  if(imported.length === 0){
    if(resultEl){
      resultEl.style.display = "";
      resultEl.innerHTML = htmlEscape("No saved members found for " + role + regionLabel + " in RolePublish.db (\"Saved Roles\" property) -- the list was left unchanged. If you saved recently, the property may not have re-evaluated yet (every 5 minutes).");
    }
    return;
  }

  setRoleUsers(role, imported);

  if(resultEl){
    resultEl.style.display = "";
    resultEl.innerHTML = htmlEscape(
      "Imported " + imported.length + " saved member" + (imported.length === 1 ? "" : "s") + " for " + role + regionLabel + " -- this REPLACED the on-screen list. Review, add/remove as needed, then Save and Publish."
    );
  }
}

function onImportSavedMembersClick(slug){
  var role = roleBySlug[slug];
  if(role){ importSavedMembersForRole(role); }
}

// addUsernameToRole(role) -- reads the per-role Add input, rejects only an
// empty (post-trim) entry (surfaced inline in errEl, never a popup dialog),
// and delegates the actual add to setRoleUsers (which silently de-dupes).
function addUsernameToRole(role){
  var slug  = roleSlug(role);
  var input = document.getElementById("addUser_" + slug);
  var errEl = document.getElementById("roleErr_" + slug);
  if(!input){ return; }
  if(errEl){ errEl.style.display = "none"; errEl.innerHTML = ""; }
  var val = String(input.value || "").replace(/^\s+|\s+$/g, "");
  if(val === ""){
    if(errEl){
      errEl.style.display = "";
      errEl.innerHTML = htmlEscape("Enter a username first.");
    }
    return;
  }
  var current = getRoleUsers(role);
  current.push(val);
  setRoleUsers(role, current);
  input.value = "";
  var suggestEl = document.getElementById("suggest_" + slug);
  if(suggestEl){ suggestEl.style.display = "none"; suggestEl.innerHTML = ""; }
}

// removeUsernameFromRole(role, username) -- Remove-button handler, always
// bound via a DOM closure (never an inline onclick string) so a username
// containing a quote/ampersand/brace can never corrupt an HTML attribute.
function removeUsernameFromRole(role, username){
  var current = getRoleUsers(role);
  var out = [];
  var i;
  for(i = 0; i < current.length; i++){
    if(current[i] !== username){ out.push(current[i]); }
  }
  setRoleUsers(role, out);
}

// loadAllComputerGroups() -- D-10/D-17, ported from fixlet_console.ojo's
// loadGroups(). One live session-relevance query for every BES computer
// group on the server (id/name/site/type), loaded once into the shared
// module-level allGroups cache. D-17 retired the free-text fleet-wide
// search/picker this used to feed (any arbitrary existing group could be
// chosen as a role's "scope") -- allGroups is now consulted only to detect
// which of THIS role's own naming-convention identities already exist live
// (isRegionGroupLive/knownRegionsForRole/switchRoleRegion), never offered as
// a raw list to pick from.
function loadAllComputerGroups(){
  allGroups = [];
  try {
    var rel = '(id of it as string & "|||" & name of it & "|||" & name of (site of it) & "|||" & (if (server based flag of it) then "Server Based" else if (automatic flag of it) then "Automatic" else "Manual")) of bes computer groups';
    // EvaluateRelevance, not getRelevanceSafe/GetRelevance: this is a direct BES
    // object-model query (computer groups), the same kind findBesObjectIdByTitle/
    // findOpenActionIdsByTitle already use EvaluateRelevance for elsewhere in this
    // file -- GetRelevance here is reserved for Analysis-property/client-gathered
    // results (loadKnownUsers/loadAnalysisView), a different query class that
    // silently returned empty for "bes computer groups" (confirmed live 2026-10-20:
    // the group listboxes rendered "(none)" only after this function originally
    // shipped on getRelevanceSafe).
    var data = EvaluateRelevance(rel);
    var i, p;
    for(i = 0; i < data.length; i++){
      p = String(data[i]).split("|||");
      allGroups.push({ id: p[0], name: p[1], siteName: p[2], groupType: p[3] });
    }
    allGroups.sort(function(a, b){
      var na = (a.name || "").toLowerCase(), nb = (b.name || "").toLowerCase();
      return na < nb ? -1 : na > nb ? 1 : 0;
    });
  } catch(ex) { allGroups = []; }

  var r, role;
  for(r = 0; r < PORTAL_CONFIG.roles.length; r++){
    role = PORTAL_CONFIG.roles[r];
    // Re-sync this role's selected bucket's groupId/dirty-safe render now
    // that allGroups reflects live reality, and surface any regional group
    // discovered live but never seen this session (e.g. created by hand).
    switchRoleRegion(role, roleState[role].selectedRegion);
  }
}

// -- Inline-handler wrappers: every onclick/onkeyup in the Roles tab passes
// only a slug (see roleBySlug comment above), then resolves to the real role
// name here before calling the role-keyed functions above.
function onAddUserClick(slug){
  var role = roleBySlug[slug];
  if(role){ addUsernameToRole(role); }
}

function onAddUserKeyup(slug){
  var input     = document.getElementById("addUser_" + slug);
  var suggestEl = document.getElementById("suggest_" + slug);
  if(!input || !suggestEl){ return; }
  var val = String(input.value || "");
  if(val.length < 2){
    suggestEl.style.display = "none";
    suggestEl.innerHTML = "";
    return;
  }
  var matches = suggestUsernames(val);
  suggestEl.innerHTML = "";
  if(matches.length === 0){
    suggestEl.style.display = "none";
    return;
  }
  suggestEl.style.display = "";
  var i;
  for(i = 0; i < matches.length; i++){
    (function(match){
      var row = document.createElement("div");
      row.className = "small";
      row.style.cursor = "pointer";
      row.innerText = match;
      row.onclick = function(){
        input.value = match;
        suggestEl.style.display = "none";
        suggestEl.innerHTML = "";
      };
      suggestEl.appendChild(row);
    })(matches[i]);
  }
}

// ==========================================================================
// SAVE (D-13 step 1) -- stages a role's full username snapshot into the
// root-server RolePublish.db audit store via a ComputerID-targeted
// SingleAction. Per this plan's objective note, the audit write fires on
// Save, not on Publish (07-07) -- Publish reads the already-saved snapshot,
// it must not add a second write.
// ==========================================================================

// Mirror of scripts/Upsert-RolePublish.ps1 (repo root). Kept as a literal
// copy here so the Save action can createfile it directly on the root
// server without a separate script-deployment step. If you edit
// scripts/Upsert-RolePublish.ps1, regenerate this array from it (do not
// hand-edit -- see buildAuditWriteActionScript). scripts/Upsert-RolePublish.ps1
// itself remains the source of truth; tests/unit/role_manager.test.js
// asserts this array joins back to that file's exact content.
var ROLE_PUBLISH_SCRIPT_LINES = [
  "#Requires -Version 5.1",
  "# Version: 1.1.0",
  "<#",
  ".SYNOPSIS",
  "    Root-server audit-store initialiser + per-Publish snapshot writer (D-05). Reads a",
  "    Publish-event payload (role, publishing operator, full username list) and writes it",
  "    as one immutable, timestamped row-set into RolePublish.db.",
  "",
  ".DESCRIPTION",
  "    D-05 makes this store - not the Computer Group's relevance text and not a JSON file -",
  "    the source of truth for \"who holds which role\", and NFR-03's audit trail. The",
  "    dashboard writes a JSON payload (see -PayloadPath), and this script:",
  "",
  "      1. Ensures the RolePublishRun / RoleUsers schema exists (CREATE TABLE IF NOT",
  "         EXISTS, plus an additive PRAGMA table_info(RolePublishRun)-gated ALTER TABLE",
  "         ADD COLUMN Region for a pre-D-17 database -- same migration discipline as",
  "         Initialize-RoleDb.ps1's Map.Region/Source_Type columns. Never DROP, never",
  "         ALTER an existing column.",
  "      2. Inserts one RolePublishRun row for the Publish event.",
  "      3. Inserts one RoleUsers row per (normalised, de-duplicated) username, tagged with",
  "         that run's RunID.",
  "",
  "    The store is append-only: every Publish creates a NEW run and a NEW full snapshot of",
  "    that role's membership. Nothing is ever UPDATEd or DELETEd, and no upsert-by-replace",
  "    write is ever used - history cannot be silently rewritten (T-07-03-03). The \"current",
  "    membership\" of a role is always the RoleUsers rows belonging to the MAX(RunID) for",
  "    that (role, region) PAIR (D-17: a role can have several concurrent regional groups,",
  "    each independently Saved/Published) - see the canonical query in .NOTES.",
  "",
  "    Constrained Language Mode safe: no dynamic .NET type-loading helper, no",
  "    System.Data.SQLite, no Invoke-Expression. Every database call goes through",
  "    Sqlite-Helper.ps1 (bundled sqlite3.exe); every value goes through",
  "    Invoke-SqliteCommand -Parameters (T-07-03-02) - the payload is data, never script",
  "    (T-07-03-04).",
  "",
  ".PARAMETER PayloadPath",
  "    Path to a UTF-8 JSON file shaped:",
  "        { \"role\": \"IT Operations\", \"region\": \"Europe\", \"published_by\": \"jfannon\", \"users\": [\"alice\",\"bob\"] }",
  "    \"region\" is always present (D-17) -- an empty string for the role's default/no-region",
  "    group. An empty \"users\" array is legal - it means the role (+ region) now has zero",
  "    members - and is recorded as a run with UserCount = 0, not treated as an error.",
  "",
  ".PARAMETER DatabasePath",
  "    Full path to RolePublish.db on the root server.",
  "",
  ".PARAMETER SQLDir",
  "    Directory containing sqlite3.exe directly (no arch subfolder).",
  "",
  ".PARAMETER SqliteHelperPath",
  "    Path to the shared Sqlite-Helper.ps1. Default: Sqlite-Helper.ps1 beside -DatabasePath",
  "    (same resolution Assign-RoleMapping.ps1 already uses).",
  "",
  ".PARAMETER WhatIf",
  "    Validates the payload and prints every statement that would run (schema DDL, the",
  "    RolePublishRun insert, every RoleUsers insert) with parameter values shown, via",
  "    [WHATIF] Write-Host lines. Performs zero database access - not even a read - so a",
  "    -DatabasePath that does not yet exist is left untouched (sqlite3.exe materialises a",
  "    file merely by opening one, so this script never opens the database at all under",
  "    -WhatIf).",
  "",
  ".EXAMPLE",
  "    .\\Upsert-RolePublish.ps1 -PayloadPath .\\publish.json -DatabasePath D:\\RolePublish\\RolePublish.db -SQLDir D:\\sqlite",
  "",
  ".NOTES",
  "    PowerShell 5.1, Constrained Language Mode safe.",
  "",
  "    Canonical \"current membership of a role+region\" query (D-17, extends the plan 07-05",
  "    original which keyed on Role alone):",
  "        SELECT u.UserID FROM RoleUsers u",
  "        WHERE u.RunID = (SELECT MAX(RunID) FROM RolePublishRun",
  "                         WHERE Role = @role AND coalesce(Region,'') = @region)",
  "        ORDER BY u.UserID",
  "",
  "    Exit codes:",
  "      0     success",
  "      5401  Sqlite-Helper.ps1 not found at the resolved -SqliteHelperPath",
  "      5402  sqlite3.exe not found under -SQLDir",
  "      5410  payload missing / not valid JSON / role blank / published_by blank / users",
  "            not an array",
  "      5411  users array exceeds the 5000-entry sanity cap",
  "      1     unexpected error writing the schema or the run (see the [ABORT] message)",
  "#>",
  "[CmdletBinding(SupportsShouldProcess = $true)]",
  "param(",
  "    [Parameter(Mandatory = $true)]",
  "    [string]$PayloadPath,",
  "",
  "    [Parameter(Mandatory = $true)]",
  "    [string]$DatabasePath,",
  "",
  "    [Parameter(Mandatory = $true)]",
  "    [string]$SQLDir,",
  "",
  "    [Parameter()]",
  "    [string]$SqliteHelperPath",
  ")",
  "",
  "Set-StrictMode -Version Latest",
  "$ErrorActionPreference = 'Stop'",
  "",
  "$MaxUsers  = 5000",
  "$BatchSize = 400",
  "",
  "function Write-Tag {",
  "    param([string]$Tag, [string]$Message)",
  "    Write-Host \"[$Tag] $Message\"",
  "}",
  "",
  "# --- Step 1: resolve + validate tooling (no DB access yet) -----------------------------",
  "if ([string]::IsNullOrWhiteSpace($SqliteHelperPath)) {",
  "    $SqliteHelperPath = Join-Path (Split-Path $DatabasePath) 'Sqlite-Helper.ps1'",
  "}",
  "",
  "if (-not (Test-Path -LiteralPath $SqliteHelperPath)) {",
  "    Write-Tag 'ABORT' \"Sqlite-Helper.ps1 not found at: $SqliteHelperPath\"",
  "    exit 5401",
  "}",
  "",
  "$sqlite3Exe = Join-Path $SQLDir 'sqlite3.exe'",
  "if (-not (Test-Path -LiteralPath $sqlite3Exe)) {",
  "    Write-Tag 'ABORT' \"sqlite3.exe not found at: $sqlite3Exe (set -SQLDir to the directory containing it)\"",
  "    exit 5402",
  "}",
  "",
  ". $SqliteHelperPath",
  "",
  "# --- Step 2: read + validate the payload (no DB access) --------------------------------",
  "if (-not (Test-Path -LiteralPath $PayloadPath)) {",
  "    Write-Tag 'ABORT' \"Payload file not found: $PayloadPath\"",
  "    exit 5410",
  "}",
  "",
  "try {",
  "    $rawPayloadText = Get-Content -Raw -LiteralPath $PayloadPath",
  "    $payload = $rawPayloadText | ConvertFrom-Json",
  "} catch {",
  "    Write-Tag 'ABORT' \"Payload is not valid JSON: $PayloadPath ($($_.Exception.Message))\"",
  "    exit 5410",
  "}",
  "",
  "if ($null -eq $payload) {",
  "    Write-Tag 'ABORT' \"Payload parsed to nothing: $PayloadPath\"",
  "    exit 5410",
  "}",
  "",
  "# Property-existence check first (Set-StrictMode -Version Latest throws",
  "# PropertyNotFoundStrict on a bare $payload.role access when the JSON key is absent --",
  "# same defensive idiom Reconcile-LocalRoles.ps1 uses for its snapshot body).",
  "$payloadProps = @($payload.PSObject.Properties.Name)",
  "$Role         = if ($payloadProps -contains 'role')         { [string]$payload.role }         else { '' }",
  "$PublishedBy  = if ($payloadProps -contains 'published_by') { [string]$payload.published_by }  else { '' }",
  "# D-17: region is OPTIONAL -- a blank value is the role's default/no-region identity, not an",
  "# error (unlike Role/PublishedBy below, which are mandatory).",
  "$Region       = if ($payloadProps -contains 'region')       { [string]$payload.region }        else { '' }",
  "",
  "if ([string]::IsNullOrWhiteSpace($Role)) {",
  "    Write-Tag 'ABORT' \"payload 'role' is missing or blank\"",
  "    exit 5410",
  "}",
  "if ([string]::IsNullOrWhiteSpace($PublishedBy)) {",
  "    Write-Tag 'ABORT' \"payload 'published_by' is missing or blank\"",
  "    exit 5410",
  "}",
  "",
  "$Role        = $Role.Trim()",
  "$PublishedBy = $PublishedBy.Trim()",
  "$Region      = $Region.Trim()",
  "",
  "# users: null (key absent, or an empty JSON array -- PS5.1 collapses [] to $null) is a",
  "# legal empty list. Anything present that is NOT enumerable (a string, a number, a JSON",
  "# object) is a type error.",
  "$rawUsers = if ($payloadProps -contains 'users') { $payload.users } else { $null }",
  "if ($null -eq $rawUsers) {",
  "    $usersArray = @()",
  "} else {",
  "    $isArrayLike = ($rawUsers -is [System.Array]) -or `",
  "        ($rawUsers -is [System.Collections.IEnumerable] -and $rawUsers -isnot [string])",
  "    if (-not $isArrayLike) {",
  "        # PS 5.1's ConvertFrom-Json collapses a single-element JSON array to a bare",
  "        # scalar -- \"users\":[\"alice\"] and \"users\":\"alice\" deserialize identically, so",
  "        # the object model alone can't tell a legal one-user array from a genuine",
  "        # scalar payload. Fall back to the raw JSON text to disambiguate.",
  "        if ($rawPayloadText -match '\"users\"\\s*:\\s*\\[') {",
  "            $isArrayLike = $true",
  "        }",
  "    }",
  "    if (-not $isArrayLike) {",
  "        Write-Tag 'ABORT' \"payload 'users' is not an array\"",
  "        exit 5410",
  "    }",
  "    $usersArray = @($rawUsers)",
  "}",
  "",
  "if ($usersArray.Count -gt $MaxUsers) {",
  "    Write-Tag 'ABORT' \"payload 'users' has $($usersArray.Count) entries, exceeding the $MaxUsers-entry sanity cap\"",
  "    exit 5411",
  "}",
  "",
  "# Normalise: trim + lower-case, drop empties, de-duplicate, ordinal-sort deterministically.",
  "$seen       = @{}",
  "$normalized = New-Object System.Collections.ArrayList",
  "foreach ($u in $usersArray) {",
  "    if ($null -eq $u) { continue }",
  "    $t = ([string]$u).Trim().ToLowerInvariant()",
  "    if ($t -eq '') { continue }",
  "    if (-not $seen.ContainsKey($t)) {",
  "        $seen[$t] = $true",
  "        [void]$normalized.Add($t)",
  "    }",
  "}",
  "$normUsers = $normalized.ToArray()",
  "if ($normUsers.Length -gt 1) { [Array]::Sort($normUsers, [System.StringComparer]::Ordinal) }",
  "",
  "# --- Step 6: -WhatIf short-circuit ------------------------------------------------------",
  "# Zero database access under -WhatIf: sqlite3.exe materialises a file merely by opening",
  "# one, so even a read-only schema probe against a -DatabasePath that does not yet exist",
  "# would leave a file behind. Describe every statement that WOULD run instead.",
  "if ($WhatIfPreference) {",
  "    Write-Tag 'WHATIF' \"would ensure schema exists: CREATE TABLE IF NOT EXISTS RolePublishRun, CREATE TABLE IF NOT EXISTS RoleUsers, CREATE INDEX IF NOT EXISTS idx_roleusers_run, CREATE INDEX IF NOT EXISTS idx_roleusers_role, ALTER TABLE RolePublishRun ADD COLUMN Region (if missing)\"",
  "    Write-Tag 'WHATIF' (\"would insert RolePublishRun row: Role='{0}' Region='{1}' Published_by='{2}' UserCount={3}\" -f $Role, $Region, $PublishedBy, $normUsers.Count)",
  "    foreach ($u in $normUsers) {",
  "        Write-Tag 'WHATIF' (\"would insert RoleUsers row: Role='{0}' UserID='{1}'\" -f $Role, $u)",
  "    }",
  "    Write-Tag 'WHATIF' \"no writes performed; $DatabasePath left untouched\"",
  "    exit 0",
  "}",
  "",
  "# --- Step 3: ensure schema --------------------------------------------------------------",
  "function Test-TableExists {",
  "    param([string]$Name)",
  "    $r = Invoke-SqliteCommand -DatabasePath $DatabasePath -SQLDir $SQLDir `",
  "        -Sql \"SELECT COUNT(*) AS n FROM sqlite_master WHERE type='table' AND name=@n\" `",
  "        -Parameters @{ n = $Name }",
  "    return ([int]$r[0].n -eq 1)",
  "}",
  "",
  "$runPublishDdl = @\"",
  "CREATE TABLE IF NOT EXISTS RolePublishRun (",
  "    RunID        INTEGER PRIMARY KEY AUTOINCREMENT,",
  "    Role         TEXT NOT NULL,",
  "    Published_by TEXT NOT NULL,",
  "    Published_on TEXT NOT NULL DEFAULT (datetime('now','localtime')),",
  "    UserCount    INTEGER NOT NULL",
  ")",
  "\"@",
  "",
  "$roleUsersDdl = @\"",
  "CREATE TABLE IF NOT EXISTS RoleUsers (",
  "    RUID   INTEGER PRIMARY KEY AUTOINCREMENT,",
  "    RunID  INTEGER NOT NULL REFERENCES RolePublishRun(RunID),",
  "    Role   TEXT NOT NULL,",
  "    UserID TEXT NOT NULL",
  ")",
  "\"@",
  "",
  "try {",
  "    foreach ($tbl in @(",
  "        @{ Name = 'RolePublishRun'; Ddl = $runPublishDdl }",
  "        @{ Name = 'RoleUsers';      Ddl = $roleUsersDdl }",
  "    )) {",
  "        if (Test-TableExists -Name $tbl.Name) {",
  "            Write-Tag 'SKIP' \"$($tbl.Name) already exists - no changes made\"",
  "        } else {",
  "            Invoke-SqliteCommand -DatabasePath $DatabasePath -SQLDir $SQLDir -Sql $tbl.Ddl | Out-Null",
  "            Write-Tag 'CREATE' \"$($tbl.Name) created\"",
  "        }",
  "    }",
  "",
  "    Invoke-SqliteCommand -DatabasePath $DatabasePath -SQLDir $SQLDir `",
  "        -Sql \"CREATE INDEX IF NOT EXISTS idx_roleusers_run ON RoleUsers(RunID)\" | Out-Null",
  "    Invoke-SqliteCommand -DatabasePath $DatabasePath -SQLDir $SQLDir `",
  "        -Sql \"CREATE INDEX IF NOT EXISTS idx_roleusers_role ON RoleUsers(Role)\" | Out-Null",
  "    Write-Tag 'INDEX' \"idx_roleusers_run, idx_roleusers_role ready\"",
  "",
  "    # D-17: Region is additive -- PRAGMA table_info-gated ALTER TABLE, same migration",
  "    # discipline as Initialize-RoleDb.ps1's Map.Region/Source_Type/Valid_to columns. Runs",
  "    # even right after a fresh CREATE TABLE above, since the base DDL never carries Region",
  "    # itself (the column is always added this way, old database or brand new).",
  "    $runCols = Invoke-SqliteCommand -DatabasePath $DatabasePath -SQLDir $SQLDir -Sql \"PRAGMA table_info(RolePublishRun)\"",
  "    $hasRegion = @($runCols | Where-Object { $_.name -eq 'Region' }).Count -gt 0",
  "    if (-not $hasRegion) {",
  "        Invoke-SqliteCommand -DatabasePath $DatabasePath -SQLDir $SQLDir -Sql \"ALTER TABLE RolePublishRun ADD COLUMN Region TEXT\" | Out-Null",
  "        Write-Tag 'MIGRATE' \"RolePublishRun.Region added\"",
  "    }",
  "} catch {",
  "    Write-Tag 'ABORT' \"failed to ensure schema: $($_.Exception.Message)\"",
  "    exit 1",
  "}",
  "",
  "# --- Step 4: write the run (append-only - no UPDATE, no DELETE, no upsert-by-replace) ---",
  "try {",
  "    # INSERT + SELECT last_insert_rowid() must be ONE call: last_insert_rowid() is scoped",
  "    # to the connection that performed the insert, and Sqlite-Helper spawns a fresh",
  "    # sqlite3.exe process per Invoke-SqliteCommand call.",
  "    $insertPrefix = \"INSERT INTO RolePublishRun (Role, Region, Published_by, UserCount) VALUES\"",
  "    $runSql       = $insertPrefix + \" (@role, @region, @pubby, @cnt);`nSELECT last_insert_rowid() AS id\"",
  "    $insertResult = Invoke-SqliteCommand -DatabasePath $DatabasePath -SQLDir $SQLDir `",
  "        -Sql $runSql `",
  "        -Parameters @{ role = $Role; region = $Region; pubby = $PublishedBy; cnt = $normUsers.Count }",
  "    $runId = [int]$insertResult[0].id",
  "",
  "    for ($i = 0; $i -lt $normUsers.Count; $i += $BatchSize) {",
  "        $end   = [Math]::Min($i + $BatchSize - 1, $normUsers.Count - 1)",
  "        $chunk = $normUsers[$i..$end]",
  "",
  "        $valuesClauses = New-Object System.Collections.ArrayList",
  "        $params        = @{ runid = $runId; role = $Role }",
  "        for ($j = 0; $j -lt $chunk.Count; $j++) {",
  "            $key = \"u$j\"",
  "            [void]$valuesClauses.Add(\"(@runid, @role, @$key)\")",
  "            $params[$key] = $chunk[$j]",
  "        }",
  "",
  "        $ruInsertPrefix = \"INSERT INTO RoleUsers (RunID, Role, UserID) VALUES\"",
  "        $ruSql          = $ruInsertPrefix + \"`n\" + ($valuesClauses -join \",`n\")",
  "        Invoke-SqliteCommand -DatabasePath $DatabasePath -SQLDir $SQLDir -Sql $ruSql -Parameters $params | Out-Null",
  "    }",
  "} catch {",
  "    Write-Tag 'ABORT' \"failed to write RolePublishRun/RoleUsers: $($_.Exception.Message)\"",
  "    exit 1",
  "}",
  "",
  "# --- Step 7: success ---------------------------------------------------------------------",
  "Write-Host \"[OK] RunID=$runId Role=$Role Users=$($normUsers.Count)\"",
  "exit 0",
  ""
];
var ROLE_PUBLISH_SCRIPT = ROLE_PUBLISH_SCRIPT_LINES.join('\r\n');

// jsonEscape(s) -- hand-rolled JSON string escaper (IE9 has no reliable
// JSON.stringify in this host). Escapes \, ", and control chars \b \f \n \r
// \t plus any char below 0x20 as \u00XX.
function jsonEscape(s){
  var str = String(s);
  var out = "";
  var i, c, code, hex;
  for(i = 0; i < str.length; i++){
    c    = str.charAt(i);
    code = str.charCodeAt(i);
    if(c === '\\'){ out += '\\\\'; }
    else if(c === '"'){ out += '\\"'; }
    else if(c === '\b'){ out += '\\b'; }
    else if(c === '\f'){ out += '\\f'; }
    else if(c === '\n'){ out += '\\n'; }
    else if(c === '\r'){ out += '\\r'; }
    else if(c === '\t'){ out += '\\t'; }
    else if(code < 0x20){
      hex = code.toString(16);
      while(hex.length < 4){ hex = "0" + hex; }
      out += '\\u' + hex;
    } else {
      out += c;
    }
  }
  return out;
}
function jsonStringLiteral(s){ return '"' + jsonEscape(s) + '"'; }

// buildRolePublishPayload(role, region, usernames, publishedBy) -- pure.
// Emits the D-17 JSON contract (extends 07-03's original shape with "region"):
// {"role":"<role>","region":"<region>","published_by":"<who>","users":["a","b"]}.
// region is "" for the default/no-region group -- never omitted, so
// Upsert-RolePublish.ps1 always has an explicit value to key RolePublishRun
// on. publishedBy falls back to "console-operator" when empty
// (getAssignedBy() already guards the console-render-time tag; this is a
// second, independent guard).
function buildRolePublishPayload(role, region, usernames, publishedBy){
  var users = usernames || [];
  var by    = String(publishedBy || "").replace(/^\s+|\s+$/g, "");
  if(by === ""){ by = "console-operator"; }
  var parts = [];
  var i;
  for(i = 0; i < users.length; i++){
    parts.push(jsonStringLiteral(users[i]));
  }
  return '{"role":' + jsonStringLiteral(role) +
    ',"region":' + jsonStringLiteral(sanitizeRegion(region)) +
    ',"published_by":' + jsonStringLiteral(by) +
    ',"users":[' + parts.join(',') + ']}';
}

// buildAuditWriteActionScript(payloadJson) -- modelled line-for-line on
// fixlet_dispatcher.ojo's buildStagingActionScript. Only escapeActionScriptBraces
// may touch braces (double "{" only); the parameter/invocation lines below
// use intentional {parameter "..."} substitutions and are never passed
// through it -- only the two createfile bodies are.
function buildAuditWriteActionScript(payloadJson){
  var lines = [];

  // Client-relevance folder expressions -- copied VERBATIM from
  // bes/Assign-RoleMapping.bes (SWPDir/SQLiteDir lines) so the root server
  // resolves the same paths the endpoint half does. TargetStore differs
  // here on purpose: this action writes RolePublish.db, never
  // RoleAwareness.db (the endpoint script's own target).
  lines.push('\tparameter "SWPDir"="{(concatenation (if windows of operating system then "\\" else "/") of ((item 0 of it;item 1 of it;item 2 of it) of ((pathname of parent folder of parent folder of client folder of site "actionsite") as string,"EC","SoftwarePortal")))}"');
  lines.push('\tparameter "SQLiteDir"="{(concatenation (if windows of operating system then "\\" else "/") of ((item 0 of it;item 1 of it;item 2 of it) of ((pathname of parent folder of parent folder of client folder of site "actionsite") as string,"EC","sqlite")))}"');
  lines.push('\tparameter "TargetStore"="{(concatenation (if windows of operating system then "\\" else "/") of ((item 0 of it;item 1 of it;item 2 of it;item 3 of it) of ((pathname of parent folder of parent folder of client folder of site "actionsite") as string,"EC","SoftwarePortal","RolePublish.db")))}"');
  lines.push('');

  lines.push('\tif {not exists folder ((parameter "SWPDir") & "\\rolegroups")}');
  lines.push('\t\trunhidden cmd /c mkdir "{parameter "SWPDir"}\\rolegroups"');
  lines.push('\tendif');
  lines.push('');

  lines.push('delete __createfile');
  lines.push('delete "{parameter "SWPDir"}\\rolegroups\\Upsert-RolePublish.ps1"');
  lines.push('');
  lines.push('createfile until _EOF_');
  lines.push(escapeActionScriptBraces(ROLE_PUBLISH_SCRIPT));
  lines.push('_EOF_');
  lines.push('');
  lines.push('move __createfile "{parameter "SWPDir"}\\rolegroups\\Upsert-RolePublish.ps1"');
  lines.push('');

  lines.push('delete __createfile');
  lines.push('delete "{parameter "SWPDir"}\\rolegroups\\rolepublish-payload.json"');
  lines.push('');
  lines.push('createfile until _EOF_');
  lines.push(escapeActionScriptBraces(payloadJson));
  lines.push('_EOF_');
  lines.push('');
  lines.push('move __createfile "{parameter "SWPDir"}\\rolegroups\\rolepublish-payload.json"');
  lines.push('');

  lines.push('action uses wow64 redirection {x64 of operating system}');
  lines.push('waithidden powershell.exe -NonInteractive -NoProfile -ExecutionPolicy Bypass -File "{parameter "SWPDir"}\\rolegroups\\Upsert-RolePublish.ps1" -PayloadPath "{parameter "SWPDir"}\\rolegroups\\rolepublish-payload.json" -DatabasePath "{parameter "TargetStore"}" -SQLDir "{parameter "SQLiteDir"}" -SqliteHelperPath "{parameter "SWPDir"}\\Sqlite-Helper.ps1"');
  lines.push('');

  lines.push('delete "{parameter "SWPDir"}\\rolegroups\\rolepublish-payload.json"');

  return lines.join('\r\n');
}

// buildAuditWriteActionXml(role, actionScript) -- SingleAction, element order
// Title -> Relevance -> ActionScript -> Settings -> Target (SKILL.md S3).
// Target is <ComputerID> (a single fixed computer, the root server), never
// <CustomRelevance> -- this action never needs client-side group evaluation.
function buildAuditWriteActionXml(role, region, actionScript){
  if(!PORTAL_CONFIG.rootServerComputerId){ return ""; }
  var stamp = new Date().toISOString();
  var title = "DSP RoleSave - " + regionalSuffix(region, role) + " " + stamp;

  var xml  = '<?xml version="1.0" encoding="UTF-8"?>\r\n';
  xml += '<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"';
  xml += ' xsi:noNamespaceSchemaLocation="BES.xsd">\r\n';
  xml += '  <SingleAction>\r\n';
  xml += '    <Title>' + xmlEscape(title) + '</Title>\r\n';
  xml += '    <Relevance>true</Relevance>\r\n';
  xml += '    <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">';
  xml += cdataStart() + xmlCDataSafe(actionScript) + cdataEnd();
  xml += '</ActionScript>\r\n';
  xml += '    <Settings>\r\n';
  xml += '      <ActionUITitle>' + xmlEscape(title) + '</ActionUITitle>\r\n';
  xml += '      <PreActionShowUI>false</PreActionShowUI>\r\n';
  xml += '      <HasEndTime>true</HasEndTime>\r\n';
  xml += '      <EndDateTimeLocalOffset>P1D</EndDateTimeLocalOffset>\r\n';
  xml += '      <IsOffer>false</IsOffer>\r\n';
  xml += '    </Settings>\r\n';
  xml += '    <Target>\r\n';
  xml += '      <ComputerID>' + xmlEscape(PORTAL_CONFIG.rootServerComputerId) + '</ComputerID>\r\n';
  xml += '    </Target>\r\n';
  xml += '  </SingleAction>\r\n';
  xml += '</BES>';
  return xml;
}

// saveRole(role) -- D-13 step 1, and only step 1: stages the role's full
// username snapshot into the root-server audit store. Never touches a
// Computer Group, Task or policy action -- Publish (07-07) is the separate,
// explicit step that changes live targeting.
// saveRole(role, onDone) -- onDone is optional (onSaveRoleClick never passes
// it); when given, it's called onDone(err) after the API call settles, so
// an orchestrating caller (D-21: revokeUsernameFromRole's auto-Publish) can
// chain a Publish immediately after a successful Save without polling the
// DOM for completion.
function saveRole(role, onDone){
  var slug     = roleSlug(role);
  var errEl    = document.getElementById("roleErr_" + slug);
  var resultEl = document.getElementById("roleResult_" + slug);
  var saveBtn  = document.getElementById("saveRole_" + slug);
  var st       = roleState[role];
  if(!st){ if(onDone){ onDone("role not found"); } return; }
  var region = st.selectedRegion;
  var bucket = st.regions[region];
  if(!bucket){ if(onDone){ onDone("region bucket not found"); } return; }

  if(errEl){ errEl.style.display = "none"; errEl.innerHTML = ""; }
  if(resultEl){ resultEl.style.display = "none"; resultEl.innerHTML = ""; }

  var payload = buildRolePublishPayload(role, region, getRoleUsers(role), getAssignedBy());
  var script  = buildAuditWriteActionScript(payload);
  var xml     = buildAuditWriteActionXml(role, region, script);

  if(xml === ""){
    if(errEl){
      errEl.style.display = "";
      errEl.innerHTML = htmlEscape("root server Computer ID not resolved -- Save disabled");
    }
    if(onDone){ onDone("root server Computer ID not resolved"); }
    return;
  }

  if(saveBtn){ saveBtn.disabled = true; }
  setStatus("Saving " + role + (region ? (" (" + region + ")") : "") + "...");

  API.Post("actions", xml, function(e, s, b){
    if(saveBtn){ saveBtn.disabled = false; }
    if(s === 200 || s === 201){
      var bodyText  = (typeof b !== "undefined" && b !== null) ? String(b) : "";
      var actionIdR = parseActionId(bodyText);
      bucket.dirty = false;
      setStatus("Saved.");
      if(resultEl){
        resultEl.style.display = "";
        resultEl.innerHTML = htmlEscape("Saved. Audit action " + (actionIdR || "(unknown)") + " dispatched to the root server. Nothing on the fleet has changed yet -- click Publish to apply.");
      }
      if(onDone){ onDone(null); }
    } else {
      setStatus("Save failed: status=" + s);
      if(errEl){
        errEl.style.display = "";
        errEl.innerHTML = htmlEscape("Save failed: status=" + s + " -- " + (e || ""));
      }
      if(onDone){ onDone("status=" + s + " -- " + (e || "")); }
    }
  });
}

function onSaveRoleClick(slug){
  var role = roleBySlug[slug];
  if(role){ saveRole(role); }
}

// ==========================================================================
// REVOKE (D-18). "Remove" (above) only edits the LOCAL username list -- it
// takes Save+Publish to retarget the role's Computer Group, and even then
// never touches the Map row Assign-RoleMapping.ps1 already wrote on that
// user's own machine (nothing in this pipeline ever clears Active on its
// own). "Revoke now" is the separate, independent, immediate path: it
// deploys a one-off SingleAction targeted (via CustomRelevance, not a
// Computer Group) at every machine whose OWN RoleAwareness.db currently has
// a live Active=1 row for this exact (role, username), and sets
// Active=0 AND Locked_by_Override=1 there right now. No Custom Repository
// staging, no prefetch, no Task -- scripts/Revoke-RoleMapping.ps1 is
// createfile'd fresh by this same action every time, exactly like Save's
// Upsert-RolePublish.ps1, so there is no sha1/size pin to go stale.
// ==========================================================================

// Mirror of scripts/Revoke-RoleMapping.ps1 (repo root). Kept as a literal
// copy here so the Revoke action can createfile it directly on the target
// endpoint without a separate script-deployment step. If you edit
// scripts/Revoke-RoleMapping.ps1, regenerate this array from it (do not
// hand-edit -- see the ROLE_PUBLISH_SCRIPT_LINES comment above for the
// established regeneration discipline). scripts/Revoke-RoleMapping.ps1
// itself remains the source of truth; tests/unit/role_manager.test.js
// asserts this array joins back to that file's exact content.
var REVOKE_ROLE_SCRIPT_LINES = [
  "#Requires -Version 5.1",
  "# Version: 1.0.0",
  "<#",
  ".SYNOPSIS",
  "    Endpoint immediate-revoke writer for the Operator-Role-Group model (D-18). Given a role",
  "    and a username, deactivates that user's Map row on THIS endpoint right now, instead of",
  "    waiting for the role's Computer Group membership change to naturally stop reapplying.",
  "",
  ".DESCRIPTION",
  "    The normal removal path (drop a username from the Role Manager dashboard's Roles tab,",
  "    Save, Publish) only stops the role's policy action from reapplying on that user's",
  "    machine going forward -- it never touches the Map row the earlier Assign-RoleMapping.ps1",
  "    run already wrote there, and nothing in this pipeline ever ages that row out on its own",
  "    (Active is never cleared by anything else; Valid_to just stops being refreshed). Dropped",
  "    users keep showing as \"mapped\" in every Analysis property that reads Active=1 until this",
  "    script -- or the eventual Valid_to expiry the dashboard's Analysis properties now also",
  "    check -- catches up.",
  "",
  "    This script is the deliberate, immediate alternative: it sets Active=0 AND",
  "    Locked_by_Override=1 in one guarded UPDATE, so the revoke cannot be silently undone by a",
  "    stale/in-flight reapply of the OLD Computer Group definition racing the new one during",
  "    Publish's rollout. Re-granting the SAME role to this user later requires clearing",
  "    Locked_by_Override first (a deliberate, visible step) -- Assign-RoleMapping.ps1's own",
  "    guarded UPDATE (`WHERE ... AND Locked_by_Override = 0`) will otherwise keep no-op'ing",
  "    against this row forever.",
  "",
  "    Constrained Language Mode safe: no Add-Type, no System.Data.SQLite, no dynamic .NET type",
  "    loading. Every database call goes through Sqlite-Helper.ps1 (bundled sqlite3.exe).",
  "    Targeted ONLY at machines whose RoleAwareness.db actually has a matching Active=1 row",
  "    (the dashboard's deployed SingleAction's own CustomRelevance enforces this) -- this script",
  "    does not re-check that itself; it trusts its caller the same way Assign-RoleMapping.ps1",
  "    trusts its inputs.",
  "",
  ".PARAMETER Role",
  "    The role name the mapping belongs to, e.g. \"IT Operations\". Trimmed, case preserved.",
  "",
  ".PARAMETER UserName",
  "    The user to revoke. Any DOMAIN\\ prefix or UPN \"@domain\" suffix is stripped; the result is",
  "    lower-cased to match how Initialize-RoleDb.ps1 stores UserID.",
  "",
  ".PARAMETER DatabasePath",
  "    Full path to RoleAwareness.db.",
  "",
  ".PARAMETER SQLDir",
  "    Directory containing sqlite3.exe directly (no arch subfolder).",
  "",
  ".PARAMETER SqliteHelperPath",
  "    Path to the shared Sqlite-Helper.ps1. Default: Sqlite-Helper.ps1 in the same folder as",
  "    -DatabasePath (the layout task 787 lays down).",
  "",
  ".NOTES",
  "    PowerShell 5.1, Constrained Language Mode safe. Aborts via throw (non-zero exit).",
  "#>",
  "[CmdletBinding(SupportsShouldProcess = $true)]",
  "param(",
  "    [Parameter(Mandatory = $true)]",
  "    [string]$Role,",
  "",
  "    [Parameter(Mandatory = $true)]",
  "    [string]$UserName,",
  "",
  "    [Parameter()]",
  "    [string]$DatabasePath = 'C:\\Program Files (x86)\\BigFix Enterprise\\BES Client\\EC\\SoftwarePortal\\RoleAwareness.db',",
  "",
  "    [Parameter()]",
  "    [string]$SQLDir = 'C:\\Program Files (x86)\\BigFix Enterprise\\BES Client\\EC\\sqlite',",
  "",
  "    [Parameter()]",
  "    [string]$SqliteHelperPath",
  ")",
  "",
  "Set-StrictMode -Version Latest",
  "$ErrorActionPreference = 'Stop'",
  "",
  "if ([string]::IsNullOrWhiteSpace($SqliteHelperPath)) {",
  "    $SqliteHelperPath = Join-Path (Split-Path $DatabasePath) 'Sqlite-Helper.ps1'",
  "}",
  "",
  "$logfile = Join-Path (Split-Path $DatabasePath) 'SWDlog.log'",
  "",
  "function Write-Tag {",
  "    param([string]$Tag, [string]$Message)",
  "    $line = \"[$Tag] $Message\"",
  "    Write-Host $line",
  "    try { Add-Content -Path $logfile -Value (\"{0} revoke-role {1}\" -f (Get-Date -Format 's'), $line) -WhatIf:$false } catch { }",
  "}",
  "",
  "function Get-DbRows {",
  "    # Flatten Sqlite-Helper's (return ,$rows) wrapper so multi-row .Count is correct.",
  "    param([string]$Sql, [hashtable]$P = @{})",
  "    $r = Invoke-SqliteCommand -DatabasePath $DatabasePath -SQLDir $SQLDir -Sql $Sql -Parameters $P",
  "    return @($r | ForEach-Object { $_ })",
  "}",
  "",
  "# --- normalise inputs -------------------------------------------------------",
  "$Role = $Role.Trim()",
  "$user = $UserName.Trim().TrimStart('@').Split('\\')[-1]",
  "$user = $user.Split('@')[0].ToLowerInvariant()",
  "",
  "$result = [ordered]@{",
  "    whatif       = [bool]$WhatIfPreference",
  "    role         = $Role",
  "    user         = $user",
  "    rows_revoked = 0",
  "    outcome      = $null",
  "}",
  "",
  "function Write-RunLog {",
  "    $dir = Split-Path $DatabasePath",
  "    $path = Join-Path $dir (\"revoke-role-{0}.json\" -f ((Get-Date).ToUniversalTime().ToString('yyyyMMdd-HHmmss')))",
  "    try {",
  "        Set-Content -Path $path -Value ([pscustomobject]$result | ConvertTo-Json -Depth 5 -Compress) -Encoding UTF8 -WhatIf:$false",
  "    } catch { }",
  "    Write-Host \"----RUN SUMMARY----\"",
  "    Write-Host ([pscustomobject]$result | ConvertTo-Json -Depth 5 -Compress)",
  "}",
  "",
  "try {",
  "    if ([string]::IsNullOrWhiteSpace($Role)) { throw \"[ABORT] -Role is empty\" }",
  "    if ([string]::IsNullOrWhiteSpace($user)) { throw \"[ABORT] -UserName is empty after normalisation\" }",
  "",
  "    if (-not (Test-Path $SqliteHelperPath)) { throw \"[ABORT] Sqlite-Helper.ps1 not found at: $SqliteHelperPath (endpoint not initialised by task 787?)\" }",
  "    . $SqliteHelperPath",
  "",
  "    if (-not (Test-Path $DatabasePath)) { throw \"[ABORT] RoleAwareness.db not found at: $DatabasePath\" }",
  "",
  "    if ($WhatIfPreference) {",
  "        Write-Tag 'WOULD' (\"revoke user '{0}' role '{1}' -> Active=0, Locked_by_Override=1\" -f $user, $Role)",
  "        $result.outcome = 'whatif'",
  "        Write-RunLog",
  "        return",
  "    }",
  "",
  "    # Guarded UPDATE + connection-scoped changes() in ONE call (see Initialize-RoleDb.ps1",
  "    # error 5350 note / Assign-RoleMapping.ps1's identical discipline). No WHERE ... AND",
  "    # Locked_by_Override = 0 guard here -- revoking an ALREADY-locked row (e.g. a second",
  "    # revoke click, or one locked by a prior manual override) is still the correct outcome,",
  "    # never a silent no-op.",
  "    $upd = @(Get-DbRows @\"",
  "UPDATE Map SET Active = 0, Locked_by_Override = 1, Updated_on = datetime('now','localtime')",
  "WHERE UserID = @u AND Role = @r;",
  "SELECT changes() AS n",
  "\"@ @{ u = $user; r = $Role })",
  "    $changed = if ($upd.Count -gt 0) { [int]$upd[0].n } else { 0 }",
  "",
  "    $result.rows_revoked = $changed",
  "    if ($changed -gt 0) {",
  "        $result.outcome = 'revoked'",
  "        Write-Tag 'REVOKE' (\"user='{0}' role='{1}' -> Active=0, Locked_by_Override=1\" -f $user, $Role)",
  "    } else {",
  "        $result.outcome = 'no-matching-row'",
  "        Write-Tag 'OK' (\"user='{0}' role='{1}' -> no matching Map row on this endpoint\" -f $user, $Role)",
  "    }",
  "",
  "    Write-RunLog",
  "}",
  "finally {",
  "    try {",
  "        if (Get-Command Invoke-SqliteCommand -ErrorAction SilentlyContinue) {",
  "            Invoke-SqliteCommand -DatabasePath $DatabasePath -SQLDir $SQLDir -Sql \"PRAGMA wal_checkpoint(TRUNCATE)\" | Out-Null",
  "        }",
  "    } catch { }",
  "}",
  "",
];
var REVOKE_ROLE_SCRIPT = REVOKE_ROLE_SCRIPT_LINES.join('\n');

// actionScriptParamSafe(s) -- strips characters that would break either a
// BigFix ActionScript `parameter "Name"="Value"` literal (") or a
// substitution block ({ }) before embedding operator-typed text (role name,
// username) directly as a literal. sAMAccountNames/role names never
// legitimately contain these -- stripping rather than erroring keeps a
// stray character from ever corrupting the generated ActionScript.
function actionScriptParamSafe(s){
  return String(s || "").replace(/["{}]/g, "");
}

// buildRevokeTargetRelevance(role, username) -- D-18. Client relevance,
// evaluated independently on EVERY endpoint by BigFix to decide whether the
// Revoke SingleAction's Target/CustomRelevance matches it: true only on a
// machine whose OWN RoleAwareness.db currently has a live Active=1 Map row
// for this exact (role, username) pair. Deliberately NOT based on Computer
// Group membership (D-18's whole point is reaching a machine regardless of
// whether it's still in the role's group) and NOT based on the server-side
// Analysis's cached results (which lag up to 5 minutes) -- this is always
// evaluated fresh, directly against that machine's own database.
function buildRevokeTargetRelevance(role, username){
  var safeUser = String(username).toLowerCase().replace(/'/g, "''");
  var safeRole = String(role).replace(/'/g, "''");
  var folderExpr = '(concatenation (if windows of operating system then "\\" else "/") of ' +
    '((item 0 of it;item 1 of it;item 2 of it) of ((pathname of parent folder of parent folder of client folder of site "actionsite") as string,"EC","SoftwarePortal")))';
  return '(exists folder it whose (' +
    '(exists files "RoleAwareness.db" whose (exists sqlite database of it) of it) and ' +
    '(exists rows of statement "SELECT 1 FROM Map WHERE UserID=\'' + safeUser + '\' AND Role=\'' + safeRole +
    '\' AND Active=1" of sqlite database of file "RoleAwareness.db" of it)' +
    ')) of ' + folderExpr;
}

// buildRevokeActionScript(role, username) -- createfile's REVOKE_ROLE_SCRIPT
// (never prefetched -- no Custom Repository staging, no sha1/size pin to go
// stale) and runs it immediately with this exact role/username baked in as
// literal parameters (actionScriptParamSafe-guarded, not resolved from
// client relevance -- unlike Assign-RoleMapping.bes's UserName, Revoke must
// target the SPECIFIC person the admin picked, never "whoever is logged on
// here").
function buildRevokeActionScript(role, username){
  var safeRole = actionScriptParamSafe(role);
  var safeUser = actionScriptParamSafe(username);
  var lines = [];
  lines.push('\tparameter "SWPDir"="{(concatenation (if windows of operating system then "\\" else "/") of ((item 0 of it;item 1 of it;item 2 of it) of ((pathname of parent folder of parent folder of client folder of site "actionsite") as string,"EC","SoftwarePortal")))}"');
  lines.push('\tparameter "SQLiteDir"="{(concatenation (if windows of operating system then "\\" else "/") of ((item 0 of it;item 1 of it;item 2 of it) of ((pathname of parent folder of parent folder of client folder of site "actionsite") as string,"EC","sqlite")))}"');
  lines.push('\tparameter "TargetStore"="{(concatenation (if windows of operating system then "\\" else "/") of ((item 0 of it;item 1 of it;item 2 of it;item 3 of it) of ((pathname of parent folder of parent folder of client folder of site "actionsite") as string,"EC","SoftwarePortal","RoleAwareness.db")))}"');
  lines.push('\tparameter "Role"="' + safeRole + '"');
  lines.push('\tparameter "UserName"="' + safeUser + '"');
  lines.push('');
  lines.push('delete __createfile');
  lines.push('delete "{parameter "SWPDir"}\\rolegroups\\Revoke-RoleMapping.ps1"');
  lines.push('');
  lines.push('createfile until _EOF_');
  lines.push(escapeActionScriptBraces(REVOKE_ROLE_SCRIPT));
  lines.push('_EOF_');
  lines.push('');
  lines.push('move __createfile "{parameter "SWPDir"}\\rolegroups\\Revoke-RoleMapping.ps1"');
  lines.push('');
  lines.push('action uses wow64 redirection {x64 of operating system}');
  lines.push('waithidden powershell.exe -NonInteractive -NoProfile -ExecutionPolicy Bypass -File "{parameter "SWPDir"}\\rolegroups\\Revoke-RoleMapping.ps1" -Role "{parameter "Role"}" -UserName "{parameter "UserName"}" -SQLDir "{parameter "SQLiteDir"}" -DatabasePath "{parameter "TargetStore"}" -SqliteHelperPath "{parameter "SWPDir"}\\Sqlite-Helper.ps1"');
  lines.push('');
  lines.push('delete "{parameter "SWPDir"}\\rolegroups\\Revoke-RoleMapping.ps1"');
  return lines.join('\r\n');
}

// buildRevokeActionXml(role, username) -- SingleAction, element order
// Title -> Relevance -> ActionScript -> Settings -> Target (SKILL.md S3).
// <Relevance>true</Relevance> (unconditional applicability) -- the REAL
// targeting is entirely Target/CustomRelevance's job, mirroring
// buildRolePolicyActionXml's own split between the two.
function buildRevokeActionXml(role, username){
  var stamp = (new Date()).toISOString();
  var title = "DSP RoleRevoke - " + role + " - " + username + " - " + stamp;
  var targetRel = buildRevokeTargetRelevance(role, username);
  var script    = buildRevokeActionScript(role, username);

  var xml  = '<?xml version="1.0" encoding="UTF-8"?>\r\n';
  xml += '<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"';
  xml += ' xsi:noNamespaceSchemaLocation="BES.xsd">\r\n';
  xml += '  <SingleAction>\r\n';
  xml += '    <Title>' + xmlEscape(title) + '</Title>\r\n';
  xml += '    <Relevance>true</Relevance>\r\n';
  xml += '    <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">';
  xml += cdataStart() + xmlCDataSafe(script) + cdataEnd();
  xml += '</ActionScript>\r\n';
  xml += '    <Settings>\r\n';
  xml += '      <ActionUITitle>' + xmlEscape(title) + '</ActionUITitle>\r\n';
  xml += '      <PreActionShowUI>false</PreActionShowUI>\r\n';
  xml += '      <HasEndTime>true</HasEndTime>\r\n';
  xml += '      <EndDateTimeLocalOffset>P1D</EndDateTimeLocalOffset>\r\n';
  xml += '      <IsOffer>false</IsOffer>\r\n';
  xml += '    </Settings>\r\n';
  xml += '    <Target>\r\n';
  xml += '      <CustomRelevance>' + cdataStart() + xmlCDataSafe(targetRel) + cdataEnd() + '</CustomRelevance>\r\n';
  xml += '    </Target>\r\n';
  xml += '  </SingleAction>\r\n';
  xml += '</BES>';
  return xml;
}

// deployRevokeAction(role, username, onDone) -- POSTs the revoke action;
// onDone(err, actionId). No popup dialogs -- the caller surfaces the
// result/error inline, same convention as every other write in this file.
function deployRevokeAction(role, username, onDone){
  var xml = buildRevokeActionXml(role, username);
  API.Post("actions", xml, function(e, s, b){
    if(s === 200 || s === 201){
      var bodyText = (typeof b !== "undefined" && b !== null) ? String(b) : "";
      if(onDone){ onDone(null, parseActionId(bodyText)); }
    } else {
      if(onDone){ onDone("status=" + s + " -- " + (e || "")); }
    }
  });
}

// revokeUsernameFromRole(role, username) -- D-18, auto-Publish added D-21.
// The "Revoke now" button's handler: removes the username from the LOCAL
// list exactly like Remove, deploys the independent, immediate kill action
// (Map.Active=0/Locked_by_Override=1 on any machine where it's already
// live), AND -- since a plain kill alone leaves the user still matching the
// Computer Group's relevance until a separate Save+Publish -- immediately
// chains Save then Publish for this role+region too, so the group excludes
// them in the same click rather than requiring a second manual step.
// Scoped to roleState[role].selectedRegion, the bucket this button's own
// panel is showing.
function revokeUsernameFromRole(role, username){
  var slug     = roleSlug(role);
  var errEl    = document.getElementById("roleErr_" + slug);
  var resultEl = document.getElementById("roleResult_" + slug);

  removeUsernameFromRole(role, username);

  if(errEl){ errEl.style.display = "none"; errEl.innerHTML = ""; }
  if(resultEl){
    resultEl.style.display = "";
    resultEl.innerHTML = htmlEscape("Revoking " + username + " from " + role + "...");
  }

  deployRevokeAction(role, username, function(err, actionId){
    if(err){
      if(errEl){
        errEl.style.display = "";
        errEl.innerHTML = htmlEscape("Revoke failed: " + err);
      }
      return;
    }
    if(resultEl){
      resultEl.style.display = "";
      resultEl.innerHTML = htmlEscape("Revoke action " + (actionId || "(unknown)") + " dispatched -- deactivating immediately on any machine with a live mapping for " + username + ". Saving and republishing " + role + " now so the group excludes them too...");
    }
  });

  saveRole(role, function(saveErr){
    if(saveErr){
      if(errEl){
        errEl.style.display = "";
        errEl.innerHTML = htmlEscape("Revoke: the immediate kill was dispatched, but auto-Save failed (" + saveErr + ") -- click Save and Publish manually to retarget the group.");
      }
      return;
    }
    publishRole(role, function(publishErr){
      if(publishErr){
        if(errEl){
          errEl.style.display = "";
          errEl.innerHTML = htmlEscape("Revoke: the immediate kill was dispatched and Save succeeded, but auto-Publish failed (" + publishErr + ") -- click Publish manually to retarget the group.");
        }
        return;
      }
      if(resultEl){
        resultEl.style.display = "";
        resultEl.innerHTML = htmlEscape("Revoked " + username + " from " + role + ": immediate kill dispatched, and the group has been republished to exclude them.");
      }
    });
  });
}

// ==========================================================================
// ANALYSIS TAB (D-16, plan 07-09). Read-only -- no API.Post/API.Put/API.Delete
// anywhere in this section (T-07-09-02). D-08: Region is reporting-only, so
// its column is explicitly labelled and never drives any query, filter or
// write in this tab or anywhere else in this file.
// ==========================================================================

// loadAnalysisAge() -- Pitfall 12: show the age of the Analysis data so an
// admin reading it is not misled by the ~5-minute property evaluation lag.
// Reads PORTAL_CONFIG.props.mappedUsers (never a hard-coded property name) so
// the config block stays the single place to change it.
function loadAnalysisAge(){
  var el = document.getElementById("analysisAge");
  if(!el){ return; }
  try {
    var rel = 'maximum of (last report time of it as string) of results whose (value of it != "") of bes property whose (name of it = "' + PORTAL_CONFIG.props.mappedUsers + '")';
    var d = EvaluateRelevance(rel);
    if(d && d.length > 0 && String(d[0]) !== ""){
      el.innerText = "Analysis data last reported: " + String(d[0]) + " (properties evaluate every 5 minutes -- expect lag).";
    } else {
      el.innerText = "Analysis data age unavailable -- no reporting computers yet.";
    }
  } catch(ex){
    el.innerText = "Analysis data age unavailable (Analysis not imported yet).";
  }
}

// isUserConfiguredInRole(role, user) -- true when `user` (case/whitespace-
// insensitive) is in roleState[role].users. Backs the main table's
// "Configured?" column; reconcileIntentVsActual (above) is the pure,
// full-list equivalent used for the two reconciliation panels below.
function isUserConfiguredInRole(role, user){
  var st = roleState[role];
  if(!st || !st.users){ return false; }
  var nu = String(user || "").toLowerCase().replace(/^\s+|\s+$/g, "");
  var i;
  for(i = 0; i < st.users.length; i++){
    if(String(st.users[i]).toLowerCase().replace(/^\s+|\s+$/g, "") === nu){ return true; }
  }
  return false;
}

// appendAnalysisCell(tr, text) -- every main-table cell value originates from
// fleet-reported Analysis data (T-07-09-01): always htmlEscape before
// innerHTML, matching the pre-existing loadAnalysisView convention this
// dashboard's Analysis tab is modelled on.
function appendAnalysisCell(tr, text){
  var td = document.createElement("td");
  td.innerHTML = htmlEscape(text);
  tr.appendChild(td);
}

// renderReconciliation(recon) -- renders the two D-16 lists beneath the main
// table. Role/user/computer values are fleet- or admin-supplied text; using
// .innerText (never HTML-parsed) is this dashboard's other established safe
// pattern (07-06) for plain text nodes, so no separate htmlEscape call is
// needed here.
function renderReconciliation(recon){
  var el = document.getElementById("analysisReconcile");
  if(!el){ return; }
  el.innerHTML = "";
  var cfgNotMapped = (recon && recon.configuredNotMapped) || [];
  var mappedNotCfg = (recon && recon.mappedNotConfigured) || [];

  if(cfgNotMapped.length === 0 && mappedNotCfg.length === 0){
    var okDiv = document.createElement("div");
    okDiv.innerText = "Configuration and fleet state agree.";
    el.appendChild(okDiv);
    return;
  }

  var h1 = document.createElement("h2");
  h1.style.margin = "0 0 4px 0";
  h1.style.fontSize = "13px";
  h1.style.color = "#996600";
  h1.innerText = "Configured but never mapped";
  el.appendChild(h1);
  var p1 = document.createElement("div");
  p1.className = "small";
  p1.innerText = "Usually a typo, or a user who has not logged on since Publish.";
  el.appendChild(p1);

  var i;
  if(cfgNotMapped.length === 0){
    var none1 = document.createElement("div");
    none1.className = "dim";
    none1.style.marginTop = "4px";
    none1.innerText = "None.";
    el.appendChild(none1);
  } else {
    var tbl1 = document.createElement("table");
    tbl1.className = "tableGrid";
    tbl1.style.marginTop = "6px";
    var thead1 = document.createElement("thead");
    var htr1 = document.createElement("tr");
    var hth1a = document.createElement("th"); hth1a.innerText = "Role";
    var hth1b = document.createElement("th"); hth1b.innerText = "Username";
    htr1.appendChild(hth1a); htr1.appendChild(hth1b);
    thead1.appendChild(htr1);
    tbl1.appendChild(thead1);
    var tbody1 = document.createElement("tbody");
    for(i = 0; i < cfgNotMapped.length; i++){
      var tr1  = document.createElement("tr");
      tr1.className = "warn-row";
      var tdR1 = document.createElement("td"); tdR1.innerText = cfgNotMapped[i].role;
      var tdU1 = document.createElement("td"); tdU1.innerText = cfgNotMapped[i].user;
      tr1.appendChild(tdR1); tr1.appendChild(tdU1);
      tbody1.appendChild(tr1);
    }
    tbl1.appendChild(tbody1);
    el.appendChild(tbl1);
  }

  var h2 = document.createElement("h2");
  h2.style.margin = "14px 0 4px 0";
  h2.style.fontSize = "13px";
  h2.style.color = "#666666";
  h2.innerText = "Mapped but not configured";
  el.appendChild(h2);
  var p2 = document.createElement("div");
  p2.className = "small";
  p2.innerText = "Legacy rows lapse naturally at Valid_to (D-17) -- no action needed.";
  el.appendChild(p2);

  var j;
  if(mappedNotCfg.length === 0){
    var none2 = document.createElement("div");
    none2.className = "dim";
    none2.style.marginTop = "4px";
    none2.innerText = "None.";
    el.appendChild(none2);
  } else {
    var tbl2 = document.createElement("table");
    tbl2.className = "tableGrid";
    tbl2.style.marginTop = "6px";
    var thead2 = document.createElement("thead");
    var htr2 = document.createElement("tr");
    var hth2a = document.createElement("th"); hth2a.innerText = "Role";
    var hth2b = document.createElement("th"); hth2b.innerText = "Username";
    var hth2c = document.createElement("th"); hth2c.innerText = "Computer";
    htr2.appendChild(hth2a); htr2.appendChild(hth2b); htr2.appendChild(hth2c);
    thead2.appendChild(htr2);
    tbl2.appendChild(thead2);
    var tbody2 = document.createElement("tbody");
    for(j = 0; j < mappedNotCfg.length; j++){
      var tr2  = document.createElement("tr");
      tr2.className = "dim";
      var tdR2 = document.createElement("td"); tdR2.innerText = mappedNotCfg[j].role;
      var tdU2 = document.createElement("td"); tdU2.innerText = mappedNotCfg[j].user;
      var tdC2 = document.createElement("td"); tdC2.innerText = mappedNotCfg[j].computer;
      tr2.appendChild(tdR2); tr2.appendChild(tdU2); tr2.appendChild(tdC2);
      tbody2.appendChild(tr2);
    }
    tbl2.appendChild(tbody2);
    el.appendChild(tbl2);
  }
}

// loadAnalysisView() -- reads mapped_users/map_source/map_region in r.db via
// GetRelevance (D-17/D-16, always through getRelevanceSafe -- never
// EvaluateRelevance, SKILL.md S1, these are remote client Analysis values),
// merges them via mergeAnalysisRows, renders the Computer/User/Role/Source/
// Region (reporting only)/Configured? table, then reconciles configured vs.
// actual via reconcileIntentVsActual and renders both lists. Degrades to an
// explicit "Analysis not reporting yet" message -- never a silently empty
// table -- when all three properties have reported nothing at all.
function loadAnalysisView(){
  var tbody          = document.getElementById("analysisBody");
  var countEl        = document.getElementById("analysisRowCount");
  var reconcileEl     = document.getElementById("analysisReconcile");
  var notReportingEl = document.getElementById("analysisNotReporting");
  if(!tbody){ return; }

  tbody.innerHTML = "";
  if(reconcileEl){ reconcileEl.innerHTML = ""; }
  if(notReportingEl){ notReportingEl.style.display = "none"; notReportingEl.innerHTML = ""; }
  if(countEl){ countEl.innerText = ""; }

  loadAnalysisAge();

  var relMapped = '(name of computer of it as string & "|||" & value of it as string) of results whose (value of it != "") of bes property whose (name of it = "' + PORTAL_CONFIG.props.mappedUsers + '")';
  var relSource = '(name of computer of it as string & "|||" & value of it as string) of results whose (value of it != "") of bes property whose (name of it = "' + PORTAL_CONFIG.props.mapSource + '")';
  var relRegion = '(name of computer of it as string & "|||" & value of it as string) of results whose (value of it != "") of bes property whose (name of it = "' + PORTAL_CONFIG.props.mapRegion + '")';

  var mappedData = getRelevanceSafe(relMapped);
  var sourceData = getRelevanceSafe(relSource);
  var regionData = getRelevanceSafe(relRegion);

  if(mappedData.length === 0 && sourceData.length === 0 && regionData.length === 0){
    if(notReportingEl){
      notReportingEl.style.display = "";
      notReportingEl.innerHTML = htmlEscape("Analysis not reporting yet -- import Dashboard_4_samples/Dereso SWD.bes on the root server and allow time for it to evaluate (properties refresh every 5 minutes).");
    }
    return;
  }

  var rows = mergeAnalysisRows(mappedData, sourceData, regionData);
  var i;
  for(i = 0; i < rows.length; i++){
    rows[i].configured = isUserConfiguredInRole(rows[i].role, rows[i].user);
  }
  analysisRows = rows;
  renderAnalysisTable();

  renderReconciliation(reconcileIntentVsActual(roleState, rows));
}

// analysisRows -- the main table's full, unfiltered/unsorted dataset, cached
// here by loadAnalysisView() so sorting/searching (D-19) never needs a fresh
// relevance query -- both are pure client-side re-renders of the same data.
var analysisRows = [];
var analysisSortKey = null;
var analysisSortDir = 1;

// ANALYSIS_COLUMNS -- single source of truth for the main table's column
// order/labels/sort keys, so renderAnalysisTableHead and analysisRowValue
// can never drift out of sync with each other.
var ANALYSIS_COLUMNS = [
  { key: "computer",   label: "Computer" },
  { key: "user",       label: "User" },
  { key: "role",       label: "Role" },
  { key: "source",     label: "Source" },
  { key: "region",     label: "Region (reporting only)" },
  { key: "configured", label: "Configured?" }
];

// analysisRowValue(row, key) -- the single place that knows how to read a
// sortable/searchable value off an analysisRows entry for a given column key.
function analysisRowValue(row, key){
  if(key === "computer"){ return row.computerName; }
  if(key === "user"){ return row.user; }
  if(key === "role"){ return row.role; }
  if(key === "source"){ return row.source; }
  if(key === "region"){ return row.region; }
  if(key === "configured"){ return row.configured ? "Yes" : "No"; }
  return "";
}

// renderAnalysisTableHead() -- (re)builds the header row from
// ANALYSIS_COLUMNS, marking whichever column analysisSortKey currently
// points at with a triangle indicating ascending/descending. Every heading
// is clickable.
function renderAnalysisTableHead(){
  var theadRow = document.getElementById("analysisHeadRow");
  if(!theadRow){ return; }
  theadRow.innerHTML = "";

  var i, col, th, label;
  for(i = 0; i < ANALYSIS_COLUMNS.length; i++){
    col = ANALYSIS_COLUMNS[i];
    th = document.createElement("th");
    th.style.cursor = "pointer";
    label = col.label;
    if(analysisSortKey === col.key){ label += (analysisSortDir === 1 ? " ▲" : " ▼"); }
    th.innerText = label;
    th.onclick = (function(key){ return function(){ onAnalysisSortClick(key); }; })(col.key);
    theadRow.appendChild(th);
  }
}

// onAnalysisSortClick(key) -- clicking the currently-sorted column reverses
// direction; clicking a different one sorts by it ascending.
function onAnalysisSortClick(key){
  if(analysisSortKey === key){
    analysisSortDir = -analysisSortDir;
  } else {
    analysisSortKey = key;
    analysisSortDir = 1;
  }
  renderAnalysisTable();
}

function onAnalysisSearchKeyup(){
  renderAnalysisTable();
}

// renderAnalysisTable() -- the only thing that actually writes to
// #analysisBody: applies the current search term (whitespace-tokenized,
// case-insensitive substring match across every column) and sort state to
// analysisRows, then renders. Called after every loadAnalysisView() refresh
// AND after every search keystroke / heading click -- none of those re-query
// relevance, matching the Roles tab's established group-search convention.
function renderAnalysisTable(){
  var tbody   = document.getElementById("analysisBody");
  var countEl = document.getElementById("analysisRowCount");
  if(!tbody){ return; }

  var searchInput = document.getElementById("analysisSearch");
  var search = String(searchInput ? searchInput.value : "").toLowerCase();
  var terms  = search === "" ? [] : search.split(/\s+/).filter(function(t){ return t !== ""; });

  var filtered;
  if(terms.length === 0){
    filtered = analysisRows.slice();
  } else {
    filtered = [];
    var i, row, hay, match, t;
    for(i = 0; i < analysisRows.length; i++){
      row = analysisRows[i];
      hay = (row.computerName + " " + row.user + " " + row.role + " " + row.source + " " + row.region + " " + (row.configured ? "yes" : "no")).toLowerCase();
      match = true;
      for(t = 0; t < terms.length; t++){
        if(hay.indexOf(terms[t]) < 0){ match = false; break; }
      }
      if(match){ filtered.push(row); }
    }
  }

  if(analysisSortKey){
    var sortKey = analysisSortKey, sortDir = analysisSortDir;
    filtered.sort(function(a, b){
      var av = String(analysisRowValue(a, sortKey)).toLowerCase();
      var bv = String(analysisRowValue(b, sortKey)).toLowerCase();
      if(av < bv){ return -1 * sortDir; }
      if(av > bv){ return 1 * sortDir; }
      return 0;
    });
  }

  renderAnalysisTableHead();

  tbody.innerHTML = "";
  if(filtered.length === 0){
    var emptyTr = document.createElement("tr");
    var emptyTd = document.createElement("td");
    emptyTd.colSpan = ANALYSIS_COLUMNS.length;
    emptyTd.className = "dim";
    emptyTd.innerText = analysisRows.length === 0
      ? "No reporting computers -- ensure Analysis is imported and clients have checked in."
      : "No rows match this search.";
    emptyTr.appendChild(emptyTd);
    tbody.appendChild(emptyTr);
  } else {
    var j, r, tr;
    for(j = 0; j < filtered.length; j++){
      r = filtered[j];
      tr = document.createElement("tr");
      if(!r.configured){ tr.className = "warn-row"; }
      appendAnalysisCell(tr, r.computerName);
      appendAnalysisCell(tr, r.user);
      appendAnalysisCell(tr, r.role);
      appendAnalysisCell(tr, r.source);
      appendAnalysisCell(tr, r.region);
      appendAnalysisCell(tr, r.configured ? "Yes" : "No");
      tbody.appendChild(tr);
    }
  }

  if(countEl){
    countEl.innerText = terms.length === 0
      ? analysisRows.length + " row" + (analysisRows.length === 1 ? "" : "s") + "."
      : filtered.length + " of " + analysisRows.length + " rows match.";
  }
}
</script>
      ]]></Head>
      <HTML><![CDATA[
<div class="dashboardVersion">v2.12.1</div>
<div class="page">
  <h1>Dereso Role Manager</h1>
  <div id="globalError" class="error-row" style="display:none;padding:6px 8px;margin-bottom:8px;"></div>
  <div id="status" class="small"></div>
  <div style="margin:4px 0 10px 0;">
    <span id="configStatus" class="small"></span>
    <span class="btn" style="margin-left:8px;padding:2px 8px;" onclick="onReloadConfigClick()">Reload config</span>
  </div>

  <div class="tabBar">
    <span id="tabBtnRoles"    class="tabBtn tabActive" onclick="switchTab('Roles')">Roles</span>
    <span id="tabBtnAnalysis" class="tabBtn"           onclick="switchTab('Analysis')">Analysis</span>
    <span id="tabBtnSettings" class="tabBtn"           onclick="switchTab('Settings')">Settings</span>
  </div>

  <!-- ================= Roles ================= -->
  <div id="tabRoles">
    <div class="panel"><div class="panelBody">
      <span class="small">Edit each role's username list below, then click Save to stage the change in the root-server audit store. Publish is the separate, explicit step that applies that role's change to the live fleet (Computer Group, Task and policy action) -- Save must run first for each new edit.</span>
    </div></div>
    <div class="panel"><div class="panelBody">
      <h2 style="margin:0 0 8px 0;color:#2a5d9f;font-size:14px;">Prerequisites</h2>
      <span class="small">Every role's policy action prefetches <code>Assign-RoleMapping.ps1</code> from the root server's Custom Repository. Stage it once -- and again whenever the script changes -- before publishing any role.</span>
      <div class="small" style="margin-top:6px;">Pinned SHA1: <code>eeeae841d9cc88d411c0b935af890f2b4f3a9aad</code> &middot; size: <code>9674</code> bytes</div>
      <div style="margin-top:10px;">
        <span class="btnGreen" id="stageScriptBtn" onclick="onStageEndpointScriptClick()">Stage endpoint script on root server</span>
      </div>
      <div id="stageScriptNote" class="small warn" style="margin-top:6px;"></div>
      <div id="stageScriptResult" class="small" style="display:none;margin-top:6px;"></div>
      <div id="stageScriptErr" class="small warn" style="display:none;margin-top:6px;"></div>

      <div style="margin-top:14px;border-top:1px solid #dddddd;padding-top:10px;">
        <span class="small">Every endpoint must first run the <b>Initialize Current User and UserRole DB</b> task (RoleAwareness.db, Sqlite-Helper.ps1, sqlite3.exe). Publish it to this site from here so its prefetch URL carries this environment's root server port as a literal. <code>sqlite-tools-win-x64-3530100.zip</code> must already be uploaded to <code>Uploads/CustomRepository/sqlite_util/</code>.</span>
        <div id="prefetchPortInfo" class="small" style="margin-top:6px;"></div>
        <div style="margin-top:10px;">
          <span class="btnGreen" id="initRoleDbBtn" onclick="onPublishInitRoleDbClick()">Publish Init RoleDB task</span>
        </div>
        <div id="initRoleDbResult" class="small" style="display:none;margin-top:6px;"></div>
        <div id="initRoleDbErr" class="small warn" style="display:none;margin-top:6px;"></div>
      </div>
    </div></div>
    <div id="rolePanelsContainer"></div>
  </div>

  <!-- ================= Analysis ================= -->
  <div id="tabAnalysis" style="display:none;">
    <div class="panel"><div class="panelBody">
      <span class="small">Read-only view of what actually landed in RoleAwareness.db across the fleet (D-16), and a reconciliation against each role's configured username list. The Region column is reporting-only -- nothing here writes, filters targeting by, or publishes a region (D-08).</span>
      <div style="margin-top:8px;">
        <span class="btn" onclick="loadAnalysisView()">Refresh</span>
        <span id="analysisRowCount" class="small" style="margin-left:8px;"></span>
      </div>
      <div id="analysisAge" class="small" style="margin-top:6px;"></div>
      <div id="analysisNotReporting" class="warn small" style="display:none;margin-top:8px;"></div>
    </div></div>
    <div class="panel"><div class="panelBody">
      <input type="text" class="txtWide" id="analysisSearch" placeholder="Search computer, user, role, source, region..." onkeyup="onAnalysisSearchKeyup()" autocomplete="off">
      <div class="small" style="margin-top:4px;">Click a column heading to sort by it; click again to reverse.</div>
      <table class="tableGrid" style="margin-top:8px;">
        <thead><tr id="analysisHeadRow"></tr></thead>
        <tbody id="analysisBody"></tbody>
      </table>
    </div></div>
    <div class="panel"><div class="panelBody">
      <div id="analysisReconcile"></div>
    </div></div>
  </div>

  <!-- ================= Settings (v2.12.0) ================= -->
  <div id="tabSettings" style="display:none;">
    <div class="panel"><div class="panelBody">
      <span class="small">Shared settings used by both the Role Manager and the Fixlet Console, stored in the site file <code>dsp_config.json</code>. Edit below, click <b>Generate JSON</b>, save the output as <code>dsp_config.json</code> and upload it to the site (Manage Site Files, replacing the old one). Then click <b>Reload config</b> here and in the Fixlet Console. One entry per line.</span>
      <div id="settingsSourceNote" class="small" style="margin-top:6px;"></div>
    </div></div>
    <div class="panel"><div class="panelBody">
      <table class="rowTable">
        <tr>
          <td class="lbl" style="vertical-align:top;width:170px;">Roles</td>
          <td><textarea id="setRoles" rows="6" style="width:340px;"></textarea>
            <div class="small">Not allowed in a role name: <code>"</code> <code>,</code> <code>|</code> <code>\</code>. Renaming a role is a remove + add: the old role's groups, tasks and actions stay until you remove them. The Console's "Invalidated" option is always added there and does not belong here.</div></td>
        </tr>
        <tr>
          <td class="lbl" style="vertical-align:top;">Software categories</td>
          <td><textarea id="setCategories" rows="8" style="width:340px;"></textarea></td>
        </tr>
        <tr>
          <td class="lbl" style="vertical-align:top;">Category suggestions</td>
          <td><textarea id="setCategoryMap" rows="10" style="width:560px;" wrap="off"></textarea>
            <div class="small">One per line: <code>Product name = Category</code>. Used by the Console to suggest a category for catalog items that have none.</div></td>
        </tr>
        <tr>
          <td class="lbl">Console default site</td>
          <td><input type="text" id="setDefaultSite" class="txtWide"></td>
        </tr>
        <tr>
          <td class="lbl" style="vertical-align:top;">Update source sites</td>
          <td><textarea id="setSourceSites" rows="3" style="width:340px;"></textarea>
            <div class="small">External sites the Console's Check for Updates tab scans.</div></td>
        </tr>
        <tr>
          <td class="lbl">Default offer expiry (days)</td>
          <td><input type="text" id="setExpiryDays" style="width:60px;"></td>
        </tr>
      </table>
      <div style="margin-top:10px;">
        <span class="btnGreen" id="settingsGenerateBtn" onclick="onSettingsGenerateClick()">Generate JSON</span>
        <span class="btn" style="margin-left:6px;" onclick="onSettingsCheckClick()">Check</span>
        <span class="btn" style="margin-left:6px;" onclick="onSettingsDiscardClick()">Discard edits</span>
      </div>
      <div id="settingsErr" class="small error-row" style="display:none;margin-top:8px;padding:6px;"></div>
      <div id="settingsWarn" class="small warn" style="display:none;margin-top:8px;"></div>
      <div id="settingsJsonWrap" style="display:none;margin-top:10px;">
        <div class="small">Complete <code>dsp_config.json</code> -- already selected; press Ctrl+C, paste into the file, then upload it:</div>
        <textarea id="settingsJsonOut" rows="16" style="width:100%;font-family:Consolas,monospace;" wrap="off" readonly="readonly"></textarea>
      </div>
    </div></div>
  </div>

  <script>
  try {
    initDashboard();
  } catch(ex){
    showGlobalError("Init error: " + (ex.message || ex.description || String(ex)));
  }
  </script>
</div>
      ]]></HTML>
    </Page>
  </Wizard>
</BES>
