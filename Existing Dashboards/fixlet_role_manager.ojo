<?xml version="1.0" encoding="UTF-8"?>
<BES>
  <Wizard>
    <Title>Dereso Role Manager</Title>
    <UIHooks LaunchType="Document" RequiresAuthoring="false" Menu="Dashboards"></UIHooks>
    <DefaultPage>main</DefaultPage>

    <Page Name="main" DocType="HTML">
      <Title>Dereso Role Manager</Title>
      <Head><![CDATA[
<meta http-equiv="X-UA-Compatible" content="IE=9">
<style type="text/css">
body { font-family: Arial; font-size: 11px; background: #f3f3f3; margin: 0; padding: 0; }
.page { padding: 16px; }
h1 { color: #2a5d9f; font-size: 24px; margin: 0 0 12px 0; font-weight: bold; }
.panel { background: #ffffff; border: 1px solid #d7dbe0; margin-bottom: 14px; }
.panelBody { padding: 12px; }
.rowTable { width: 100%; border-collapse: collapse; }
.rowTable td { padding: 6px 8px; vertical-align: middle; border: none; }
.lbl { font-weight: bold; color: #333333; white-space: nowrap; }
input[type=text], input[type=number], textarea, select { font-family: Arial; font-size: 11px; border: 1px solid #c8c8c8; padding: 4px 6px; }
.txt { width: 260px; }
.txtWide { width: 340px; }
.btn { font-family: Arial; font-size: 11px; padding: 6px 14px; border: 1px solid #b3b3b3; background: #f7f7f7; cursor: pointer; }
.btnGreen { font-family: Arial; font-size: 11px; padding: 8px 18px; border: 1px solid #237241; background: #33a05a; color: #ffffff; font-weight: bold; cursor: pointer; }
.tableGrid { width: 100%; border-collapse: collapse; background: #ffffff; }
.tableGrid td, .tableGrid th { border: 1px solid #d7dbe0; padding: 6px 8px; vertical-align: middle; }
.tableGrid th { background: #f4f6f8; color: #2a5d9f; text-align: left; }
.small { color: #666666; font-size: 10px; }
.warn { color: #996600; }
.warn-row { background: #fffbe6; }
.error-row { background: #fff0f0; }
.dim { color: #aaaaaa; }
.tabBar { margin: 0 0 14px 0; border-bottom: 2px solid #2a5d9f; }
.tabBtn { font-family: Arial; font-size: 12px; padding: 8px 16px; border: 1px solid #d7dbe0; border-bottom: none; background: #eef1f4; cursor: pointer; margin-right: 3px; }
.tabActive { background: #2a5d9f; color: #ffffff; font-weight: bold; }
</style>
<script language="javascript">
// ==========================================================================
// PORTAL CONFIGURATION -- Edit this block only.
// D-14 "Dereso Role Manager" -- replaces fixlet_role_admin.ojo and
// fixlet_role_assigner.ojo (both retired to Existing Dashboards/archive/).
// Role -> username-list editing/Publish flow only; no GroupRoleMap, no
// RolePublication, no Region picker, no CSV break-glass.
// ==========================================================================
var PORTAL_CONFIG = {
  siteName: 'Dereso Software Portal',
  // D-03: role list is fixed/small, edited here -- not dynamically added/removed
  // from the dashboard UI.
  roles: ["IT Operations", "Business Operations"],
  // D-10: optional per-role scope filter -- the same four standard groups every
  // dashboard in this family offers, plus an empty "(none)" option rendered by
  // the UI in a later plan.
  targetGroups: ['All Workstations', 'IT Department', 'Finance Department', 'All Servers'],
  groupTitlePrefix:  'DSP Role - ',           // Computer Group title = prefix + role
  taskTitlePrefix:   'Assign Role Mapping - ',// per-role Task title  = prefix + role
  actionTitlePrefix: 'DSP RoleMap - ',        // policy action title  = prefix + role
  // Resolved once at console render time (bigfix-relevance skill S1) -- current
  // console operator's name, stamps __ASSIGNED_BY__ / RolePublishRun.Published_by.
  // getAssignedBy() below guards the empty-result case.
  assignedBy: '<?relevance name of current console operator ?>',
  // Resolved once at console render time -- the BES Root Server's own Computer ID,
  // the D-07 audit-write SingleAction's <Target><ComputerID> (verbatim from
  // fixlet_dispatcher.ojo).
  rootServerComputerId: '<?relevance concatenation "" of ((id of it as string) of bes computers whose(exists value whose (it = "BES Root Server") of result (it, bes property "BES Relay Service Installed"))) ?>',
  // D-16/D-02: the four Analysis property names published by
  // Dashboard_4_samples/Dereso SWD.bes (users/mapped_users/map_source/map_region).
  props: {
    knownUsers:  "users in r.db",
    mappedUsers: "mapped_users in r.db",
    mapSource:   "map_source in r.db",
    mapRegion:   "map_region in r.db"
  },
  fieldSep: "\u001f"
};
// ==========================================================================
// END PORTAL CONFIGURATION
// ==========================================================================

// btoa polyfill for IE9 -- verbatim from fixlet_role_assigner.ojo (L59-72)
if (typeof btoa === 'undefined') {
  btoa = function(s) {
    var CHARS = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/';
    var str = String(s), out = '', i = 0;
    while (i < str.length) {
      var b0 = str.charCodeAt(i++), b1 = str.charCodeAt(i++), b2 = str.charCodeAt(i++);
      out += CHARS.charAt(b0 >> 2)
           + CHARS.charAt(((b0 & 3) << 4) | (b1 >> 4))
           + (isNaN(b1) ? '=' : CHARS.charAt(((b1 & 15) << 2) | (b2 >> 6)))
           + (isNaN(b2) ? '=' : CHARS.charAt(b2 & 63));
    }
    return out;
  };
}

// -- HTML escaping to prevent XSS from untrusted data -- verbatim from fixlet_role_assigner.ojo (L83-89)
function htmlEscape(s){
  return String(s)
    .replace(/&/g,"&amp;")
    .replace(/</g,"&lt;")
    .replace(/>/g,"&gt;")
    .replace(/"/g,"&quot;");
}

// -- Status -- verbatim from fixlet_role_assigner.ojo (L92-95)
function setStatus(msg){
  var el = document.getElementById("status");
  if(el){ el.innerText = msg; }
}

// -- Surface a fatal init/runtime error in the shared banner -- no popup dialogs --
function showGlobalError(msg){
  var el = document.getElementById("globalError");
  if(el){ el.style.display = ""; el.innerHTML = htmlEscape(msg); }
  setStatus(msg);
}

// -- XML helpers -- verbatim from fixlet_dispatcher.ojo (L470-481) / fixlet_role_assigner.ojo (L98-109)
function xmlEscape(s){
  return String(s)
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;")
    .replace(/'/g, "&apos;");
}
function cdataStart(){ return '<!' + '[CDATA['; }
function cdataEnd(){   return ']]' + '>'; }
function xmlCDataSafe(s){ return String(s).replace(/\]\]>/g, ']]]]><![CDATA[>'); }

// -- IE9 XML parse (MSXML) -- verbatim from fixlet_role_admin.ojo (L114-136)
function parseXml(text){
  var xml = new ActiveXObject("Msxml2.DOMDocument.6.0");
  xml.async = false;
  xml.setProperty("SelectionLanguage", "XPath");
  xml.loadXML(String(text));
  return xml;
}
function parseActionId(body){
  if(!body){ return ""; }
  try {
    var xml = parseXml(body);
    var nodes = xml.getElementsByTagName("Action");
    if(nodes.length > 0){
      var idNode = nodes[0].selectSingleNode("ID");
      if(idNode && idNode.text){ return idNode.text; }
    }
  } catch(ex) {}
  var m = /\/api\/action\/(\d+)/i.exec(String(body));
  if(m && m[1]){ return m[1]; }
  m = /<ID>(\d+)<\/ID>/i.exec(String(body));
  return (m && m[1]) ? m[1] : "";
}

// -- ActionScript brace escaping (bigfix-relevance skill S2 / fixlet_dispatcher.ojo L622-632) --
// Only the OPENING brace is doubled. "{{" is BigFix ActionScript's escape for a
// literal "{" -- it never opens a real {relevance} substitution, so a later plain
// "}" has nothing to close and passes through as a literal character on its own.
// Doubling "}" too produces a stray extra "}" at the end of every block -- a
// previously-shipped, confirmed bug in this codebase's staging-action history.
// Never "fix" this to double both braces.
function escapeActionScriptBraces(s){
  return String(s).replace(/\{/g, "{{");
}

// -- getRelevanceSafe(rel) -- GetRelevance wrapper that returns [] on any failure --
// verbatim from fixlet_role_assigner.ojo (L863-872)
function getRelevanceSafe(rel){
  try {
    var d = GetRelevance(rel);
    return d ? d : [];
  } catch(ex){
    return [];
  }
}

// -- Guards PORTAL_CONFIG.assignedBy: an empty console-operator-name resolution --
// -- must never produce an empty RolePublishRun.Published_by / __ASSIGNED_BY__. --
function getAssignedBy(){
  var v = PORTAL_CONFIG.assignedBy;
  if(!v || String(v).replace(/^\s+|\s+$/g, "") === ""){ return "console-operator"; }
  return v;
}

// ==========================================================================
// TAB SWITCHING (fixlet_role_admin.ojo L166-178 pattern)
// ==========================================================================
function switchTab(tab){
  var ids = ["Roles","Analysis"];
  var i, panel, btn;
  for(i=0;i<ids.length;i++){
    panel = document.getElementById("tab"+ids[i]);
    btn   = document.getElementById("tabBtn"+ids[i]);
    if(panel){ panel.style.display = (ids[i]===tab) ? "" : "none"; }
    if(btn){ btn.className = (ids[i]===tab) ? "tabBtn tabActive" : "tabBtn"; }
  }
}

// -- Init -- populates roleState from PORTAL_CONFIG.roles (D-03: config is
// the only source of the role list, never mutated at runtime), loads the
// D-02 known-users cache, then renders the Roles tab.
function initDashboard(){
  switchTab("Roles");
  var i, role;
  for(i = 0; i < PORTAL_CONFIG.roles.length; i++){
    role = PORTAL_CONFIG.roles[i];
    roleState[role] = { users: [], scopeGroupId: "", scopeSiteName: "", dirty: false, lastSavedRunId: null };
    roleBySlug[roleSlug(role)] = role;
  }
  loadKnownUsers();
  renderRolesTab();
  updateStageEndpointScriptUI();
  setStatus("Ready.");
}

// ==========================================================================
// PURE BUILDERS -- unit-tested in tests/unit/role_manager.test.js
// None of these touch the DOM or call API.*. findBesObjectIdByTitle calls
// EvaluateRelevance (a console-provided read-only query function, not local
// mutable state) so it can't run under Node -- everything else here is a
// deterministic string-in/string-out function of its own arguments plus
// PORTAL_CONFIG.
// ==========================================================================

// buildRoleGroupRelevance(usernames, scopeGroupId, scopeSiteName) -- D-09/D-10.
// T-07-04-01 (Elevation of Privilege, highest-impact bug this generator could
// ship): a role with ZERO usernames must never produce an unconstrained
// match. This guard is the single most important line in this file -- it
// beats every other branch below, including a supplied scope group. An empty
// or all-blank username list always yields the literal string "false", never
// "true", never an empty `set of ()`.
function buildRoleGroupRelevance(usernames, scopeGroupId, scopeSiteName){
  if(!usernames || usernames.length === 0){ return "false"; }
  var seen   = {};
  var quoted = [];
  var i, u;
  for(i = 0; i < usernames.length; i++){
    u = String(usernames[i]).toLowerCase().replace(/^\s+|\s+$/g, "");
    if(u === ""){ continue; }
    if(seen[u]){ continue; }
    seen[u] = true;
    // T-07-04-02 (Tampering): double any embedded double-quote before
    // interpolating into the relevance string literal -- matches
    // fixlet_dispatcher.ojo's buildTargetRelevance() escaping discipline.
    quoted.push('"' + u.replace(/"/g, '""') + '"');
  }
  if(quoted.length === 0){ return "false"; }
  var base = '(number of (logged on users whose (name of it as lowercase is contained by ' +
    'set of (' + quoted.join(';') + ')))) = 1';
  if(scopeGroupId){
    var safeSite = String(scopeSiteName || "").toLowerCase().replace(/"/g, '""');
    base += ' AND (member of group ' + scopeGroupId + ' of site whose ' +
      '(name of it as lowercase = "' + safeSite + '" as lowercase))';
  }
  return base;
}

// buildComputerGroupXml(title, domain, relevance) -- Pattern 1.
// Six-element belt-and-suspenders body confirmed accepted live by plan 07-01
// (07-SPIKE-FINDINGS.md Check A, six-element POST -> success=True status=200):
// Title / Domain / JoinByIntersection / IsDynamic / EvaluateOnClient /
// SearchComponentRelevance. No deviation needed -- the spike did not force a
// reduced form.
function buildComputerGroupXml(title, domain, relevance){
  var xml  = '<?xml version="1.0" encoding="UTF-8"?>\r\n';
  xml += '<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"';
  xml += ' xsi:noNamespaceSchemaLocation="BES.xsd">\r\n';
  xml += '  <ComputerGroup>\r\n';
  xml += '    <Title>' + xmlEscape(title) + '</Title>\r\n';
  xml += '    <Domain>' + xmlEscape(domain || "BESC") + '</Domain>\r\n';
  xml += '    <JoinByIntersection>true</JoinByIntersection>\r\n';
  xml += '    <IsDynamic>true</IsDynamic>\r\n';
  xml += '    <EvaluateOnClient>true</EvaluateOnClient>\r\n';
  xml += '    <SearchComponentRelevance Comparison="IsTrue">\r\n';
  xml += '      <Relevance>' + cdataStart() + xmlCDataSafe(relevance) + cdataEnd() + '</Relevance>\r\n';
  xml += '    </SearchComponentRelevance>\r\n';
  xml += '  </ComputerGroup>\r\n';
  xml += '</BES>';
  return xml;
}

// buildRolePolicyTaskXml(templateFields, role, assignedBy) -- Pattern 3 step 1.
// templateFields is a plain object carrying fields extracted (via
// getElementsByTagName, by the caller) from bes/Assign-RoleMapping.bes:
//   { title, description, relevances (array), category, source, sourceId,
//     sourceReleaseDate, sourceSeverity, cveNames, sansId,
//     mimeFields (array of {name,value}), domain,
//     actionDescription {preLink,link,postLink}, actionScript }
// T-07-04-04 (Tampering, in-place-mutation pitfall): this always emits a
// brand-new <BES><Task> document in SKILL.md S7 schema order -- it never
// mutates a fetched DOM and re-serialises it.
function buildRolePolicyTaskXml(templateFields, role, assignedBy){
  var tf  = templateFields || {};
  var sub = function(s){
    return String(s || "")
      .replace(/__ROLE__/g, role)
      .replace(/__ASSIGNED_BY__/g, assignedBy);
  };
  // The Task <Title> is always PORTAL_CONFIG.taskTitlePrefix + role (not the
  // raw template title) so findBesObjectIdByTitle can locate this exact Task
  // by title on every subsequent Publish.
  var title             = PORTAL_CONFIG.taskTitlePrefix + role;
  var description        = sub(tf.description);
  var relevances          = tf.relevances || [];
  var category            = tf.category || "";
  var source               = tf.source || "Internal";
  var sourceId             = tf.sourceId || "";
  var sourceReleaseDate    = tf.sourceReleaseDate || "";
  var sourceSeverity       = tf.sourceSeverity || "";
  var cveNames             = tf.cveNames || "";
  var sansId               = tf.sansId || "";
  var mimeFields           = tf.mimeFields || [];
  var domain               = tf.domain || "BESC";
  var actionDescription    = tf.actionDescription || {};
  var preLink              = actionDescription.preLink || "Click ";
  var link                 = actionDescription.link || "here";
  var postLink             = sub(actionDescription.postLink || "");
  // __USERNAME__ is deliberately NOT substituted here -- the ActionScript
  // resolves it at runtime from client relevance ({name of current user as
  // lowercase}). Substituting a real username would defeat the whole
  // "exactly one of N" design (the Computer Group already guarantees
  // uniqueness; baking a username in here would make every deployed copy of
  // this Task target a single fixed person instead of "whoever is logged on
  // and in the role").
  var actionScript = sub(tf.actionScript);

  var xml  = '<?xml version="1.0" encoding="UTF-8"?>\r\n';
  xml += '<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">\r\n';
  xml += '  <Task>\r\n';
  xml += '    <Title>' + xmlEscape(title) + '</Title>\r\n';
  xml += '    <Description>' + cdataStart() + xmlCDataSafe(description) + cdataEnd() + '</Description>\r\n';
  var ri;
  for(ri = 0; ri < relevances.length; ri++){
    // Defensive: the current bes/Assign-RoleMapping.bes template carries no
    // tokens in either <Relevance> body, so this is a no-op today -- but
    // substituting here too (same __ROLE__/__ASSIGNED_BY__ global replace as
    // every other field) means a future template edit that adds a token to a
    // Relevance can't silently leak an unsubstituted placeholder.
    xml += '    <Relevance>' + cdataStart() + xmlCDataSafe(sub(relevances[ri])) + cdataEnd() + '</Relevance>\r\n';
  }
  xml += '    <Category>' + xmlEscape(category) + '</Category>\r\n';
  xml += '    <Source>' + xmlEscape(source) + '</Source>\r\n';
  xml += '    <SourceID>' + xmlEscape(sourceId) + '</SourceID>\r\n';
  xml += '    <SourceReleaseDate>' + xmlEscape(sourceReleaseDate) + '</SourceReleaseDate>\r\n';
  xml += '    <SourceSeverity>' + xmlEscape(sourceSeverity) + '</SourceSeverity>\r\n';
  xml += '    <CVENames>' + xmlEscape(cveNames) + '</CVENames>\r\n';
  xml += '    <SANSID>' + xmlEscape(sansId) + '</SANSID>\r\n';
  var mi;
  for(mi = 0; mi < mimeFields.length; mi++){
    xml += '    <MIMEField>\r\n';
    xml += '      <Name>' + xmlEscape(mimeFields[mi].name) + '</Name>\r\n';
    xml += '      <Value>' + xmlEscape(mimeFields[mi].value) + '</Value>\r\n';
    xml += '    </MIMEField>\r\n';
  }
  xml += '    <Domain>' + xmlEscape(domain) + '</Domain>\r\n';
  xml += '    <DefaultAction ID="Action1">\r\n';
  xml += '      <Description>\r\n';
  xml += '        <PreLink>' + xmlEscape(preLink) + '</PreLink>\r\n';
  xml += '        <Link>' + xmlEscape(link) + '</Link>\r\n';
  xml += '        <PostLink>' + xmlEscape(postLink) + '</PostLink>\r\n';
  xml += '      </Description>\r\n';
  xml += '      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">';
  xml += cdataStart() + xmlCDataSafe(actionScript) + cdataEnd();
  xml += '</ActionScript>\r\n';
  xml += '    </DefaultAction>\r\n';
  xml += '  </Task>\r\n';
  xml += '</BES>';
  return xml;
}

// buildRolePolicyActionXml(title, relevance, actionScript, groupId, siteName)
// -- Pattern 3 steps 2-3, D-11. SingleAction only (T-07-04-05) -- never the
// server-evaluated sourced-fixlet action type, whose <CustomRelevance> is
// evaluated server-side where `member of group` cannot resolve (skill S3,
// RESEARCH Pitfall 2). Element
// order is fixed: Title -> Relevance -> ActionScript -> Settings -> Target ->
// MIMEFieldSingleAction -- Target before Settings is a confirmed 400.
function buildRolePolicyActionXml(title, relevance, actionScript, groupId, siteName){
  var safeSite  = String(siteName || "").toLowerCase().replace(/"/g, '""');
  var targetRel = 'member of group ' + groupId + ' of site whose (name of it as lowercase = "' + safeSite + '" as lowercase)';

  // MIMEFieldSingleAction role value: derived from title (this function's
  // fixed signature carries no separate role parameter). Callers build title
  // as PORTAL_CONFIG.actionTitlePrefix + role (D-13/07-07), so stripping that
  // prefix recovers the bare role name; falls back to the full title if the
  // prefix isn't present.
  var roleValue = String(title || "");
  if(roleValue.indexOf(PORTAL_CONFIG.actionTitlePrefix) === 0){
    roleValue = roleValue.substring(PORTAL_CONFIG.actionTitlePrefix.length);
  }

  var xml  = '<?xml version="1.0" encoding="UTF-8"?>\r\n';
  xml += '<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"';
  xml += ' xsi:noNamespaceSchemaLocation="BES.xsd">\r\n';
  xml += '  <SingleAction>\r\n';
  xml += '    <Title>' + xmlEscape(title) + '</Title>\r\n';
  xml += '    <Relevance>' + xmlEscape(relevance) + '</Relevance>\r\n';
  xml += '    <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">';
  xml += cdataStart() + xmlCDataSafe(actionScript) + cdataEnd();
  xml += '</ActionScript>\r\n';
  xml += '    <Settings>\r\n';
  xml += '      <ActionUITitle>' + xmlEscape(title) + '</ActionUITitle>\r\n';
  xml += '      <PreActionShowUI>false</PreActionShowUI>\r\n';
  xml += '      <Reapply>true</Reapply>\r\n';
  xml += '      <HasReapplyLimit>false</HasReapplyLimit>\r\n';
  xml += '      <HasReapplyInterval>true</HasReapplyInterval>\r\n';
  xml += '      <ReapplyInterval>P1D</ReapplyInterval>\r\n';
  xml += '      <IsOffer>false</IsOffer>\r\n';
  xml += '    </Settings>\r\n';
  xml += '    <Target>\r\n';
  xml += '      <CustomRelevance>' + cdataStart() + xmlCDataSafe(targetRel) + cdataEnd() + '</CustomRelevance>\r\n';
  xml += '    </Target>\r\n';
  xml += '    <MIMEFieldSingleAction>\r\n';
  xml += '      <Name>DSP_RoleManager_Role</Name>\r\n';
  xml += '      <Value>' + xmlEscape(roleValue) + '</Value>\r\n';
  xml += '    </MIMEFieldSingleAction>\r\n';
  xml += '  </SingleAction>\r\n';
  xml += '</BES>';
  return xml;
}

// findBesObjectIdByTitle(kind, siteName, title) -- session-relevance
// find-by-title, used by the Publish flow (07-06/07-07) to decide POST
// (create) vs. PUT (update) for each of the three BES object kinds this
// generator manages. kind is "computergroup" | "fixlet" | "action". For
// "action", additionally filters to state of it = "Open" so a previously
// stopped action (create-new-then-stop-previous, this plan's Publish-time
// decision) is never mistaken for the current one.
function findBesObjectIdByTitle(kind, siteName, title){
  var collection;
  if(kind === "computergroup"){ collection = "bes computer groups"; }
  else if(kind === "fixlet"){ collection = "bes fixlets"; }
  else if(kind === "action"){ collection = "bes actions"; }
  else { return null; }

  var safeSite  = String(siteName || "").replace(/"/g, '""');
  var safeTitle = String(title || "").replace(/"/g, '""');
  var rel = '(id of it as string) of ' + collection + ' whose (name of site of it = "' +
    safeSite + '" and name of it = "' + safeTitle + '"';
  if(kind === "action"){
    rel += ' and state of it = "Open"';
  }
  rel += ')';

  try {
    var data = EvaluateRelevance(rel);
    if(data && data.length > 0 && data[0] !== ""){ return String(data[0]); }
  } catch(ex) {}
  return null;
}


// ==========================================================================
// PUBLISH PREREQUISITES (07-07). Task 1: endpoint-script staging into the
// root server's Custom Repository (the prefetch every per-role policy action
// depends on). Task 2: the per-role Task find-or-create (ensureRoleTask).
// Neither writes to RolePublish.db -- Save (07-06) already owns that write.
// Plan 07-08's publishRole() calls ensureRoleTask() directly; the Publish
// button itself (onPublishRoleClick) remains a 07-08 stub, unchanged here.
// ==========================================================================

// Mirror of scripts/Assign-RoleMapping.ps1 (repo root) -- the endpoint script
// every per-role policy action's prefetch block downloads. Kept as a literal
// copy here so the staging action can createfile it directly on the root
// server's own Custom Repository. If you edit scripts/Assign-RoleMapping.ps1,
// regenerate this array from it (do not hand-edit) -- scripts/Assign-RoleMapping.ps1
// itself remains the source of truth; tests/unit/role_manager.test.js asserts
// this array's SHA1 equals the sha1= token bes/Assign-RoleMapping.bes pins.
//
// Joiner convention: scripts/Assign-RoleMapping.ps1 is LF-only (verified --
// unlike scripts/Upsert-RolePublish.ps1, which is CRLF and uses '\r\n' for
// ROLE_PUBLISH_SCRIPT above). ASSIGN_ROLE_MAPPING_SCRIPT_LINES therefore joins
// with a bare '\n' so the reconstructed string is byte-identical to the file
// on disk -- round-trip-verified (sha1 of the joined string equals the file's
// own sha1, 69860a1239e4509dce483a07523ea07e26764279) before this array was pasted
// in. Do not "normalise" this joiner to '\r\n' -- that would break the pin.
var ASSIGN_ROLE_MAPPING_SCRIPT_LINES = [
  "#Requires -Version 5.1",
  "<#",
  ".SYNOPSIS",
  "    Endpoint role-mapping writer for the Operator-Role-Group model. Given a role, a",
  "    username and the issuing operator, ensures the user exists in RoleAwareness.db and",
  "    upserts a UserID -> Role row into the Map table, using the same D-12 discipline as",
  "    Reconcile-LocalRoles.ps1 (INSERT OR IGNORE + a conditional UPDATE guarded by",
  "    Locked_by_Override = 0).",
  "",
  ".DESCRIPTION",
  "    This is the endpoint half of a deliberately simpler assignment model than the Axonius",
  "    snapshot pipeline:",
  "",
  "      * One automatic Computer Group per role. Its membership relevance carries the list",
  "        of operator usernames that hold the role and admits a device only when EXACTLY",
  "        ONE logged-on user is in that list.",
  "      * One policy action per group runs this script. The ActionScript resolves the",
  "        single matching user and passes it as -UserName, so this script does no",
  "        logged-on-user parsing of its own - it trusts its inputs.",
  "      * BigFix Operator -> Role assignments are the source of truth. There is no CSV, no",
  "        snapshot, no GroupRoleMap.",
  "",
  "    Revoke: none. When an operator loses the role they drop out of the Computer Group,",
  "    the policy action stops applying, and the Map row lapses at Valid_to (age-out) - the",
  "    same no-revoke model as Reconcile-LocalRoles.ps1 v1.",
  "",
  "    Constrained Language Mode safe: no Add-Type, no System.Data.SQLite, no dynamic .NET",
  "    type loading. Every database call goes through Sqlite-Helper.ps1 (bundled sqlite3.exe).",
  "    Assumes Sqlite-Helper.ps1 and sqlite3.exe are already staged on the endpoint by the",
  "    \"Init  Current User and UserRole DB\" task (787); the task's <Relevance> gates on that.",
  "",
  ".PARAMETER Role",
  "    The role name to assign, e.g. \"IT Operations\". Inserted into Roles if new to this",
  "    endpoint (D-15 parity with Reconcile-LocalRoles.ps1). Trimmed, case preserved.",
  "",
  ".PARAMETER UserName",
  "    The user to map. Any DOMAIN\\ prefix or UPN \"@domain\" suffix is stripped; the result",
  "    is lower-cased to match how Initialize-RoleDb.ps1 stores UserID.",
  "",
  ".PARAMETER AssignedBy",
  "    Value written to Map.Assigned_By - the identity of the operator who issued the task",
  "    (the ActionScript substitutes it). Default 'OperatorRoleGroup' for a manual run.",
  "",
  ".PARAMETER ValidityMonths",
  "    How far forward the mapped row's Valid_to is pushed. Default 6 (mirrors",
  "    Initialize-RoleDb.ps1 -ValidityMonths / PORTAL_CONFIG.validityMonths).",
  "",
  ".PARAMETER DatabasePath",
  "    Full path to RoleAwareness.db.",
  "",
  ".PARAMETER SQLDir",
  "    Directory containing sqlite3.exe directly (no arch subfolder).",
  "",
  ".PARAMETER SqliteHelperPath",
  "    Path to the shared Sqlite-Helper.ps1. Default: Sqlite-Helper.ps1 in the same folder",
  "    as -DatabasePath (the layout task 787 lays down).",
  "",
  ".NOTES",
  "    PowerShell 5.1, Constrained Language Mode safe. Aborts via throw (non-zero exit).",
  "#>",
  "[CmdletBinding(SupportsShouldProcess = $true)]",
  "param(",
  "    [Parameter(Mandatory = $true)]",
  "    [string]$Role,",
  "",
  "    [Parameter(Mandatory = $true)]",
  "    [string]$UserName,",
  "",
  "    [Parameter()]",
  "    [string]$AssignedBy = 'OperatorRoleGroup',",
  "",
  "    [Parameter()]",
  "    [int]$ValidityMonths = 6,",
  "",
  "    [Parameter()]",
  "    [string]$DatabasePath = 'C:\\Program Files (x86)\\BigFix Enterprise\\BES Client\\EC\\SoftwarePortal\\RoleAwareness.db',",
  "",
  "    [Parameter()]",
  "    [string]$SQLDir = 'C:\\Program Files (x86)\\BigFix Enterprise\\BES Client\\EC\\sqlite',",
  "",
  "    [Parameter()]",
  "    [string]$SqliteHelperPath",
  ")",
  "",
  "Set-StrictMode -Version Latest",
  "$ErrorActionPreference = 'Stop'",
  "",
  "if ([string]::IsNullOrWhiteSpace($SqliteHelperPath)) {",
  "    $SqliteHelperPath = Join-Path (Split-Path $DatabasePath) 'Sqlite-Helper.ps1'",
  "}",
  "",
  "$logfile = Join-Path (Split-Path $DatabasePath) 'SWDlog.log'",
  "",
  "function Write-Tag {",
  "    param([string]$Tag, [string]$Message)",
  "    $line = \"[$Tag] $Message\"",
  "    Write-Host $line",
  "    try { Add-Content -Path $logfile -Value (\"{0} assign-role {1}\" -f (Get-Date -Format 's'), $line) -WhatIf:$false } catch { }",
  "}",
  "",
  "function Get-DbRows {",
  "    # Flatten Sqlite-Helper's (return ,$rows) wrapper so multi-row .Count is correct.",
  "    param([string]$Sql, [hashtable]$P = @{})",
  "    $r = Invoke-SqliteCommand -DatabasePath $DatabasePath -SQLDir $SQLDir -Sql $Sql -Parameters $P",
  "    return @($r | ForEach-Object { $_ })",
  "}",
  "",
  "function Invoke-DbWrite {",
  "    param([string]$Sql, [hashtable]$P = @{})",
  "    if ($WhatIfPreference) { return }",
  "    Invoke-SqliteCommand -DatabasePath $DatabasePath -SQLDir $SQLDir -Sql $Sql -Parameters $P | Out-Null",
  "}",
  "",
  "# --- normalise inputs -------------------------------------------------------",
  "$Role = $Role.Trim()",
  "$user = $UserName.Trim().TrimStart('@').Split('\\')[-1]",
  "$user = $user.Split('@')[0].ToLowerInvariant()",
  "",
  "$result = [ordered]@{",
  "    whatif               = [bool]$WhatIfPreference",
  "    role                 = $Role",
  "    user                 = $user",
  "    assigned_by          = $AssignedBy",
  "    validity_months      = $ValidityMonths",
  "    roles_created        = 0",
  "    rows_updated         = 0",
  "    rows_blocked_by_lock = 0",
  "    outcome              = $null",
  "}",
  "",
  "function Write-RunLog {",
  "    $dir = Split-Path $DatabasePath",
  "    $path = Join-Path $dir (\"assign-role-{0}.json\" -f ((Get-Date).ToUniversalTime().ToString('yyyyMMdd-HHmmss')))",
  "    try {",
  "        Set-Content -Path $path -Value ([pscustomobject]$result | ConvertTo-Json -Depth 5 -Compress) -Encoding UTF8 -WhatIf:$false",
  "    } catch { }",
  "    Write-Host \"----RUN SUMMARY----\"",
  "    Write-Host ([pscustomobject]$result | ConvertTo-Json -Depth 5 -Compress)",
  "}",
  "",
  "try {",
  "    if ([string]::IsNullOrWhiteSpace($Role)) { throw \"[ABORT] -Role is empty\" }",
  "    if ([string]::IsNullOrWhiteSpace($user)) { throw \"[ABORT] -UserName is empty after normalisation\" }",
  "",
  "    if (-not (Test-Path $SqliteHelperPath)) { throw \"[ABORT] Sqlite-Helper.ps1 not found at: $SqliteHelperPath (endpoint not initialised by task 787?)\" }",
  "    . $SqliteHelperPath",
  "",
  "    if (-not (Test-Path $DatabasePath)) { throw \"[ABORT] RoleAwareness.db not found at: $DatabasePath\" }",
  "",
  "    $validModifier = \"+$ValidityMonths months\"",
  "",
  "    if ($WhatIfPreference) {",
  "        Write-Tag 'WOULD' (\"ensure user '{0}', upsert Map: role='{1}' Assigned_By='{2}' Valid_to=now{3}\" -f $user, $Role, $AssignedBy, $validModifier)",
  "        $result.outcome = 'whatif'",
  "        Write-RunLog",
  "        return",
  "    }",
  "",
  "    # 1. Users: INSERT OR IGNORE + UPDATE LastSeen (never delete-and-reinsert)",
  "    Invoke-DbWrite \"INSERT OR IGNORE INTO Users (UserID, LastSeen) VALUES (@u, datetime('now','localtime'))\" @{ u = $user }",
  "    Invoke-DbWrite \"UPDATE Users SET LastSeen = datetime('now','localtime') WHERE UserID = @u\" @{ u = $user }",
  "",
  "    # 2. Roles: role new to this endpoint propagates without an init redeploy (D-15)",
  "    $before = @(Get-DbRows \"SELECT COUNT(*) AS n FROM Roles WHERE Role = @r\" @{ r = $Role })",
  "    Invoke-DbWrite \"INSERT OR IGNORE INTO Roles (Role) VALUES (@r)\" @{ r = $Role }",
  "    $after = @(Get-DbRows \"SELECT COUNT(*) AS n FROM Roles WHERE Role = @r\" @{ r = $Role })",
  "    if ([int]$before[0].n -eq 0 -and [int]$after[0].n -eq 1) { $result.roles_created++ }",
  "",
  "    # 3. Map: create the row if absent, without disturbing any existing state",
  "    Invoke-DbWrite \"INSERT OR IGNORE INTO Map (UserID, Role, Active, Created_on) VALUES (@u, @r, 1, datetime('now','localtime'))\" `",
  "        @{ u = $user; r = $Role }",
  "",
  "    # 4. guarded UPDATE + connection-scoped changes() in ONE call (see Initialize-RoleDb.ps1 error 5350 note)",
  "    $upd = @(Get-DbRows @\"",
  "UPDATE Map SET Active = 1, Updated_on = datetime('now','localtime'),",
  "    Valid_to = datetime('now','localtime', @v),",
  "    Source_Type = 'BigFix Role', Source_Value = @sv, Assigned_By = @ab",
  "WHERE UserID = @u AND Role = @r AND Locked_by_Override = 0;",
  "SELECT changes() AS n",
  "\"@ @{ v = $validModifier; sv = $Role; ab = $AssignedBy; u = $user; r = $Role })",
  "    $changed = if ($upd.Count -gt 0) { [int]$upd[0].n } else { 0 }",
  "",
  "    if ($changed -gt 0) {",
  "        $result.rows_updated += $changed",
  "        $result.outcome = 'mapped'",
  "        Write-Tag 'UPSERT' (\"user='{0}' role='{1}' -> Assigned_By={2}, Valid_to +{3}mo\" -f $user, $Role, $AssignedBy, $ValidityMonths)",
  "    } else {",
  "        $lockRow = @(Get-DbRows \"SELECT COUNT(*) AS n FROM Map WHERE UserID = @u AND Role = @r AND Locked_by_Override = 1\" @{ u = $user; r = $Role })",
  "        if ([int]$lockRow[0].n -gt 0) {",
  "            $result.rows_blocked_by_lock++",
  "            $result.outcome = 'blocked-by-lock'",
  "            Write-Tag 'LOCKED' (\"user='{0}' role='{1}' has Locked_by_Override=1 - left untouched\" -f $user, $Role)",
  "        } else {",
  "            $result.outcome = 'no-change'",
  "            Write-Tag 'OK' (\"user='{0}' role='{1}' already current - no change\" -f $user, $Role)",
  "        }",
  "    }",
  "",
  "    Write-RunLog",
  "}",
  "finally {",
  "    try {",
  "        if (Get-Command Invoke-SqliteCommand -ErrorAction SilentlyContinue) {",
  "            Invoke-SqliteCommand -DatabasePath $DatabasePath -SQLDir $SQLDir -Sql \"PRAGMA wal_checkpoint(TRUNCATE)\" | Out-Null",
  "        }",
  "    } catch { }",
  "}",
  ""
];
var ASSIGN_ROLE_MAPPING_SCRIPT = ASSIGN_ROLE_MAPPING_SCRIPT_LINES.join('\n');

// buildEndpointScriptStagingActionXml() -- Task 1. Emits a ComputerID-targeted
// SingleAction that createfile's the byte-identical ASSIGN_ROLE_MAPPING_SCRIPT
// mirror into the root server's own Custom Repository, at the exact path
// bes/Assign-RoleMapping.bes's prefetch block pins:
// Uploads\CustomRepository\SoftwarePortal\rolegroups\Assign-RoleMapping.ps1.
// RepoDir is derived entirely from the wwwRootFolder registry value (SKILL.md
// S4) plus a hard-coded suffix -- no operator input reaches the path
// (T-07-07-03). Only escapeActionScriptBraces touches braces, and only the
// createfile body -- the {parameter "RepoDir"} / {value "wwwRootFolder" ...}
// substitutions live outside it and are never escaped (T-07-07-02).
function buildEndpointScriptStagingActionXml(){
  if(!PORTAL_CONFIG.rootServerComputerId){ return ""; }
  var stamp = (new Date()).toISOString();
  var title = "DSP RoleMap StageScript " + stamp;

  var lines = [];
  lines.push('\tparameter "RepoDir"="{(value "wwwRootFolder" of key "HKEY_LOCAL_MACHINE\\SOFTWARE\\Wow6432Node\\BigFix\\Enterprise Server" of registry) & "Uploads\\CustomRepository\\SoftwarePortal\\rolegroups"}"');
  lines.push('');
  lines.push('\tif {not exists folder "{parameter "RepoDir"}"}');
  lines.push('\t\trunhidden cmd /c mkdir "{parameter "RepoDir"}"');
  lines.push('\tendif');
  lines.push('');
  lines.push('delete __createfile');
  lines.push('delete "{parameter "RepoDir"}\\Assign-RoleMapping.ps1"');
  lines.push('');
  lines.push('createfile until _EOF_');
  lines.push(escapeActionScriptBraces(ASSIGN_ROLE_MAPPING_SCRIPT));
  lines.push('_EOF_');
  lines.push('');
  lines.push('move __createfile "{parameter "RepoDir"}\\Assign-RoleMapping.ps1"');

  var script = lines.join('\r\n');

  var xml  = '<?xml version="1.0" encoding="UTF-8"?>\r\n';
  xml += '<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"';
  xml += ' xsi:noNamespaceSchemaLocation="BES.xsd">\r\n';
  xml += '  <SingleAction>\r\n';
  xml += '    <Title>' + xmlEscape(title) + '</Title>\r\n';
  xml += '    <Relevance>true</Relevance>\r\n';
  xml += '    <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">';
  xml += cdataStart() + xmlCDataSafe(script) + cdataEnd();
  xml += '</ActionScript>\r\n';
  xml += '    <Settings>\r\n';
  xml += '      <ActionUITitle>' + xmlEscape(title) + '</ActionUITitle>\r\n';
  xml += '      <PreActionShowUI>false</PreActionShowUI>\r\n';
  xml += '      <HasEndTime>true</HasEndTime>\r\n';
  xml += '      <EndDateTimeLocalOffset>P1D</EndDateTimeLocalOffset>\r\n';
  xml += '      <IsOffer>false</IsOffer>\r\n';
  xml += '    </Settings>\r\n';
  xml += '    <Target>\r\n';
  xml += '      <ComputerID>' + xmlEscape(PORTAL_CONFIG.rootServerComputerId) + '</ComputerID>\r\n';
  xml += '    </Target>\r\n';
  xml += '  </SingleAction>\r\n';
  xml += '</BES>';
  return xml;
}

// stageEndpointScript(onDone) -- Task 1. POSTs the staging action;
// onDone(err, actionId). No popup dialogs -- callers surface the
// result/error in the Prerequisites panel's dedicated resultEl/errEl.
function stageEndpointScript(onDone){
  var xml = buildEndpointScriptStagingActionXml();
  if(xml === ""){
    if(onDone){ onDone("root server Computer ID not resolved -- staging disabled"); }
    return;
  }
  API.Post("actions", xml, function(e, s, b){
    if(s === 200 || s === 201){
      var bodyText = (typeof b !== "undefined" && b !== null) ? String(b) : "";
      if(onDone){ onDone(null, parseActionId(bodyText)); }
    } else {
      if(onDone){ onDone("status=" + s + " " + (e || "")); }
    }
  });
}

function onStageEndpointScriptClick(){
  var resultEl = document.getElementById("stageScriptResult");
  var errEl    = document.getElementById("stageScriptErr");
  var btn      = document.getElementById("stageScriptBtn");
  if(resultEl){ resultEl.style.display = "none"; resultEl.innerHTML = ""; }
  if(errEl){ errEl.style.display = "none"; errEl.innerHTML = ""; }
  if(btn){ btn.disabled = true; }
  setStatus("Staging endpoint script on root server...");
  stageEndpointScript(function(err, actionId){
    if(btn){ btn.disabled = false; }
    if(err){
      setStatus("Stage failed.");
      if(errEl){
        errEl.style.display = "";
        errEl.innerHTML = htmlEscape("Stage failed: " + err);
      }
      return;
    }
    setStatus("Staged.");
    if(resultEl){
      resultEl.style.display = "";
      resultEl.innerHTML = htmlEscape("Endpoint script staged (action " + (actionId || "(unknown)") + "). SHA1 must match 69860a1239e4509dce483a07523ea07e26764279.");
    }
  });
}

// updateStageEndpointScriptUI() -- mirrors fixlet_dispatcher.ojo's
// updateStagingCheckboxUI(): disables the Prerequisites Stage button with an
// inline note when rootServerComputerId is unresolved.
function updateStageEndpointScriptUI(){
  var btn  = document.getElementById("stageScriptBtn");
  var note = document.getElementById("stageScriptNote");
  if(!btn){ return; }
  if(!PORTAL_CONFIG.rootServerComputerId){
    btn.disabled = true;
    if(note){ note.innerHTML = htmlEscape("rootServerComputerId not configured in PORTAL_CONFIG -- staging disabled."); }
  } else {
    btn.disabled = false;
    if(note){ note.innerHTML = ""; }
  }
}

// ==========================================================================
// ROLES TAB -- state, rendering, D-02 autocomplete, D-10 scope selector.
// Save (D-13 step 1) lands in the next block below; Publish is 07-07/07-08.
// ==========================================================================

// roleState: one entry per PORTAL_CONFIG.roles entry, initialised in
// initDashboard(). Plan 07-08's Publish flow reads getRoleUsers()/roleState.
var roleState = {};

// roleBySlug: reverse lookup from a DOM-safe roleSlug back to the real role
// name. Every inline onclick="...('slug')" attribute in this tab passes only
// a slug (guaranteed to match /^[A-Za-z0-9_]*$/, so it can never break out of
// the surrounding HTML attribute or JS string literal) -- never raw role or
// username text.
var roleBySlug = {};

// module-level cache of already-seen sAMAccountNames (D-02), populated once
// by loadKnownUsers() from initDashboard().
var knownUsers = [];

// roleSlug(role) -- deterministic, DOM-safe id fragment for a role name.
// Never build an element id (or an inline event-handler argument) by
// string-concatenating unescaped role text into innerHTML.
function roleSlug(role){
  return String(role).replace(/[^A-Za-z0-9]/g, "_");
}

// getRoleUsers(role) -> string[] -- trimmed, lower-cased, de-duplicated.
function getRoleUsers(role){
  var st = roleState[role];
  return st ? st.users.slice() : [];
}

// setRoleUsers(role, usernames) -- trims, lower-cases, drops empties and
// de-duplicates (case-insensitive) before storing; marks the role dirty and
// re-renders its panel. D-04: a username already present on another role is
// untouched here -- each role's list is independent. A duplicate within the
// same role is a silent no-op (no error).
function setRoleUsers(role, usernames){
  var st = roleState[role];
  if(!st){ return; }
  var seen = {};
  var out  = [];
  var i, u;
  for(i = 0; i < (usernames || []).length; i++){
    u = String(usernames[i]).toLowerCase().replace(/^\s+|\s+$/g, "");
    if(u === ""){ continue; }
    if(seen[u]){ continue; }
    seen[u] = true;
    out.push(u);
  }
  st.users = out;
  st.dirty = true;
  renderRolePanel(role);
}

// loadKnownUsers() -- runs once from initDashboard(). Reads the Analysis
// property named by PORTAL_CONFIG.props.knownUsers (SELECT userid from the
// endpoint's users table, one row per reporting computer; each row may
// itself carry multiple usernames as a tuple/comma list). On any failure or
// empty result, caches [] and renderRolePanel() shows the established
// "Analysis not reporting yet" hint -- freeform entry (D-02) still works
// either way.
function loadKnownUsers(){
  var raw = getRelevanceSafe('(value of it as string) of results whose (value of it != "") of bes property whose (name of it = "' + PORTAL_CONFIG.props.knownUsers + '")');
  var seen = {};
  var out  = [];
  var i, j, row, parts, p;
  for(i = 0; i < raw.length; i++){
    row = String(raw[i]);
    // The Analysis property emits its per-computer result as either a
    // %22-quoted tuple string ("alice","bob") or a plain comma list
    // (alice,bob) -- strip any %22 quoting, then split on comma.
    parts = row.replace(/%22/g, "").split(",");
    for(j = 0; j < parts.length; j++){
      p = String(parts[j]).toLowerCase().replace(/^\s+|\s+$/g, "");
      if(p === ""){ continue; }
      if(seen[p]){ continue; }
      seen[p] = true;
      out.push(p);
    }
  }
  knownUsers = out;
}

// suggestUsernames(prefix) -> string[] -- pure filter over the knownUsers
// cache. Up to 10 case-insensitive prefix matches, ordinal-sorted.
function suggestUsernames(prefix){
  var p = String(prefix || "").toLowerCase().replace(/^\s+|\s+$/g, "");
  if(p === ""){ return []; }
  var out = [];
  var i, u;
  for(i = 0; i < knownUsers.length; i++){
    u = String(knownUsers[i]).toLowerCase();
    if(u.indexOf(p) === 0){ out.push(u); }
  }
  out.sort();
  return out.slice(0, 10);
}

// renderRolesTab() -- builds the static per-role panel skeleton (every id
// derived from roleSlug) once, then renders each panel's dynamic content.
function renderRolesTab(){
  var container = document.getElementById("rolePanelsContainer");
  if(!container){ return; }
  var html = "";
  var i, role, slug, g;
  for(i = 0; i < PORTAL_CONFIG.roles.length; i++){
    role = PORTAL_CONFIG.roles[i];
    slug = roleSlug(role);
    html += '<div class="panel"><div class="panelBody">';
    html += '<h2 id="roleHeading_' + slug + '" style="margin:0 0 10px 0;color:#2a5d9f;font-size:15px;">' + htmlEscape(role) + '</h2>';
    html += '<table class="tableGrid"><thead><tr><th>Username</th><th style="width:90px;"></th></tr></thead><tbody id="userTable_' + slug + '"></tbody></table>';
    html += '<table class="rowTable" style="margin-top:10px;"><tr>';
    html += '<td class="lbl">Add username</td>';
    html += '<td>';
    html += '<input type="text" class="txt" id="addUser_' + slug + '" onkeyup="onAddUserKeyup(\'' + slug + '\')" autocomplete="off">';
    html += ' <span class="btn" onclick="onAddUserClick(\'' + slug + '\')">Add</span>';
    html += '<div id="suggest_' + slug + '" class="panel" style="display:none;position:absolute;max-width:260px;padding:4px;z-index:10;"></div>';
    html += '<div id="knownUsersHint_' + slug + '" class="small warn" style="display:none;">Analysis not reporting yet -- freeform entry still works.</div>';
    html += '</td>';
    html += '</tr></table>';
    html += '<table class="rowTable"><tr>';
    html += '<td class="lbl">Scope to group (optional)</td>';
    html += '<td>';
    html += '<select id="scopeSelect_' + slug + '" onchange="onScopeSelectChange(\'' + slug + '\')"><option value="">(none)</option>';
    for(g = 0; g < PORTAL_CONFIG.targetGroups.length; g++){
      html += '<option value="' + htmlEscape(PORTAL_CONFIG.targetGroups[g]) + '">' + htmlEscape(PORTAL_CONFIG.targetGroups[g]) + '</option>';
    }
    html += '</select>';
    html += '<div class="small">Leaving this at (none) means the role&#39;s group matches on logged-on user alone.</div>';
    html += '</td>';
    html += '</tr></table>';
    html += '<div style="margin-top:12px;">';
    html += '<span class="btnGreen" id="saveRole_' + slug + '" onclick="onSaveRoleClick(\'' + slug + '\')">Save</span> ';
    html += '<span class="btn" id="publishRole_' + slug + '" onclick="onPublishRoleClick(\'' + slug + '\')">Publish</span>';
    html += '</div>';
    html += '<div id="roleStatus_' + slug + '" class="small" style="margin-top:6px;"></div>';
    html += '<div id="roleResult_' + slug + '" class="small" style="display:none;margin-top:4px;"></div>';
    html += '<div id="roleErr_' + slug + '" class="small warn" style="display:none;margin-top:4px;"></div>';
    html += '</div></div>';
  }
  container.innerHTML = html;
  for(i = 0; i < PORTAL_CONFIG.roles.length; i++){
    renderRolePanel(PORTAL_CONFIG.roles[i]);
  }
}

// renderRolePanel(role) -- re-renders one role's username table, member
// count and known-users degradation hint from roleState[role].
function renderRolePanel(role){
  var slug = roleSlug(role);
  var st   = roleState[role];
  if(!st){ return; }

  var headingEl = document.getElementById("roleHeading_" + slug);
  if(headingEl){
    headingEl.innerHTML = htmlEscape(role) + ' <span class="small">(' + st.users.length + ' member' + (st.users.length === 1 ? '' : 's') + ')</span>';
  }

  var tbody = document.getElementById("userTable_" + slug);
  if(tbody){
    tbody.innerHTML = "";
    if(st.users.length === 0){
      var trEmpty = document.createElement("tr");
      var tdEmpty = document.createElement("td");
      tdEmpty.colSpan = 2;
      tdEmpty.className = "dim";
      tdEmpty.innerText = "No usernames yet.";
      trEmpty.appendChild(tdEmpty);
      tbody.appendChild(trEmpty);
    } else {
      var i;
      for(i = 0; i < st.users.length; i++){
        (function(username){
          var tr   = document.createElement("tr");
          var tdU  = document.createElement("td");
          tdU.innerText = username;
          var tdBtn = document.createElement("td");
          var btn   = document.createElement("span");
          btn.className = "btn";
          btn.innerText = "Remove";
          btn.onclick = function(){ removeUsernameFromRole(role, username); };
          tdBtn.appendChild(btn);
          tr.appendChild(tdU);
          tr.appendChild(tdBtn);
          tbody.appendChild(tr);
        })(st.users[i]);
      }
    }
  }

  var hintEl = document.getElementById("knownUsersHint_" + slug);
  if(hintEl){ hintEl.style.display = (knownUsers.length === 0) ? "" : "none"; }
}

// addUsernameToRole(role) -- reads the per-role Add input, rejects only an
// empty (post-trim) entry (surfaced inline in errEl, never a popup dialog),
// and delegates the actual add to setRoleUsers (which silently de-dupes).
function addUsernameToRole(role){
  var slug  = roleSlug(role);
  var input = document.getElementById("addUser_" + slug);
  var errEl = document.getElementById("roleErr_" + slug);
  if(!input){ return; }
  if(errEl){ errEl.style.display = "none"; errEl.innerHTML = ""; }
  var val = String(input.value || "").replace(/^\s+|\s+$/g, "");
  if(val === ""){
    if(errEl){
      errEl.style.display = "";
      errEl.innerHTML = htmlEscape("Enter a username first.");
    }
    return;
  }
  var current = getRoleUsers(role);
  current.push(val);
  setRoleUsers(role, current);
  input.value = "";
  var suggestEl = document.getElementById("suggest_" + slug);
  if(suggestEl){ suggestEl.style.display = "none"; suggestEl.innerHTML = ""; }
}

// removeUsernameFromRole(role, username) -- Remove-button handler, always
// bound via a DOM closure (never an inline onclick string) so a username
// containing a quote/ampersand/brace can never corrupt an HTML attribute.
function removeUsernameFromRole(role, username){
  var current = getRoleUsers(role);
  var out = [];
  var i;
  for(i = 0; i < current.length; i++){
    if(current[i] !== username){ out.push(current[i]); }
  }
  setRoleUsers(role, out);
}

// onScopeChange(role) -- D-10. Resolves the selected target-group NAME to a
// BES group ID via findBesObjectIdByTitle so Publish (07-07) can AND a
// "member of group <id>" clause into the role's relevance. Leaving the
// select at "(none)" clears both fields (informational-only, matches the
// established fixlet_role_assigner.ojo target-group-selector convention).
function onScopeChange(role){
  var slug = roleSlug(role);
  var sel  = document.getElementById("scopeSelect_" + slug);
  var st   = roleState[role];
  if(!sel || !st){ return; }
  var groupName = sel.value;
  if(!groupName){
    st.scopeGroupId  = "";
    st.scopeSiteName = "";
    return;
  }
  st.scopeSiteName = PORTAL_CONFIG.siteName;
  var id = null;
  try { id = findBesObjectIdByTitle("computergroup", PORTAL_CONFIG.siteName, groupName); } catch(ex){ id = null; }
  st.scopeGroupId = id || "";
  if(!id){
    setStatus('Could not resolve BES group ID for "' + groupName + '" -- scope will be ignored until this group exists.');
  }
}

// -- Inline-handler wrappers: every onclick/onkeyup in the Roles tab passes
// only a slug (see roleBySlug comment above), then resolves to the real role
// name here before calling the role-keyed functions above.
function onAddUserClick(slug){
  var role = roleBySlug[slug];
  if(role){ addUsernameToRole(role); }
}

function onAddUserKeyup(slug){
  var input     = document.getElementById("addUser_" + slug);
  var suggestEl = document.getElementById("suggest_" + slug);
  if(!input || !suggestEl){ return; }
  var val = String(input.value || "");
  if(val.length < 2){
    suggestEl.style.display = "none";
    suggestEl.innerHTML = "";
    return;
  }
  var matches = suggestUsernames(val);
  suggestEl.innerHTML = "";
  if(matches.length === 0){
    suggestEl.style.display = "none";
    return;
  }
  suggestEl.style.display = "";
  var i;
  for(i = 0; i < matches.length; i++){
    (function(match){
      var row = document.createElement("div");
      row.className = "small";
      row.style.cursor = "pointer";
      row.innerText = match;
      row.onclick = function(){
        input.value = match;
        suggestEl.style.display = "none";
        suggestEl.innerHTML = "";
      };
      suggestEl.appendChild(row);
    })(matches[i]);
  }
}

function onScopeSelectChange(slug){
  var role = roleBySlug[slug];
  if(role){ onScopeChange(role); }
}

// ==========================================================================
// SAVE (D-13 step 1) -- stages a role's full username snapshot into the
// root-server RolePublish.db audit store via a ComputerID-targeted
// SingleAction. Per this plan's objective note, the audit write fires on
// Save, not on Publish (07-07) -- Publish reads the already-saved snapshot,
// it must not add a second write.
// ==========================================================================

// Mirror of scripts/Upsert-RolePublish.ps1 (repo root). Kept as a literal
// copy here so the Save action can createfile it directly on the root
// server without a separate script-deployment step. If you edit
// scripts/Upsert-RolePublish.ps1, regenerate this array from it (do not
// hand-edit -- see buildAuditWriteActionScript). scripts/Upsert-RolePublish.ps1
// itself remains the source of truth; tests/unit/role_manager.test.js
// asserts this array joins back to that file's exact content.
var ROLE_PUBLISH_SCRIPT_LINES = [
  "#Requires -Version 5.1",
  "<#",
  ".SYNOPSIS",
  "    Root-server audit-store initialiser + per-Publish snapshot writer (D-05). Reads a",
  "    Publish-event payload (role, publishing operator, full username list) and writes it",
  "    as one immutable, timestamped row-set into RolePublish.db.",
  "",
  ".DESCRIPTION",
  "    D-05 makes this store - not the Computer Group's relevance text and not a JSON file -",
  "    the source of truth for \"who holds which role\", and NFR-03's audit trail. The",
  "    dashboard writes a JSON payload (see -PayloadPath), and this script:",
  "",
  "      1. Ensures the RolePublishRun / RoleUsers schema exists (CREATE TABLE IF NOT",
  "         EXISTS, never DROP, never ALTER an existing column).",
  "      2. Inserts one RolePublishRun row for the Publish event.",
  "      3. Inserts one RoleUsers row per (normalised, de-duplicated) username, tagged with",
  "         that run's RunID.",
  "",
  "    The store is append-only: every Publish creates a NEW run and a NEW full snapshot of",
  "    that role's membership. Nothing is ever UPDATEd or DELETEd, and no upsert-by-replace",
  "    write is ever used - history cannot be silently rewritten (T-07-03-03). The \"current",
  "    membership\" of a role is always the RoleUsers rows belonging to the MAX(RunID) for",
  "    that role - see the canonical query in .NOTES.",
  "",
  "    Constrained Language Mode safe: no dynamic .NET type-loading helper, no",
  "    System.Data.SQLite, no Invoke-Expression. Every database call goes through",
  "    Sqlite-Helper.ps1 (bundled sqlite3.exe); every value goes through",
  "    Invoke-SqliteCommand -Parameters (T-07-03-02) - the payload is data, never script",
  "    (T-07-03-04).",
  "",
  ".PARAMETER PayloadPath",
  "    Path to a UTF-8 JSON file shaped:",
  "        { \"role\": \"IT Operations\", \"published_by\": \"jfannon\", \"users\": [\"alice\",\"bob\"] }",
  "    An empty \"users\" array is legal - it means the role now has zero members - and is",
  "    recorded as a run with UserCount = 0, not treated as an error.",
  "",
  ".PARAMETER DatabasePath",
  "    Full path to RolePublish.db on the root server.",
  "",
  ".PARAMETER SQLDir",
  "    Directory containing sqlite3.exe directly (no arch subfolder).",
  "",
  ".PARAMETER SqliteHelperPath",
  "    Path to the shared Sqlite-Helper.ps1. Default: Sqlite-Helper.ps1 beside -DatabasePath",
  "    (same resolution Assign-RoleMapping.ps1 already uses).",
  "",
  ".PARAMETER WhatIf",
  "    Validates the payload and prints every statement that would run (schema DDL, the",
  "    RolePublishRun insert, every RoleUsers insert) with parameter values shown, via",
  "    [WHATIF] Write-Host lines. Performs zero database access - not even a read - so a",
  "    -DatabasePath that does not yet exist is left untouched (sqlite3.exe materialises a",
  "    file merely by opening one, so this script never opens the database at all under",
  "    -WhatIf).",
  "",
  ".EXAMPLE",
  "    .\\Upsert-RolePublish.ps1 -PayloadPath .\\publish.json -DatabasePath D:\\RolePublish\\RolePublish.db -SQLDir D:\\sqlite",
  "",
  ".NOTES",
  "    PowerShell 5.1, Constrained Language Mode safe.",
  "",
  "    Canonical \"current membership of a role\" query (plan 07-05 uses this verbatim):",
  "        SELECT u.UserID FROM RoleUsers u",
  "        WHERE u.RunID = (SELECT MAX(RunID) FROM RolePublishRun WHERE Role = @role)",
  "        ORDER BY u.UserID",
  "",
  "    Exit codes:",
  "      0     success",
  "      5401  Sqlite-Helper.ps1 not found at the resolved -SqliteHelperPath",
  "      5402  sqlite3.exe not found under -SQLDir",
  "      5410  payload missing / not valid JSON / role blank / published_by blank / users",
  "            not an array",
  "      5411  users array exceeds the 5000-entry sanity cap",
  "      1     unexpected error writing the schema or the run (see the [ABORT] message)",
  "#>",
  "[CmdletBinding(SupportsShouldProcess = $true)]",
  "param(",
  "    [Parameter(Mandatory = $true)]",
  "    [string]$PayloadPath,",
  "",
  "    [Parameter(Mandatory = $true)]",
  "    [string]$DatabasePath,",
  "",
  "    [Parameter(Mandatory = $true)]",
  "    [string]$SQLDir,",
  "",
  "    [Parameter()]",
  "    [string]$SqliteHelperPath",
  ")",
  "",
  "Set-StrictMode -Version Latest",
  "$ErrorActionPreference = 'Stop'",
  "",
  "$MaxUsers  = 5000",
  "$BatchSize = 400",
  "",
  "function Write-Tag {",
  "    param([string]$Tag, [string]$Message)",
  "    Write-Host \"[$Tag] $Message\"",
  "}",
  "",
  "# --- Step 1: resolve + validate tooling (no DB access yet) -----------------------------",
  "if ([string]::IsNullOrWhiteSpace($SqliteHelperPath)) {",
  "    $SqliteHelperPath = Join-Path (Split-Path $DatabasePath) 'Sqlite-Helper.ps1'",
  "}",
  "",
  "if (-not (Test-Path -LiteralPath $SqliteHelperPath)) {",
  "    Write-Tag 'ABORT' \"Sqlite-Helper.ps1 not found at: $SqliteHelperPath\"",
  "    exit 5401",
  "}",
  "",
  "$sqlite3Exe = Join-Path $SQLDir 'sqlite3.exe'",
  "if (-not (Test-Path -LiteralPath $sqlite3Exe)) {",
  "    Write-Tag 'ABORT' \"sqlite3.exe not found at: $sqlite3Exe (set -SQLDir to the directory containing it)\"",
  "    exit 5402",
  "}",
  "",
  ". $SqliteHelperPath",
  "",
  "# --- Step 2: read + validate the payload (no DB access) --------------------------------",
  "if (-not (Test-Path -LiteralPath $PayloadPath)) {",
  "    Write-Tag 'ABORT' \"Payload file not found: $PayloadPath\"",
  "    exit 5410",
  "}",
  "",
  "try {",
  "    $rawPayloadText = Get-Content -Raw -LiteralPath $PayloadPath",
  "    $payload = $rawPayloadText | ConvertFrom-Json",
  "} catch {",
  "    Write-Tag 'ABORT' \"Payload is not valid JSON: $PayloadPath ($($_.Exception.Message))\"",
  "    exit 5410",
  "}",
  "",
  "if ($null -eq $payload) {",
  "    Write-Tag 'ABORT' \"Payload parsed to nothing: $PayloadPath\"",
  "    exit 5410",
  "}",
  "",
  "# Property-existence check first (Set-StrictMode -Version Latest throws",
  "# PropertyNotFoundStrict on a bare $payload.role access when the JSON key is absent --",
  "# same defensive idiom Reconcile-LocalRoles.ps1 uses for its snapshot body).",
  "$payloadProps = @($payload.PSObject.Properties.Name)",
  "$Role         = if ($payloadProps -contains 'role')         { [string]$payload.role }         else { '' }",
  "$PublishedBy  = if ($payloadProps -contains 'published_by') { [string]$payload.published_by }  else { '' }",
  "",
  "if ([string]::IsNullOrWhiteSpace($Role)) {",
  "    Write-Tag 'ABORT' \"payload 'role' is missing or blank\"",
  "    exit 5410",
  "}",
  "if ([string]::IsNullOrWhiteSpace($PublishedBy)) {",
  "    Write-Tag 'ABORT' \"payload 'published_by' is missing or blank\"",
  "    exit 5410",
  "}",
  "",
  "$Role        = $Role.Trim()",
  "$PublishedBy = $PublishedBy.Trim()",
  "",
  "# users: null (key absent, or an empty JSON array -- PS5.1 collapses [] to $null) is a",
  "# legal empty list. Anything present that is NOT enumerable (a string, a number, a JSON",
  "# object) is a type error.",
  "$rawUsers = if ($payloadProps -contains 'users') { $payload.users } else { $null }",
  "if ($null -eq $rawUsers) {",
  "    $usersArray = @()",
  "} else {",
  "    $isArrayLike = ($rawUsers -is [System.Array]) -or `",
  "        ($rawUsers -is [System.Collections.IEnumerable] -and $rawUsers -isnot [string])",
  "    if (-not $isArrayLike) {",
  "        # PS 5.1's ConvertFrom-Json collapses a single-element JSON array to a bare",
  "        # scalar -- \"users\":[\"alice\"] and \"users\":\"alice\" deserialize identically, so",
  "        # the object model alone can't tell a legal one-user array from a genuine",
  "        # scalar payload. Fall back to the raw JSON text to disambiguate.",
  "        if ($rawPayloadText -match '\"users\"\\s*:\\s*\\[') {",
  "            $isArrayLike = $true",
  "        }",
  "    }",
  "    if (-not $isArrayLike) {",
  "        Write-Tag 'ABORT' \"payload 'users' is not an array\"",
  "        exit 5410",
  "    }",
  "    $usersArray = @($rawUsers)",
  "}",
  "",
  "if ($usersArray.Count -gt $MaxUsers) {",
  "    Write-Tag 'ABORT' \"payload 'users' has $($usersArray.Count) entries, exceeding the $MaxUsers-entry sanity cap\"",
  "    exit 5411",
  "}",
  "",
  "# Normalise: trim + lower-case, drop empties, de-duplicate, ordinal-sort deterministically.",
  "$seen       = @{}",
  "$normalized = New-Object System.Collections.ArrayList",
  "foreach ($u in $usersArray) {",
  "    if ($null -eq $u) { continue }",
  "    $t = ([string]$u).Trim().ToLowerInvariant()",
  "    if ($t -eq '') { continue }",
  "    if (-not $seen.ContainsKey($t)) {",
  "        $seen[$t] = $true",
  "        [void]$normalized.Add($t)",
  "    }",
  "}",
  "$normUsers = $normalized.ToArray()",
  "if ($normUsers.Length -gt 1) { [Array]::Sort($normUsers, [System.StringComparer]::Ordinal) }",
  "",
  "# --- Step 6: -WhatIf short-circuit ------------------------------------------------------",
  "# Zero database access under -WhatIf: sqlite3.exe materialises a file merely by opening",
  "# one, so even a read-only schema probe against a -DatabasePath that does not yet exist",
  "# would leave a file behind. Describe every statement that WOULD run instead.",
  "if ($WhatIfPreference) {",
  "    Write-Tag 'WHATIF' \"would ensure schema exists: CREATE TABLE IF NOT EXISTS RolePublishRun, CREATE TABLE IF NOT EXISTS RoleUsers, CREATE INDEX IF NOT EXISTS idx_roleusers_run, CREATE INDEX IF NOT EXISTS idx_roleusers_role\"",
  "    Write-Tag 'WHATIF' (\"would insert RolePublishRun row: Role='{0}' Published_by='{1}' UserCount={2}\" -f $Role, $PublishedBy, $normUsers.Count)",
  "    foreach ($u in $normUsers) {",
  "        Write-Tag 'WHATIF' (\"would insert RoleUsers row: Role='{0}' UserID='{1}'\" -f $Role, $u)",
  "    }",
  "    Write-Tag 'WHATIF' \"no writes performed; $DatabasePath left untouched\"",
  "    exit 0",
  "}",
  "",
  "# --- Step 3: ensure schema --------------------------------------------------------------",
  "function Test-TableExists {",
  "    param([string]$Name)",
  "    $r = Invoke-SqliteCommand -DatabasePath $DatabasePath -SQLDir $SQLDir `",
  "        -Sql \"SELECT COUNT(*) AS n FROM sqlite_master WHERE type='table' AND name=@n\" `",
  "        -Parameters @{ n = $Name }",
  "    return ([int]$r[0].n -eq 1)",
  "}",
  "",
  "$runPublishDdl = @\"",
  "CREATE TABLE IF NOT EXISTS RolePublishRun (",
  "    RunID        INTEGER PRIMARY KEY AUTOINCREMENT,",
  "    Role         TEXT NOT NULL,",
  "    Published_by TEXT NOT NULL,",
  "    Published_on TEXT NOT NULL DEFAULT (datetime('now','localtime')),",
  "    UserCount    INTEGER NOT NULL",
  ")",
  "\"@",
  "",
  "$roleUsersDdl = @\"",
  "CREATE TABLE IF NOT EXISTS RoleUsers (",
  "    RUID   INTEGER PRIMARY KEY AUTOINCREMENT,",
  "    RunID  INTEGER NOT NULL REFERENCES RolePublishRun(RunID),",
  "    Role   TEXT NOT NULL,",
  "    UserID TEXT NOT NULL",
  ")",
  "\"@",
  "",
  "try {",
  "    foreach ($tbl in @(",
  "        @{ Name = 'RolePublishRun'; Ddl = $runPublishDdl }",
  "        @{ Name = 'RoleUsers';      Ddl = $roleUsersDdl }",
  "    )) {",
  "        if (Test-TableExists -Name $tbl.Name) {",
  "            Write-Tag 'SKIP' \"$($tbl.Name) already exists - no changes made\"",
  "        } else {",
  "            Invoke-SqliteCommand -DatabasePath $DatabasePath -SQLDir $SQLDir -Sql $tbl.Ddl | Out-Null",
  "            Write-Tag 'CREATE' \"$($tbl.Name) created\"",
  "        }",
  "    }",
  "",
  "    Invoke-SqliteCommand -DatabasePath $DatabasePath -SQLDir $SQLDir `",
  "        -Sql \"CREATE INDEX IF NOT EXISTS idx_roleusers_run ON RoleUsers(RunID)\" | Out-Null",
  "    Invoke-SqliteCommand -DatabasePath $DatabasePath -SQLDir $SQLDir `",
  "        -Sql \"CREATE INDEX IF NOT EXISTS idx_roleusers_role ON RoleUsers(Role)\" | Out-Null",
  "    Write-Tag 'INDEX' \"idx_roleusers_run, idx_roleusers_role ready\"",
  "} catch {",
  "    Write-Tag 'ABORT' \"failed to ensure schema: $($_.Exception.Message)\"",
  "    exit 1",
  "}",
  "",
  "# --- Step 4: write the run (append-only - no UPDATE, no DELETE, no upsert-by-replace) ---",
  "try {",
  "    # INSERT + SELECT last_insert_rowid() must be ONE call: last_insert_rowid() is scoped",
  "    # to the connection that performed the insert, and Sqlite-Helper spawns a fresh",
  "    # sqlite3.exe process per Invoke-SqliteCommand call.",
  "    $insertPrefix = \"INSERT INTO RolePublishRun (Role, Published_by, UserCount) VALUES\"",
  "    $runSql       = $insertPrefix + \" (@role, @pubby, @cnt);`nSELECT last_insert_rowid() AS id\"",
  "    $insertResult = Invoke-SqliteCommand -DatabasePath $DatabasePath -SQLDir $SQLDir `",
  "        -Sql $runSql `",
  "        -Parameters @{ role = $Role; pubby = $PublishedBy; cnt = $normUsers.Count }",
  "    $runId = [int]$insertResult[0].id",
  "",
  "    for ($i = 0; $i -lt $normUsers.Count; $i += $BatchSize) {",
  "        $end   = [Math]::Min($i + $BatchSize - 1, $normUsers.Count - 1)",
  "        $chunk = $normUsers[$i..$end]",
  "",
  "        $valuesClauses = New-Object System.Collections.ArrayList",
  "        $params        = @{ runid = $runId; role = $Role }",
  "        for ($j = 0; $j -lt $chunk.Count; $j++) {",
  "            $key = \"u$j\"",
  "            [void]$valuesClauses.Add(\"(@runid, @role, @$key)\")",
  "            $params[$key] = $chunk[$j]",
  "        }",
  "",
  "        $ruInsertPrefix = \"INSERT INTO RoleUsers (RunID, Role, UserID) VALUES\"",
  "        $ruSql          = $ruInsertPrefix + \"`n\" + ($valuesClauses -join \",`n\")",
  "        Invoke-SqliteCommand -DatabasePath $DatabasePath -SQLDir $SQLDir -Sql $ruSql -Parameters $params | Out-Null",
  "    }",
  "} catch {",
  "    Write-Tag 'ABORT' \"failed to write RolePublishRun/RoleUsers: $($_.Exception.Message)\"",
  "    exit 1",
  "}",
  "",
  "# --- Step 7: success ---------------------------------------------------------------------",
  "Write-Host \"[OK] RunID=$runId Role=$Role Users=$($normUsers.Count)\"",
  "exit 0",
  ""
];
var ROLE_PUBLISH_SCRIPT = ROLE_PUBLISH_SCRIPT_LINES.join('\r\n');

// jsonEscape(s) -- hand-rolled JSON string escaper (IE9 has no reliable
// JSON.stringify in this host). Escapes \, ", and control chars \b \f \n \r
// \t plus any char below 0x20 as \u00XX.
function jsonEscape(s){
  var str = String(s);
  var out = "";
  var i, c, code, hex;
  for(i = 0; i < str.length; i++){
    c    = str.charAt(i);
    code = str.charCodeAt(i);
    if(c === '\\'){ out += '\\\\'; }
    else if(c === '"'){ out += '\\"'; }
    else if(c === '\b'){ out += '\\b'; }
    else if(c === '\f'){ out += '\\f'; }
    else if(c === '\n'){ out += '\\n'; }
    else if(c === '\r'){ out += '\\r'; }
    else if(c === '\t'){ out += '\\t'; }
    else if(code < 0x20){
      hex = code.toString(16);
      while(hex.length < 4){ hex = "0" + hex; }
      out += '\\u' + hex;
    } else {
      out += c;
    }
  }
  return out;
}
function jsonStringLiteral(s){ return '"' + jsonEscape(s) + '"'; }

// buildRolePublishPayload(role, usernames, publishedBy) -- pure. Emits the
// exact JSON contract from 07-03:
// {"role":"<role>","published_by":"<who>","users":["a","b"]}. publishedBy
// falls back to "console-operator" when empty (getAssignedBy() already
// guards the console-render-time tag; this is a second, independent guard).
function buildRolePublishPayload(role, usernames, publishedBy){
  var users = usernames || [];
  var by    = String(publishedBy || "").replace(/^\s+|\s+$/g, "");
  if(by === ""){ by = "console-operator"; }
  var parts = [];
  var i;
  for(i = 0; i < users.length; i++){
    parts.push(jsonStringLiteral(users[i]));
  }
  return '{"role":' + jsonStringLiteral(role) +
    ',"published_by":' + jsonStringLiteral(by) +
    ',"users":[' + parts.join(',') + ']}';
}

// buildAuditWriteActionScript(payloadJson) -- modelled line-for-line on
// fixlet_dispatcher.ojo's buildStagingActionScript. Only escapeActionScriptBraces
// may touch braces (double "{" only); the parameter/invocation lines below
// use intentional {parameter "..."} substitutions and are never passed
// through it -- only the two createfile bodies are.
function buildAuditWriteActionScript(payloadJson){
  var lines = [];

  // Client-relevance folder expressions -- copied VERBATIM from
  // bes/Assign-RoleMapping.bes (SWPDir/SQLiteDir lines) so the root server
  // resolves the same paths the endpoint half does. TargetStore differs
  // here on purpose: this action writes RolePublish.db, never
  // RoleAwareness.db (the endpoint script's own target).
  lines.push('\tparameter "SWPDir"="{(concatenation (if windows of operating system then "\\" else "/") of ((item 0 of it;item 1 of it;item 2 of it) of ((pathname of parent folder of parent folder of client folder of site "actionsite") as string,"EC","SoftwarePortal")))}"');
  lines.push('\tparameter "SQLiteDir"="{(concatenation (if windows of operating system then "\\" else "/") of ((item 0 of it;item 1 of it;item 2 of it) of ((pathname of parent folder of parent folder of client folder of site "actionsite") as string,"EC","sqlite")))}"');
  lines.push('\tparameter "TargetStore"="{(concatenation (if windows of operating system then "\\" else "/") of ((item 0 of it;item 1 of it;item 2 of it;item 3 of it) of ((pathname of parent folder of parent folder of client folder of site "actionsite") as string,"EC","SoftwarePortal","RolePublish.db")))}"');
  lines.push('');

  lines.push('\tif {not exists folder ((parameter "SWPDir") & "\\rolegroups")}');
  lines.push('\t\trunhidden cmd /c mkdir "{parameter "SWPDir"}\\rolegroups"');
  lines.push('\tendif');
  lines.push('');

  lines.push('delete __createfile');
  lines.push('delete "{parameter "SWPDir"}\\rolegroups\\Upsert-RolePublish.ps1"');
  lines.push('');
  lines.push('createfile until _EOF_');
  lines.push(escapeActionScriptBraces(ROLE_PUBLISH_SCRIPT));
  lines.push('_EOF_');
  lines.push('');
  lines.push('move __createfile "{parameter "SWPDir"}\\rolegroups\\Upsert-RolePublish.ps1"');
  lines.push('');

  lines.push('delete __createfile');
  lines.push('delete "{parameter "SWPDir"}\\rolegroups\\rolepublish-payload.json"');
  lines.push('');
  lines.push('createfile until _EOF_');
  lines.push(escapeActionScriptBraces(payloadJson));
  lines.push('_EOF_');
  lines.push('');
  lines.push('move __createfile "{parameter "SWPDir"}\\rolegroups\\rolepublish-payload.json"');
  lines.push('');

  lines.push('action uses wow64 redirection {x64 of operating system}');
  lines.push('waithidden powershell.exe -NonInteractive -NoProfile -ExecutionPolicy Bypass -File "{parameter "SWPDir"}\\rolegroups\\Upsert-RolePublish.ps1" -PayloadPath "{parameter "SWPDir"}\\rolegroups\\rolepublish-payload.json" -DatabasePath "{parameter "TargetStore"}" -SQLDir "{parameter "SQLiteDir"}" -SqliteHelperPath "{parameter "SWPDir"}\\Sqlite-Helper.ps1"');
  lines.push('');

  lines.push('delete "{parameter "SWPDir"}\\rolegroups\\rolepublish-payload.json"');

  return lines.join('\r\n');
}

// buildAuditWriteActionXml(role, actionScript) -- SingleAction, element order
// Title -> Relevance -> ActionScript -> Settings -> Target (SKILL.md S3).
// Target is <ComputerID> (a single fixed computer, the root server), never
// <CustomRelevance> -- this action never needs client-side group evaluation.
function buildAuditWriteActionXml(role, actionScript){
  if(!PORTAL_CONFIG.rootServerComputerId){ return ""; }
  var stamp = new Date().toISOString();
  var title = "DSP RoleSave - " + role + " " + stamp;

  var xml  = '<?xml version="1.0" encoding="UTF-8"?>\r\n';
  xml += '<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"';
  xml += ' xsi:noNamespaceSchemaLocation="BES.xsd">\r\n';
  xml += '  <SingleAction>\r\n';
  xml += '    <Title>' + xmlEscape(title) + '</Title>\r\n';
  xml += '    <Relevance>true</Relevance>\r\n';
  xml += '    <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">';
  xml += cdataStart() + xmlCDataSafe(actionScript) + cdataEnd();
  xml += '</ActionScript>\r\n';
  xml += '    <Settings>\r\n';
  xml += '      <ActionUITitle>' + xmlEscape(title) + '</ActionUITitle>\r\n';
  xml += '      <PreActionShowUI>false</PreActionShowUI>\r\n';
  xml += '      <HasEndTime>true</HasEndTime>\r\n';
  xml += '      <EndDateTimeLocalOffset>P1D</EndDateTimeLocalOffset>\r\n';
  xml += '      <IsOffer>false</IsOffer>\r\n';
  xml += '    </Settings>\r\n';
  xml += '    <Target>\r\n';
  xml += '      <ComputerID>' + xmlEscape(PORTAL_CONFIG.rootServerComputerId) + '</ComputerID>\r\n';
  xml += '    </Target>\r\n';
  xml += '  </SingleAction>\r\n';
  xml += '</BES>';
  return xml;
}

// saveRole(role) -- D-13 step 1, and only step 1: stages the role's full
// username snapshot into the root-server audit store. Never touches a
// Computer Group, Task or policy action -- Publish (07-07) is the separate,
// explicit step that changes live targeting.
function saveRole(role){
  var slug     = roleSlug(role);
  var errEl    = document.getElementById("roleErr_" + slug);
  var resultEl = document.getElementById("roleResult_" + slug);
  var saveBtn  = document.getElementById("saveRole_" + slug);
  var st       = roleState[role];
  if(!st){ return; }

  if(errEl){ errEl.style.display = "none"; errEl.innerHTML = ""; }
  if(resultEl){ resultEl.style.display = "none"; resultEl.innerHTML = ""; }

  var payload = buildRolePublishPayload(role, getRoleUsers(role), getAssignedBy());
  var script  = buildAuditWriteActionScript(payload);
  var xml     = buildAuditWriteActionXml(role, script);

  if(xml === ""){
    if(errEl){
      errEl.style.display = "";
      errEl.innerHTML = htmlEscape("root server Computer ID not resolved -- Save disabled");
    }
    return;
  }

  if(saveBtn){ saveBtn.disabled = true; }
  setStatus("Saving " + role + "...");

  API.Post("actions", xml, function(e, s, b){
    if(saveBtn){ saveBtn.disabled = false; }
    if(s === 200 || s === 201){
      var bodyText  = (typeof b !== "undefined" && b !== null) ? String(b) : "";
      var actionIdR = parseActionId(bodyText);
      st.dirty = false;
      setStatus("Saved.");
      if(resultEl){
        resultEl.style.display = "";
        resultEl.innerHTML = htmlEscape("Saved. Audit action " + (actionIdR || "(unknown)") + " dispatched to the root server. Nothing on the fleet has changed yet -- click Publish to apply.");
      }
    } else {
      setStatus("Save failed: status=" + s);
      if(errEl){
        errEl.style.display = "";
        errEl.innerHTML = htmlEscape("Save failed: status=" + s + " -- " + (e || ""));
      }
    }
  });
}

function onSaveRoleClick(slug){
  var role = roleBySlug[slug];
  if(role){ saveRole(role); }
}
</script>
      ]]></Head>
      <HTML><![CDATA[
<div class="page">
  <h1>Dereso Role Manager</h1>
  <div id="globalError" class="error-row" style="display:none;padding:6px 8px;margin-bottom:8px;"></div>
  <div id="status" class="small"></div>

  <div class="tabBar">
    <span id="tabBtnRoles"    class="tabBtn tabActive" onclick="switchTab('Roles')">Roles</span>
    <span id="tabBtnAnalysis" class="tabBtn"           onclick="switchTab('Analysis')">Analysis</span>
  </div>

  <!-- ================= Roles ================= -->
  <div id="tabRoles">
    <div class="panel"><div class="panelBody">
      <span class="small">Edit each role's username list below, then click Save to stage the change in the root-server audit store. Publish (wired in a later plan) is the separate, explicit step that applies a role's change to the live fleet.</span>
    </div></div>
    <div class="panel"><div class="panelBody">
      <h2 style="margin:0 0 8px 0;color:#2a5d9f;font-size:14px;">Prerequisites</h2>
      <span class="small">Every role's policy action prefetches <code>Assign-RoleMapping.ps1</code> from the root server's Custom Repository. Stage it once -- and again whenever the script changes -- before publishing any role.</span>
      <div class="small" style="margin-top:6px;">Pinned SHA1: <code>69860a1239e4509dce483a07523ea07e26764279</code> &middot; size: <code>8877</code> bytes</div>
      <div style="margin-top:10px;">
        <span class="btnGreen" id="stageScriptBtn" onclick="onStageEndpointScriptClick()">Stage endpoint script on root server</span>
      </div>
      <div id="stageScriptNote" class="small warn" style="margin-top:6px;"></div>
      <div id="stageScriptResult" class="small" style="display:none;margin-top:6px;"></div>
      <div id="stageScriptErr" class="small warn" style="display:none;margin-top:6px;"></div>
    </div></div>
    <div id="rolePanelsContainer"></div>
  </div>

  <!-- ================= Analysis ================= -->
  <div id="tabAnalysis" style="display:none;">
    <div class="panel"><div class="panelBody">
      <span class="dim">Read-only current role assignments (D-16) -- built in plan 07-08.</span>
    </div></div>
  </div>

  <script>
  try {
    initDashboard();
  } catch(ex){
    showGlobalError("Init error: " + (ex.message || ex.description || String(ex)));
  }
  </script>
</div>
      ]]></HTML>
    </Page>
  </Wizard>
</BES>
