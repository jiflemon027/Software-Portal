<?xml version="1.0" encoding="UTF-8"?>
<BES>
  <Wizard>
    <Title>Dereso Fixlet Dispatcher</Title>
    <UIHooks LaunchType="Document" RequiresAuthoring="false" Menu="Dashboards"></UIHooks>
    <DefaultPage>main</DefaultPage>

    <Page Name="main" DocType="HTML">
      <Title>Dereso Fixlet Dispatcher</Title>
      <Head><![CDATA[
<meta http-equiv="X-UA-Compatible" content="IE=9">
<style type="text/css">
body { font-family: Arial; font-size: 11px; background: #f3f3f3; margin: 0; padding: 0; }
.dashboardVersion { position: fixed; top: 6px; right: 10px; font-size: 10px; color: #999999; z-index: 1000; }
.page { padding: 16px; }
h1 { color: #2a5d9f; font-size: 24px; margin: 0 0 18px 0; font-weight: bold; }
.panel { background: #ffffff; border: 1px solid #d7dbe0; margin-bottom: 14px; }
.panelBody { padding: 12px; }
.rowTable { width: 100%; border-collapse: collapse; }
.rowTable td { padding: 6px 8px; vertical-align: middle; border: none; }
.lbl { font-weight: bold; color: #333333; white-space: nowrap; }
input[type=text], textarea { font-family: Arial; font-size: 11px; border: 1px solid #c8c8c8; padding: 4px 6px; }
.txt { width: 260px; }
.txtWide { width: 340px; }
.btn { font-family: Arial; font-size: 11px; padding: 6px 14px; border: 1px solid #b3b3b3; background: #f7f7f7; cursor: pointer; }
.btnGreen { font-family: Arial; font-size: 11px; padding: 8px 18px; border: 1px solid #237241; background: #33a05a; color: #ffffff; font-weight: bold; cursor: pointer; }
.tableGrid { width: 100%; border-collapse: collapse; background: #ffffff; }
.tableGrid td, .tableGrid th { border: 1px solid #d7dbe0; padding: 6px 8px; vertical-align: middle; }
.tableGrid th { background: #f4f6f8; color: #2a5d9f; text-align: left; }
.small { color: #666666; font-size: 10px; }
.right { text-align: right; }
.divider { border-top: 1px solid #e1e1e1; margin: 10px 0; }
</style>
<script language="javascript">
// ==========================================================================
// PORTAL CONFIGURATION -- Edit this block to change the default expiry.
// Do not modify any code below this section.
// ==========================================================================
var PORTAL_CONFIG = {
  defaultExpirationDays: 7,
  // Set to the BigFix Computer ID of the BES root server (find via
  // EvaluateRelevance("id of bes computer") run against that computer, or the
  // Computer ID column in the console). Required for "Stage file on root
  // server" — without it, the staging checkbox stays disabled and the
  // precache/deployment indicators show "not configured".


   rootServerComputerId: '<?relevance concatenation "" of ((id of it as string) of bes computers whose(exists value whose (it = "BES Root Server") of result (it, bes property "BES Relay Service Installed"))) ?>'
};
// ==========================================================================
// END PORTAL CONFIGURATION
// ==========================================================================

// ==========================================================================
// EMBEDDED ROOT-SERVER STAGING SCRIPT
// Mirror of Invoke-PrefetchStage.ps1 (repo root). Kept as a literal copy here
// so the staging action can createfile it directly on the root server without
// a separate script-deployment step. If you edit Invoke-PrefetchStage.ps1,
// regenerate this array from it (do not hand-edit — see buildStagingActionScript).
// ==========================================================================
var PREFETCH_STAGE_SCRIPT_LINES = [
  "<#",
  ".SYNOPSIS",
  "    Downloads and stages a file described by a BigFix prefetch statement.",
  "",
  ".DESCRIPTION",
  "    Parses a prefetch line, downloads the file, verifies SHA1, SHA256 (optional),",
  "    and size, then places the file at <DestinationRoot>\\<sha1>\\<filename> — matching",
  "    the layout expected by CustomRepository / rewritePrefetchUrls() in fixlet_dispatcher.ojo.",
  "",
  "    If -DestinationRoot is not supplied, it is resolved from the registry:",
  "        HKLM:\\SOFTWARE\\Wow6432Node\\BigFix\\Enterprise Server -> wwwRootFolder",
  "        + \"\\Uploads\\CustomRepository\\SoftwarePortal\"",
  "    matching the path the BES root server serves at",
  "        http://127.0.0.1:52311/Uploads/CustomRepository/SoftwarePortal/<sha1>/<filename>",
  "",
  "    Safe to re-run: if the destination file already exists and its SHA1 matches the",
  "    expected hash, the download is skipped (exit 0).",
  "",
  ".PARAMETER PrefetchLine",
  "    A BigFix prefetch statement, e.g.:",
  "        prefetch Setup.exe sha1:abc123 size:1048576 https://example.com/Setup.exe sha256:def456",
  "",
  ".PARAMETER DestinationRoot",
  "    Optional. Overrides the registry-derived CustomRepository path — mainly for manual",
  "    testing away from the BES root server.",
  "",
  ".EXAMPLE",
  "    .\\Invoke-PrefetchStage.ps1 \"prefetch Setup.exe sha1:abc123 size:1048576 https://example.com/Setup.exe sha256:def456\"",
  "#>",
  "[CmdletBinding()]",
  "param(",
  "    [Parameter(Mandatory, Position = 0, ValueFromPipeline)]",
  "    [string]$PrefetchLine,",
  "",
  "    [Parameter(Position = 1)]",
  "    [string]$DestinationRoot",
  ")",
  "",
  "Set-StrictMode -Version Latest",
  "$ErrorActionPreference = 'Stop'",
  "",
  "# Parse — 'prefetch' keyword is optional so the script accepts a raw matched line too",
  "$pattern = '^(?:prefetch\\s+)?(\\S+)\\s+sha1:([0-9a-fA-F]+)\\s+size:(\\d+)\\s+(\\S+)(?:\\s+sha256:([0-9a-fA-F]+))?'",
  "if ($PrefetchLine -notmatch $pattern) {",
  "    Write-Error \"Cannot parse prefetch line.`nExpected: prefetch <file> sha1:<hash> size:<bytes> <url> [sha256:<hash>]\"",
  "    exit 1",
  "}",
  "",
  "$fileName       = $Matches[1]",
  "$sha1Expected   = $Matches[2].ToUpper()",
  "$sizeExpected   = [long]$Matches[3]",
  "$url            = $Matches[4]",
  "$sha256Expected = if ($Matches[5]) { $Matches[5].ToUpper() } else { $null }",
  "",
  "Write-Host \"File   : $fileName\"",
  "Write-Host \"SHA1   : $sha1Expected\"",
  "Write-Host \"Size   : $sizeExpected bytes\"",
  "Write-Host \"URL    : $url\"",
  "if ($sha256Expected) { Write-Host \"SHA256 : $sha256Expected\" }",
  "",
  "# Resolve destination root — explicit override wins, otherwise derive from the BES",
  "# web root registered by the Enterprise Server (matches the path it serves over HTTP).",
  "if (-not $DestinationRoot) {",
  "    $regPath = 'HKLM:\\SOFTWARE\\Wow6432Node\\BigFix\\Enterprise Server'",
  "    $regProp = Get-ItemProperty -Path $regPath -Name 'wwwRootFolder' -ErrorAction Stop",
  "    $wwwRoot = $regProp.wwwRootFolder",
  "    if (-not $wwwRoot) {",
  "        Write-Error \"Registry value 'wwwRootFolder' at '$regPath' is empty.\"",
  "        exit 1",
  "    }",
  "    $DestinationRoot = Join-Path $wwwRoot 'Uploads\\CustomRepository\\SoftwarePortal'",
  "}",
  "Write-Host \"Target : $DestinationRoot\"",
  "",
  "# Create <sha1>/<filename> directory structure (sha1 in lowercase — BigFix CustomRepository paths use lowercase)",
  "$sha1Dir  = $sha1Expected.ToLower()",
  "$outDir   = Join-Path $DestinationRoot $sha1Dir",
  "$destPath = Join-Path $outDir $fileName",
  "",
  "# Idempotent: if it's already staged and verified, there's nothing to do.",
  "if (Test-Path $destPath) {",
  "    $existingSha1 = (Get-FileHash $destPath -Algorithm SHA1).Hash",
  "    if ($existingSha1 -eq $sha1Expected) {",
  "        Write-Host \"`n[SKIP] Already staged and verified: $destPath\"",
  "        exit 0",
  "    }",
  "    Write-Host \"`n[STALE] Existing file hash mismatch — re-downloading.\"",
  "    Remove-Item $destPath -Force",
  "}",
  "",
  "# Download to a temp path",
  "$tempPath = Join-Path $env:TEMP ([System.IO.Path]::GetRandomFileName())",
  "Write-Host \"`nDownloading...\"",
  "try {",
  "    Invoke-WebRequest -Uri $url -OutFile $tempPath -UseBasicParsing",
  "} catch {",
  "    Write-Error \"Download failed: $_\"",
  "    exit 1",
  "}",
  "",
  "# Size check",
  "$actualSize = (Get-Item $tempPath).Length",
  "if ($actualSize -ne $sizeExpected) {",
  "    Remove-Item $tempPath -Force",
  "    Write-Error \"Size mismatch: expected $sizeExpected bytes, got $actualSize bytes.\"",
  "    exit 1",
  "}",
  "Write-Host \"Size   : OK ($actualSize bytes)\"",
  "",
  "# SHA1 check",
  "$sha1Actual = (Get-FileHash $tempPath -Algorithm SHA1).Hash",
  "if ($sha1Actual -ne $sha1Expected) {",
  "    Remove-Item $tempPath -Force",
  "    Write-Error \"SHA1 mismatch:`n  expected : $sha1Expected`n  actual   : $sha1Actual\"",
  "    exit 1",
  "}",
  "Write-Host \"SHA1   : OK\"",
  "",
  "# SHA256 check (optional)",
  "if ($sha256Expected) {",
  "    $sha256Actual = (Get-FileHash $tempPath -Algorithm SHA256).Hash",
  "    if ($sha256Actual -ne $sha256Expected) {",
  "        Remove-Item $tempPath -Force",
  "        Write-Error \"SHA256 mismatch:`n  expected : $sha256Expected`n  actual   : $sha256Actual\"",
  "        exit 1",
  "    }",
  "    Write-Host \"SHA256 : OK\"",
  "}",
  "",
  "if (-not (Test-Path $outDir)) {",
  "    New-Item -ItemType Directory -Path $outDir | Out-Null",
  "}",
  "",
  "Move-Item -Path $tempPath -Destination $destPath -Force",
  "Write-Host \"`nStaged : $destPath\"",
  "exit 0",
  ""
];
var PREFETCH_STAGE_SCRIPT = PREFETCH_STAGE_SCRIPT_LINES.join('\r\n');

var currentItems      = [];
var currentItem       = null;
var sourceXml         = "";
var selectedItemIndex = -1;
var currentPage       = 0;
var allItems          = [];
var searchTimer       = null;
var sortColumn        = "";
var sortAsc           = true;
var parsedActions     = [];
var selectedActionId  = "";
var allGroups         = [];
var currentGroups     = [];
var selectedGroupData = null;
var sourcePrefetchLines = [];
var openDeploymentCounts = null;

// -- Page size --
function getPageSize(){
  var sel = document.getElementById("pageSizeSelect");
  var val = sel ? sel.value : "50";
  if(val === "all"){ return currentItems.length || 1; }
  return parseInt(val, 10) || 50;
}

// -- HTML escaping to prevent XSS from untrusted BigFix server data --
function htmlEscape(s){
  return String(s)
    .replace(/&/g,"&amp;")
    .replace(/</g,"&lt;")
    .replace(/>/g,"&gt;")
    .replace(/"/g,"&quot;");
}

// -- Status --
function setStatus(msg){
  var el = document.getElementById("status");
  if(el){ el.innerText = msg; }
}

// -- Table helpers --
function clearTable(){
  var t = document.getElementById("fixletTable");
  while(t.rows.length > 0){ t.deleteRow(0); }
}

function addHeader(){
  var t = document.getElementById("fixletTable");
  var r = t.insertRow(-1);
  r.insertCell(-1).innerHTML = "<b>Select</b>";
  r.insertCell(-1).innerHTML = makeSortHeader("name",      "Fixlet Name");
  r.insertCell(-1).innerHTML = makeSortHeader("category",  "Category");
  r.insertCell(-1).innerHTML = makeSortHeader("roleValue", "Roles");
  r.insertCell(-1).innerHTML = makeSortHeader("siteName",  "Site");
  r.insertCell(-1).innerHTML = makeSortHeader("openDeployments", "Open Deployments");
}

// -- Init --
function initDashboard(){
  clearTable();
  addHeader();
  setStatus("Ready.");
  loadGroups();
  loadAllFixlets();
}

// -- REST test --
function testREST(){
  API.Get("sites", function(e,s,b){
    if(s === 200){ setStatus("API OK"); }
    else{ setStatus("FAIL: " + e + " status=" + s); }
  });
}

// -- Open Deployments count: JS-side join, not a correlated subquery --
// A correlated subquery inside a `whose (...)` clause rebinds `it` to the
// item being filtered (the bes action). Comparing the action's own name
// field against itself there is a tautology (always true), so every row
// would silently render the same server-wide open-action count. Instead:
// one extra bulk relevance query for all open action names, counted into
// a hash map in JS, then joined to each fixlet row by exact name match
// (same rule as checkExistingDeployment()).
function buildOpenDeploymentMap(names){
  var map = {}, i, key;
  for(i = 0; i < names.length; i++){
    key = String(names[i]);
    map[key] = (map[key] || 0) + 1;
  }
  return map;
}

function loadOpenDeploymentCounts(){
  try {
    var rel  = '(name of it) of bes actions whose (state of it = "Open")';
    var data = EvaluateRelevance(rel);
    return buildOpenDeploymentMap(data || []);
  } catch(ex) {
    return null;
  }
}

// -- Load all fixlets from Dereso Software Portal site only (D-04) --
function loadAllFixlets(){
  var rel =
    '(id of it as string' +
    ' & "|||" & name of it' +
    ' & "|||" & name of (site of it)' +
    ' & "|||" & (if exists category of it then category of it as string else "")' +
    ' & "|||" & (if exists mime fields whose (name of it = "Associated_Roles") of it' +
    '   then concatenation of values of mime fields whose (name of it = "Associated_Roles") of it' +
    '   else "")' +
    ' & "|||" & (if fixlet flag of it then "fixlet" else "task"))' +
    ' of bes fixlets whose ((custom site flag of site of it and ' +
    ' name of (site of it) = "Dereso Software Portal"  and ' +
	' (fixlet flag of it or task flag of it))and (if (exists category of it) ' +
    ' then (not(category of it as lowercase = "Setup" as lowercase)) else (false)) ' +
    ' of it )';
	

  var data = EvaluateRelevance(rel);
  var i, p;

  openDeploymentCounts = loadOpenDeploymentCounts();

  allItems = [];
  for(i = 0; i < data.length; i++){
    p = String(data[i]).split("|||");
    allItems.push({
      id:        p[0],
      name:      p[1],
      siteName:  p[2],
      category:  p[3],
      roleValue: p[4] || "",
      itemType:  p[5] || "fixlet",
      openDeployments: (openDeploymentCounts === null ? "—" : String(openDeploymentCounts[p[1]] || 0))
    });
  }
  setStatus("Loaded " + allItems.length + " fixlets.");
  filterAndRender();
}

// -- Filter and render --
function filterAndRender(){
  var search   = String(document.getElementById("searchText").value).toLowerCase();
  var rawTerms = search === "" ? [] : search.split(/\s+/);
  var terms    = [];
  var i, t, item, fields, match;

  for(t = 0; t < rawTerms.length; t++){
    if(rawTerms[t] !== ""){ terms.push(rawTerms[t]); }
  }

  currentItems = [];
  for(i = 0; i < allItems.length; i++){
    item = allItems[i];
    if(terms.length > 0){
      fields = [item.name, item.category, item.roleValue, item.siteName].join(" ").toLowerCase();
      match = true;
      for(t = 0; t < terms.length; t++){
        if(fields.indexOf(terms[t]) < 0){ match = false; break; }
      }
      if(!match){ continue; }
    }
    currentItems.push(item);
  }

  setStatus(allItems.length > 0
    ? "Showing " + currentItems.length + " of " + allItems.length + " fixlets."
    : "Click Load Fixlets to begin.");
  applySortToCurrentItems();
  renderPage(0);
}

function onSearchInput(){
  clearTimeout(searchTimer);
  searchTimer = setTimeout(filterAndRender, 300);
}

// -- Render page (columns: Select, Name, Category, Roles, Site — D-05) --
function renderPage(page){
  var pageSize = getPageSize();
  var start    = page * pageSize;
  var end      = Math.min(start + pageSize, currentItems.length);
  var t        = document.getElementById("fixletTable");
  var i, item, r, oc;

  currentPage = page;
  clearTable();
  addHeader();

  for(i = start; i < end; i++){
    item = currentItems[i];
    r    = t.insertRow(-1);
    r.insertCell(-1).innerHTML = '<input type="radio" name="fixSel" onclick="selectFixlet(' + i + ')">';
    r.insertCell(-1).innerHTML = htmlEscape(item.name);
    r.insertCell(-1).innerHTML = htmlEscape(item.category);
    r.insertCell(-1).innerHTML = htmlEscape(item.roleValue || "—");
    r.insertCell(-1).innerHTML = htmlEscape(item.siteName);
    oc = item.openDeployments || "0";
    r.insertCell(-1).innerHTML = (parseInt(oc, 10) > 0)
      ? '<span style="color:#cc6600; font-weight:bold;">' + htmlEscape(oc) + '</span>'
      : htmlEscape(oc);
  }

  updatePagination();
}

function updatePagination(){
  var ctrl       = document.getElementById("paginationControls");
  var pageSize   = getPageSize();
  var totalPages = Math.ceil(currentItems.length / pageSize);
  var start, end;

  if(!ctrl){ return; }
  if(currentItems.length === 0){ ctrl.innerHTML = ""; return; }

  if(pageSize >= currentItems.length){
    ctrl.innerHTML = '<span class="small">Showing all ' + currentItems.length + ' items</span>';
    return;
  }

  start = currentPage * pageSize + 1;
  end   = Math.min((currentPage + 1) * pageSize, currentItems.length);

  ctrl.innerHTML =
    '<button class="btn" ' + (currentPage === 0 ? 'disabled="disabled"' : 'onclick="renderPage(' + (currentPage - 1) + ')"') + '>&laquo; Prev</button>' +
    '&nbsp;<span class="small">Page ' + (currentPage + 1) + ' of ' + totalPages + ' &nbsp;(' + start + '&ndash;' + end + ' of ' + currentItems.length + ')</span>&nbsp;' +
    '<button class="btn" ' + (currentPage >= totalPages - 1 ? 'disabled="disabled"' : 'onclick="renderPage(' + (currentPage + 1) + ')"') + '>Next &raquo;</button>';
}

// -- Sort --
function makeSortHeader(col, label){
  var indicator = sortColumn === col ? (sortAsc ? " &#9650;" : " &#9660;") : "";
  return '<b style="cursor:pointer;" onclick="sortBy(\'' + col + '\')">' + label + indicator + '</b>';
}

function applySortToCurrentItems(){
  if(sortColumn === ""){ return; }
  var col = sortColumn;
  var asc = sortAsc;
  currentItems.sort(function(a, b){
    var va, vb, na, nb;
    if(col === "openDeployments"){
      na = parseInt(String(a[col] || ""), 10) || 0;
      nb = parseInt(String(b[col] || ""), 10) || 0;
      return asc ? na - nb : nb - na;
    }
    va = String(a[col] || "").toLowerCase();
    vb = String(b[col] || "").toLowerCase();
    if(va < vb){ return asc ? -1 : 1; }
    if(va > vb){ return asc ? 1 : -1; }
    return 0;
  });
}

function sortBy(col){
  if(sortColumn === col){ sortAsc = !sortAsc; }
  else { sortColumn = col; sortAsc = true; }
  applySortToCurrentItems();
  renderPage(0);
}

// -- XML helpers --
function getNodeText(xml, tag){
  var n = xml.getElementsByTagName(tag);
  if(n.length > 0){ return n[0].text || ""; }
  return "";
}

function xmlEscape(s){
  return String(s)
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;")
    .replace(/'/g, "&apos;");
}

function cdataStart(){ return '<!' + '[CDATA['; }
function cdataEnd(){   return ']]' + '>'; }
function xmlCDataSafe(s){ return String(s).replace(/\]\]>/g, ']]]]><![CDATA[>'); }

// -- Target group relevance builder — type-aware (BigFix Software Installer Library method) --
// Automatic: member of group <id> of site (numeric ID + lowercase site name comparison)
// Manual: client setting __Group_0_<name>
// Server Based: client setting __Group_1_<name>
// Wrapped in "exists true whose (if true then ... else false)" defensive pattern per BigFix library.
// BigFix relevance uses "" to escape a literal double quote within a string.
function buildTargetRelevance(group){
  if(!group){ return "true"; }
  var id       = group.id;
  var name     = group.name;
  var site     = (group.siteName || "").toLowerCase();
  var type     = group.groupType || "Automatic";
  var safeName = String(name).replace(/"/g, '""');
  var safeSite = site.replace(/"/g, '""');
  if(type === "Manual"){
    return 'exists true whose (if true then (exists setting "__Group_0_' + safeName + '" whose (value of it is "True") of client) else false)';
  }
  if(type === "Server Based"){
    return 'exists true whose (if true then (exists setting "__Group_1_' + safeName + '" whose (value of it is "True") of client) else false)';
  }
  return 'exists true whose (if true then (member of group ' + id + ' of site whose (name of it as lowercase = "' + safeSite + '" as lowercase)) else false)';
}

// -- Action ID extraction from POST response (RESEARCH.md Pattern 3) --
function parseActionId(body){
  var m;
  if(!body){ return ""; }
  try {
    var xml = new ActiveXObject("Msxml2.DOMDocument.6.0");
    xml.async = false;
    xml.loadXML(body);
    var nodes = xml.getElementsByTagName("Action");
    if(nodes.length > 0){
      var idNode = nodes[0].selectSingleNode("ID");
      if(idNode && idNode.text){ return idNode.text; }
      var res = nodes[0].getAttribute("Resource");
      if(res){ var rm = /\/(\d+)$/.exec(res); if(rm && rm[1]){ return rm[1]; } }
    }
  } catch(ex) {}
  m = /\/api\/action\/(\d+)/i.exec(body);
  if(m && m[1]){ return m[1]; }
  m = /<ID>(\d+)<\/ID>/i.exec(body);
  if(m && m[1]){ return m[1]; }
  return "";
}

// -- Parse action dropdown from fixlet XML (RESEARCH.md Pattern 4) --
function parseActions(xmlText){
  var xml = new ActiveXObject("Msxml2.DOMDocument.6.0");
  xml.async = false;
  xml.loadXML(xmlText);
  parsedActions    = [];
  selectedActionId = "";

  var defaults = xml.getElementsByTagName("DefaultAction");
  var actions  = xml.getElementsByTagName("Action");
  var i, node, idAttr;

  for(i = 0; i < defaults.length; i++){
    node   = defaults[i];
    idAttr = node.getAttribute("ID") || "Action1";
    parsedActions.push({ id: idAttr, label: "Default Action (" + idAttr + ")" });
  }
  for(i = 0; i < actions.length; i++){
    node   = actions[i];
    idAttr = node.getAttribute("ID") || ("Action" + (i + 1));
    parsedActions.push({ id: idAttr, label: idAttr });
  }
  renderActionDropdown();
}

// -- Render action dropdown (D-08: no auto-selection) --
function renderActionDropdown(){
  var sel = document.getElementById("actionSelect");
  if(!sel){ return; }
  sel.innerHTML = "";

  if(parsedActions.length === 0){
    var noOpt = document.createElement("option");
    noOpt.value = "";
    noOpt.text  = "No actions found";
    sel.appendChild(noOpt);
    selectedActionId = "";
    refreshPrefetchAndStatus();
    return;
  }

  var blank = document.createElement("option");
  blank.value = "";
  blank.text  = "-- Select action --";
  sel.appendChild(blank);

  for(var i = 0; i < parsedActions.length; i++){
    var opt = document.createElement("option");
    opt.value = parsedActions[i].id;
    opt.text  = parsedActions[i].label;
    sel.appendChild(opt);
  }
  // Auto-select the first Default Action if present, otherwise the first action
  sel.selectedIndex = 1;
  selectedActionId = parsedActions[0].id;
  updatePreview();
  refreshPrefetchAndStatus();
}

// -- Rewrite prefetch URLs to local managed repository on the root server --
// Transforms: prefetch <file> sha1:<sha1> size:<n> <original-url> [sha256:<sha256>]
// Into:       prefetch <file> sha1:<sha1> size:<n> http://127.0.0.1:52311/Uploads/CustomRepository/SoftwarePortal/<sha1>/<file> [sha256:<sha256>]
function rewritePrefetchUrls(script){
  return script.replace(
    /^(prefetch\s+(\S+)\s+sha1:([0-9a-fA-F]+)\s+size:\d+\s+)\S+((?:\s+sha256:[0-9a-fA-F]+)?)$/gim,
    function(match, leader, filename, sha1, tail){
      var newLine = leader + 'http://127.0.0.1:52311/Uploads/CustomRepository/SoftwarePortal/' + sha1 + '/' + filename + tail;
      return '// ' + match + '\r\n' + newLine;
    }
  );
}

// -- Extract prefetch line(s) from an (unrewritten) action script --
// Returns [{ filename, sha1, size, url, raw }] in source order. raw is the
// exact original line text (before rewritePrefetchUrls touches it) — this is
// what gets handed to Invoke-PrefetchStage.ps1 on the root server so it
// downloads from the ORIGINAL internet URL, not the local rewritten one.
function extractPrefetchLines(script){
  var results = [];
  var re = /^(?:prefetch\s+)?(\S+)\s+sha1:([0-9a-fA-F]+)\s+size:(\d+)\s+(\S+)(?:\s+sha256:[0-9a-fA-F]+)?$/gim;
  var m;
  while((m = re.exec(String(script || ""))) !== null){
    results.push({
      filename: m[1],
      sha1:     m[2],
      size:     m[3],
      url:      m[4],
      raw:      m[0]
    });
  }
  return results;
}

// Only the OPENING brace is doubled. "{{" is BigFix ActionScript's escape for a
// literal "{" — it never opens a real {relevance} substitution, so a later plain
// "}" has nothing to close and passes through as a literal character on its own.
// Doubling "}" too produces a stray extra "}" at the end of every block in the
// embedded script — confirmed against the one other embedded-PS1 example in this
// codebase, Dashboard_4_samples/"Init  Current User and UserRole DB.bes", which
// follows the same asymmetric rule (e.g. "if (...) {{" / "@{{ Name = ... }" but
// every closing "}" stays single).
function escapeActionScriptBraces(s){
  return String(s).replace(/\{/g, "{{");
}

// -- Build the ActionScript that stages this deploy's prefetch file(s) on the --
// -- root server, by createfile-ing Invoke-PrefetchStage.ps1 into the BES     --
// -- Client's EC folder and running it once per prefetch line found.         --
function buildStagingActionScript(prefetchLines){
  var ecPath = '{pathname of folder "EC" of parent folder of client}\\Invoke-PrefetchStage.ps1';
  var lines  = [];
  var i, arg;

  lines.push('delete __createfile');
  lines.push('delete "' + ecPath + '"');
  lines.push('');
  lines.push('createfile until _EOF_');
  lines.push(escapeActionScriptBraces(PREFETCH_STAGE_SCRIPT));
  lines.push('_EOF_');
  lines.push('move __createfile "' + ecPath + '"');
  lines.push('');
  for(i = 0; i < prefetchLines.length; i++){
    arg = String(prefetchLines[i].raw).replace(/"/g, "");
    lines.push('waithidden powershell.exe -NoProfile -ExecutionPolicy Bypass -File "' + ecPath + '" "' + arg + '"');
  }
  lines.push('');
  lines.push('delete "' + ecPath + '"');

  return lines.join('\r\n');
}

// -- Build a SingleAction XML that stages this deploy's prefetch file(s) on --
// -- the BES root server (PORTAL_CONFIG.rootServerComputerId). Sent BEFORE  --
// -- the main deploy action so the CustomRepository cache is warm before    --
// -- any client's rewritten prefetch line resolves.                        --
function buildStagingActionXml(prefetchLines, title){
  if(!PORTAL_CONFIG.rootServerComputerId){ return ""; }
  if(!prefetchLines || prefetchLines.length === 0){ return ""; }

  var stamp  = new Date().toISOString();
  var script = buildStagingActionScript(prefetchLines);

  var xml  = '<?xml version="1.0" encoding="UTF-8"?>\r\n';
  xml += '<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"';
  xml += ' xsi:noNamespaceSchemaLocation="BES.xsd">\r\n';
  xml += '  <SingleAction>\r\n';
  xml += '    <Title>' + xmlEscape('Dereso_Stage ' + (title || "") + ' ' + stamp) + '</Title>\r\n';
  xml += '    <Relevance>true</Relevance>\r\n';
  xml += '    <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">';
  xml += cdataStart() + xmlCDataSafe(script) + cdataEnd();
  xml += '</ActionScript>\r\n';
  xml += '    <Settings>\r\n';
  xml += '      <ActionUITitle>Stage prefetch files</ActionUITitle>\r\n';
  xml += '      <PreActionShowUI>false</PreActionShowUI>\r\n';
  xml += '      <HasEndTime>true</HasEndTime>\r\n';
  xml += '      <EndDateTimeLocalOffset>P1D</EndDateTimeLocalOffset>\r\n';
  xml += '      <HasRetry>true</HasRetry>\r\n';
  xml += '      <RetryCount>3</RetryCount>\r\n';
  xml += '      <RetryWait Behavior="WaitForInterval">PT10M</RetryWait>\r\n';
  xml += '      <IsOffer>false</IsOffer>\r\n';
  xml += '    </Settings>\r\n';
  xml += '    <Target>\r\n';
  xml += '      <ComputerID>' + xmlEscape(PORTAL_CONFIG.rootServerComputerId) + '</ComputerID>\r\n';
  xml += '    </Target>\r\n';
  xml += '    <MIMEFieldSingleAction>\r\n';
  xml += '      <Name>Dereso_StagingFor</Name>\r\n';
  xml += '      <Value>' + xmlEscape(title || "") + '</Value>\r\n';
  xml += '    </MIMEFieldSingleAction>\r\n';
  xml += '  </SingleAction>\r\n';
  xml += '</BES>';
  return xml;
}

// -- Extract action script from parsed fixlet DOM by action ID --
function getActionScript(xmlDom, actionId){
  var defaults = xmlDom.getElementsByTagName("DefaultAction");
  var actions  = xmlDom.getElementsByTagName("Action");
  var i, node, id, scriptNode;
  for(i = 0; i < defaults.length; i++){
    node = defaults[i];
    id   = node.getAttribute("ID") || "Action1";
    if(id === actionId){
      scriptNode = node.getElementsByTagName("ActionScript")[0];
      if(scriptNode){
        return { script: scriptNode.text || "", mimeType: scriptNode.getAttribute("MIMEType") || "application/x-Fixlet-Windows-Shell" };
      }
    }
  }
  for(i = 0; i < actions.length; i++){
    node = actions[i];
    id   = node.getAttribute("ID") || ("Action" + (i + 1));
    if(id === actionId){
      scriptNode = node.getElementsByTagName("ActionScript")[0];
      if(scriptNode){
        return { script: scriptNode.text || "", mimeType: scriptNode.getAttribute("MIMEType") || "application/x-Fixlet-Windows-Shell" };
      }
    }
  }
  return null;
}

// -- Re-parse sourceXml and pull the ActionScript for the currently selected action --
function getCurrentActionScript(){
  if(!sourceXml || !selectedActionId){ return null; }
  var fxml = new ActiveXObject("Msxml2.DOMDocument.6.0");
  fxml.async = false;
  fxml.loadXML(sourceXml);
  return getActionScript(fxml, selectedActionId);
}

// -- Refresh sourcePrefetchLines for the current action, then re-run the --
// -- staging checkbox / precache / existing-deployment indicators.       --
function refreshPrefetchAndStatus(){
  var info = getCurrentActionScript();
  sourcePrefetchLines = info ? extractPrefetchLines(info.script) : [];
  updateStagingCheckboxUI();
  checkPrecache();
  checkExistingDeployment();
}

// -- Enable/disable the "Stage file on root server" checkbox and explain why --
function updateStagingCheckboxUI(){
  var cb   = document.getElementById("stageOnRootServer");
  var note = document.getElementById("stagingNote");
  if(!cb){ return; }
  var hasPrefetch = sourcePrefetchLines.length > 0;
  var hasRootId   = !!PORTAL_CONFIG.rootServerComputerId;

  if(!hasRootId){
    cb.checked  = false;
    cb.disabled = true;
    if(note){ note.innerHTML = htmlEscape("rootServerComputerId not configured in PORTAL_CONFIG — staging disabled."); }
  } else if(!hasPrefetch){
    cb.checked  = false;
    cb.disabled = true;
    if(note){ note.innerHTML = htmlEscape("Selected action has no prefetch statement — nothing to stage."); }
  } else {
    cb.disabled = false;
    cb.checked  = true;
    var names = [];
    for(var i = 0; i < sourcePrefetchLines.length; i++){ names.push(sourcePrefetchLines[i].filename); }
    if(note){ note.innerHTML = htmlEscape(names.length + " file(s) will be staged: " + names.join(", ")); }
  }
}

// -- Precache indicator: reads the "Cached SHA1 Directories" retrieved --
// -- property from the "Dereso SWD Repository Cache" Analysis on the   --
// -- root server (see Dashboard_4_samples/Dereso SWD Repository Cache.bes). --
function checkPrecache(){
  var el = document.getElementById("precacheStatus");
  if(!el){ return; }

  if(sourcePrefetchLines.length === 0){
    el.innerHTML = htmlEscape("—");
    return;
  }
  if(!PORTAL_CONFIG.rootServerComputerId){
    el.innerHTML = htmlEscape("Unknown (rootServerComputerId not configured)");
    return;
  }

  el.innerHTML = htmlEscape("Checking...");
  try {
    var safeId = String(PORTAL_CONFIG.rootServerComputerId).replace(/"/g, "");
    var rel = '(( if (exists  results (item 0 of it, item 1 of it) and exists values of  results (item 0 of it, item 1 of it) ) then ( concatenation "" of values of results (item 0 of it, item 1 of it)) else "")of it) of ( bes computers whose (id of it as string = "' + safeId + '"), bes property "Cached SHA1 Directories")';
    var data = EvaluateRelevance(rel);
    var cachedList = (data && data.length > 0) ? String(data[0]).toLowerCase().split("|") : [];
    var missing = [];
    var i, sha1;
    for(i = 0; i < sourcePrefetchLines.length; i++){
      sha1 = sourcePrefetchLines[i].sha1.toLowerCase();
      if(cachedList.indexOf(sha1) < 0){ missing.push(sourcePrefetchLines[i].filename); }
    }
    if(cachedList.length === 0){
      el.innerHTML = htmlEscape("Unknown — Analysis not reporting yet (import Dereso SWD Repository Cache.bes to the root server)");
    } else if(missing.length === 0){
      el.innerHTML = '<span style="color:#237241; font-weight:bold;">&#10003; Cached on root server</span>';
    } else {
      el.innerHTML = '<span style="color:#cc6600; font-weight:bold;">Not cached: ' + htmlEscape(missing.join(", ")) + '</span>';
    }
  } catch(ex) {
    el.innerHTML = htmlEscape("Unknown (could not evaluate: " + (ex.message || ex.description || String(ex)) + ")");
  }
}

// -- Existing-deployment indicator: any open action for this fixlet (Title --
// -- match — reliable), plus open actions targeting the currently selected --
// -- group specifically (SmartRole_Source MIME field match — best effort,  --
// -- degrades to "Unknown" if this BigFix version doesn't expose action    --
// -- MIME fields to session relevance).                                    --
function checkExistingDeployment(){
  var elAny = document.getElementById("deploymentStatusAny");
  var elGrp = document.getElementById("deploymentStatusGroup");
  if(elAny){ elAny.innerHTML = htmlEscape("—"); }
  if(elGrp){ elGrp.innerHTML = htmlEscape("—"); }
  if(!currentItem){ return; }

  var safeName = String(currentItem.name || "").replace(/"/g, '""');
  try {
    var relAny   = '((number of bes actions whose (state of it = "Open"  and name of it = "' + safeName + '" )))';
    var dataAny  = EvaluateRelevance(relAny);
    var countAny = (dataAny && dataAny.length > 0) ? (parseInt(String(dataAny[0]), 10) || 0) : 0;
    if(elAny){
      elAny.innerHTML = countAny > 0
        ? '<span style="color:#cc6600; font-weight:bold;">' + countAny + ' open action(s) already exist for this fixlet</span>'
        : '<span style="color:#237241;">No open actions for this fixlet</span>';
    }
  } catch(ex) {
    if(elAny){ elAny.innerHTML = htmlEscape("Unknown (could not evaluate)"); }
  }

  if(!selectedGroupData){ return; }
  try {
    var safeGroup = String(selectedGroupData.name || "").replace(/\\/g, "\\\\").replace(/"/g, '\\"');
    var relGrp = 'if (exists true whose (if true then ((exists key "targetGroup" of (json of it ) ) of ( values of mime fields whose(name of it = "SmartRole_Source") of it as string ) of (bes actions whose (state of it = "Open" and name of it = "' + safeName + '" and exists mime field whose (exists name whose (it = "SmartRole_Source") of it) of it ) ) ) else false)) then  (number of bes actions whose (state of it = "Open"  and name of it = "' + safeName + '"  and exists ( mime field "SmartRole_Source" whose (exists (value of key "targetGroup" of json of it)whose (it as string = "' + safeGroup + '")) of it as string )  ) )   else 0';
    var dataGrp  = EvaluateRelevance(relGrp);
    var countGrp = (dataGrp && dataGrp.length > 0) ? (parseInt(String(dataGrp[0]), 10) || 0) : 0;
    if(elGrp){
      elGrp.innerHTML = countGrp > 0
        ? '<span style="color:#cc6600; font-weight:bold;">' + countGrp + ' open deployment(s) already targeting "' + htmlEscape(selectedGroupData.name) + '"</span>'
        : '<span style="color:#237241;">None targeting "' + htmlEscape(selectedGroupData.name) + '"</span>';
    }
  } catch(ex) {
    if(elGrp){ elGrp.innerHTML = htmlEscape("Unknown (action MIME field query not supported on this BigFix version)"); }
  }
}

// -- Select fixlet — loads XML via API.Get (D-07) --
function selectFixlet(i){
  if(i < 0 || i >= currentItems.length){
    setStatus("Selection error: please try again.");
    return;
  }
  selectedItemIndex = i;
  currentItem       = currentItems[i];
  var path = (currentItem.itemType === "task" ? "task" : "fixlet") + "/custom/" +
    encodeURIComponent(currentItem.siteName) + "/" +
    encodeURIComponent(currentItem.id);

  API.Get(path, function(e, s, b){
    if(s === 200){
      sourceXml = b;
      parseDetailPanel(b);
      setStatus("Loaded: " + currentItem.name);
    } else {
      setStatus("Load failed: status=" + s);
    }
  });
}

// -- Parse detail panel from fixlet XML --
function parseDetailPanel(xmlText){
  var xml = new ActiveXObject("Msxml2.DOMDocument.6.0");
  xml.async = false;
  xml.loadXML(xmlText);

  var name     = getNodeText(xml, "Title");
  var category = getNodeText(xml, "Category");

  // Read Associated_Roles MIME field (established pattern from modifier.ojo)
  var mimeNodes = xml.getElementsByTagName("MIMEField");
  var m, nameNode, valueNode, mName, rolesValue = "";
  for(m = 0; m < mimeNodes.length; m++){
    nameNode = mimeNodes[m].selectSingleNode("Name");
    mName    = nameNode ? String(nameNode.text || "").replace(/^\s+|\s+$/g, "") : "";
    if(mName === "Associated_Roles"){
      valueNode  = mimeNodes[m].selectSingleNode("Value");
      rolesValue = valueNode ? String(valueNode.text || "") : "";
      break;
    }
  }
  var existingRoles = rolesValue !== "" ? rolesValue.split("|").filter(function(r){ return r !== ""; }) : [];
  var rolesDisplay  = existingRoles.length > 0 ? existingRoles.join(" | ") : "—";

  // Count actions
  var defaults    = xml.getElementsByTagName("DefaultAction");
  var actionNodes = xml.getElementsByTagName("Action");
  var actionCount = defaults.length + actionNodes.length;

  // Populate detail panel DOM
  var elName     = document.getElementById("detailName");
  var elCat      = document.getElementById("detailCategory");
  var elRoles    = document.getElementById("detailRoles");
  var elCount    = document.getElementById("detailActionCount");
  var panelEl    = document.getElementById("detailPanel");

  if(elName)  { elName.innerHTML  = htmlEscape(name); }
  if(elCat)   { elCat.innerHTML   = htmlEscape(category); }
  if(elRoles) { elRoles.innerHTML = htmlEscape(rolesDisplay); }
  if(elCount) { elCount.innerHTML = htmlEscape(actionCount + " action" + (actionCount !== 1 ? "s" : "")); }
  if(panelEl) { panelEl.style.display = ""; }

  parseActions(xmlText);
  updatePreview();
}

// -- Target group helpers --
function getSelectedTargetGroup(){
  return selectedGroupData ? selectedGroupData.name : "";
}

function getExpirationDays(){
  var inp = document.getElementById("expiryDaysInput");
  if(!inp){ return PORTAL_CONFIG.defaultExpirationDays; }
  var val = parseInt(inp.value, 10);
  return (val > 0) ? val : PORTAL_CONFIG.defaultExpirationDays;
}

// -- Live preview update (D-10) --
function updatePreview(){
  var name     = currentItem ? currentItem.name     : "—";
  var category = currentItem ? currentItem.category : "—";
  var days     = getExpirationDays();

  // Calculate absolute expiry date (YYYY-MM-DD)
  var expiryDate = new Date();
  expiryDate.setDate(expiryDate.getDate() + days);
  var yyyy = expiryDate.getFullYear();
  var mm   = String(expiryDate.getMonth() + 1);
  var dd   = String(expiryDate.getDate());
  if(mm.length < 2){ mm = "0" + mm; }
  if(dd.length < 2){ dd = "0" + dd; }
  var expiryStr = yyyy + "-" + mm + "-" + dd;

  var setInner = function(id, val){
    var el = document.getElementById(id);
    if(el){ el.innerHTML = htmlEscape(val); }
  };

  setInner("previewTitle",    name);
  setInner("previewCategory", category);
  setInner("previewAction",   selectedActionId || "—");
  setInner("previewTarget",   getSelectedTargetGroup() || "—");

  var elExpiry = document.getElementById("previewExpiry");
  if(elExpiry){ elExpiry.innerHTML = htmlEscape(expiryStr); }
}

// -- Action change handler --
function onActionChange(){
  var sel = document.getElementById("actionSelect");
  selectedActionId = sel ? sel.value : "";
  updatePreview();
  refreshPrefetchAndStatus();
}

// -- Target group change handler --
function onTargetGroupChange(){
  var sel = document.getElementById("targetGroupSelect");
  if(!sel || sel.selectedIndex < 0){
    selectedGroupData = null;
  } else {
    var idx = parseInt(sel.value, 10);
    selectedGroupData = (idx >= 0 && idx < currentGroups.length) ? currentGroups[idx] : null;
  }
  updatePreview();
  checkExistingDeployment();
}

// -- Load all BigFix computer groups dynamically via EvaluateRelevance --
function loadGroups(){
  var statEl = document.getElementById("groupStatus");
  var sel    = document.getElementById("targetGroupSelect");
  if(sel){ sel.innerHTML = ""; }
  if(statEl){ statEl.innerText = "Loading groups..."; }
  allGroups = [];
  currentGroups = [];
  selectedGroupData = null;
  try {
    var rel = '(id of it as string & "|||" & name of it & "|||" & name of (site of it) & "|||" & (if (server based flag of it) then "Server Based" else if (automatic flag of it) then "Automatic" else "Manual")) of bes computer groups';
    var data = EvaluateRelevance(rel);
    var i, p;
    for(i = 0; i < data.length; i++){
      p = String(data[i]).split("|||");
      allGroups.push({ id: p[0], name: p[1], siteName: p[2], groupType: p[3] });
    }
    allGroups.sort(function(a, b){
      var na = (a.name || "").toLowerCase(), nb = (b.name || "").toLowerCase();
      return na < nb ? -1 : na > nb ? 1 : 0;
    });
    currentGroups = allGroups.slice();
    renderGroupSelect();
    if(statEl){ statEl.innerText = allGroups.length + " group" + (allGroups.length !== 1 ? "s" : "") + " loaded."; }
  } catch(ex) {
    if(statEl){ statEl.innerText = "Could not load groups."; }
  }
}

// -- Filter groups by search text --
function filterGroups(){
  var search = String(document.getElementById("groupSearch").value || "").toLowerCase();
  var terms  = search === "" ? [] : search.split(/\s+/).filter(function(t){ return t !== ""; });
  if(terms.length === 0){
    currentGroups = allGroups.slice();
  } else {
    currentGroups = [];
    for(var i = 0; i < allGroups.length; i++){
      var g     = allGroups[i];
      var field = (g.name + " " + g.siteName).toLowerCase();
      var match = true;
      for(var t = 0; t < terms.length; t++){
        if(field.indexOf(terms[t]) < 0){ match = false; break; }
      }
      if(match){ currentGroups.push(g); }
    }
  }
  renderGroupSelect();
  var statEl = document.getElementById("groupStatus");
  if(statEl){
    statEl.innerText = terms.length === 0
      ? allGroups.length + " group" + (allGroups.length !== 1 ? "s" : "") + "."
      : currentGroups.length + " of " + allGroups.length + " groups.";
  }
}

// -- Render the group list into the select element --
function renderGroupSelect(){
  var sel = document.getElementById("targetGroupSelect");
  if(!sel){ return; }
  sel.innerHTML = "";
  for(var i = 0; i < currentGroups.length; i++){
    var g   = currentGroups[i];
    var opt = document.createElement("option");
    opt.value = String(i);
    opt.text  = g.name + "  [" + g.siteName + "]";
    sel.appendChild(opt);
  }
  if(selectedGroupData){
    for(var j = 0; j < currentGroups.length; j++){
      if(currentGroups[j].id === selectedGroupData.id){
        sel.selectedIndex = j;
        return;
      }
    }
  }
  sel.selectedIndex = -1;
}

// -- Build SingleAction XML (FR-05, FR-06, FR-07) --
// Uses SingleAction (not SourcedFixletAction) because <CustomRelevance> inside
// SingleAction/<Target> is evaluated client-side on each endpoint — matching the method
// used by the BigFix Software Installer Library for Windows (install.js confirmSelection).
// SourcedFixletAction evaluates <CustomRelevance> server-side, yielding 0 relevant computers
// for group-membership expressions that rely on client-local data.
function buildDeployXml(){
  if(!sourceXml || !currentItem || !selectedActionId || !selectedGroupData){ return ""; }

  var category   = currentItem.category || "";
  var expiryDays = getExpirationDays();

  var fxml = new ActiveXObject("Msxml2.DOMDocument.6.0");
  fxml.async = false;
  fxml.loadXML(sourceXml);

  // Collect all Relevance clauses — fixlets often have multiple (platform check + app check).
  // getNodeText() only returns the first, losing the rest. AND them all together.
  var relParts = [], ri, fixletNode = fxml.getElementsByTagName("Fixlet")[0] || fxml.getElementsByTagName("Task")[0];
  if(fixletNode){
    var rChildren = fixletNode.childNodes;
    for(ri = 0; ri < rChildren.length; ri++){
      if(rChildren[ri].nodeName === "Relevance"){
        var rt = String(rChildren[ri].text || "").replace(/^\s+|\s+$/g, "");
        if(rt){ relParts.push(rt); }
      }
    }
  }
  var relevance = relParts.length === 0 ? "true" :
                  relParts.length === 1 ? relParts[0] :
                  "(" + relParts.join(") AND (") + ")";
  var offerDesc  = getNodeText(fxml, "Description");
  var actionInfo = getActionScript(fxml, selectedActionId);
  if(!actionInfo){ return ""; }

  // Extract MIME fields from source fixlet to carry over into the deployed SingleAction.
  var uiMetadata      = "";
  var associatedRoles = "";
  var mimeNodes       = fxml.getElementsByTagName("MIMEField");
  var mn, mNameNode, mValueNode, mNameText;
  for(mn = 0; mn < mimeNodes.length; mn++){
    mNameNode = mimeNodes[mn].selectSingleNode("Name");
    mNameText = mNameNode ? String(mNameNode.text || "").replace(/^\s+|\s+$/g, "") : "";
    if(mNameText === "action-ui-metadata"){
      mValueNode = mimeNodes[mn].selectSingleNode("Value");
      uiMetadata = mValueNode ? String(mValueNode.text || "") : "";
    } else if(mNameText === "Associated_Roles"){
      mValueNode      = mimeNodes[mn].selectSingleNode("Value");
      associatedRoles = mValueNode ? String(mValueNode.text || "") : "";
    }
  }

  // SmartRole_Source: records the source fixlet identity for downstream role resolution.
  var safeId    = String(currentItem.id       || "").replace(/\\/g, "\\\\").replace(/"/g, '\\"');
  var safeSite  = String(currentItem.siteName || "").replace(/\\/g, "\\\\").replace(/"/g, '\\"');
  var safeGroup = String((selectedGroupData && selectedGroupData.name) || "").replace(/\\/g, "\\\\").replace(/"/g, '\\"');
  var smartRoleSource = '{"id":"' + safeId + '","sitename":"' + safeSite + '","targetGroup":"' + safeGroup + '"}';

  var targetRel = buildTargetRelevance(selectedGroupData);

  var xml  = '<?xml version="1.0" encoding="UTF-8"?>\r\n';
  xml += '<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"';
  xml += ' xsi:noNamespaceSchemaLocation="BES.xsd">\r\n';
  xml += '  <SingleAction>\r\n';
  xml += '    <Title>' + xmlEscape(currentItem.name || "") + '</Title>\r\n';
  xml += '    <Relevance>' + xmlEscape(relevance) + '</Relevance>\r\n';
  xml += '    <ActionScript MIMEType="' + xmlEscape(actionInfo.mimeType) + '">';
  xml += cdataStart() + xmlCDataSafe(rewritePrefetchUrls(actionInfo.script)) + cdataEnd();
  xml += '</ActionScript>\r\n';
  xml += '    <Settings>\r\n';
  xml += '      <ActionUITitle>' + xmlEscape(currentItem.name || "") + '</ActionUITitle>\r\n';
  xml += '      <HasEndTime>true</HasEndTime>\r\n';
  xml += '      <EndDateTimeLocalOffset>P' + parseInt(expiryDays, 10) + 'D</EndDateTimeLocalOffset>\r\n';
  xml += '      <HasRetry>true</HasRetry>\r\n';
  xml += '      <RetryCount>3</RetryCount>\r\n';
  xml += '      <RetryWait Behavior="WaitForInterval">PT15M</RetryWait>\r\n';
  xml += '      <IsOffer>true</IsOffer>\r\n';
  xml += '      <AnnounceOffer>false</AnnounceOffer>\r\n';
  xml += '      <OfferCategory>' + xmlEscape(category) + '</OfferCategory>\r\n';
  xml += '      <OfferDescriptionHTML>' + cdataStart() + xmlCDataSafe(offerDesc) + cdataEnd() + '</OfferDescriptionHTML>\r\n';
  xml += '    </Settings>\r\n';
  xml += '    <Target>\r\n';
  xml += '      <CustomRelevance>' + cdataStart() + xmlCDataSafe(targetRel) + cdataEnd() + '</CustomRelevance>\r\n';
  xml += '    </Target>\r\n';
  if(uiMetadata){
    xml += '    <MIMEFieldSingleAction>\r\n';
    xml += '      <Name>action-ui-metadata</Name>\r\n';
    xml += '      <Value>' + xmlEscape(uiMetadata) + '</Value>\r\n';
    xml += '    </MIMEFieldSingleAction>\r\n';
  }
  if(associatedRoles){
    xml += '    <MIMEFieldSingleAction>\r\n';
    xml += '      <Name>Associated_Roles</Name>\r\n';
    xml += '      <Value>' + xmlEscape(associatedRoles) + '</Value>\r\n';
    xml += '    </MIMEFieldSingleAction>\r\n';
  }
  xml += '    <MIMEFieldSingleAction>\r\n';
  xml += '      <Name>SmartRole_Source</Name>\r\n';
  xml += '      <Value>' + xmlEscape(smartRoleSource) + '</Value>\r\n';
  xml += '    </MIMEFieldSingleAction>\r\n';
  xml += '  </SingleAction>\r\n';
  xml += '</BES>';
  return xml;
}

// -- Deploy fixlet — builds SingleAction XML with client-side group targeting --
function deployFixlet(){
  if(!sourceXml || !currentItem){
    setStatus("Select a fixlet first.");
    return;
  }
  if(!selectedGroupData){
    setStatus("Select a target group.");
    return;
  }
  if(!selectedActionId){
    setStatus("Select an action.");
    return;
  }

  var xml = buildDeployXml();
  if(xml === ""){
    setStatus("Could not build deployment XML.");
    return;
  }

  // D-11: inline feedback — no alert()
  var errEl    = document.getElementById("deployError");
  var resultEl = document.getElementById("deployResult");
  if(errEl)    { errEl.style.display    = "none"; errEl.innerHTML    = ""; }
  if(resultEl) { resultEl.style.display = "none"; resultEl.innerHTML = ""; }

  var stageCb      = document.getElementById("stageOnRootServer");
  var wantsStaging = !!(stageCb && !stageCb.disabled && stageCb.checked && sourcePrefetchLines.length > 0);

  var postDeploy = function(stagingNote){
    setStatus("Deploying...");
    API.Post("actions", xml, function(e, s, b){
      if(s === 200 || s === 201){
        var bodyText  = (typeof b !== "undefined" && b !== null) ? String(b) : "";
        var actionIdR = parseActionId(bodyText);
        setStatus("Deployed successfully.");
        if(resultEl){
          resultEl.style.display = "";
          resultEl.innerHTML = htmlEscape("Action ID: " + (actionIdR || "(unknown)") + (stagingNote ? "  " + stagingNote : ""));
        }
      } else {
        setStatus("Deploy failed: status=" + s);
        if(errEl){
          errEl.style.display = "";
          errEl.innerHTML = htmlEscape("Deploy failed: status=" + s + " — " + (e || ""));
        }
      }
    });
  };

  if(wantsStaging){
    var stagingXml = buildStagingActionXml(sourcePrefetchLines, currentItem.name);
    if(stagingXml === ""){
      postDeploy("(staging skipped: could not build staging action)");
      return;
    }
    setStatus("Staging file(s) on root server...");
    API.Post("actions", stagingXml, function(e2, s2, b2){
      var stagingNote;
      if(s2 === 200 || s2 === 201){
        var stagingBody = (typeof b2 !== "undefined" && b2 !== null) ? String(b2) : "";
        var stagingId    = parseActionId(stagingBody);
        stagingNote = "(staging action " + (stagingId || "?") + " sent)";
      } else {
        stagingNote = "(staging action failed: status=" + s2 + " — main deploy still sent)";
      }
      postDeploy(stagingNote);
    });
  } else {
    postDeploy("");
  }
}

// -- Reset deploy form (D-11: "Deploy Another" resets state) --
function resetDeployForm(){
  sourceXml           = "";
  currentItem         = null;
  parsedActions       = [];
  selectedActionId    = "";
  selectedItemIndex   = -1;
  sourcePrefetchLines = [];

  var resultEl = document.getElementById("deployResult");
  var errEl    = document.getElementById("deployError");
  var panelEl  = document.getElementById("detailPanel");

  if(resultEl) { resultEl.style.display = "none"; resultEl.innerHTML = ""; }
  if(errEl)    { errEl.style.display    = "none"; errEl.innerHTML    = ""; }
  if(panelEl)  { panelEl.style.display  = "none"; }

  // Reset form inputs
  var expiryInp = document.getElementById("expiryDaysInput");
  if(expiryInp){ expiryInp.value = String(PORTAL_CONFIG.defaultExpirationDays); }

  selectedGroupData = null;
  var searchInp = document.getElementById("groupSearch");
  if(searchInp){ searchInp.value = ""; }
  currentGroups = allGroups.slice();
  renderGroupSelect();
  var statEl = document.getElementById("groupStatus");
  if(statEl){ statEl.innerText = allGroups.length + " group" + (allGroups.length !== 1 ? "s" : "") + "."; }

  renderActionDropdown();
  loadAllFixlets();
}
</script>
      ]]></Head>
      <HTML><![CDATA[
<div class="dashboardVersion">v1.0.1</div>
<div class="page">
  <h1>Dereso Fixlet Dispatcher</h1>

  <!-- Filter panel -->
  <div class="panel">
    <div class="panelBody">
      <table class="rowTable">
        <tr>
          <td class="lbl">Search:</td>
          <td><input id="searchText" class="txtWide" value="" oninput="onSearchInput()"></td>
          <td class="right">
            <button class="btn" onclick="loadAllFixlets()">Load Fixlets</button>
            &nbsp;
            <button class="btn" onclick="testREST()">Test REST</button>
          </td>
        </tr>
      </table>
    </div>
  </div>

  <!-- Table panel -->
  <div class="panel">
    <div class="panelBody">
      <table style="width:100%; margin-bottom:8px;"><tr>
        <td><div id="status">Ready.</div></td>
        <td class="right">
          <span class="small">Show:&nbsp;
            <select id="pageSizeSelect" onchange="renderPage(0)" style="font-family:Arial; font-size:11px;">
              <option value="all">All</option>
              <option value="10">10</option>
              <option value="25">25</option>
              <option value="50" selected="selected">50</option>
              <option value="100">100</option>
            </select>&nbsp;rows
          </span>
        </td>
      </tr></table>
      <table id="fixletTable" class="tableGrid"></table>
      <div id="paginationControls" style="margin-top:8px; text-align:center;"></div>
      <div style="margin-top:10px;" class="small">Select a fixlet to load its details and deploy.</div>
    </div>
  </div>

  <!-- Detail panel (hidden until fixlet selected — D-07) -->
  <div class="panel" id="detailPanel" style="display:none;">
    <div class="panelBody">
      <table class="rowTable">
        <tr>
          <td class="lbl" style="width:120px;">Fixlet Name:</td>
          <td><span id="detailName" style="font-weight:bold;"></span></td>
        </tr>
        <tr>
          <td class="lbl">Category:</td>
          <td><span id="detailCategory"></span></td>
        </tr>
        <tr>
          <td class="lbl">Assigned Roles:</td>
          <td><span id="detailRoles" class="small"></span></td>
        </tr>
        <tr>
          <td class="lbl">Actions:</td>
          <td><span id="detailActionCount"></span></td>
        </tr>
        <tr>
          <td class="lbl">Prefetch Cache:</td>
          <td><span id="precacheStatus" class="small">—</span></td>
        </tr>
        <tr>
          <td class="lbl">Existing Deployment:</td>
          <td class="small">
            <span id="deploymentStatusAny">—</span><br>
            <span id="deploymentStatusGroup">—</span>
          </td>
        </tr>
        <tr>
          <td class="lbl">Action:</td>
          <td>
            <select id="actionSelect" onchange="onActionChange()" style="font-family:Arial; font-size:11px; border:1px solid #c8c8c8; padding:3px; width:280px;">
            </select>
            <span class="small" style="margin-left:8px;">Select an action to deploy</span>
          </td>
        </tr>
      </table>

      <div class="divider"></div>

      <!-- Deployment form -->
      <table class="rowTable">
        <tr>
          <td class="lbl" style="width:120px;">Target Group:</td>
          <td>
            <input type="text" id="groupSearch" class="txtWide" placeholder="Search groups..."
              oninput="filterGroups()">
            <select id="targetGroupSelect" onchange="onTargetGroupChange()" size="6"
              style="font-family:Arial; font-size:11px; border:1px solid #c8c8c8; width:360px; display:block; margin-top:4px;">
            </select>
            <div id="groupStatus" class="small" style="margin-top:2px;"></div>
          </td>
        </tr>
        <tr>
          <td class="lbl">Expires after:</td>
          <td>
            <input type="text" id="expiryDaysInput" value="7"
              style="width:40px; font-family:Arial; font-size:11px; border:1px solid #c8c8c8; padding:4px 6px;"
              oninput="updatePreview()">
            &nbsp;days
          </td>
        </tr>
        <tr>
          <td class="lbl">Root Server Staging:</td>
          <td>
            <label><input type="checkbox" id="stageOnRootServer" checked="checked" disabled="disabled"> Stage file on root server</label>
            <div id="stagingNote" class="small" style="margin-top:2px;"></div>
          </td>
        </tr>
      </table>

      <!-- Live preview panel (D-10) -->
      <div class="divider"></div>
      <div style="background:#f9f9f9; border:1px solid #e1e1e1; padding:10px; margin-bottom:10px;">
        <div class="small" style="margin-bottom:6px; font-weight:bold; color:#2a5d9f;">Deployment Preview</div>
        <table class="rowTable">
          <tr>
            <td class="lbl small" style="width:90px;">Title:</td>
            <td class="small"><span id="previewTitle"></span></td>
          </tr>
          <tr>
            <td class="lbl small">Category:</td>
            <td class="small"><span id="previewCategory"></span></td>
          </tr>
          <tr>
            <td class="lbl small">Action:</td>
            <td class="small"><span id="previewAction"></span></td>
          </tr>
          <tr>
            <td class="lbl small">Target:</td>
            <td class="small"><span id="previewTarget"></span></td>
          </tr>
          <tr>
            <td class="lbl small">Expires:</td>
            <td class="small"><span id="previewExpiry"></span></td>
          </tr>
        </table>
      </div>

      <!-- Deploy button and feedback (D-11) -->
      <table class="rowTable"><tr>
        <td>
          <div class="small">Offer will be created using the fixlet's category and description.<br>
          Selecting a target group is required. Admin must explicitly select an action above.</div>
        </td>
        <td class="right" style="white-space:nowrap;">
          <button class="btnGreen" onclick="deployFixlet()">Deploy</button>
          &nbsp;<span id="deployResult" style="color:#237241; font-weight:bold; display:none;"></span>
        </td>
      </tr></table>

      <!-- Inline error (D-11: no alert()) — T-03-02-04 -->
      <div id="deployError" style="color:#cc0000; margin-top:8px; display:none;"></div>
    </div>
  </div>

  <script>
  try {
    initDashboard();
  } catch(ex){
    alert("Init error: " + (ex.message || ex.description || String(ex)));
  }
  </script>

</div>
      ]]></HTML>
    </Page>
  </Wizard>
</BES>


