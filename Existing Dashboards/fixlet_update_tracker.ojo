var scanSourceResults = [];  // accumulated across source sites
var scanSiteIndex     = 0;   // current site index during scan loop
var updateRows        = [];  // buildScanResults().updates
var arrivalRows       = [];  // buildScanResults().arrivals
var sortColumn        = "";
var sortAsc           = true;

// -- HTML escaping to prevent XSS from untrusted BigFix server data --
function htmlEscape(s) {
  return String(s)
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;");
}

// -- XML escaping for BES XML payload construction --
function xmlEscape(s) {
  return String(s)
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;")
    .replace(/'/g, "&apos;");
}

function cdataStart() { return '<!' + '[CDATA['; }
function cdataEnd()   { return ']]' + '>'; }
function xmlCDataSafe(s) { return String(s).replace(/\]\]>/g, ']]]]><![CDATA[>'); }

// -- Status bar update (D-02) --
function setStatus(msg) {
  var el = document.getElementById("status");
  if (el) { el.innerText = msg; }
}

// -- Parse new fixlet ID from BigFix POST response (verbatim from fixlet_copier.ojo) --
function parseCreatedId(body) {
  var xml, nodes, txt, m;
  if (!body) { return ""; }
  try {
    xml = new ActiveXObject("Msxml2.DOMDocument.6.0");
    xml.async = false;
    xml.loadXML(body);
    nodes = xml.getElementsByTagName("Fixlet");
    if (nodes.length > 0) {
      txt = nodes[0].getAttribute("ID");
      if (txt && txt !== "") { return txt; }
      txt = nodes[0].getAttribute("Resource");
      if (txt && txt !== "") {
        m = /\/([^\/]+)$/.exec(txt);
        if (m && m[1]) { return m[1]; }
      }
    }
    nodes = xml.getElementsByTagName("Task");
    if (nodes.length > 0) {
      txt = nodes[0].getAttribute("ID");
      if (txt && txt !== "") { return txt; }
      txt = nodes[0].getAttribute("Resource");
      if (txt && txt !== "") {
        m = /\/([^\/]+)$/.exec(txt);
        if (m && m[1]) { return m[1]; }
      }
    }
  } catch (ex) {}
  m = /fixlet\/(?:custom|operator|external|master)\/[^\/]+\/(\d+)/i.exec(body);
  if (m && m[1]) { return m[1]; }
  m = /task\/(?:custom|operator|external|master)\/[^\/]+\/(\d+)/i.exec(body);
  if (m && m[1]) { return m[1]; }
  m = /\bID=["']?(\d+)["']?/i.exec(body);
  if (m && m[1]) { return m[1]; }
  return "";
}

// -- Sort header helper --
function makeSortHeader(col, label) {
  var indicator = sortColumn === col ? (sortAsc ? " &#9650;" : " &#9660;") : "";
  return '<b style="cursor:pointer;" onclick="sortBy(\'' + col + '\')">' + label + indicator + '</b>';
}

// -- Sort helpers for updates table --
function applySortToUpdateRows() {
  if (sortColumn === "") { return; }
  var col = sortColumn;
  var asc = sortAsc;
  updateRows.sort(function(a, b) {
    var va, vb, na, nb;
    if (col === "portalId" || col === "sourceId") {
      na = parseInt(String(a[col] || ""), 10) || 0;
      nb = parseInt(String(b[col] || ""), 10) || 0;
      return asc ? na - nb : nb - na;
    }
    va = String(a[col] || "").toLowerCase();
    vb = String(b[col] || "").toLowerCase();
    if (va < vb) { return asc ? -1 : 1; }
    if (va > vb) { return asc ? 1 : -1; }
    return 0;
  });
}

function sortBy(col) {
  if (sortColumn === col) { sortAsc = !sortAsc; }
  else { sortColumn = col; sortAsc = true; }
  applySortToUpdateRows();
  renderUpdatesTable();
}

// ---------------------------------------------------------------------------
// PURE LOGIC FUNCTIONS (verbatim from tests/unit/update_tracker.test.js SECTION 1)
// ---------------------------------------------------------------------------

// Source: RESEARCH.md Pattern 2
// CRITICAL: regex is / v\d[\d.]+/g — ONE-or-more [\d.]+ after first digit.
// This preserves product-family tokens like "v2" in "AWS Command Line Interface v2".
function stripVersion(name) {
  return String(name).replace(/ v\d[\d.]+/g, "");
}

// Source: RESEARCH.md Pattern 2
function extractVersion(name) {
  var m = / v(\d[\d.]+)/.exec(name);
  return m ? m[1] : "";
}

// Source: RESEARCH.md Pattern 2
// Segment-by-segment numeric comparison. Returns 1 if a > b, -1 if a < b, 0 if equal.
function compareVersions(a, b) {
  var pa = a.split("."), pb = b.split(".");
  var len = Math.max(pa.length, pb.length);
  var i, na, nb;
  for (i = 0; i < len; i++) {
    na = parseInt(pa[i] || "0", 10) || 0;
    nb = parseInt(pb[i] || "0", 10) || 0;
    if (na > nb) { return 1; }
    if (na < nb) { return -1; }
  }
  return 0;
}

// Source: RESEARCH.md Code Examples
// D-16: prefer old portal fixlet's native <Category>; fall back to CSV lookup.
function lookupCategory(productKey, portalCategory) {
  if (portalCategory && portalCategory !== "") { return portalCategory; }
  if (typeof CATEGORY_MAP !== "undefined" && CATEGORY_MAP[productKey]) {
    return CATEGORY_MAP[productKey];
  }
  return "";
}

// Source: RESEARCH.md Pattern 6
// D-06: show all newer versions (not just latest).
// D-07: show all source-site matches (no deduplication).
function buildScanResults(portalItemsArg, sourceItemsArg) {
  var portalMap = {};
  var i, key, pItem;
  for (i = 0; i < portalItemsArg.length; i++) {
    pItem = portalItemsArg[i];
    key = stripVersion(pItem.name);
    if (!portalMap[key]) { portalMap[key] = []; }
    portalMap[key].push(pItem);
  }

  var updates  = [];
  var arrivals = [];

  for (i = 0; i < sourceItemsArg.length; i++) {
    var sItem = sourceItemsArg[i];
    var sKey  = stripVersion(sItem.name);
    var sVer  = extractVersion(sItem.name);

    if (portalMap[sKey]) {
      var j, pMatch;
      for (j = 0; j < portalMap[sKey].length; j++) {
        pMatch = portalMap[sKey][j];
        var pVer = extractVersion(pMatch.name);
        if (compareVersions(sVer, pVer) > 0) {
          updates.push({
            portalId:       pMatch.id,
            portalName:     pMatch.name,
            portalCategory: pMatch.category,
            portalRoles:    pMatch.roles,
            sourceId:       sItem.id,
            sourceName:     sItem.name,
            sourceSiteName: sItem.siteName,
            sourceSiteType: sItem.siteType,
            productKey:     sKey
          });
        }
      }
    } else {
      var suggested = (typeof CATEGORY_MAP !== "undefined" && CATEGORY_MAP[sKey]) || "";
      arrivals.push({
        sourceId:          sItem.id,
        sourceName:        sItem.name,
        sourceSiteName:    sItem.siteName,
        sourceSiteType:    sItem.siteType,
        productKey:        sKey,
        suggestedCategory: suggested
      });
    }
  }

  return { updates: updates, arrivals: arrivals };
}

// ---------------------------------------------------------------------------
// MIME FIELD READ HELPER
// ---------------------------------------------------------------------------

// Reads a named MIME field value from a parsed MSXML document.
// REQUIRES: origDoc.setProperty("SelectionLanguage","XPath") called first (Pitfall 4).
function readMimeField(xmlDoc, fieldName) {
  var mimeNodes = xmlDoc.getElementsByTagName("MIMEField");
  var m, nameNode, valueNode, mName;
  for (m = 0; m < mimeNodes.length; m++) {
    nameNode = mimeNodes[m].selectSingleNode("Name");
    mName = nameNode ? String(nameNode.text || "").replace(/^\s+|\s+$/g, "") : "";
    if (mName === fieldName) {
      valueNode = mimeNodes[m].selectSingleNode("Value");
      return valueNode ? String(valueNode.text || "") : "";
    }
  }
  return "";
}

// ---------------------------------------------------------------------------
// PORTAL FIXLET QUERY
// ---------------------------------------------------------------------------

// Loads all fixlets from the Dereso Software Portal site via EvaluateRelevance.
// Returns array of {id, name, category, roles, portalItemType} objects.
// Source: RESEARCH.md Pattern 5 (adapted from fixlet_dispatcher.ojo loadAllFixlets).
function loadPortalFixlets() {
  var rel =
    '(id of it as string' +
    ' & "\x1F" & name of it' +
    ' & "\x1F" & (if exists category of it then category of it as string else "")' +
    ' & "\x1F" & (if exists mime fields whose (name of it = "Associated_Roles") of it' +
    '   then concatenation of values of mime fields whose (name of it = "Associated_Roles") of it' +
    '   else "")' +
    ' & "\x1F" & (if task flag of it then "task" else "fixlet"))' +
    ' of bes fixlets whose (name of (site of it) = "Dereso Software Portal"' +
    '   and (fixlet flag of it or task flag of it))';
  var data = EvaluateRelevance(rel);
  var items = [];
  var i, p;
  for (i = 0; i < data.length; i++) {
    p = String(data[i]).split("\x1F");
    items.push({ id: p[0], name: p[1], category: p[2] || "", roles: p[3] || "", portalItemType: p[4] || "fixlet" });
  }
  return items;
}

// ---------------------------------------------------------------------------
// SCAN ENGINE (D-01, D-02, D-05)
// ---------------------------------------------------------------------------

// D-01: Admin clicks "Scan for Updates" to trigger scan.
// D-03: Results cleared on each scan.
function startScan() {
  scanSourceResults = [];
  scanSiteIndex = 0;
  portalItems = [];
  updateRows = [];
  arrivalRows = [];
  setStatus("Loading portal fixlets...");
  portalItems = loadPortalFixlets();
  setStatus("Scanning source sites...");
  setTimeout(scanNextSite, 0);  // Yield to allow initial repaint (D-02)
}

// Processes one source site per call, then yields via setTimeout (D-02).
// Source: RESEARCH.md Pattern 4.
function scanNextSite() {
  if (scanSiteIndex >= PORTAL_CONFIG.sourceSites.length) {
    processScanResults();
    return;
  }
  var siteName = PORTAL_CONFIG.sourceSites[scanSiteIndex];
  setStatus("Scanning site " + (scanSiteIndex + 1) + " of " +
    PORTAL_CONFIG.sourceSites.length + ": " + siteName +
    "... (" + scanSourceResults.length + " fixlets found so far)");

  var safesite = siteName.replace(/"/g, '""');
  var rel =
    '(id of it as string' +
    ' & "\x1F" & name of it' +
    ' & "\x1F" & name of (site of it)' +
    ' & "\x1F" & (if custom site flag of (site of it) then "custom"' +
    '   else if external site flag of (site of it) then "external"' +
    '   else if operator site flag of (site of it) then "operator" else "master"))' +
    ' of bes fixlets whose (name of (site of it) = "' + safesite + '"' +
    '   and (fixlet flag of it or task flag of it))';

  var data = EvaluateRelevance(rel);
  var i, p;
  for (i = 0; i < data.length; i++) {
    p = String(data[i]).split("\x1F");
    scanSourceResults.push({ id: p[0], name: p[1], siteName: p[2], siteType: p[3] });
  }
  scanSiteIndex++;
  setTimeout(scanNextSite, 0);  // Yield to allow repaint before next site (D-02)
}

// Called after all source sites have been scanned.
function processScanResults() {
  var result = buildScanResults(portalItems, scanSourceResults);
  updateRows  = result.updates;
  arrivalRows = result.arrivals;
  renderUpdatesTable();
  renderArrivalsTable();
  updateTabBadges(updateRows.length, arrivalRows.length);
  setStatus("Scan complete. " + updateRows.length + " updates, " + arrivalRows.length + " new arrivals.");
}

// ---------------------------------------------------------------------------
// TABLE RENDERING
// ---------------------------------------------------------------------------

// Renders the updates comparison table into #updatesTableContainer.
// Source: RESEARCH.md Pattern 11.
function renderUpdatesTable() {
  var container = document.getElementById("updatesTableContainer");
  if (!container) { return; }
  container.innerHTML = "";

  if (updateRows.length === 0) {
    container.innerHTML = '<p class="small">No updates found. Click "Scan for Updates" to scan.</p>';
    return;
  }

  var t = document.createElement("table");
  t.id = "updatesTable";
  t.className = "tableGrid";
  t.style.width = "100%";

  // Header row
  var hdr = t.insertRow(-1);
  var chkAllCell = hdr.insertCell(-1);
  chkAllCell.style.width = "24px";
  chkAllCell.innerHTML = '<input type="checkbox" id="chkAll" onclick="toggleSelectAll(this)">';

  hdr.insertCell(-1).innerHTML = makeSortHeader("portalName",     "Current Portal Fixlet");
  hdr.insertCell(-1).innerHTML = makeSortHeader("sourceName",     "Available Update");
  hdr.insertCell(-1).innerHTML = makeSortHeader("sourceSiteName", "Source Site");
  hdr.insertCell(-1).innerHTML = makeSortHeader("portalCategory", "Category");
  hdr.insertCell(-1).innerHTML = makeSortHeader("portalRoles",    "Roles");

  // Style header cells
  var hi, hCell;
  for (hi = 0; hi < hdr.cells.length; hi++) {
    hCell = hdr.cells[hi];
    hCell.style.background = "#f4f6f8";
    hCell.style.color = "#2a5d9f";
    hCell.style.fontWeight = "bold";
    hCell.style.borderBottom = "2px solid #d7dbe0";
  }

  // Data rows
  var i;
  for (i = 0; i < updateRows.length; i++) {
    renderUpdateRow(t, updateRows[i], i);
  }

  container.appendChild(t);
}

// Renders one update row with checkbox and 5 data cells.
// Source: RESEARCH.md Pattern 11.
function renderUpdateRow(t, item, index) {
  var r = t.insertRow(-1);
  r._rowData = item;  // Assumption A5: store data on TR for getSelectedUpdateRows()

  // Checkbox cell
  var chkCell = r.insertCell(-1);
  var chk = document.createElement("input");
  chk.type = "checkbox";
  chk.id   = "chkUpd_" + index;
  chkCell.appendChild(chk);

  // Data cells — all values through htmlEscape() (T-06-02-XSS mitigation)
  r.insertCell(-1).innerHTML = htmlEscape(item.portalName     || "");
  r.insertCell(-1).innerHTML = htmlEscape(item.sourceName     || "");
  r.insertCell(-1).innerHTML = htmlEscape(item.sourceSiteName || "");
  r.insertCell(-1).innerHTML = htmlEscape(item.portalCategory || "");
  r.insertCell(-1).innerHTML = htmlEscape(item.portalRoles    || "");
}

// Renders the new arrivals table into #arrivalsTableContainer.
// Per-row Copy button for simplified 2-step flow (no batch selection on arrivals).
function renderArrivalsTable() {
  var container = document.getElementById("arrivalsTableContainer");
  if (!container) { return; }
  container.innerHTML = "";

  if (arrivalRows.length === 0) {
    container.innerHTML = '<p class="small">No new arrivals found.</p>';
    return;
  }

  var t = document.createElement("table");
  t.id = "arrivalsTable";
  t.className = "tableGrid";
  t.style.width = "100%";

  // Header row
  var hdr = t.insertRow(-1);
  hdr.insertCell(-1).innerHTML = "<b>Product (Source Site)</b>";
  hdr.insertCell(-1).innerHTML = "<b>Suggested Category</b>";
  hdr.insertCell(-1).innerHTML = "<b>Action</b>";

  // Style header cells
  var hi, hCell;
  for (hi = 0; hi < hdr.cells.length; hi++) {
    hCell = hdr.cells[hi];
    hCell.style.background = "#f4f6f8";
    hCell.style.color = "#2a5d9f";
    hCell.style.fontWeight = "bold";
    hCell.style.borderBottom = "2px solid #d7dbe0";
  }

  // Data rows
  var i;
  for (i = 0; i < arrivalRows.length; i++) {
    var item = arrivalRows[i];
    var r = t.insertRow(-1);

    // Product name + site
    r.insertCell(-1).innerHTML =
      htmlEscape(item.sourceName || "") +
      '<br><span class="small">' + htmlEscape(item.sourceSiteName || "") + '</span>';

    // Suggested category
    r.insertCell(-1).innerHTML = htmlEscape(item.suggestedCategory || "");

    // Per-row Copy button (closure to capture item)
    var actionCell = r.insertCell(-1);
    var btn = document.createElement("button");
    btn.className = "btn";
    btn.innerText = "Copy";
    btn.onclick = (function(arrival) {
      return function() { onCopyArrival(arrival); };
    })(item);
    actionCell.appendChild(btn);
  }

  container.appendChild(t);
}

// ---------------------------------------------------------------------------
// CHECKBOX HELPERS (D-11, D-12, D-14)
// ---------------------------------------------------------------------------

// Toggles all update row checkboxes to match the master checkbox state.
function toggleSelectAll(masterChk) {
  var t = document.getElementById("updatesTable");
  if (!t) { return; }
  var i, chk;
  for (i = 1; i < t.rows.length; i++) {  // skip header row
    chk = t.rows[i].cells[0] && t.rows[i].cells[0].getElementsByTagName("input")[0];
    if (chk && chk.type === "checkbox") { chk.checked = masterChk.checked; }
  }
}

// Returns array of _rowData for all checked update rows.
function getSelectedUpdateRows() {
  var t = document.getElementById("updatesTable");
  if (!t) { return []; }
  var selected = [];
  var i, chk;
  for (i = 1; i < t.rows.length; i++) {  // skip header row
    chk = t.rows[i].cells[0] && t.rows[i].cells[0].getElementsByTagName("input")[0];
    if (chk && chk.type === "checkbox" && chk.checked) {
      selected.push(t.rows[i]._rowData);
    }
  }
  return selected;
}

// ---------------------------------------------------------------------------
// TAB UI (D-15)
// ---------------------------------------------------------------------------

// Switches between Updates and New Arrivals tabs (div show/hide pattern).
// Source: RESEARCH.md Pattern 10.
function switchTab(tab) {
  var u  = document.getElementById("tabUpdates");
  var a  = document.getElementById("tabArrivals");
  var bu = document.getElementById("tabBtnUpdates");
  var ba = document.getElementById("tabBtnArrivals");
  if (u)  { u.style.display  = tab === "updates"  ? "" : "none"; }
  if (a)  { a.style.display  = tab === "arrivals" ? "" : "none"; }
  if (bu) { bu.className = tab === "updates"  ? "tabBtn tabActive" : "tabBtn"; }
  if (ba) { ba.className = tab === "arrivals" ? "tabBtn tabActive" : "tabBtn"; }
}

// Updates tab badge counts after scan completes (D-15).
function updateTabBadges(updCount, arrCount) {
  var bu = document.getElementById("badgeUpdates");
  var ba = document.getElementById("badgeArrivals");
  if (bu) { bu.innerHTML = updCount > 0  ? " (" + updCount + ")"  : ""; }
  if (ba) { ba.innerHTML = arrCount > 0  ? " (" + arrCount + ")"  : ""; }
}

// ---------------------------------------------------------------------------
// COPY ENGINE (Task 2)
// ---------------------------------------------------------------------------

// Builds BES XML for a new portal fixlet based on the source fixlet XML,
// overriding Category and adding Associated_Roles MIME field (D-16, D-17).
// Source: RESEARCH.md Pattern 7.
function buildCopyXml(sourceXml, category, rolesValue) {
  // Strip existing Associated_Roles via regex before DOM parsing (modifier.ojo pattern)
  var cleanedXml = ("" + sourceXml).replace(
    /<MIMEField>\s*<Name>\s*Associated_Roles\s*<\/Name>[\s\S]*?<\/MIMEField>/gi, "");

  var origDoc = new ActiveXObject("Msxml2.DOMDocument.6.0");
  origDoc.async            = false;
  origDoc.validateOnParse  = false;
  origDoc.resolveExternals = false;
  origDoc.setProperty("SelectionLanguage", "XPath");  // Pitfall 4 guard
  origDoc.loadXML(cleanedXml);

  var fixletNode = origDoc.getElementsByTagName("Fixlet")[0] ||
                   origDoc.getElementsByTagName("Task")[0];
  if (!fixletNode) {
    setStatus("ERROR: no Fixlet/Task node in source XML");
    return "";
  }

  // Override Category (D-16: portal category wins); create element if absent
  var catNodes = origDoc.getElementsByTagName("Category");
  var catNode;
  if (catNodes.length > 0) {
    catNode = catNodes[0];
  } else {
    catNode = origDoc.createElement("Category");
    var relNodes = fixletNode.getElementsByTagName("Relevance");
    var refNode = relNodes.length > 0 ? relNodes[relNodes.length - 1].nextSibling : null;
    fixletNode.insertBefore(catNode, refNode || fixletNode.firstChild);
  }
  catNode.text = category;

  // Add Associated_Roles MIME field before <Domain> (D-17: roles transfer)
  if (rolesValue) {
    var newMime = origDoc.createElement("MIMEField");
    var nameEl  = origDoc.createElement("Name");
    var valueEl = origDoc.createElement("Value");
    nameEl.text  = "Associated_Roles";
    valueEl.text = rolesValue;  // DOM .text assignment auto-escapes (T-06-02-MIME)
    newMime.appendChild(nameEl);
    newMime.appendChild(valueEl);
    var domainNode = fixletNode.selectSingleNode("Domain");
    if (domainNode) { fixletNode.insertBefore(newMime, domainNode); }
    else            { fixletNode.appendChild(newMime); }
  }

  return '<?xml version="1.0" encoding="UTF-8"?>\r\n' + origDoc.documentElement.xml;
}

// Builds BES XML for the old portal fixlet stamped with X-Superseded-By MIME field (D-08).
// Source: RESEARCH.md Pattern 8.
function buildSupersededXml(oldPortalXml, newFixletId) {
  // Strip existing X-Superseded-By via regex (idempotent)
  var cleanedXml = ("" + oldPortalXml).replace(
    /<MIMEField>\s*<Name>\s*X-Superseded-By\s*<\/Name>[\s\S]*?<\/MIMEField>/gi, "");

  var origDoc = new ActiveXObject("Msxml2.DOMDocument.6.0");
  origDoc.async            = false;
  origDoc.validateOnParse  = false;
  origDoc.resolveExternals = false;
  origDoc.setProperty("SelectionLanguage", "XPath");  // Pitfall 4 guard
  origDoc.loadXML(cleanedXml);

  var fixletNode = origDoc.getElementsByTagName("Fixlet")[0] ||
                   origDoc.getElementsByTagName("Task")[0];
  if (!fixletNode) { return ""; }

  // Add X-Superseded-By MIME field (D-08: new fixlet ID as integer string)
  var newMime = origDoc.createElement("MIMEField");
  var nameEl  = origDoc.createElement("Name");
  var valueEl = origDoc.createElement("Value");
  nameEl.text  = "X-Superseded-By";
  valueEl.text = String(newFixletId);
  newMime.appendChild(nameEl);
  newMime.appendChild(valueEl);
  var domainNode = fixletNode.selectSingleNode("Domain");
  if (domainNode) { fixletNode.insertBefore(newMime, domainNode); }
  else            { fixletNode.appendChild(newMime); }

  return '<?xml version="1.0" encoding="UTF-8"?>\r\n' + origDoc.documentElement.xml;
}

// Sequentially copies items one at a time using 4 nested API callbacks per item.
// ALWAYS recurses on both success AND error (D-12 partial failure model).
// Source: RESEARCH.md Pattern 9 (adapted from fixlet_role_assigner.ojo deployNextRole).
function copyNextItem(items, index, results, onAllDone) {
  if (index >= items.length) {
    onAllDone(results);
    return;
  }

  var item = items[index];
  var progressEl = document.getElementById("copyProgress");
  if (progressEl) {
    var msg = document.createElement("div");
    msg.innerText = "Copying " + (index + 1) + " of " + items.length + ": " + item.sourceName + "...";
    progressEl.appendChild(msg);
  }

  // Step 1: GET old portal fixlet XML
  var pathType = item.portalItemType || "fixlet";
  var portalGetPath = pathType + "/custom/" + encodeURIComponent("Dereso Software Portal") +
                      "/" + encodeURIComponent(item.portalId);

  API.Get(portalGetPath, function(e1, s1, b1) {
    if (s1 !== 200) {
      results.push({ ok: false, name: item.sourceName, error: "GET portal fixlet failed: status=" + s1 });
      copyNextItem(items, index + 1, results, onAllDone);  // always recurse (D-12)
      return;
    }
    var portalXml = b1;

    // Step 2: GET source fixlet XML
    var srcPath = "fixlet/" + item.sourceSiteType + "/" +
                  encodeURIComponent(item.sourceSiteName) + "/" + encodeURIComponent(item.sourceId);

    API.Get(srcPath, function(e2, s2, b2) {
      if (s2 !== 200) {
        results.push({ ok: false, name: item.sourceName, error: "GET source fixlet failed: status=" + s2 });
        copyNextItem(items, index + 1, results, onAllDone);  // always recurse (D-12)
        return;
      }

      // Step 3: POST copy to portal with category + roles from preview panel
      var newXml   = buildCopyXml(b2, item.previewCategory, item.previewRoles);
      var postPath = "fixlets/custom/" + encodeURIComponent("Dereso Software Portal");  // plural (Pitfall 2)

      API.Post(postPath, newXml, function(e3, s3, b3) {
        if (s3 !== 200 && s3 !== 201) {  // dual-status check (Pitfall 6)
          results.push({ ok: false, name: item.sourceName, error: "POST copy failed: status=" + s3 });
          copyNextItem(items, index + 1, results, onAllDone);  // always recurse (D-12)
          return;
        }
        var newId = parseCreatedId(b3);
        if (!newId) {
          results.push({ ok: false, name: item.sourceName,
                         error: "POST succeeded but could not extract new fixlet ID from response" });
          copyNextItem(items, index + 1, results, onAllDone);
          return;
        }

        // Step 4: PUT X-Superseded-By on old portal fixlet
        var supersededXml = buildSupersededXml(portalXml, newId);
        var putPath = pathType + "/custom/" + encodeURIComponent("Dereso Software Portal") +
                      "/" + encodeURIComponent(item.portalId);

        API.Put(putPath, supersededXml, function(e4, s4, b4) {
          var putOk = (s4 === 200 || s4 === 201);  // dual-status check (Pitfall 6)
          results.push({
            ok:    putOk,
            name:  item.sourceName,
            newId: newId,
            error: putOk ? "" : "PUT supersede failed: status=" + s4
          });
          copyNextItem(items, index + 1, results, onAllDone);  // always recurse (D-12)
        });
      });
    });
  });
}

// Simplified 2-step copy for New Arrivals (no old portal fixlet, no PUT supersede).
// Source: RESEARCH.md copyArrival specification.
function copyArrival(arrival, onDone) {
  // Step 1: GET source fixlet XML
  var srcPath = "fixlet/" + arrival.sourceSiteType + "/" +
                encodeURIComponent(arrival.sourceSiteName) + "/" + encodeURIComponent(arrival.sourceId);

  API.Get(srcPath, function(e1, s1, b1) {
    if (s1 !== 200) {
      onDone({ ok: false, name: arrival.sourceName, error: "GET source failed: status=" + s1 });
      return;
    }

    // Step 2: POST copy to portal (no roles — admin assigns via Modifier per D-09)
    var newXml   = buildCopyXml(b1, arrival.copyCategory, "");
    var postPath = "fixlets/custom/" + encodeURIComponent("Dereso Software Portal");

    API.Post(postPath, newXml, function(e2, s2, b2) {
      if (s2 === 200 || s2 === 201) {
        onDone({ ok: true, name: arrival.sourceName, newId: parseCreatedId(b2), error: "" });
      } else {
        onDone({ ok: false, name: arrival.sourceName, error: "POST failed: status=" + s2 });
      }
    });
  });
}

// Per-row Copy button handler for New Arrivals tab.
function onCopyArrival(arrival) {
  arrival.copyCategory = arrival.suggestedCategory;
  var resultsEl = document.getElementById("resultsPanel");
  var progressEl = document.getElementById("copyProgress");
  var tableEl = document.getElementById("resultsTableContainer");
  if (resultsEl) { resultsEl.style.display = ""; }
  if (progressEl) { progressEl.innerHTML = ""; }
  if (tableEl) { tableEl.innerHTML = ""; }
  copyArrival(arrival, function(result) {
    renderResultsPanel([result]);
  });
}

// Populates the preview panel with editable Category dropdown and Roles field (D-13).
// Source: RESEARCH.md D-11, D-13 specification.
function showPreviewPanel(selectedRows) {
  var panel = document.getElementById("previewPanel");
  var container = document.getElementById("previewTableContainer");
  if (!panel || !container) { return; }

  // Build preview table HTML
  var html = '<table class="tableGrid" style="width:100%;">';
  html += '<tr style="background:#f4f6f8;">';
  html += '<th>From (Current Portal Fixlet)</th>';
  html += '<th>To (Available Update)</th>';
  html += '<th>Category</th>';
  html += '<th>Roles</th>';
  html += '</tr>';

  var i, item, catOptions, ci, cat, selected;
  for (i = 0; i < selectedRows.length; i++) {
    item = selectedRows[i];

    // Build category dropdown options
    catOptions = "";
    for (ci = 0; ci < PORTAL_CONFIG.categories.length; ci++) {
      cat = PORTAL_CONFIG.categories[ci];
      selected = (lookupCategory(item.productKey, item.portalCategory) === cat) ? ' selected="selected"' : "";
      catOptions += '<option value="' + htmlEscape(cat) + '"' + selected + '>' + htmlEscape(cat) + '</option>';
    }

    html += '<tr>';
    html += '<td>' + htmlEscape(item.portalName || "") + '</td>';
    html += '<td>' + htmlEscape(item.sourceName || "") + '</td>';
    html += '<td><select id="previewCat_' + i + '" class="txt">' + catOptions + '</select></td>';
    html += '<td><input type="text" id="previewRoles_' + i + '" class="txt" value="' + htmlEscape(item.portalRoles || "") + '"></td>';
    html += '</tr>';
  }
  html += '</table>';

  container.innerHTML = html;

  // Store selected rows reference for onConfirmCopy
  panel._selectedRows = selectedRows;

  // Show preview panel; hide tab panels while preview is active
  panel.style.display = "";
  var tabUpdatesEl = document.getElementById("tabUpdates");
  var tabArrivalsEl = document.getElementById("tabArrivals");
  if (tabUpdatesEl)  { tabUpdatesEl.style.display  = "none"; }
  if (tabArrivalsEl) { tabArrivalsEl.style.display = "none"; }
}

// Click handler for "Copy Selected" button in the Updates tab (D-11).
function onCopySelected() {
  var selectedRows = getSelectedUpdateRows();
  if (selectedRows.length === 0) {
    alert("Select at least one update to copy.");
    return;
  }
  showPreviewPanel(selectedRows);
}

// Click handler for "Cancel" button in the preview panel (CR-04).
// Hides the preview panel and restores the active tab so both tab panels become visible again.
function onCancelCopy() {
  var panel = document.getElementById("previewPanel");
  if (panel) { panel.style.display = "none"; }
  switchTab("updates");  // restore active tab and tab button styles
}

// Click handler for "Confirm & Copy All" button in the preview panel (D-11).
function onConfirmCopy() {
  var panel = document.getElementById("previewPanel");
  if (!panel || !panel._selectedRows) { return; }
  var selectedRows = panel._selectedRows;
  var items = [];
  var i, item, catEl, rolesEl;

  // Read editable values from preview panel DOM
  for (i = 0; i < selectedRows.length; i++) {
    item = selectedRows[i];
    catEl   = document.getElementById("previewCat_"   + i);
    rolesEl = document.getElementById("previewRoles_" + i);
    // Clone the row data and attach preview-panel values
    items.push({
      portalId:       item.portalId,
      portalName:     item.portalName,
      portalCategory: item.portalCategory,
      portalRoles:    item.portalRoles,
      sourceId:       item.sourceId,
      sourceName:     item.sourceName,
      sourceSiteName: item.sourceSiteName,
      sourceSiteType: item.sourceSiteType,
      productKey:     item.productKey,
      previewCategory: catEl   ? catEl.value   : (item.portalCategory || ""),
      previewRoles:    rolesEl ? rolesEl.value : (item.portalRoles    || "")
    });
  }

  // Hide preview panel; show results panel
  panel.style.display = "none";
  var resultsPanel = document.getElementById("resultsPanel");
  var progressEl   = document.getElementById("copyProgress");
  var tableEl      = document.getElementById("resultsTableContainer");
  if (resultsPanel) { resultsPanel.style.display = ""; }
  if (progressEl)   { progressEl.innerHTML = ""; }
  if (tableEl)      { tableEl.innerHTML = ""; }

  // Restore tab panels visibility and active tab state
  switchTab("updates");

  copyNextItem(items, 0, [], onAllCopiesDone);
}

// Callback invoked when all items in copyNextItem batch have been processed.
function onAllCopiesDone(results) {
  renderResultsPanel(results);
  var succeeded = 0;
  var failed    = 0;
  var i;
  for (i = 0; i < results.length; i++) {
    if (results[i].ok) { succeeded++; } else { failed++; }
  }
  setStatus("Copy complete: " + succeeded + " succeeded, " + failed + " failed.");
}

// Renders per-item copy results into #resultsTableContainer.
function renderResultsPanel(results) {
  var container = document.getElementById("resultsTableContainer");
  if (!container) { return; }

  var html = '<table class="tableGrid" style="width:100%;">';
  html += '<tr style="background:#f4f6f8;"><th>Status</th><th>Product</th><th>Details</th></tr>';
  var i, r, statusHtml, detailHtml;
  for (i = 0; i < results.length; i++) {
    r = results[i];
    if (r.ok) {
      statusHtml = '<span style="color:#237241;font-weight:bold;">OK</span>';
      detailHtml = 'New ID: ' + htmlEscape(String(r.newId || ""));
    } else {
      statusHtml = '<span style="color:#a02020;font-weight:bold;">FAIL</span>';
      detailHtml = htmlEscape(r.error || "Unknown error");
    }
    html += '<tr>';
    html += '<td>' + statusHtml + '</td>';
    html += '<td>' + htmlEscape(r.name || "") + '</td>';
    html += '<td>' + detailHtml + '</td>';
    html += '</tr>';
  }
  html += '</table>';
  container.innerHTML = html;
}

</script>
]]></Head>
      <HTML><![CDATA[
<div class="page">
  <h1>Dereso Fixlet Update Tracker</h1>

  <!-- Scan panel -->
  <div class="panel">
    <div class="panelBody">
      <table class="rowTable"><tr>
        <td><button class="btnGreen" onclick="startScan()">Scan for Updates</button></td>
        <td><span id="status" class="small">&nbsp;</span></td>
      </tr></table>
    </div>
  </div>

  <!-- Tab bar -->
  <div style="margin-bottom:0;">
    <button id="tabBtnUpdates" class="tabBtn tabActive" onclick="switchTab('updates')">Updates <span id="badgeUpdates"></span></button>
    <button id="tabBtnArrivals" class="tabBtn" onclick="switchTab('arrivals')">New Arrivals <span id="badgeArrivals"></span></button>
  </div>

  <!-- Tab panels -->
  <div id="tabUpdates" class="panel" style="padding:8px;">
    <div style="margin-bottom:6px;">
      <button class="btn" onclick="onCopySelected()">Copy Selected</button>
    </div>
    <div id="updatesTableContainer"></div>
  </div>

  <div id="tabArrivals" class="panel" style="padding:8px;display:none;">
    <div id="arrivalsTableContainer"></div>
  </div>

  <!-- Preview panel (hidden until Copy Selected clicked) -->
  <div id="previewPanel" class="panel" style="display:none;">
    <div class="panelBody">
      <h2 style="font-size:14px;margin:0 0 8px 0;">Review &amp; Confirm Copies</h2>
      <div id="previewTableContainer"></div>
      <div style="margin-top:10px;">
        <button class="btnGreen" onclick="onConfirmCopy()">Confirm &amp; Copy All</button>
        &nbsp;
        <button class="btn" onclick="onCancelCopy()">Cancel</button>
      </div>
    </div>
  </div>

  <!-- Results panel (hidden until copy completes) -->
  <div id="resultsPanel" class="panel" style="display:none;">
    <div class="panelBody">
      <h2 style="font-size:14px;margin:0 0 8px 0;">Copy Results</h2>
      <div id="copyProgress"></div>
      <div id="resultsTableContainer"></div>
    </div>
  </div>

</div>
      ]]></HTML>
    </Page>
  </Wizard>
</BES>
